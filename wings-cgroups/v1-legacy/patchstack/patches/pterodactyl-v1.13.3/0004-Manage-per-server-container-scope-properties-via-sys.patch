 }
 
+// DockerSliceDefaults are the node-wide default resource properties applied
+// to every Wings-derived per-server slice. Sizes use single-letter binary
+// suffixes ("6G", "512M") or plain byte counts; empty means "no default".
+// Weights are the systemd cgroup weight range 1..10000; 0 means "no default".
+// A per-server WINGS_CG_* environment variable overrides the corresponding
+// default for that server only.
+type DockerSliceDefaults struct {
+	MemoryMin  string `default:"" json:"memory_min" yaml:"memory_min"`
+	MemoryLow  string `default:"" json:"memory_low" yaml:"memory_low"`
+	MemoryHigh string `default:"" json:"memory_high" yaml:"memory_high"`
+	MemoryMax  string `default:"" json:"memory_max" yaml:"memory_max"`
+	CPUWeight  uint64 `default:"0" json:"cpu_weight" yaml:"cpu_weight"`
+	IOWeight   uint64 `default:"0" json:"io_weight" yaml:"io_weight"`
+}
+
+// PerServerSlicesConfiguration configures per-server cgroup property
+// management (docker.per_server_slices). Requires CgroupParent to be set:
+// containers are placed flat under it, and the properties are applied to each
+// container's own docker-<id>.scope inside it.
+//
+// The block keeps its historical name for configuration compatibility even
+// though Wings no longer creates a slice per server. There is no budget knob
+// here on purpose: floors are applied exactly as configured and an
+// over-committed tier is arbitrated by the kernel, which shares the tier
+// slice's protection out in proportion to each child's usage below its own
+// floor. Wings only reports the condition; see cgroups.Result.Overcommit.
+type PerServerSlicesConfiguration struct {
+	Enabled bool `default:"false" json:"enabled" yaml:"enabled"`
+
+	// Defaults are applied to every managed container scope; individual
+	// servers may override single properties through admin-only WINGS_CG_*
+	// variables. A server pinned to an administrator-managed slice by an
+	// explicit WINGS_CGROUP_PARENT override receives only its explicit
+	// WINGS_CG_* values, never these defaults — that slice's policy is the
+	// administrator's.
+	Defaults DockerSliceDefaults `json:"defaults" yaml:"defaults"`
+}
+
 func (c DockerConfiguration) ContainerLogConfig() container.LogConfig {
 	if c.LogConfig.Type == "" {
 		return container.LogConfig{}
@@ -224,12 +279,7 @@ const CgroupParentOverrideEnv = "WINGS_CGROUP_PARENT"
 // default is returned together with an error describing the rejection so that
 // callers can log it. The returned string is always safe to use.
 func (c DockerConfiguration) ResolveCgroupParent(env []string) (string, error) {
-	override := ""
-	for _, v := range env {
-		if val, ok := strings.CutPrefix(v, CgroupParentOverrideEnv+"="); ok {
-			override = val
-		}
-	}
+	override := cgroupParentOverride(env)
 	if override == "" || override == c.CgroupParent {
 		return c.CgroupParent, nil
 	}
@@ -250,6 +300,102 @@ func (c DockerConfiguration) ResolveCgroupParent(env []string) (string, error) {
 	return c.CgroupParent, errors.New(CgroupParentOverrideEnv + " override " + strconv.Quote(override) + " is outside the built-in wings-*.slice namespace and docker.allowed_cgroup_parents is not configured")
 }
 
+// cgroupParentOverride extracts the raw (unvalidated) WINGS_CGROUP_PARENT
+// value from a resolved server environment; the last occurrence wins.
+func cgroupParentOverride(env []string) string {
+	override := ""
+	for _, v := range env {
+		if val, ok := strings.CutPrefix(v, CgroupParentOverrideEnv+"="); ok {
+			override = val
+		}
+	}
+	return override
+}
+
+// ResolveServerCgroupParent resolves the cgroup parent a server's containers
+// are created under, and reports whether Wings should manage the resource
+// properties of the container scope that ends up inside it.
+//
+// Placement itself is flat and unchanged by per-server management: every
+// container goes directly under the node-wide CgroupParent unless an explicit
+// admin-only WINGS_CGROUP_PARENT override names a different, allow-listed
+// slice. Rejected overrides fail closed to the node-wide value and are
+// reported through err.
+//
+// The managed return value reports whether Wings applies this server's
+// resource properties to its container scope once the container is running
+// (see cgroups.Apply). Setting WINGS_CGROUP_PARENT to exactly the node-wide
+// CgroupParent value remains the documented per-server opt-out gesture: it
+// changes nothing about placement and now means "leave this server's cgroup
+// properties alone entirely".
+func (c DockerConfiguration) ResolveServerCgroupParent(env []string) (parent string, managed bool, err error) {
+	parent, err = c.ResolveCgroupParent(env)
+	if !c.PerServerSlices.Enabled || c.CgroupParent == "" {
+		return parent, false, err
+	}
+	if override := cgroupParentOverride(env); override != "" && override == c.CgroupParent {
+		// Explicit opt-out.
+		return c.CgroupParent, false, nil
+	}
+	return parent, true, err
+}
+
+// ValidatePerServerSlices sanity-checks the docker.per_server_slices block at
+// startup so misconfiguration fails loudly at boot instead of surfacing as
+// per-server warnings at container start.
+func (c DockerConfiguration) ValidatePerServerSlices() error {
+	s := c.PerServerSlices
+	if !s.Enabled {
+		return nil
+	}
+	if c.CgroupParent == "" {
+		return errors.New("docker.per_server_slices requires docker.cgroup_parent to be set: it is the tier the managed container scopes are placed under, and the tier whose own MemoryMin the per-server floors are reported against")
+	}
+	if _, errs := c.SliceDefaults().Props(); len(errs) > 0 {
+		return errors.Wrap(errs[0], "docker.per_server_slices.defaults")
+	}
+	return nil
+}
+
+// SliceDefaults converts the configured per-server slice defaults into the
+// internal/cgroups representation.
+func (c DockerConfiguration) SliceDefaults() cgroups.Defaults {
+	d := c.PerServerSlices.Defaults
+	return cgroups.Defaults{
+		MemoryMin:  d.MemoryMin,
+		MemoryLow:  d.MemoryLow,
+		MemoryHigh: d.MemoryHigh,
+		MemoryMax:  d.MemoryMax,
+		CPUWeight:  d.CPUWeight,
+		IOWeight:   d.IOWeight,
+	}
+}
+
+// ScopeEnsureRequest assembles the cgroups.EnsureForServer request for a
+// running server: uuid identifies the server, containerID is its live Docker
+// container id (the scope unit name is derived from it), and parent is the
+// slice the container was actually placed under, as returned by
+// ResolveServerCgroupParent.
+//
+// The node-wide defaults apply only when the server sits under the node-wide
+// CgroupParent. A server pinned elsewhere by WINGS_CGROUP_PARENT gets its
+// explicit WINGS_CG_* values only, and is left out of the floor ledger: its
+// floors draw on that administrator's slice, not on this node's tier.
+func (c DockerConfiguration) ScopeEnsureRequest(uuid, containerID, parent string, env []string) cgroups.EnsureRequest {
+	onNodeTier := parent == c.CgroupParent
+	req := cgroups.EnsureRequest{
+		Scope:         cgroups.ScopeName(containerID),
+		Owner:         uuid,
+		ApplyDefaults: onNodeTier,
+		Defaults:      c.SliceDefaults(),
+		Env:           env,
+	}
+	if onNodeTier {
+		req.Parent = c.CgroupParent
+	}
+	return req
+}
+
 // RegistryCredentialsForImage returns registry credentials for an image only
 // when the configured registry and image reference share the same registry
 // identity.
diff --git a/config/config_docker_slices_test.go b/config/config_docker_slices_test.go
new file mode 100644
index 0000000..bd45c50
--- /dev/null
+++ b/config/config_docker_slices_test.go
@@ -0,0 +1,172 @@
+package config
+
+import (
+	"testing"
+)
+
+const testUUID = "b87c0a5b-2387-4a1c-8863-ff23e6800a1d"
+const testContainerID = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
+const testScope = "docker-" + testContainerID + ".scope"
+
+func slicesConfig(enabled bool) DockerConfiguration {
+	c := DockerConfiguration{CgroupParent: "wings.slice"}
+	c.PerServerSlices.Enabled = enabled
+	return c
+}
+
+// Placement is flat and identical whether or not per-server management is on:
+// the whole point of the scope-targeted design is that Wings inserts no unit
+// of its own between the tier slice and the container.
+func TestResolveServerCgroupParentPlacementIsFlat(t *testing.T) {
+	for _, enabled := range []bool{false, true} {
+		c := slicesConfig(enabled)
+		parent, managed, err := c.ResolveServerCgroupParent(nil)
+		if err != nil {
+			t.Fatalf("enabled=%v: unexpected error: %v", enabled, err)
+		}
+		if parent != "wings.slice" {
+			t.Errorf("enabled=%v: parent = %q, want wings.slice", enabled, parent)
+		}
+		if managed != enabled {
+			t.Errorf("enabled=%v: managed = %v, want %v", enabled, managed, enabled)
+		}
+	}
+}
+
+func TestResolveServerCgroupParentRequiresANodeParent(t *testing.T) {
+	c := slicesConfig(true)
+	c.CgroupParent = ""
+	parent, managed, err := c.ResolveServerCgroupParent(nil)
+	if err != nil || parent != "" {
+		t.Fatalf("parent = %q, err = %v", parent, err)
+	}
+	if managed {
+		t.Error("with no node cgroup_parent there is no tier to manage against")
+	}
+}
+
+func TestResolveServerCgroupParentAcceptedOverride(t *testing.T) {
+	c := slicesConfig(true)
+	env := []string{"WINGS_CGROUP_PARENT=wings-manual.slice"}
+	parent, managed, err := c.ResolveServerCgroupParent(env)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if parent != "wings-manual.slice" {
+		t.Errorf("parent = %q, want wings-manual.slice", parent)
+	}
+	if !managed {
+		t.Error("an accepted override still gets its explicit WINGS_CG_* properties applied")
+	}
+}
+
+// Setting the override to exactly the node-wide value changes nothing about
+// placement; it is the documented per-server opt-out gesture and must switch
+// property management off.
+func TestResolveServerCgroupParentOptOut(t *testing.T) {
+	c := slicesConfig(true)
+	env := []string{"WINGS_CGROUP_PARENT=wings.slice"}
+	parent, managed, err := c.ResolveServerCgroupParent(env)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if parent != "wings.slice" {
+		t.Errorf("parent = %q, want wings.slice", parent)
+	}
+	if managed {
+		t.Error("opt-out must disable per-server property management")
+	}
+}
+
+// A rejected override fails closed to the node-wide parent and is still
+// reported, but the server stays managed: refusing the placement must not also
+// silently strip the resource policy the egg asked for.
+func TestResolveServerCgroupParentRejectedOverrideFailsClosed(t *testing.T) {
+	c := slicesConfig(true)
+	env := []string{"WINGS_CGROUP_PARENT=system.slice"}
+	parent, managed, err := c.ResolveServerCgroupParent(env)
+	if err == nil {
+		t.Fatal("expected a rejection error for system.slice")
+	}
+	if parent != "wings.slice" {
+		t.Errorf("parent = %q, want the node-wide wings.slice", parent)
+	}
+	if !managed {
+		t.Error("a rejected override must still leave the server managed on the node tier")
+	}
+}
+
+func TestValidatePerServerSlices(t *testing.T) {
+	// Disabled: nothing is checked.
+	c := slicesConfig(false)
+	c.CgroupParent = ""
+	if err := c.ValidatePerServerSlices(); err != nil {
+		t.Errorf("disabled block must validate: %v", err)
+	}
+
+	// Enabled without a node parent: there is no tier to place under or to
+	// report floors against.
+	c = slicesConfig(true)
+	c.CgroupParent = ""
+	if err := c.ValidatePerServerSlices(); err == nil {
+		t.Error("expected an error when cgroup_parent is unset")
+	}
+
+	// Enabled with a bad default value.
+	c = slicesConfig(true)
+	c.PerServerSlices.Defaults.MemoryMin = "not-a-size"
+	if err := c.ValidatePerServerSlices(); err == nil {
+		t.Error("expected an error for an unparseable default")
+	}
+
+	// Enabled and well-formed.
+	c = slicesConfig(true)
+	c.PerServerSlices.Defaults.MemoryMin = "512M"
+	c.PerServerSlices.Defaults.CPUWeight = 800
+	if err := c.ValidatePerServerSlices(); err != nil {
+		t.Errorf("valid block rejected: %v", err)
+	}
+}
+
+func TestScopeEnsureRequestOnNodeTier(t *testing.T) {
+	c := slicesConfig(true)
+	c.PerServerSlices.Defaults.MemoryMin = "512M"
+	req := c.ScopeEnsureRequest(testUUID, testContainerID, "wings.slice", nil)
+
+	if req.Scope != testScope {
+		t.Errorf("Scope = %q, want %q", req.Scope, testScope)
+	}
+	if req.Owner != testUUID {
+		t.Errorf("Owner = %q, want %q", req.Owner, testUUID)
+	}
+	if !req.ApplyDefaults {
+		t.Error("a server on the node tier receives the node-wide defaults")
+	}
+	if req.Parent != "wings.slice" {
+		t.Errorf("Parent = %q, want wings.slice (the tripwire tier)", req.Parent)
+	}
+}
+
+// A server pinned to an administrator's own slice gets its explicit
+// WINGS_CG_* values only, and is left out of this node's floor ledger: its
+// floors draw on that slice's budget, not on the node tier's.
+func TestScopeEnsureRequestUnderAnOverrideSlice(t *testing.T) {
+	c := slicesConfig(true)
+	c.PerServerSlices.Defaults.MemoryMin = "512M"
+	req := c.ScopeEnsureRequest(testUUID, testContainerID, "wings-manual.slice", nil)
+
+	if req.ApplyDefaults {
+		t.Error("node defaults must not be stamped onto a scope inside an override slice")
+	}
+	if req.Parent != "" {
+		t.Errorf("Parent = %q, want \"\" so the node-tier tripwire stays out of it", req.Parent)
+	}
+}
+
+func TestScopeEnsureRequestRejectsAnUnusableContainerID(t *testing.T) {
+	c := slicesConfig(true)
+	req := c.ScopeEnsureRequest(testUUID, testContainerID[:12], "wings.slice", nil)
+	if req.Scope != "" {
+		t.Errorf("Scope = %q, want \"\" for a short container id", req.Scope)
+	}
+}
diff --git a/environment/docker/container.go b/environment/docker/container.go
index d38ddb0..0324565 100644
--- a/environment/docker/container.go
+++ b/environment/docker/container.go
@@ -20,6 +20,7 @@ import (
 
 	"github.com/pterodactyl/wings/config"
 	"github.com/pterodactyl/wings/environment"
+	"github.com/pterodactyl/wings/internal/cgroups"
 	"github.com/pterodactyl/wings/system"
 )
 
@@ -127,6 +128,36 @@ func (e *Environment) InSituUpdate() error {
 		e.clearCpuBurst(c.State.Pid)
 	}
 
+	// Re-assert this server's cgroup properties once the Docker write is done.
+	//
+	// ContainerUpdate below carries the panel's own container.Resources —
+	// Memory, MemoryReservation, CpuShares, BlkioWeight — and with the systemd
+	// cgroup driver runc translates those into SetUnitProperties on the SAME
+	// docker-<id>.scope Wings sets its properties on. Docker's write is the
+	// later one, so without this call a routine panel-side settings save
+	// silently replaces MemoryLow, MemoryMax, CPUWeight and the BFQ weight with
+	// the panel's values — including replacing a deliberately tight
+	// WINGS_CG_MEMORY_MAX with a much looser panel memory limit, and collapsing
+	// an 800 CPUWeight to the ~39 that docker.cpu_shares=1024 derives. Under the
+	// retired per-server-slice design the two writers lived on different units
+	// and composed by the min-along-path rule; on one unit they overwrite.
+	//
+	// Deferred rather than called at the end, so that it also runs when
+	// ContainerUpdate fails: Docker restores its own HostConfig on that path
+	// but does not roll back the cgroup writes runc has already made, so a
+	// partially applied update is exactly the state that most needs repairing.
+	// A re-assert against a scope that no longer exists is cheap and harmless
+	// (applyScopeProps bails out on a container that is not running).
+	//
+	// Its own context, because the update may have consumed most of this
+	// call's budget and a D-Bus round trip skipped for lack of a deadline is
+	// the same silent no-op this whole path exists to prevent.
+	defer func() {
+		sctx, scancel := context.WithTimeout(context.Background(), 15*time.Second)
+		defer scancel()
+		e.applyScopeProps(sctx)
+	}()
+
 	// CPU pinning cannot be removed once it is applied to a container. The same is true
