index 0000000..36dde5c
--- /dev/null
+++ b/environment/docker/scope.go
@@ -0,0 +1,74 @@
+package docker
+
+import (
+	"context"
+
+	"github.com/pterodactyl/wings/config"
+	"github.com/pterodactyl/wings/internal/cgroups"
+)
+
+// applyScopeProps applies this server's configured cgroup resource properties
+// to the systemd scope unit backing its container.
+//
+// Why this runs after the container has been started, and not at create time:
+// with the systemd cgroup driver the docker-<id>.scope unit does not exist
+// until the container's init process is actually launched. There is nothing to
+// set properties on before ContainerStart() returns. The consequence is a
+// window of a few milliseconds in which the container's processes run charged
+// to a scope that carries no floors and no ceilings; that window is accepted
+// deliberately. It is bounded by process startup rather than by workload, and a
+// game server does not reach a memory footprint worth protecting inside it.
+//
+// The previous design avoided the window by creating a Wings-owned slice ahead
+// of the container and placing the container inside it, at the cost of a unit
+// whose lifecycle Wings had to own: orphan garbage collection at boot,
+// transient-versus-administrator discrimination, and a dependency on the
+// cgroup2 memory_recursiveprot mount flag for the floors to reach the
+// container's own cgroup at all. Setting the properties on the leaf scope
+// removes all three.
+//
+// Strictly best-effort: every failure is logged and none of them affect the
+// server, which runs under the node tier slice either way.
+func (e *Environment) applyScopeProps(ctx context.Context) {
+	cfg := config.Get()
+	if !cfg.Docker.PerServerSlices.Enabled {
+		return
+	}
+
+	evs := e.Configuration.EnvironmentVariables()
+	parent, managed, err := cfg.Docker.ResolveServerCgroupParent(evs)
+	if err != nil {
+		e.log().WithField("cgroup_parent", parent).WithError(err).Warn("environment/docker: rejected per-server cgroup parent override")
+	}
+	if !managed {
+		return
+	}
+
+	c, err := e.ContainerInspect(ctx)
+	if err != nil {
+		e.log().WithError(err).Warn("cgroups: could not inspect container to resolve its systemd scope; resource properties not applied")
+		return
+	}
+	if c.State == nil || !c.State.Running {
+		// A docker-<id>.scope lives exactly as long as the container's init
+		// process. For a container that exists but is not running there is no
+		// unit to set properties on, and asking anyway fails with "Unit
+		// docker-<id>.scope not found" — which EnsureForServer reports as the
+		// "runs under the node tier without its own resource guarantees"
+		// warning. That warning is the one diagnostic this design leans on for
+		// a genuinely degraded server (see internal/cgroups.EnsureForServer),
+		// so it must not fire for the routine case of a stopped one. Debug,
+		// not Warn: nothing is wrong here.
+		e.log().Debug("cgroups: container is not running; no scope unit exists to carry its resource properties")
+		return
+	}
+
+	req := cfg.Docker.ScopeEnsureRequest(e.Id, c.ID, parent, evs)
+	if req.Scope == "" {
+		// ScopeName rejected the container id. Nothing sane to do: issuing
+		// property calls against a guessed unit name would silently do nothing.
+		e.log().WithField("container_id", c.ID).Warn("cgroups: could not derive a systemd scope unit name for this container; resource properties not applied")
+		return
+	}
+	cgroups.EnsureForServer(ctx, e.log(), req)
+}
