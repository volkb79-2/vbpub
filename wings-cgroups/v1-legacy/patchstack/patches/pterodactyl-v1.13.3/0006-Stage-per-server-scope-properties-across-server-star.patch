new file mode 100644
index 0000000..313538d
--- /dev/null
+++ b/server/slice_reassert_dispatch_test.go
@@ -0,0 +1,234 @@
+package server
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/apex/log"
+
+	"github.com/pterodactyl/wings/environment"
+	"github.com/pterodactyl/wings/events"
+	"github.com/pterodactyl/wings/internal/cgroups"
+	"github.com/pterodactyl/wings/server/filesystem"
+)
+
+// These tests cover the seam between reassertRequest(), which the tests in
+// slice_phase_test.go already pin down, and its one real caller. Without them
+// two mutations survive the entire suite: deleting the reassertSliceProps call
+// from SyncWithEnvironment (the whole repair silently disappearing), and
+// rewiring it through applySliceProps (which restores the "nothing staged"
+// early return a repair must never take). Both are caught here, because what
+// is asserted is the request that actually came out of SyncWithEnvironment.
+
+// stubEnvironment is a ProcessEnvironment that touches nothing outside itself.
+// SyncWithEnvironment only ever calls Config, InSituUpdate and State on it; the
+// rest of the interface is present because the interface requires it.
+type stubEnvironment struct {
+	cfg       *environment.Configuration
+	state     string
+	insituErr error
+
+	mu      sync.Mutex
+	insituN int
+}
+
+func newStubEnvironment(insituErr error) *stubEnvironment {
+	return &stubEnvironment{
+		cfg:       environment.NewConfiguration(environment.Settings{}, nil),
+		state:     environment.ProcessRunningState,
+		insituErr: insituErr,
+	}
+}
+
+func (e *stubEnvironment) InSituUpdate() error {
+	e.mu.Lock()
+	e.insituN++
+	e.mu.Unlock()
+	return e.insituErr
+}
+
+func (e *stubEnvironment) inSituCalls() int {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	return e.insituN
+}
+
+func (e *stubEnvironment) Type() string                       { return "stub" }
+func (e *stubEnvironment) Config() *environment.Configuration { return e.cfg }
+func (e *stubEnvironment) Events() *events.Bus                { return events.NewBus() }
+func (e *stubEnvironment) Exists() (bool, error)              { return true, nil }
+func (e *stubEnvironment) IsRunning(context.Context) (bool, error) {
+	return e.state == environment.ProcessRunningState, nil
+}
+func (e *stubEnvironment) OnBeforeStart(context.Context) error { return nil }
+func (e *stubEnvironment) Start(context.Context) error         { return nil }
+func (e *stubEnvironment) Stop(context.Context) error          { return nil }
+func (e *stubEnvironment) WaitForStop(context.Context, time.Duration, bool) error {
+	return nil
+}
+func (e *stubEnvironment) Terminate(context.Context, string) error { return nil }
+func (e *stubEnvironment) Destroy() error                          { return nil }
+func (e *stubEnvironment) ExitState() (uint32, bool, error)        { return 0, false, nil }
+func (e *stubEnvironment) Create() error                           { return nil }
+func (e *stubEnvironment) Attach(context.Context) error            { return nil }
+func (e *stubEnvironment) SendCommand(string) error                { return nil }
+func (e *stubEnvironment) Readlog(int) ([]string, error)           { return nil, nil }
+func (e *stubEnvironment) State() string                           { return e.state }
+func (e *stubEnvironment) SetState(s string)                       { e.state = s }
+func (e *stubEnvironment) Uptime(context.Context) (int64, error)   { return 0, nil }
+func (e *stubEnvironment) SetLogCallback(func([]byte))             {}
+
+var _ environment.ProcessEnvironment = (*stubEnvironment)(nil)
+
+// dispatchRecorder stands in for dispatchSliceProps' two effects on the outside
+// world and keeps every request that reached the applier.
+//
+// The scope resolver is stubbed as well as the applier: the real one needs a
+// live Docker daemon and returns "" without one, which would swallow the very
+// call being asserted.
+type dispatchRecorder struct {
+	scope string
+
+	mu   sync.Mutex
+	reqs []cgroups.EnsureRequest
+}
+
+// dispatchLog is installed once, in init, rather than swapped per test. Two
+// reasons, both real: enterSteady dispatches applySliceProps onto a goroutine,
+// so a request from an earlier test can land at any time — and a per-test swap
+// would be a write racing those goroutines' reads, as well as attributing their
+// requests to whichever test happened to hold the seam. Requests are therefore
+// filtered by the owning server, and every test here uses its own uuid.
+var dispatchLog = &dispatchRecorder{scope: "docker-0123456789abcdef.scope"}
+
+func init() {
+	sliceResolveScope = func(*Server, context.Context) string { return dispatchLog.scope }
+	sliceEnsure = func(_ context.Context, _ *log.Entry, req cgroups.EnsureRequest, _ string) {
+		dispatchLog.mu.Lock()
+		dispatchLog.reqs = append(dispatchLog.reqs, req)
+		dispatchLog.mu.Unlock()
+	}
+}
+
+// requestsFor returns the requests applied to one server, in order.
+func (r *dispatchRecorder) requestsFor(owner string) []cgroups.EnsureRequest {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	var out []cgroups.EnsureRequest
+	for _, req := range r.reqs {
+		if req.Owner == owner {
+			out = append(out, req)
+		}
+	}
+	return out
+}
+
+// newSyncTestServer is newSliceTestServer plus the two things
+// SyncWithEnvironment dereferences — an environment and a filesystem — and its
+// own uuid, so its dispatches are distinguishable from every other test's.
+func newSyncTestServer(t *testing.T, uuid string, env environment.ProcessEnvironment) *Server {
+	t.Helper()
+	s := newSliceTestServer()
+	s.cfg.Uuid = uuid
+	fs, err := filesystem.New(t.TempDir(), 0, nil)
+	if err != nil {
+		t.Fatalf("filesystem.New: %v", err)
+	}
+	s.fs = fs
+	s.Environment = env
+	return s
+}
+
+// The load-bearing case. A Panel settings save arrives while the server is
+// still loading its world under an explicit steady trigger — the configuration
+// SETUP.md recommends — and the repair that follows Docker's write must carry
+// the STARTUP band and must not write a ceiling. Asserted on the request that
+// came out of SyncWithEnvironment itself, so deleting the call is a failure and
+// not merely an unread line.
+func TestSyncWithEnvironmentReassertsTheLiveBand(t *testing.T) {
+	sliceTestConfig(t, true, "15m", "64G")
+	env := newStubEnvironment(nil)
+	s := newSyncTestServer(t, "5d1c2f6e-0001-4a1c-8863-ff23e6800a1d", env)
+	s.cfg.EnvVars = map[string]interface{}{
+		"WINGS_CG_STEADY_MATCH": `regex:World load complete`,
+	}
+	s.beginSlicePhase()
+	t.Cleanup(s.endSlicePhase)
+	if !s.slicePhaseInProgress() {
+		t.Fatal("the startup phase should be in progress; the test is not exercising what it claims")
+	}
+
+	s.SyncWithEnvironment()
+
+	if got := env.inSituCalls(); got != 1 {
+		t.Fatalf("InSituUpdate calls = %d, want 1", got)
+	}
+	reqs := dispatchLog.requestsFor(s.ID())
+	if len(reqs) != 1 {
+		t.Fatalf("requests reaching the applier = %d, want 1 (a panel save that repairs nothing leaves the scope carrying docker's values)", len(reqs))
+	}
+	req := reqs[0]
+	if req.Phase != cgroups.PhaseStartup {
+		t.Errorf("repair applied the %q band; the server is still loading and holds the %q one", req.Phase, cgroups.PhaseStartup)
+	}
+	if !req.KeepMemoryHigh {
+		t.Error("the repair must leave memory.high alone: docker cannot have touched it, and writing it mid-load is the eviction this whole path exists to avoid")
+	}
+	if req.RampStep != 0 {
+		t.Errorf("the repair must not sit on a reclaim-paced ramp; RampStep = %d", req.RampStep)
+	}
+	if req.Scope != dispatchLog.scope {
+		t.Errorf("request scope = %q, want the resolved live scope %q", req.Scope, dispatchLog.scope)
+	}
+}
+
+// The mutant applySliceProps would let through. With no startup band staged the
+// transition path takes its "nothing to swap in" exit — correct for a
+// transition, wrong for a repair, because what is on the unit is no longer what
+// Wings wrote. The InSituUpdate error is deliberate too: Docker does not roll
+// back the cgroup writes runc already made, so a failed update is the state
+// that most needs repairing and must not short-circuit the repair.
+func TestSyncWithEnvironmentRepairsWithNothingStagedAndAfterAFailedUpdate(t *testing.T) {
+	sliceTestConfig(t, true, "15m", "") // no startup band configured at all
+	env := newStubEnvironment(errors.New("in-situ update failed"))
+	s := newSyncTestServer(t, "5d1c2f6e-0002-4a1c-8863-ff23e6800a1d", env)
+
+	if s.reassertRequest().Staged() {
+		t.Fatal("something is staged in this configuration; the test is not exercising what it claims")
+	}
+
+	s.SyncWithEnvironment()
+
+	reqs := dispatchLog.requestsFor(s.ID())
+	if len(reqs) != 1 {
+		t.Fatalf("requests reaching the applier = %d, want 1", len(reqs))
+	}
+	if got := reqs[0].Phase; got != cgroups.PhaseSteady {
+		t.Errorf("repair phase = %q, want %q", got, cgroups.PhaseSteady)
+	}
+	if !reqs[0].KeepMemoryHigh {
+		t.Error("the repair must leave memory.high alone")
+	}
+}
+
+// A suspended server never reaches InSituUpdate, so there is nothing for a
+// repair to put back either.
+func TestSyncWithEnvironmentDoesNotRepairASuspendedServer(t *testing.T) {
+	sliceTestConfig(t, true, "15m", "64G")
+	env := newStubEnvironment(nil)
+	env.state = environment.ProcessOfflineState
+	s := newSyncTestServer(t, "5d1c2f6e-0003-4a1c-8863-ff23e6800a1d", env)
+	s.cfg.Suspended = true
+
+	s.SyncWithEnvironment()
+
+	if got := env.inSituCalls(); got != 0 {
+		t.Errorf("InSituUpdate calls on a suspended server = %d, want 0", got)
+	}
+	if got := len(dispatchLog.requestsFor(s.ID())); got != 0 {
+		t.Errorf("requests reaching the applier for a suspended server = %d, want 0", got)
+	}
+}
