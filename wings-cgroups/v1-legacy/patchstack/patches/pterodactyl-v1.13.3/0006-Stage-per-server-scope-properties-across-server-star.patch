diff --git a/server/slice_phase.go b/server/slice_phase.go
new file mode 100644
index 0000000..d28d8b8
--- /dev/null
+++ b/server/slice_phase.go
@@ -0,0 +1,501 @@
+package server
+
+import (
+	"context"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/apex/log"
+
+	"github.com/pterodactyl/wings/config"
+	"github.com/pterodactyl/wings/environment"
+	"github.com/pterodactyl/wings/internal/cgroups"
+	"github.com/pterodactyl/wings/internal/database"
+	"github.com/pterodactyl/wings/internal/models"
+)
+
+// Staged per-server slice properties.
+//
+// A game server's load-time peak routinely dwarfs its steady working set, and
+// a cgroup is not protected from reclaim it inflicts on itself (see the
+// package comment on internal/cgroups) — so a ceiling sized for the steady
+// state evicts the server through its own floor while it is still loading,
+// permanently, because nothing faults those pages back except the workload.
+//
+// Wings therefore applies the startup band before the container is created and
+// swaps in the steady band once the server is up. "Up" reuses the detection
+// Wings already performs: the egg's startup "done" matcher flips the
+// environment to the running state (see Server.onConsoleOutput), which reaches
+// us through OnStateChange. No new log scraping, and the trigger is per-egg
+// configuration that every game already carries.
+//
+// A grace timer bounds the startup band, because a ready line that never
+// matches — a broken egg, a game that changed its log format — must not leave
+// a server on startup properties forever.
+
+// Reasons name the trigger in every log line, so a server's phase transitions
+// are readable without correlating timestamps against console output.
+const (
+	sliceReasonReady = "server reported ready"
+	sliceReasonMatch = "steady match seen in console"
+	sliceReasonGrace = "startup grace expired"
+)
+
+// A note on delivery guarantees, because this design leans on them. Wings
+// dispatches each state-change event in its own goroutine (server/listeners.go)
+// and OnStateChange re-reads the current state rather than using the event
+// payload, so a fast starting -> running sequence can deliver "running" twice
+// and "starting" not at all. That is survivable here by construction: missing
+// "starting" only means no grace timer is armed, which matters solely when the
+// server never reaches "running" — and if it never reaches "running" after a
+// start, the startup band is the safer of the two to be holding. The terminal
+// states that replace the band are the ones delivered reliably.
+
+// beginSlicePhase starts the startup-grace timer for a server that has just
+// entered the starting state. It is a no-op when nothing stages the startup
+// band, or when no grace period is configured.
+func (s *Server) beginSlicePhase() {
+	cfg := config.Get()
+	if !cfg.Docker.PerServerSlices.Enabled {
+		return
+	}
+	// Nothing staged for this server: the band applied at container create is
+	// already the steady one, so there is nothing to swap in later.
+	req := s.sliceRequest(cgroups.PhaseSteady)
+	if !req.Staged() {
+		return
+	}
+	env := s.GetEnvironmentVariables()
+
+	// How long a world takes to load is a property of the game and its save,
+	// so the server may override the node default.
+	grace := cfg.Docker.SliceStartupGrace()
+	if d, set, err := cgroups.StartupGraceFromEnv(env); err != nil {
+		s.Log().WithError(err).Warn("cgroups: ignoring invalid per-server startup grace; using the node default")
+	} else if set {
+		grace = d
+	}
+
+	// An explicit matcher displaces the egg's "done" line as the trigger. That
+	// matters when "done" fires before the world has finished loading, which is
+	// exactly the case the startup band exists for.
+	matcher, err := compileSliceMatch(cgroups.SteadyMatchFromEnv(env))
+	if err != nil {
+		s.Log().WithError(err).Warn("cgroups: ignoring invalid " + cgroups.EnvSteadyMatch + "; falling back to the egg's startup done matcher")
+	}
+	s.slicePhaseMu.Lock()
+	defer s.slicePhaseMu.Unlock()
+	if s.slicePhaseTimer != nil {
+		s.slicePhaseTimer.Stop()
+	}
+	s.sliceSteadyDone = false
+	s.slicePhaseActive = true
+	s.slicePhaseMatch = matcher
+	s.slicePhaseTimer = nil
+	if grace > 0 {
+		s.slicePhaseTimer = time.AfterFunc(grace, func() {
+			s.Log().WithField("grace", grace.String()).
+				Warn("cgroups: startup grace expired without the steady trigger firing; applying steady slice properties")
+			s.enterSteady(sliceReasonGrace)
+		})
+	}
+	trigger := "the egg's startup done matcher"
+	if matcher != nil {
+		trigger = cgroups.EnvSteadyMatch + "=" + matcher.String()
+	}
+	s.Log().WithFields(log.Fields{"grace": grace.String(), "steady_trigger": trigger}).
+		Info("cgroups: startup slice properties in effect")
+}
+
+// enterSteady applies the steady band exactly once per start, whichever trigger
+// fires first — a console match, the running state, or the grace timer. The
+// idempotent guard is what makes the three triggers safe to race: an egg whose
+// steady matcher happens to appear before its "done"/running line would
+// otherwise emit two activity rows and apply the steady band twice.
+func (s *Server) enterSteady(reason string) {
+	s.slicePhaseMu.Lock()
+	if s.sliceSteadyDone {
+		s.slicePhaseMu.Unlock()
+		return
+	}
+	s.sliceSteadyDone = true
+	s.slicePhaseActive = false
+	if s.slicePhaseTimer != nil {
+		s.slicePhaseTimer.Stop()
+		s.slicePhaseTimer = nil
+	}
+	s.slicePhaseMatch = nil
+	s.slicePhaseMu.Unlock()
+
+	s.emitPhaseActivity("steady-reached", reason)
+	// Dispatched: OnStateChange runs crash detection after this, and a steady
+	// application is a D-Bus round trip plus a possible ramp — it must never sit
+	// in the state machine's path.
+	go s.applySliceProps(cgroups.PhaseSteady, reason)
+}
+
+// endSlicePhase resets all phase state; called when the server goes offline.
+func (s *Server) endSlicePhase() {
+	s.slicePhaseMu.Lock()
+	defer s.slicePhaseMu.Unlock()
+	if s.slicePhaseTimer != nil {
+		s.slicePhaseTimer.Stop()
+		s.slicePhaseTimer = nil
+	}
+	s.slicePhaseActive = false
+	s.slicePhaseMatch = nil
+	s.sliceSteadyDone = false
+}
+
+// sliceRequest resolves this server's container scope and builds the ensure
+// request for the given phase. The zero request (empty Scope) means the server
+// has no Wings-managed properties, or has no running container to carry them,
+// and nothing should be applied.
+func (s *Server) sliceRequest(phase cgroups.Phase) cgroups.EnsureRequest {
+	cfg := config.Get()
+	if !cfg.Docker.PerServerSlices.Enabled {
+		return cgroups.EnsureRequest{}
+	}
+	env := s.GetEnvironmentVariables()
+	parent, managed, err := cfg.Docker.ResolveServerCgroupParent(env)
+	if err != nil {
+		s.Log().WithField("cgroup_parent", parent).WithError(err).
+			Warn("cgroups: rejected per-server cgroup parent override while applying scope properties")
+	}
+	if !managed {
+		return cgroups.EnsureRequest{}
+	}
+	// Scope is deliberately left empty here. The scope unit name derives from
+	// the live container id, which needs a Docker round trip; resolveScope
+	// fills it in at apply time. Everything that decides WHETHER to apply --
+	// Staged(), the property bands -- is independent of it.
+	return cfg.Docker.ScopeEnsureRequest(s.ID(), "", parent, env, phase)
+}
+
+// resolveScope looks up the systemd scope unit backing this server's current
+// container. Returns "" when there is no container to apply properties to,
+// which is the normal case for a stopped server.
+func (s *Server) resolveScope(ctx context.Context) string {
+	cli, err := environment.Docker()
+	if err != nil {
+		s.Log().WithError(err).Warn("cgroups: no docker client available to resolve the container scope")
+		return ""
+	}
+	c, err := cli.ContainerInspect(ctx, s.ID())
+	if err != nil {
+		s.Log().WithError(err).Debug("cgroups: could not inspect container to resolve its systemd scope")
+		return ""
+	}
+	if c.State == nil || !c.State.Running {
+		// A docker-<id>.scope lives exactly as long as the container's init
+		// process, so a container that exists but is stopped has no unit to
+		// carry properties. Deriving a name from its id anyway would produce a
+		// unit systemd does not know, and the property write would fail with
+		// "Unit docker-<id>.scope not found" — reported by EnsureForServer as
+		// the "runs under the node tier without its own resource guarantees"
+		// warning, which is the one diagnostic this design leans on for a
+		// genuinely degraded server. It must not fire for a stopped one.
+		s.Log().Debug("cgroups: container is not running; no scope unit exists to carry its resource properties")
+		return ""
+	}
+	return cgroups.ScopeName(c.ID)
+}
+
+// currentPhase reports which band is in effect for this server right now.
+//
+// This is the phase the server layer actually holds. It is NOT interchangeable
+// with the environment's process state, and anything that needs to know "which
+// band is live" has to ask here rather than infer it from Environment.State():
+//
+//   - A server with an explicit WINGS_CG_STEADY_MATCH deliberately stays in the
+//     startup phase after the environment flips to running, because the egg's
+//     "done" line is whatever makes the Panel show Running, which for a
+//     world-streaming game is routinely well before loading finishes. See
+//     onSliceStateChange. That window is the whole remaining world load, bounded
+//     only by the startup grace.
+//   - The grace backstop moves a server to the steady band while the
+//     environment is still starting, for a server that never prints its done
+//     line at all.
+//
+// Both are the documented, recommended configuration, not corner cases.
+func (s *Server) currentPhase() cgroups.Phase {
+	if s.slicePhaseInProgress() {
+		return cgroups.PhaseStartup
+	}
+	return cgroups.PhaseSteady
+}
+
+// hasSliceMatcher reports whether an explicit steady trigger is in effect for
+// the phase currently in progress.
+func (s *Server) hasSliceMatcher() bool {
+	s.slicePhaseMu.Lock()
+	defer s.slicePhaseMu.Unlock()
+	return s.slicePhaseMatch != nil
+}
+
+// matchSliceSteady is fed every console line while a startup phase is in
+// progress. The first line matching the server's steady trigger ends the
+// phase. Called from the console listener, so it must stay cheap and must
+// never block: the apply is dispatched.
+func (s *Server) matchSliceSteady(line []byte) {
+	s.slicePhaseMu.Lock()
+	m := s.slicePhaseMatch
+	s.slicePhaseMu.Unlock()
+	if m == nil || !m.Match(line) {
+		return
+	}
+	s.Log().WithFields(log.Fields{
+		"match":   m.String(),
+		"against": strconv.QuoteToASCII(string(line)),
+	}).Info("cgroups: steady trigger matched; leaving the startup band")
+	s.enterSteady(sliceReasonMatch)
+}
+
+// compileSliceMatch builds the steady trigger. A "regex:" prefix makes it a
+// regular expression, matching the convention the Panel uses for
+// startup.done; anything else is matched as a literal substring.
+func compileSliceMatch(raw string) (*regexp.Regexp, error) {
+	if raw == "" {
+		return nil, nil
+	}
+	if expr, ok := strings.CutPrefix(raw, "regex:"); ok {
+		return regexp.Compile(expr)
+	}
+	return regexp.Compile(regexp.QuoteMeta(raw))
+}
+
+// slicePhaseInProgress reports whether a startup phase is currently in
+// progress for this server.
+func (s *Server) slicePhaseInProgress() bool {
+	s.slicePhaseMu.Lock()
+	defer s.slicePhaseMu.Unlock()
+	return s.slicePhaseActive
+}
+
+// applySliceProps re-applies this server's container scope properties with the
+// given phase's band. Best-effort: a server that is already running is never
+// disturbed by a failure here.
+// The retired per-server-slice design had to pin the slice a phase began with:
+// placement was fixed at container-create time, so a Panel sync that changed
+// WINGS_CGROUP_PARENT mid-startup would make the steady band land on a unit the
+// container was not in. Nothing to pin here — the scope name is read back from
+// the container that actually exists at apply time, so it cannot drift away
+// from reality in the first place.
+func (s *Server) applySliceProps(phase cgroups.Phase, reason string) {
+	req := s.sliceRequest(phase)
+	if req.Owner == "" {
+		return
+	}
+	// With no startup band staged, the properties set at container start are
+	// already the steady ones; re-applying them would cost a systemd round
+	// trip per server start and log a transition that did not happen.
+	//
+	// Correct for a phase TRANSITION, wrong for a re-assertion — see
+	// reassertSliceProps, which does not take this exit.
+	if phase == cgroups.PhaseSteady && !req.Staged() {
+		return
+	}
+	s.dispatchSliceProps(req, reason)
+}
+
+// reassertSliceProps re-applies the band that is currently in effect, after
+// something else has written to this server's systemd scope.
+//
+// The caller is SyncWithEnvironment. Docker's ContainerUpdate carries the
+// Panel's own container.Resources — Memory, MemoryReservation, CpuShares,
+// BlkioWeight — and with the systemd cgroup driver runc issues those as
+// SetUnitProperties on the SAME docker-<id>.scope Wings writes to. Docker's
+// write is the later one, so a routine Panel-side settings save silently
+// replaces MemoryLow, MemoryMax, CPUWeight and the BFQ weight with the Panel's
+// values, including replacing a deliberately tight WINGS_CG_MEMORY_MAX with a
+// much looser Panel memory limit.
+//
+// It lives here, and not in environment/docker where the Docker write is made,
+// for one reason: only this layer knows which band is live. See currentPhase.
+//
+// Two deliberate differences from applySliceProps, which handles a phase
+// transition:
+//
+//   - No "nothing staged" early return. Skipping a transition between two
+//     identical bands is right; skipping the repair of those properties is not.
+//     The whole premise here is that what is on the unit is no longer what
+//     Wings wrote, whether or not a startup band was ever staged.
+//   - The ceiling is left alone (KeepMemoryHigh), and the ramp is off. Docker
+//     cannot have touched memory.high — container.Resources has no such field —
+//     so there is nothing to repair, and writing it anyway is the one thing a
+//     repair could do damage with: mid-load under a high startup ceiling, or
+//     mid-ramp while the startup->steady handoff is still walking it down.
+func (s *Server) reassertSliceProps(reason string) {
+	req := s.reassertRequest()
+	if req.Owner == "" {
+		return
+	}
+	s.dispatchSliceProps(req, reason)
+}
+
+// reassertRequest builds the re-assert request for the band currently in
+// effect. Split out from reassertSliceProps so that the part which has to be
+// right — WHICH band, and what a repair is allowed to write — is assertable
+// without a Docker daemon or a systemd bus. The zero request (empty Owner)
+// means there is nothing for Wings to re-assert on this server.
+func (s *Server) reassertRequest() cgroups.EnsureRequest {
+	req := s.sliceRequest(s.currentPhase())
+	if req.Owner == "" {
+		return cgroups.EnsureRequest{}
+	}
+	req.KeepMemoryHigh = true
+	req.RampStep = 0
+	return req
+}
+
+// The two effects dispatchSliceProps has on the outside world, behind package
+// variables so that the seam between the request builders — which are already
+// assertable without a daemon — and their callers can be tested too.
+//
+// This is not decoration. Without it, the only coverage of that seam is
+// reading: deleting the reassertSliceProps call from SyncWithEnvironment
+// altogether, or rewiring it through applySliceProps (which silently restores
+// the "nothing staged" early return a re-assert must not take), both leave the
+// whole suite green. Those are the two mutants TestSyncWithEnvironment* kill.
+//
+// Production never reassigns either; the test binary installs its recorders
+// once, before any test runs.
+var (
+	sliceResolveScope = (*Server).resolveScope
+	sliceEnsure       = cgroups.EnsureForServer
+)
+
+// dispatchSliceProps resolves the live scope and hands the request to
+// internal/cgroups. Shared by the transition and re-assert entry points above,
+// which differ only in how they build the request.
+func (s *Server) dispatchSliceProps(req cgroups.EnsureRequest, reason string) {
+	// This can run on its own goroutine, where a panic takes the whole daemon
+	// with it, so do not assume a context exists.
+	ctx := s.Context()
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	if req.Scope = sliceResolveScope(s, ctx); req.Scope == "" {
+		return
+	}
+	sliceEnsure(ctx, s.Log(), req, reason)
+}
+
+// sliceConsoleEvent is one compiled WINGS_CG_PHASE_EVENTS entry plus whether it
+// has already been recorded (fire-once).
+type sliceConsoleEvent struct {
+	name  string
+	re    *regexp.Regexp
+	fired bool
+}
+
+// systemActivityIP is the source IP recorded for system-generated activity.
+// It must be a PARSEABLE address: the activity cron purges any row whose IP
+// fails net.ParseIP (a guard against a historical octet-truncation bug), so an
+// empty string would delete every phase event before it reached the Panel.
+// Loopback is the honest choice — the event originated on the node itself.
+const systemActivityIP = "127.0.0.1"
+
+// emitPhaseActivity records a per-server slice phase to the Panel activity log.
+// Best-effort and non-blocking (SaveActivity dispatches its own goroutine).
+func (s *Server) emitPhaseActivity(phase, detail string) {
+	s.Log().WithField("phase", phase).WithField("detail", detail).Info("cgroups: phase")
+	// The activity log needs the database; it is always initialised in a real
+	// Wings but not in unit tests, and SaveActivity dispatches its write on a
+	// goroutine where an unset handle would panic the daemon. Guard it.
+	if !database.Initialized() {
+		return
+	}
+	s.SaveActivity(s.NewRequestActivity("", systemActivityIP), ActivityCgroupPhase, models.ActivityMeta{
+		"phase":  phase,
+		"detail": detail,
+	})
+}
+
+// beginPhaseEvents compiles this server's WINGS_CG_PHASE_EVENTS once per start.
+// Gated on per-server slices being enabled node-wide, so a node not using this
+// feature never compiles or matches anything.
+func (s *Server) beginPhaseEvents() {
+	if !config.Get().Docker.PerServerSlices.Enabled {
+		return
+	}
+	env := s.GetEnvironmentVariables()
+	var evs []sliceConsoleEvent
+	for _, pe := range cgroups.PhaseEventsFromEnv(env) {
+		re, err := compileSliceMatch(pe.Match)
+		if err != nil || re == nil {
+			if err != nil {
+				s.Log().WithField("event", pe.Name).WithError(err).
+					Warn("cgroups: ignoring invalid " + cgroups.EnvPhaseEvents + " entry")
+			}
+			continue
+		}
+		evs = append(evs, sliceConsoleEvent{name: pe.Name, re: re})
+	}
+	s.slicePhaseMu.Lock()
+	s.sliceEvents = evs
+	s.sliceEventsSet = true
+	s.slicePhaseMu.Unlock()
+}
+
+// matchPhaseEvents records the first console line that matches each configured
+// informational phase event. Cheap and non-blocking; fed every console line.
+func (s *Server) matchPhaseEvents(line []byte) {
+	s.slicePhaseMu.Lock()
+	if !s.sliceEventsSet || len(s.sliceEvents) == 0 {
+		s.slicePhaseMu.Unlock()
+		return
+	}
+	var hit string
+	remaining := 0
+	for i := range s.sliceEvents {
+		e := &s.sliceEvents[i]
+		if e.fired {
+			continue
+		}
+		if hit == "" && e.re.Match(line) {
+			e.fired = true
+			hit = e.name
+			continue
+		}
+		remaining++
+	}
+	if remaining == 0 {
+		// All events have fired: stop matching every console line for the rest
+		// of the server's life.
+		s.sliceEventsSet = false
+	}
+	s.slicePhaseMu.Unlock()
+	if hit != "" {
+		s.emitPhaseActivity(hit, strings.TrimSpace(string(line)))
+	}
+}
+
+// onSliceStateChange drives the startup -> steady transition from the server's
+// own state machine.
+func (s *Server) onSliceStateChange(state string) {
+	switch state {
+	case environment.ProcessStartingState:
+		s.beginPhaseEvents()
+		s.beginSlicePhase()
+	case environment.ProcessRunningState:
+		// The egg's "done" matcher fired. When the server defines its own
+		// steady trigger this is deliberately NOT the end of the startup
+		// phase: "done" is whatever makes the Panel show Running, which for a
+		// world-streaming game is routinely well before loading finishes. Once
+		// that trigger has fired (or without one at all), enterSteady is the
+		// idempotent gate — a duplicate call here is a no-op.
+		if s.hasSliceMatcher() {
+			return
+		}
+		s.enterSteady(sliceReasonReady)
+	case environment.ProcessOfflineState:
+		s.endSlicePhase()
+		s.slicePhaseMu.Lock()
+		s.sliceEvents = nil
+		s.sliceEventsSet = false
+		s.slicePhaseMu.Unlock()
+	}
+}
diff --git a/server/slice_phase_test.go b/server/slice_phase_test.go
new file mode 100644
index 0000000..eab5f74
--- /dev/null
+++ b/server/slice_phase_test.go
@@ -0,0 +1,446 @@
+package server
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/pterodactyl/wings/config"
+	"github.com/pterodactyl/wings/internal/cgroups"
+)
+
+// sliceTestConfig installs a per-server-slices configuration for these tests.
+//
+// It deliberately does NOT snapshot the previous configuration first:
+// config.Get() takes mu.RLock() and then dereferences a nil _config when no
+// configuration has been set, and its mu.RUnlock() is not deferred — so a
+// single Get() before the first Set() leaves the read lock held forever and
+// every later Set() deadlocks. Unit tests are exactly that situation.
+func sliceTestConfig(t *testing.T, enabled bool, grace string, startupHigh string) {
+	t.Helper()
+	var c config.Configuration
+	// config.Set derives the JWT signer from the token and panics on an empty
+	// HMAC key, so a non-empty placeholder is required.
+	c.AuthenticationToken = "slice-phase-test-token"
+	c.Docker.CgroupParent = "wings.slice"
+	c.Docker.PerServerSlices.Enabled = enabled
+	c.Docker.PerServerSlices.Defaults.MemoryHigh = "7G"
+	c.Docker.PerServerSlices.StartupDefaults.MemoryHigh = startupHigh
+	c.Docker.PerServerSlices.StartupGrace = grace
+	// Non-zero on purpose. RampStep is populated from this key, so leaving it
+	// unset would make every "a re-assert must not sit on a ramp" assertion
+	// unfalsifiable: the field would read 0 whether or not the code zeroes it.
+	c.Docker.PerServerSlices.SteadyRampStep = "64M"
+	config.Set(&c)
+}
+
+// newSliceTestServer builds the minimum Server these tests need, including a
+// context: applySliceProps is dispatched onto a goroutine and would otherwise
+// panic on a nil parent.
+func newSliceTestServer() *Server {
+	ctx, cancel := context.WithCancel(context.Background())
+	s := &Server{ctx: ctx, ctxCancel: &cancel}
+	s.cfg.Uuid = "b87c0a5b-2387-4a1c-8863-ff23e6800a1d"
+	return s
+}
+
+func TestSliceStartupGraceParsing(t *testing.T) {
+	for _, tt := range []struct {
+		raw  string
+		want time.Duration
+	}{
+		{"15m", 15 * time.Minute},
+		{"90s", 90 * time.Second},
+		{"", 0},
+		{"0", 0},
+		{"garbage", 0}, // unreachable via config (validation rejects it first)
+		{"-5m", 0},
+	} {
+		sliceTestConfig(t, true, tt.raw, "64G")
+		if got := config.Get().Docker.SliceStartupGrace(); got != tt.want {
+			t.Errorf("startup_grace %q = %v, want %v", tt.raw, got, tt.want)
+		}
+	}
+}
+
+// The grace timer must not be armed when nothing is staged, or every server on
+// a node that does not use the feature gets a 15-minute timer and an eventual
+// spurious warning.
+func TestBeginSlicePhaseOnlyArmsWhenStaged(t *testing.T) {
+	s := newSliceTestServer()
+
+	sliceTestConfig(t, true, "15m", "") // no startup band configured
+	s.beginSlicePhase()
+	if s.slicePhaseTimer != nil {
+		t.Error("timer armed with no startup band staged")
+	}
+	s.endSlicePhase()
+
+	sliceTestConfig(t, true, "15m", "64G") // startup band configured
+	s.beginSlicePhase()
+	if s.slicePhaseTimer == nil {
+		t.Error("timer not armed despite a staged startup band")
+	}
+	s.endSlicePhase()
+
+	sliceTestConfig(t, false, "15m", "64G") // per-server slices disabled entirely
+	s.beginSlicePhase()
+	if s.slicePhaseTimer != nil {
+		t.Error("timer armed while per_server_slices is disabled")
+	}
+	s.endSlicePhase()
+
+	sliceTestConfig(t, true, "0", "64G") // grace disabled
+	s.beginSlicePhase()
+	if s.slicePhaseTimer != nil {
+		t.Error("timer armed with startup_grace disabled")
+	}
+	s.endSlicePhase()
+}
+
+func TestEndSlicePhaseIsIdempotent(t *testing.T) {
+	sliceTestConfig(t, true, "15m", "64G")
+	s := newSliceTestServer()
+
+	s.endSlicePhase() // nothing armed yet
+	s.beginSlicePhase()
+	s.endSlicePhase()
+	s.endSlicePhase()
+	if s.slicePhaseTimer != nil {
+		t.Error("timer should be nil after cancellation")
+	}
+	if s.sliceSteadyDone {
+		t.Error("a cancelled phase must not be marked steady-done")
+	}
+}
+
+// enterSteady must apply the steady band exactly once no matter how many
+// triggers fire — the guard against a matcher-before-running double-apply.
+func TestEnterSteadyIsIdempotent(t *testing.T) {
+	sliceTestConfig(t, true, "15m", "64G")
+	s := newSliceTestServer()
+	s.beginSlicePhase()
+	if !s.slicePhaseInProgress() {
+		t.Fatal("precondition: a phase should be in progress")
+	}
+	s.enterSteady("match") // first trigger wins
+	if !s.sliceSteadyDone {
+		t.Fatal("first enterSteady must mark the phase steady-done")
+	}
+	if s.slicePhaseInProgress() || s.hasSliceMatcher() {
+		t.Error("entering steady must end the phase and clear the matcher")
+	}
+	// Subsequent triggers (running, grace) are no-ops.
+	s.enterSteady("running")
+	s.onSliceStateChange("running")
+	if !s.sliceSteadyDone {
+		t.Error("phase must stay steady-done")
+	}
+}
+
+// CleanupForDestroy must cancel the timer: its closure pins the whole *Server.
+func TestCleanupForDestroyCancelsSlicePhase(t *testing.T) {
+	sliceTestConfig(t, true, "15m", "64G")
+	s, err := New(nil)
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	s.cfg.Uuid = "b87c0a5b-2387-4a1c-8863-ff23e6800a1d"
+	s.beginSlicePhase()
+	if s.slicePhaseTimer == nil {
+		t.Fatal("precondition: timer should be armed")
+	}
+	s.CleanupForDestroy()
+	if s.slicePhaseTimer != nil {
+		t.Error("CleanupForDestroy left the grace timer running")
+	}
+}
+
+// A server with no Wings-managed properties must produce no request at all, so
+// no systemd call is ever attempted for it. Owner, not Scope, is the sentinel:
+// the scope name needs a live container and is resolved at apply time.
+func TestSliceRequestSkipsUnmanaged(t *testing.T) {
+	sliceTestConfig(t, true, "15m", "64G")
+	s := newSliceTestServer()
+
+	if got := s.sliceRequest(cgroups.PhaseSteady); got.Owner == "" {
+		t.Error("a managed server should have produced a request")
+	}
+
+	sliceTestConfig(t, false, "15m", "64G")
+	if got := s.sliceRequest(cgroups.PhaseSteady); got.Owner != "" {
+		t.Errorf("per_server_slices disabled must yield no request, got owner %q", got.Owner)
+	}
+}
+
+// The startup phase is a simple in-progress flag now. The retired per-server
+// slice design had to pin the slice a phase began with, because placement was
+// fixed at container-create time and a Panel sync could change
+// WINGS_CGROUP_PARENT mid-startup, leaving the steady band on a unit the
+// container was not in. There is nothing to pin any more: the scope name is
+// read back from the container that actually exists when the steady band is
+// applied, so it cannot drift away from reality in the first place.
+func TestSlicePhaseTracksWhetherItIsInProgress(t *testing.T) {
+	sliceTestConfig(t, true, "15m", "64G")
+	s := newSliceTestServer()
+
+	if s.slicePhaseInProgress() {
+		t.Error("no phase should be in progress before one begins")
+	}
+	s.beginSlicePhase()
+	if !s.slicePhaseInProgress() {
+		t.Error("beginSlicePhase must mark a phase in progress")
+	}
+	s.endSlicePhase()
+	if s.slicePhaseInProgress() {
+		t.Error("ended phase must clear the in-progress flag")
+	}
+}
+
+func TestCompileSliceMatch(t *testing.T) {
+	if m, err := compileSliceMatch(""); m != nil || err != nil {
+		t.Errorf("empty trigger = (%v, %v), want (nil, nil)", m, err)
+	}
+	// A bare string is a literal substring, so regex metacharacters in a game's
+	// log line cannot silently change what it matches.
+	m, err := compileSliceMatch("Create Dungeon (Successed)")
+	if err != nil {
+		t.Fatalf("literal: %v", err)
+	}
+	if !m.Match([]byte("xx Create Dungeon (Successed) yy")) {
+		t.Error("literal trigger should match as a substring")
+	}
+	if m.Match([]byte("Create Dungeon Successed")) {
+		t.Error("literal trigger must not be interpreted as a regex")
+	}
+	// regex: opts in, matching the Panel's own startup.done convention.
+	m, err = compileSliceMatch(`regex:SERVER_LIST.*registe server.*succeed`)
+	if err != nil {
+		t.Fatalf("regex: %v", err)
+	}
+	if !m.Match([]byte("[SERVER_LIST] try registe server ... succeed!")) {
+		t.Error("regex trigger should match the registration line")
+	}
+	if m.Match([]byte("Create Dungeon Successed")) {
+		t.Error("regex trigger must not match the earlier done line")
+	}
+	if _, err := compileSliceMatch("regex:[unterminated"); err == nil {
+		t.Error("a bad regex must report an error, not be silently ignored")
+	}
+}
+
+// With an explicit trigger the egg's early "done" must NOT end the phase.
+func TestExplicitTriggerOutranksTheDoneMatcher(t *testing.T) {
+	sliceTestConfig(t, true, "15m", "64G")
+	s := newSliceTestServer()
+	s.cfg.EnvVars = map[string]interface{}{
+		"WINGS_CG_STEADY_MATCH": `regex:registe server.*succeed`,
+	}
+	s.beginSlicePhase()
+	if !s.hasSliceMatcher() {
+		t.Fatal("an explicit trigger should be in effect")
+	}
+	// The Panel's running state arrives first and must be ignored.
+	s.onSliceStateChange("running")
+	if !s.hasSliceMatcher() || !s.slicePhaseInProgress() {
+		t.Error("running state ended the phase despite an explicit trigger")
+	}
+	// A non-matching line changes nothing.
+	s.matchSliceSteady([]byte("Create Dungeon Successed"))
+	if !s.slicePhaseInProgress() {
+		t.Error("a non-matching console line ended the phase")
+	}
+	// The trigger line ends it.
+	s.matchSliceSteady([]byte("[SERVER_LIST] try registe server ... succeed!"))
+	if s.slicePhaseInProgress() || s.hasSliceMatcher() {
+		t.Error("the trigger line did not end the startup phase")
+	}
+}
+
+// The band a Panel-side re-assert applies comes from the phase this layer
+// holds, never from the environment's process state.
+//
+// This is the regression guard for the worst shape this code has had. An
+// earlier version inferred the band inside environment/docker from
+// Environment.State(): startup while the container reported starting, steady
+// otherwise. On the configuration SETUP.md actually recommends — an explicit
+// WINGS_CG_STEADY_MATCH, because a world-streaming game's "done" line fires
+// long before loading finishes — the two disagree for the entire remaining
+// world load. A routine settings save in that window applied the STEADY band,
+// one-shot and unramped, to a server sitting at its load-time peak: a cgroup
+// reclaims through its own memory.min when it exceeds its own memory.high, so
+// that is precisely the eviction the startup band exists to prevent. And it
+// stood for the rest of the boot, because nothing re-applies the startup band.
+func TestReassertUsesThePhaseNotTheEnvironmentState(t *testing.T) {
+	sliceTestConfig(t, true, "15m", "64G")
+	s := newSliceTestServer()
+	s.cfg.EnvVars = map[string]interface{}{
+		"WINGS_CG_STEADY_MATCH": `regex:World load complete`,
+	}
+	s.beginSlicePhase()
+
+	if got := s.currentPhase(); got != cgroups.PhaseStartup {
+		t.Fatalf("phase during startup = %q, want %q", got, cgroups.PhaseStartup)
+	}
+
+	// The egg's own done matcher fires. The environment is now RUNNING, which
+	// is exactly the signal the retired heuristic read — but the world is still
+	// loading and the phase deliberately stays startup.
+	s.onSliceStateChange("running")
+	if !s.slicePhaseInProgress() {
+		t.Fatal("the explicit trigger should still be holding the startup phase")
+	}
+	req := s.reassertRequest()
+	if req.Phase != cgroups.PhaseStartup {
+		t.Errorf("re-assert during the steady-match window would apply the %q band; the server is still loading and holds the %q one", req.Phase, cgroups.PhaseStartup)
+	}
+
+	// A repair must not move the ceiling: Docker's container.Resources cannot
+	// have touched memory.high, and writing it here is what slams a loading
+	// workload.
+	if !req.KeepMemoryHigh {
+		t.Error("a re-assert must leave memory.high alone")
+	}
+	if req.RampStep != 0 {
+		t.Error("a re-assert must not sit on a reclaim-paced ramp; it writes no ceiling to walk")
+	}
+
+	// The trigger finally fires. Now, and only now, the steady band is live.
+	s.matchSliceSteady([]byte("World load complete"))
+	if got := s.currentPhase(); got != cgroups.PhaseSteady {
+		t.Errorf("phase after the steady trigger = %q, want %q", got, cgroups.PhaseSteady)
+	}
+	if got := s.reassertRequest().Phase; got != cgroups.PhaseSteady {
+		t.Errorf("re-assert after the steady trigger = %q, want %q", got, cgroups.PhaseSteady)
+	}
+}
+
+// The mirror case, same root cause: the startup grace expires while the
+// environment is still "starting" because the server never printed its done
+// line. enterSteady has run and the steady band is live, so a re-assert must
+// apply THAT — the retired heuristic would have read "starting" and re-lifted
+// the ceiling the grace backstop had just lowered, silently defeating it.
+func TestReassertAfterGraceExpiryUsesTheSteadyBand(t *testing.T) {
+	sliceTestConfig(t, true, "15m", "64G")
+	s := newSliceTestServer()
+	s.beginSlicePhase()
+	if got := s.currentPhase(); got != cgroups.PhaseStartup {
+		t.Fatalf("phase during startup = %q, want %q", got, cgroups.PhaseStartup)
+	}
+
+	// What the grace timer does when it fires. The environment is never told
+	// anything; it is still in the starting state.
+	s.enterSteady(sliceReasonGrace)
+
+	if got := s.currentPhase(); got != cgroups.PhaseSteady {
+		t.Errorf("phase after the grace backstop = %q, want %q", got, cgroups.PhaseSteady)
+	}
+	if got := s.reassertRequest().Phase; got != cgroups.PhaseSteady {
+		t.Errorf("re-assert after the grace backstop = %q, want %q", got, cgroups.PhaseSteady)
+	}
+}
+
+// A re-assert has no "nothing staged" exit. applySliceProps skips a steady
+// transition whose band is identical to the startup one, because there is no
+// transition to make; a re-assert of that same band is the entire point, since
+// what is on the unit is no longer what Wings wrote.
+func TestReassertAppliesEvenWithNothingStaged(t *testing.T) {
+	sliceTestConfig(t, true, "15m", "") // no startup band at all
+	s := newSliceTestServer()
+	s.beginSlicePhase()
+
+	req := s.reassertRequest()
+	if req.Owner == "" {
+		t.Fatal("a managed server with no staged startup band still has properties to re-assert")
+	}
+	if req.Staged() {
+		t.Fatal("nothing is staged in this configuration; the test is not exercising what it claims")
+	}
+	if req.Phase != cgroups.PhaseSteady {
+		t.Errorf("re-assert phase = %q, want %q", req.Phase, cgroups.PhaseSteady)
+	}
+}
+
+// A server Wings does not manage has nothing to re-assert.
+func TestReassertSkipsUnmanaged(t *testing.T) {
+	sliceTestConfig(t, false, "15m", "64G")
+	s := newSliceTestServer()
+	if got := s.reassertRequest(); got.Owner != "" {
+		t.Errorf("re-assert request built for a node with per-server slices off: %+v", got)
+	}
+}
+
+// Without a trigger the previous behaviour stands: running ends the phase.
+func TestWithoutTriggerRunningEndsThePhase(t *testing.T) {
+	sliceTestConfig(t, true, "15m", "64G")
+	s := newSliceTestServer()
+	s.beginSlicePhase()
+	if s.hasSliceMatcher() {
+		t.Fatal("no trigger configured, yet one is in effect")
+	}
+	s.onSliceStateChange("running")
+	if s.slicePhaseInProgress() {
+		t.Error("running state should have ended the phase")
+	}
+}
+
+func TestPerServerStartupGraceOverride(t *testing.T) {
+	sliceTestConfig(t, true, "15m", "64G")
+	for _, tt := range []struct {
+		raw  string
+		want time.Duration
+		set  bool
+	}{
+		{"30m", 30 * time.Minute, true},
+		{"", 0, false},
+		{"nonsense", 0, true}, // reported as an error, node default used
+	} {
+		d, set, err := cgroups.StartupGraceFromEnv([]string{"WINGS_CG_STARTUP_GRACE=" + tt.raw})
+		if tt.raw == "nonsense" {
+			if err == nil {
+				t.Error("an unparseable grace must report an error")
+			}
+			continue
+		}
+		if set != tt.set || d != tt.want {
+			t.Errorf("grace %q = (%v, %v), want (%v, %v)", tt.raw, d, set, tt.want, tt.set)
+		}
+	}
+}
+
+func TestPhaseEventsRecordOncePerLine(t *testing.T) {
+	sliceTestConfig(t, true, "15m", "64G")
+	s := newSliceTestServer()
+	s.cfg.EnvVars = map[string]interface{}{
+		"WINGS_CG_PHASE_EVENTS": "load=regex:LogLoad: LoadMap:\nupdate=Checking for available updates",
+	}
+	s.beginPhaseEvents()
+
+	// A non-matching line records nothing; the matching line arms once.
+	s.matchPhaseEvents([]byte("noise"))
+	s.slicePhaseMu.Lock()
+	fired := 0
+	for _, e := range s.sliceEvents {
+		if e.fired {
+			fired++
+		}
+	}
+	s.slicePhaseMu.Unlock()
+	if fired != 0 {
+		t.Fatalf("nothing should have fired yet, %d did", fired)
+	}
+
+	s.matchPhaseEvents([]byte("[..] Checking for available updates..."))
+	s.matchPhaseEvents([]byte("[..] Checking for available updates...")) // repeat: no re-fire
+	s.matchPhaseEvents([]byte("LogLoad: LoadMap: /Game/X"))
+
+	s.slicePhaseMu.Lock()
+	defer s.slicePhaseMu.Unlock()
+	byName := map[string]bool{}
+	for _, e := range s.sliceEvents {
+		byName[e.name] = e.fired
+	}
+	if !byName["update"] || !byName["load"] {
+		t.Errorf("both events should have fired once: %+v", byName)
+	}
+}
