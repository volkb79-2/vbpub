+// A server with no Wings-managed properties must produce no request at all, so
+// no systemd call is ever attempted for it. Owner, not Scope, is the sentinel:
+// the scope name needs a live container and is resolved at apply time.
+func TestSliceRequestSkipsUnmanaged(t *testing.T) {
