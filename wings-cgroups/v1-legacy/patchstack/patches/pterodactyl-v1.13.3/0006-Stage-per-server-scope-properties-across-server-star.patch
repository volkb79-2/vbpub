@@ -0,0 +1,217 @@
+package cgroups
+
+import "testing"
+
+func TestStartupFromEnv(t *testing.T) {
+	env := []string{
+		"WINGS_CG_MEMORY_MIN=6G",
+		"WINGS_CG_MEMORY_HIGH=7G",
+		"WINGS_CG_STARTUP_MEMORY_MIN=9G",
+		"WINGS_CG_STARTUP_MEMORY_HIGH=",
+		"UNRELATED=x",
+	}
+	p, errs := StartupFromEnv(env)
+	if len(errs) != 0 {
+		t.Fatalf("unexpected errors: %v", errs)
+	}
+	if p.MemoryMin == nil || *p.MemoryMin != 9<<30 {
+		t.Errorf("startup memory_min = %v, want 9G", p.MemoryMin)
+	}
+	// An empty value is "not set", not an error and not a zero override.
+	if p.MemoryHigh != nil {
+		t.Errorf("empty startup memory_high should stay unset, got %d", *p.MemoryHigh)
+	}
+	if _, errs := StartupFromEnv([]string{"WINGS_CG_STARTUP_MEMORY_MIN=nonsense"}); len(errs) != 1 {
+		t.Errorf("bad value should report exactly one error, got %v", errs)
+	}
+}
+
+// The whole point of the feature: during startup the ceiling must be the
+// startup one, and the steady band must come back afterwards.
+func TestEnsureRequestPhaseBands(t *testing.T) {
+	req := EnsureRequest{
+		ApplyDefaults: true,
+		Defaults: Defaults{
+			MemoryMin:  "6G",
+			MemoryHigh: "7G",
+			CPUWeight:  1000,
+		},
+		StartupDefaults: StartupDefaults{
+			MemoryMin:  "9G",
+			MemoryHigh: "64G", // effectively no ceiling during world load
+		},
+		Env: []string{"WINGS_CG_MEMORY_HIGH=8G"},
+	}
+
+	req.Phase = PhaseSteady
+	steady, errs := req.props()
+	if len(errs) != 0 {
+		t.Fatalf("steady errors: %v", errs)
+	}
+	if steady.MemoryMin == nil || *steady.MemoryMin != 6<<30 {
+		t.Errorf("steady min = %v, want 6G", steady.MemoryMin)
+	}
+	// The per-server variable overrides the node default in the steady band.
+	if steady.MemoryHigh == nil || *steady.MemoryHigh != 8<<30 {
+		t.Errorf("steady high = %v, want 8G (per-server override)", steady.MemoryHigh)
+	}
+	if steady.CPUWeight == nil || *steady.CPUWeight != 1000 {
+		t.Errorf("steady cpu weight = %v, want 1000", steady.CPUWeight)
+	}
+
+	req.Phase = PhaseStartup
+	startup, errs := req.props()
+	if len(errs) != 0 {
+		t.Fatalf("startup errors: %v", errs)
+	}
+	if startup.MemoryMin == nil || *startup.MemoryMin != 9<<30 {
+		t.Errorf("startup min = %v, want 9G (startup default wins)", startup.MemoryMin)
+	}
+	if startup.MemoryHigh == nil || *startup.MemoryHigh != 64<<30 {
+		t.Errorf("startup high = %v, want 64G (startup band beats the per-server 8G)", startup.MemoryHigh)
+	}
+	// Weights are not staged and must survive both phases identically.
+	if startup.CPUWeight == nil || *startup.CPUWeight != 1000 {
+		t.Errorf("startup cpu weight = %v, want 1000", startup.CPUWeight)
+	}
+}
+
+// A node that configures no startup band must behave exactly as before the
+// feature existed: the same properties in both phases.
+func TestEnsureRequestNoStartupOverrideIsIdentical(t *testing.T) {
+	req := EnsureRequest{
+		ApplyDefaults:  true,
+		Defaults: Defaults{MemoryMin: "6G", MemoryHigh: "7G"},
+	}
+	req.Phase = PhaseStartup
+	a, _ := req.props()
+	req.Phase = PhaseSteady
+	b, _ := req.props()
+	if a.String() != b.String() {
+		t.Errorf("startup band %q differs from steady %q with nothing staged", a, b)
+	}
+}
+
+// A per-server startup variable must work even when the node stages nothing.
+func TestEnsureRequestPerServerStartupOverride(t *testing.T) {
+	req := EnsureRequest{
+		ApplyDefaults:  true,
+		Phase:    PhaseStartup,
+		Defaults: Defaults{MemoryHigh: "7G"},
+		Env:      []string{"WINGS_CG_STARTUP_MEMORY_HIGH=12G"},
+	}
+	p, _ := req.props()
+	if p.MemoryHigh == nil || *p.MemoryHigh != 12<<30 {
+		t.Errorf("startup high = %v, want 12G", p.MemoryHigh)
+	}
+}
+
+// Hand-managed slices (explicit WINGS_CGROUP_PARENT) never receive node
+// defaults — including the startup band.
+func TestEnsureRequestWithoutDefaultsSkipsThem(t *testing.T) {
+	req := EnsureRequest{
+		ApplyDefaults:         false,
+		Phase:           PhaseStartup,
+		Defaults:        Defaults{MemoryMin: "6G"},
+		StartupDefaults: StartupDefaults{MemoryMin: "9G"},
+		Env:             []string{"WINGS_CG_MEMORY_MIN=1G"},
+	}
+	p, _ := req.props()
+	if p.MemoryMin == nil || *p.MemoryMin != 1<<30 {
+		t.Errorf("non-derived min = %v, want only the explicit 1G", p.MemoryMin)
+	}
+}
+
+func TestPropsEqual(t *testing.T) {
+	a := Props{MemoryMin: u64(6 << 30), CPUWeight: u64(200)}
+	if !a.Equal(Props{MemoryMin: u64(6 << 30), CPUWeight: u64(200)}) {
+		t.Error("identical props must compare equal")
+	}
+	if a.Equal(Props{MemoryMin: u64(7 << 30), CPUWeight: u64(200)}) {
+		t.Error("differing values must not compare equal")
+	}
+	// "unset" and "set to zero" are different requests and must not collapse.
+	if (Props{MemoryMin: u64(0)}).Equal(Props{}) {
+		t.Error("explicit zero must not equal unset")
+	}
+}
+
+// Staged() gates the steady re-apply: with nothing staged it must report false
+// so no pointless systemd round trip happens on every server start.
+func TestEnsureRequestStaged(t *testing.T) {
+	base := EnsureRequest{ApplyDefaults: true, Defaults: Defaults{MemoryMin: "6G", MemoryHigh: "7G"}}
+	if base.Staged() {
+		t.Error("no startup band configured must report not staged")
+	}
+	withNode := base
+	withNode.StartupDefaults = StartupDefaults{MemoryHigh: "64G"}
+	if !withNode.Staged() {
+		t.Error("node startup_defaults must report staged")
+	}
+	withServer := base
+	withServer.Env = []string{"WINGS_CG_STARTUP_MEMORY_HIGH=64G"}
+	if !withServer.Staged() {
+		t.Error("per-server startup variable must report staged")
+	}
+	// A startup value equal to the steady one changes nothing and must not
+	// trigger a transition.
+	same := base
+	same.StartupDefaults = StartupDefaults{MemoryHigh: "7G"}
+	if same.Staged() {
+		t.Error("startup band identical to steady must report not staged")
+	}
+}
+
+func TestPhaseEventsFromEnv(t *testing.T) {
+	env := []string{
+		"WINGS_CG_PHASE_EVENTS=steam-update-started=Checking for available updates\nsteam-update-done=regex:already up to date|fully installed\n\nworld-load-begin=LogLoad: LoadMap:\nbad-entry-no-match=\n=no-name",
+	}
+	got := PhaseEventsFromEnv(env)
+	if len(got) != 3 {
+		t.Fatalf("want 3 valid entries, got %d: %+v", len(got), got)
+	}
+	if got[0].Name != "steam-update-started" || got[0].Match != "Checking for available updates" {
+		t.Errorf("entry 0 = %+v", got[0])
+	}
+	if got[1].Match != "regex:already up to date|fully installed" {
+		t.Errorf("regex prefix must be preserved for the caller: %q", got[1].Match)
+	}
+	if PhaseEventsFromEnv([]string{"OTHER=x"}) != nil {
+		t.Error("no WINGS_CG_PHASE_EVENTS must yield nil")
+	}
+}
+
+func TestRampCeilings(t *testing.T) {
+	const G = uint64(1) << 30
+	// Nothing to walk.
+	if rampCeilings(6*G, 7*G, 64<<20) != nil {
+		t.Error("cur below target must plan nothing")
+	}
+	if rampCeilings(9*G, 7*G, 0) != nil {
+		t.Error("step 0 must plan nothing (one-shot)")
+	}
+	// A clean 2G tail in 1G steps: 8G, then 7G (target). First step is one
+	// `step` below cur, NOT cur itself (the empty span above cur is free).
+	seq := rampCeilings(9*G, 7*G, 1*G)
+	if len(seq) != 2 || seq[0] != 8*G || seq[len(seq)-1] != 7*G {
+		t.Errorf("2G/1G ramp = %v, want [8G 7G]", seq)
+	}
+	// Always lands exactly on target, monotonically decreasing.
+	seq = rampCeilings(10*G, 7*G, 700<<20)
+	if seq[len(seq)-1] != 7*G {
+		t.Errorf("last element = %d, want target %d", seq[len(seq)-1], 7*G)
+	}
+	for i := 1; i < len(seq); i++ {
+		if seq[i] >= seq[i-1] {
+			t.Errorf("not monotonically decreasing at %d: %v", i, seq)
+		}
+	}
+	// A pathologically small step is capped at rampMaxSteps writes, not millions.
+	seq = rampCeilings(9*G, 7*G, 1) // 2G tail, 1-byte step
+	if len(seq) > rampMaxSteps {
+		t.Errorf("tiny step produced %d writes, must cap at %d", len(seq), rampMaxSteps)
+	}
+	if seq[len(seq)-1] != 7*G {
+		t.Errorf("capped ramp must still reach target, got %d", seq[len(seq)-1])
+	}
+}
