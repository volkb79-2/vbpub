 sftp/server.go      | 18 +++++++++++++-
 sftp/server_test.go | 60 +++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 77 insertions(+), 1 deletion(-)

diff --git a/sftp/server.go b/sftp/server.go
index 870c63c..dc71d11 100644
--- a/sftp/server.go
+++ b/sftp/server.go
@@ -325,7 +325,8 @@ func handshake(conn net.Conn, config *ssh.ServerConfig, timeout time.Duration) (
 }
 
 // logAcceptInboundFailure logs an SSH handshake failure at the severity its cause warrants.
-// Authentication rejection is expected scanner noise; protocol and transport
+// Authentication rejections and connections dropped before authentication are
+// expected scanner traffic, with distinct messages for monitoring. Protocol
 // failures remain errors with their existing stack-trace field.
 func logAcceptInboundFailure(err error, ip string) {
 	var authErr *ssh.ServerAuthError
@@ -333,9 +334,24 @@ func logAcceptInboundFailure(err error, ip string) {
 		log.WithField("ip", ip).WithField("reason", authErr.Error()).Warn("sftp: rejected unauthenticated connection")
 		return
 	}
+	if isHandshakeDisconnect(err) {
+		log.WithField("ip", ip).WithField("reason", err.Error()).Warn("sftp: connection dropped before authentication began")
+		return
+	}
 	log.WithField("error", err).WithField("ip", ip).Error("sftp: failed to accept inbound connection")
 }
 
+// isHandshakeDisconnect reports whether err is a network-level disconnect -- a
+// clean close, unexpected EOF, or any net.OpError -- rather than a protocol or
+// authentication error raised by the SSH library.
+func isHandshakeDisconnect(err error) bool {
+	if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+		return true
+	}
+	var netErr *net.OpError
+	return errors.As(err, &netErr)
+}
+
 // AcceptInbound handles an inbound connection to the instance and determines if we should
 // serve the request or not.
 func (c *SFTPServer) AcceptInbound(conn net.Conn, config *ssh.ServerConfig) error {
diff --git a/sftp/server_test.go b/sftp/server_test.go
index ae7ad3f..34414fd 100644
--- a/sftp/server_test.go
+++ b/sftp/server_test.go
@@ -5,6 +5,7 @@ import (
 	"crypto/ed25519"
 	"crypto/rand"
 	"errors"
+	"io"
 	"net"
 	"os"
 	"strings"
@@ -266,6 +267,65 @@ func TestLogAcceptInboundFailure_WrappedAuthRejection_StillUnwrapped(t *testing.
 	}
 }
 
+func TestIsHandshakeDisconnect(t *testing.T) {
+	cases := []struct {
+		name string
+		err  error
+		want bool
+	}{
+		{"bare io.EOF", io.EOF, true},
+		{"bare io.ErrUnexpectedEOF", io.ErrUnexpectedEOF, true},
+		{"io.EOF wrapped in a stack", emperrors.WithStack(io.EOF), true},
+		{"net.OpError", &net.OpError{Op: "read", Net: "tcp", Err: errors.New("connection reset by peer")}, true},
+		{"net.OpError wrapped in a stack", emperrors.WithStack(&net.OpError{Op: "read", Net: "tcp", Err: io.ErrClosedPipe}), true},
+		{"unrelated plain error", errors.New("ssh: no common algorithm for key exchange"), false},
+		{"auth error", &ssh.ServerAuthError{Errors: []error{ssh.ErrNoAuth}}, false},
+		{"nil", nil, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := isHandshakeDisconnect(tc.err); got != tc.want {
+				t.Errorf("isHandshakeDisconnect(%v) = %v, want %v", tc.err, got, tc.want)
+			}
+		})
+	}
+}
+
+func TestLogAcceptInboundFailure_HandshakeDisconnect_DistinctFromAuthRejection(t *testing.T) {
+	h := withLogCapture(t)
+	logAcceptInboundFailure(emperrors.WithStack(io.EOF), "203.0.113.9:4444")
+
+	if len(h.Entries) != 1 {
+		t.Fatalf("want 1 log entry, got %d", len(h.Entries))
+	}
+	e := h.Entries[0]
+	if e.Level != log.WarnLevel {
+		t.Errorf("want WarnLevel, got %v", e.Level)
+	}
+	if e.Fields.Get("error") != nil {
+		t.Error(`a handshake disconnect must not carry an "error" field`)
+	}
+	if e.Fields.Get("reason") == nil {
+		t.Error(`want a "reason" field describing the disconnect`)
+	}
+	if e.Message != "sftp: connection dropped before authentication began" {
+		t.Errorf("unexpected message %q", e.Message)
+	}
+}
+
+func TestLogAcceptInboundFailure_NetOpError_AlsoClassifiedAsDisconnect(t *testing.T) {
+	h := withLogCapture(t)
+	opErr := &net.OpError{Op: "read", Net: "tcp", Err: errors.New("connection reset by peer")}
+	logAcceptInboundFailure(opErr, "203.0.113.9:4444")
+
+	if len(h.Entries) != 1 {
+		t.Fatalf("want 1 log entry, got %d", len(h.Entries))
+	}
+	if e := h.Entries[0]; e.Level != log.WarnLevel || e.Message != "sftp: connection dropped before authentication began" {
+		t.Errorf("want Warn/handshake-disconnect message, got %v/%q", e.Level, e.Message)
+	}
+}
+
 func TestLogAcceptInboundFailure_OtherError_KeepsErrorLevelAndField(t *testing.T) {
 	h := withLogCapture(t)
 	unexpected := emperrors.New("ssh: message too large")
