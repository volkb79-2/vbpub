[Unit]
Description=nyxloom gate runs — CPU-heavy batch; lowest priority in the factory
Before=slices.target

[Slice]
# Lowest weight inside nyxloom.slice. A gate is `pytest -n auto` for minutes --
# the dominant CPU consumer and the least latency-sensitive.
#
# RETRACTED CAVEAT (2026-07-27): an earlier comment here claimed starvation
# "manufactures FALSE REDS" (two timing failures at CPUWeight 20 that vanished
# at 50) and used that to argue against weighting gates low. Retracted -- see
# README.md "Starvation does NOT justify raising a weight". Briefly: (a) a test
# that fails on a slow machine is a TRUE red exposing a real race, never a false
# one; (b) CPUWeight binds ONLY under contention, so 20-vs-50 could not have
# changed CPU availability on an idle host -- the experiment was uncontrolled;
# (c) re-measured with a HARD quota, the full suite passes at --cpus=2 AND at
# --cpus=1 (12.5% of an 8-core host, 4 xdist workers on one core), both
# PYTEST_EXIT:0. Weight gates for the HOST's priorities. If a test fails when
# starved, fix the test with a deterministic oracle -- never raise this number
# to make a suite pass.
CPUWeight=25
IOWeight=30

# Filled in (host dev-tier cgroup governance rollout) from the existing
# sustained-v3 baseline measured 2026-07-08 (RIOPS_MAX=90173, WIOPS_MAX=58695,
# RBW_MAX_BPS=2149035554, WBW_MAX_BPS=516276624 -- see
# modern-debian-tools-python-debug/host-setup/README.md "The IO baseline").
# Low end of the 60-80% band (whole-tier ceiling: several gate runs can be
# concurrent, same reasoning as dev.slice's own DEV_IO_CAP_PCT default).
# RAM: generous swap on purpose -- a gate that swaps finishes slowly; a gate
# that OOMs fails a merge. Independent of nyxloom.slice's own still-unset
# whole-factory MemoryMax (D-G1/G4, out of scope here) -- revisit once that
# lands, since these child values only matter up to whatever the parent caps.
MemoryHigh=12G
MemoryMax=16G
MemorySwapMax=40G
IOReadIOPSMax=/dev/vda 54103
IOWriteIOPSMax=/dev/vda 35217
IOReadBandwidthMax=/dev/vda 1229M
IOWriteBandwidthMax=/dev/vda 295M
