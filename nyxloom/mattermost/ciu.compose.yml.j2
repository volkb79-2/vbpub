# ─── Mattermost + dedicated Postgres — nyxloom notification channel ──────
# Rendered by ciu; the sibling docker-compose.yml is the pre-rendered copy
# for plain-compose deploys (keep both in sync: edit HERE, re-render or
# hand-sync — and remember the plain path gets NO governance overlay, so its
# caps are inlined there).
#
# GOVERNANCE (NL-6, the incident this stack must not repeat): the app
# service emits NO cgroup_parent / mem_limit / memswap_limit / cpus /
# blkio_config of its own, because ciu skips any governance key the author
# already set (S15.3) — that silent skip is what left the live ntfy
# container unconfined. Only `postgres` sets its own mem/cpu keys, and only
# to NARROW them below the stack ceiling; it still inherits cgroup_parent
# and blkio from the overlay.

services:
  postgres:
    image: {{ mattermost.postgres.image }}:{{ mattermost.postgres.image_tag }}
    container_name: {{ mattermost.container_prefix }}-mattermost-db
    # CIU-48/49: qualify `hostname` the same way `container_name` is, so a
    # second ciu instance on a shared network cannot hijack DNS resolution.
    hostname: {{ mattermost.container_prefix }}-mattermost-db
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    environment:
      TZ: "UTC"
      POSTGRES_DB: "{{ mattermost.postgres.db }}"
      POSTGRES_USER: "{{ mattermost.postgres.user }}"
      # S4.17: the *_FILE convention — the value never reaches the compose
      # file or the process environment, only the mounted secret file.
      POSTGRES_PASSWORD_FILE: /run/secrets/postgres_password
      # Mattermost needs a deterministic collation; C is stable across
      # image upgrades where the host locale is not.
      POSTGRES_INITDB_ARGS: "--encoding=UTF8 --lc-collate=C --lc-ctype=C"
    secrets:
      - postgres_password
    volumes:
      # nyxloom-P107: a ciu HOSTDIR (S6.1/S6.2), not a named volume — the
      # value is already the ABSOLUTE PHYSICAL host path, which is what makes
      # it correct under DooD. ciu pre-owns it 70:<DOCKER_GID> 0700 through
      # the S6.5 root helper, so the image's own root->postgres drop finds a
      # directory it already owns and no init container is needed. See
      # `[mattermost.postgres.hostdir]` for the measurements behind that.
      - {{ mattermost.postgres.hostdir.data }}:/var/lib/postgresql/data
    expose:
      - "{{ mattermost.postgres.port }}"
    networks:
      - internal
    # Author-set (S15.3): narrows THIS service below the stack ceiling.
    # mem_limit and memswap_limit are set as a coherent PAIR on purpose —
    # setting only mem_limit would leave governance injecting the app's
    # 18g combined total onto a 512m container.
    mem_limit: {{ mattermost.postgres.mem_limit }}
    memswap_limit: {{ mattermost.postgres.mem_swap_limit }}
    cpus: {{ mattermost.postgres.cpus }}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ mattermost.postgres.user }} -d {{ mattermost.postgres.db }}"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s
    logging:
      driver: json-file
      options:
        max-size: "{{ mattermost.logging.max_size }}"
        max-file: "{{ mattermost.logging.max_file }}"

  mattermost:
    image: {{ mattermost.app.image }}:{{ mattermost.app.image_tag }}
    container_name: {{ mattermost.container_prefix }}-mattermost
    hostname: {{ mattermost.container_prefix }}-mattermost
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    environment:
      TZ: "UTC"
      MM_SQLSETTINGS_DRIVERNAME: "postgres"
      # The DSN's password comes from compose `${...}` interpolation, fed by
      # ciu's S4.19 `expose_env` on the SAME GEN_LOCAL secret Postgres reads
      # from /run/secrets. S4.19 calls that escape hatch discouraged, and it
      # is used here only because this image forces it: the 11.x
      # mattermost-team-edition image is minimal (NO /bin/sh — verified:
      # `exec: "/bin/sh": stat /bin/sh: no such file or directory`), so the
      # S4.18 entrypoint-wrapper pattern that would read /run/secrets and
      # assemble the DSN in-container cannot run, and Mattermost has no
      # *_FILE form for MM_SQLSETTINGS_DATASOURCE. The rendered compose
      # holds only the `${MM_DB_PASSWORD}` placeholder (so the S4.22 leak
      # scan stays meaningful); the trade-off is that the resolved DSN is
      # visible in this container's env to anyone who can already talk to
      # the docker daemon.
      MM_SQLSETTINGS_DATASOURCE: "postgres://{{ mattermost.postgres.user }}:${MM_DB_PASSWORD}@{{ mattermost.container_prefix }}-mattermost-db:{{ mattermost.postgres.port }}/{{ mattermost.postgres.db }}?sslmode=disable&connect_timeout=10"
      MM_SERVICESETTINGS_LISTENADDRESS: ":{{ mattermost.app.port }}"
{% if mattermost.expose_public %}
      MM_SERVICESETTINGS_SITEURL: "https://{{ mattermost.public_host }}"
{% else %}
      MM_SERVICESETTINGS_SITEURL: "http://{{ mattermost.container_prefix }}-mattermost:{{ mattermost.app.port }}"
{% endif %}
      # Local mode = an admin socket inside the container, so provisioning
      # (admin user, team, channel, incoming webhook) runs through
      # `docker exec ... mmctl --local` with NO network-exposed admin API
      # and no password on a command line.
      MM_SERVICESETTINGS_ENABLELOCALMODE: "true"
      MM_SERVICESETTINGS_LOCALMODESOCKETLOCATION: "/var/tmp/mattermost_local.socket"
      # ── Safe-governance baseline, mirroring ntfy's server.yml posture ──
      # No open server / no self-signup: accounts are admin-created only.
      #
      # ENABLEUSERCREATION is "false", NOT the "true" this stack shipped
      # until nyxloom-P110. That combination did NOT deliver the README's
      # "no self-signup — admin-created only" claim, and it was measured, not
      # reasoned about (11.10.1, throwaway instance):
      #
      #   POST /api/v4/users            (no token, no invite) -> 403
      #                                 api.user.create_user.no_open_server
      #   POST /api/v4/users?iid=<team invite_id>             -> 201 CREATED
      #
      # i.e. ENABLEOPENSERVER=false closes the bare signup route and NOTHING
      # else: anyone holding a team's `invite_id` creates a full `system_user`
      # anonymously. That id is not a secret in any useful sense — the team
      # this stack's own hook creates comes out `type: "O"` with
      # `allow_open_invite: true`, so the id is in the invite link every team
      # member can copy, including the `nyxloom-installer` service account
      # whose credential is meant to live on third-party install hosts. Behind
      # `expose_public = true` that is an unauthenticated account-creation
      # endpoint on the public internet.
      #
      # ENABLEUSERCREATION=false is the flag that closes it, and it does NOT
      # cost this stack anything: `mmctl --local user create` is an admin-
      # socket path and keeps working (measured — the provisioning hook
      # creates all four accounts on a fresh instance with this set), so
      # "admin-created only" becomes literally true instead of aspirational.
      MM_TEAMSETTINGS_ENABLEOPENSERVER: "false"
      MM_TEAMSETTINGS_ENABLEUSERCREATION: "false"
      MM_TEAMSETTINGS_ENABLEUSERDEACTIVATION: "false"
      # Kept "true", and left alone deliberately. It reads like the obvious
      # thing to switch off, but it is the email/password AUTHENTICATION
      # method as well as the signup one, and no SSO provider is configured
      # here — turning it off risks leaving this server with no way to log in
      # at all. NOT MEASURED (unlike everything else in this block): the
      # throwaway was torn down before that was tested, so it is reasoned
      # about, and it is flagged as such rather than presented as a finding.
      # It is also not the account-creation gate: with ENABLEUSERCREATION
      # false, the signup route already refuses (measured — 501
      # `api.user.create_user.signup_email_disabled`) while
      # `POST /api/v4/users/login` still returns 200 for both human accounts.
      MM_EMAILSETTINGS_ENABLESIGNUPWITHEMAIL: "true"
      MM_EMAILSETTINGS_REQUIREEMAILVERIFICATION: "false"
      # Default is TRUE (measured). Inert while no SMTP is configured, but it
      # is the other invite surface and there is no reason to leave the only
      # thing standing between it and use as an "SMTP was configured later"
      # accident.
      MM_SERVICESETTINGS_ENABLEEMAILINVITATIONS: "false"
      # No SMTP is configured; sending would only produce error noise.
      MM_EMAILSETTINGS_SENDEMAILNOTIFICATIONS: "false"
      MM_EMAILSETTINGS_ENABLEEMAILBATCHING: "false"
      # Incoming webhooks are the whole point; outgoing ones are an egress
      # surface nyxloom does not use.
      MM_SERVICESETTINGS_ENABLEINCOMINGWEBHOOKS: "true"
      MM_SERVICESETTINGS_ENABLEOUTGOINGWEBHOOKS: "false"
      MM_SERVICESETTINGS_ENABLECOMMANDS: "false"
      # notify.py's Mattermost backend may set username/icon_url on a post;
      # Mattermost ignores both unless these overrides are enabled.
      MM_SERVICESETTINGS_ENABLEPOSTUSERNAMEOVERRIDE: "true"
      MM_SERVICESETTINGS_ENABLEPOSTICONOVERRIDE: "true"
      # nyxloom-P109 (B9): server-wide personal access tokens, off unless
      # `[mattermost].enable_user_access_tokens` says otherwise. Required by
      # the intake bridge's `rest` read transport and by nothing else -- its
      # `mmctl` transport needs no server change, which is why both exist.
      # Turning this on lets any system admin mint a bearer token for any
      # account, so it stays a declared decision rather than a side effect of
      # declaring a token to provision.
      MM_SERVICESETTINGS_ENABLEUSERACCESSTOKENS: "{{ 'true' if mattermost.enable_user_access_tokens else 'false' }}"
      MM_SERVICESETTINGS_ENABLEDEVELOPER: "false"
      MM_SERVICESETTINGS_ENABLETESTING: "false"
      # ── nyxloom-P110: settings whose SILENT DEFAULT was wrong for a
      #    public instance. Every value below the divider was read off a
      #    throwaway 11.10.1 instance with `mmctl --local config get` before
      #    being set, because guessing is what this stack does not do.
      #
      # EnableOAuthServiceProvider's default is TRUE. Mattermost Team Edition
      # ships an OAuth2 *authorization server* switched on: a system admin can
      # register third-party OAuth apps that then mint bearer credentials for
      # this server. Nothing in nyxloom uses it, and it is a second credential
      # factory sitting behind the one human admin login. Off, explicitly —
      # the same "explicit over silently-inherited-default" rule this stack
      # already applies to `cgroup_parent` and `device`.
      MM_SERVICESETTINGS_ENABLEOAUTHSERVICEPROVIDER: "false"
      # Deletion APIs. All three ALREADY default false (measured); they are
      # restated because "measured false today" and "false by contract" are
      # different things across an image bump, and these three are the ones
      # that turn a stolen admin session into data loss rather than a leak.
      MM_SERVICESETTINGS_ENABLEAPITEAMDELETION: "false"
      MM_SERVICESETTINGS_ENABLEAPIUSERDELETION: "false"
      MM_SERVICESETTINGS_ENABLEAPICHANNELDELETION: "false"
      # ── Login surface (item 5 of the P110 audit) ───────────────────────
      # MaximumLoginAttempts already defaults to 10 (measured), so the public
      # login form is NOT the zero-lockout surface it was suspected to be.
      # Restated at the same value rather than tightened: two human logins
      # with GEN_LOCAL passwords do not need a 3-strike lockout, and a
      # too-tight threshold is its own denial-of-service on the operator.
      MM_SERVICESETTINGS_MAXIMUMLOGINATTEMPTS: "10"
      # SessionLengthWebInHours defaults to 4320 — 180 days. That is the one
      # login-surface default that IS wrong here: a browser session stolen
      # once stays valid for half a year. 168h = 7 days, and
      # ExtendSessionLengthWithActivity (default true, restated) means the
      # operator's own session is refreshed by use rather than expiring
      # mid-week.
      MM_SERVICESETTINGS_SESSIONLENGTHWEBINHOURS: "168"
      MM_SERVICESETTINGS_EXTENDSESSIONLENGTHWITHACTIVITY: "true"
      # MFA is AVAILABLE in Team Edition (measured: the setting exists and
      # defaults false). Enabled, deliberately NOT enforced: enabling only
      # exposes the per-account opt-in so the operator can turn it on for the
      # human login, while ENFORCE would apply server-wide and lock out any
      # account that authenticates with a password and cannot hold a TOTP
      # secret.
      MM_SERVICESETTINGS_ENABLEMULTIFACTORAUTHENTICATION: "true"
      MM_SERVICESETTINGS_ENFORCEMULTIFACTORAUTHENTICATION: "false"
      # EnableSecurityFixAlert defaults TRUE and is a telemetry channel —
      # it reports this server's version and deployment shape to Mattermost.
      # The README already claims "no telemetry" and MM_LOGSETTINGS_
      # ENABLEDIAGNOSTICS is already false; leaving this one on made that
      # claim untrue. The cost is stated rather than hidden: nobody will mail
      # this instance about a CVE, so the image tag is the operator's only
      # notification channel and bumping it stays a deliberate act.
      MM_SERVICESETTINGS_ENABLESECURITYFIXALERT: "false"
      # ── Directory disclosure (PrivacySettings) ──────────────────────────
      # Both default TRUE. Measured consequence: any authenticated account —
      # including `nyxloom-installer`, whose credential is meant to sit on a
      # third-party install host — can read every other account's address and
      # roles off `GET /api/v4/users/username/<name>`, which is how an
      # attacker finds out WHICH account is the system admin worth attacking.
      # The four provisioned addresses are `*@nyxloom.local` placeholders, so
      # hiding them costs nothing and the operator loses no function: mmctl's
      # local admin socket is not subject to PrivacySettings (verified — the
      # hook's `channel users list` parse still sees the `(<email>)` field).
      MM_PRIVACYSETTINGS_SHOWEMAILADDRESS: "false"
      MM_PRIVACYSETTINGS_SHOWFULLNAME: "false"
      # ── Rate limiting (item 4 of the P110 audit) ────────────────────────
      # RateLimitSettings.Enable defaults FALSE (measured), and the shared
      # ingress does NOT make up for it: tls-edge attaches exactly one
      # entrypoint-level middleware, `secure-headers` (HSTS / nosniff /
      # referrer-policy), and lists `rateLimit` under ARCHITECTURE.md F5
      # "Traefik middleware additions — Partially implemented" as a future
      # item with no definition shipped in `edge-proxy/conf.d/middlewares.yml`.
      # So app-level limiting here is NOT redundant; it is the only limiter
      # in the path.
      #
      # The estate already HAS a pattern for this and it is app-level, not
      # edge-level: ../ntfy/server.yml carries visitor-request-limit-burst /
      # -replenish / -subscription-limit / -message-daily-limit with the
      # comment "defense in depth; all real use is authenticated", plus
      # `behind-proxy: true` so the limiter keys on the forwarded address
      # instead of the edge's. This block is that same shape in Mattermost's
      # vocabulary, not a new invention.
      #
      # PerSec/MaxBurst/MemoryStoreSize are restated at their measured
      # defaults (10 / 100 / 10000) — the default VALUES are fine, it is
      # `Enable: false` that was not.
      MM_RATELIMITSETTINGS_ENABLE: "true"
      MM_RATELIMITSETTINGS_PERSEC: "10"
      MM_RATELIMITSETTINGS_MAXBURST: "100"
      MM_RATELIMITSETTINGS_MEMORYSTORESIZE: "10000"
{% if mattermost.expose_public %}
      # KEYING, and it has to follow the topology — this is the one part of
      # the hardening that is genuinely conditional, because getting it wrong
      # inverts the control rather than weakening it. Behind tls-edge every
      # request arrives from the Traefik container's address, so the default
      # VaryByRemoteAddr=true would put the entire internet in ONE bucket:
      # a single client could then exhaust the limit for the operator, the
      # daemon and the install hosts at once. Keyed on the forwarded address
      # instead — ntfy's `behind-proxy: true`, spelled Mattermost's way.
      MM_RATELIMITSETTINGS_VARYBYREMOTEADDR: "false"
      MM_RATELIMITSETTINGS_VARYBYHEADER: "X-Forwarded-For"
{% else %}
      # Not exposed: there is no proxy in front, so no X-Forwarded-For to
      # trust, and keying on it would put every caller in one bucket for the
      # mirror-image reason. The peer address IS the caller here.
      MM_RATELIMITSETTINGS_VARYBYREMOTEADDR: "true"
{% endif %}
      # nyxloom's OWN notifications stay typed text only (SPEC §13) — this
      # flag is not for `notify.py`, which never attaches anything
      # regardless of it. It gates the REST Files API for third-party
      # producers with their own PAT (nyxloom-P111 — see
      # `ciu.defaults.toml.j2`'s `enable_file_attachments` for the full
      # reasoning, including the named-volume residual it leaves open).
      MM_FILESETTINGS_ENABLEFILEATTACHMENTS: "{{ 'true' if mattermost.enable_file_attachments else 'false' }}"
      # The whole plugin framework is off: the image ships prepackaged
      # plugins (playbooks, the AI agent) that start their own processes and
      # run their own DB migrations on first boot — none of which a
      # notification sink needs, all of which are charged to this
      # container's 2g memory cgroup on a shared host.
      MM_PLUGINSETTINGS_ENABLE: "false"
      MM_PLUGINSETTINGS_ENABLEUPLOADS: "false"
      MM_PLUGINSETTINGS_ENABLEMARKETPLACE: "false"
      MM_LOGSETTINGS_ENABLEDIAGNOSTICS: "false"
      MM_LOGSETTINGS_CONSOLELEVEL: "INFO"
    volumes:
      # nyxloom-P107 — hostdirs where host visibility PAYS FOR ITSELF, named
      # volumes where it does not. Reasoning is recorded per line rather than
      # applied wholesale, because each extra bind is another directory whose
      # ownership has to be right before the container can start (uid 2000,
      # no root phase, no shell — see the hostdir tables).
      #   config: the file an operator actually needs to read and diff.
      #           ciu owns the dir 2000:<DOCKER_GID> 0770 and Mattermost
      #           writes config.json 0644 inside it, so the docker group can
      #           read it from the host without a helper container.
      - {{ mattermost.app.hostdir.config }}:/mattermost/config
      #   logs: worth host-visibility for grepping across restarts, and it
      #         makes the one unbounded-growth surface in this stack visible
      #         to `du` instead of hidden under /var/lib/docker.
      - {{ mattermost.app.hostdir.logs }}:/mattermost/logs
      #   data: holds uploaded file attachments now that
      #         MM_FILESETTINGS_ENABLEFILEATTACHMENTS can be true
      #         (nyxloom-P111). Still a NAMED volume, not a bind mount —
      #         there was nothing here worth host-visibility for while this
      #         was permanently false. Converting it follows the same
      #         recipe nyxloom-P107 used for postgres-data/config; not done
      #         here (residual, stated not buried — see the flag's own
      #         comment in ciu.defaults.toml.j2).
      - mattermost-data:/mattermost/data
      #   plugins / client-plugins: the plugin framework is off entirely
      #         (MM_PLUGINSETTINGS_ENABLE=false). These two exist ONLY because
      #         the image declares VOLUME on both paths — dropping them would
      #         hand Docker two anonymous volumes per recreate instead. Named
      #         volumes, deliberately.
      - mattermost-plugins:/mattermost/plugins
      - mattermost-client-plugins:/mattermost/client/plugins
    expose:
      - "{{ mattermost.app.port }}"
    networks:
      - internal
{% if mattermost.expose_public %}
      - ingress
{% endif %}
    healthcheck:
      # The image ships no shell and no curl, so this is mmctl over the
      # local-mode socket (the image's own built-in healthcheck), re-declared
      # here with this stack's intervals rather than inherited silently.
      test: ["CMD", "/mattermost/bin/mmctl", "system", "status", "--local"]
      interval: {{ mattermost.health.interval }}
      timeout: {{ mattermost.health.timeout }}
      retries: {{ mattermost.health.retries }}
      start_period: {{ mattermost.health.start_period }}
{% if mattermost.expose_public %}
    labels:
      traefik.enable: "true"
      traefik.docker.network: "{{ mattermost.ingress_network }}"
      traefik.http.routers.nyxloom-mattermost.rule: "Host(`{{ mattermost.public_host }}`)"
      traefik.http.routers.nyxloom-mattermost.entrypoints: "websecure"
      traefik.http.services.nyxloom-mattermost.loadbalancer.server.port: "{{ mattermost.app.port }}"
{% endif %}
    logging:
      driver: json-file
      options:
        max-size: "{{ mattermost.logging.max_size }}"
        max-file: "{{ mattermost.logging.max_file }}"

networks:
  # Private, stack-owned bridge: Postgres is reachable ONLY from this
  # stack's own app service, never from the shared ingress network.
  internal:
    driver: bridge
{% if mattermost.expose_public %}
  ingress:
    external: true
    name: {{ mattermost.ingress_network }}
{% endif %}

volumes:
  # What is left after nyxloom-P107 moved postgres-data / mattermost-config /
  # mattermost-logs to ciu hostdirs. These three stay named volumes (S6.7(b))
  # for the reasons recorded beside their mounts above: nothing in them is
  # worth reading from the host. `ciu down` PRESERVES them; `ciu up --reset`
  # and `ciu clean` DELETE them (S6.4) — the same verbs that now also wipe the
  # `vol-*` hostdirs, so one command still means one consistent state.
  #
  # The P106 note here said "postgres uid 999" — wrong for `postgres:16-alpine`,
  # whose postgres account is uid 70; 999 is the Debian-based image. Corrected
  # rather than deleted, because the claim it supported (that a named volume
  # avoids the ownership problem) is still true for the three below.
  mattermost-data:
  mattermost-plugins:
  mattermost-client-plugins:

# NOTE: no top-level `secrets:` block here on purpose. S4.17 — ciu's
# generated overlay declares `secrets.postgres_password.file` with the
# ABSOLUTE PHYSICAL host path; declaring a relative one here would resolve
# to the LOGICAL devcontainer path under DooD (the same class of failure
# ntfy's server.yml bind hit on 2026-07-15). The plain-compose fallback in
# docker-compose.yml carries the physical path explicitly instead.
