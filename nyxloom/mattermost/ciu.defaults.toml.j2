# ─── Mattermost stack configuration — nyxloom notification channel ───────
# ciu v2 stack package (S3.1: this file is the tracked, author-owned FULL
# defaults; a sibling `ciu.toml.j2` may carry a tracked SPARSE override —
# non-secret only — and ciu renders both into the gitignored `ciu.toml`).
# A pre-rendered docker-compose.yml ships alongside (the ntfy/tls-edge
# dual-mode pattern) so the stack also deploys with plain compose; it
# receives NO ciu overlay, so its governance caps are inlined by hand and
# MUST be kept in step with the [mattermost.governance] table below.
#
# Replaces ntfy as nyxloom's live notification channel (NL-17/nyxloom-P106).
# ntfy is kept, stopped and still selectable — not deleted.
#
# Root key `mattermost` (S3.5: exactly one non-reserved top-level key;
# S3.7: not one of ciu's reserved global namespaces).

[mattermost]
name = "mattermost"
container_prefix = "{% if deploy is defined %}{{ deploy.project_name }}-{{ deploy.environment_tag }}{% else %}nyxloom{% endif %}"

# ── Network exposure — DELIBERATELY OFF BY DEFAULT ──────────────────────
# false: no tls-edge router labels, no ingress_public join, no host ports —
# the stack is reachable only from its own private bridge network. This is
# the safe default for a NEW public endpoint nobody has confirmed yet; it
# is also enough for nyxloom's own delivery path once nyxloomd runs on the
# same network, since the incoming webhook is a plain HTTP POST.
# true: publishes `public_host` through tls-edge exactly like ntfy does
# (needed for mobile/desktop clients and off-host browser access — the same
# reason ntfy had to be publicly reachable). Flipping it is an operator
# decision: the hostname must exist in DNS (the wildcard A record covers
# it) and Mattermost then faces the internet with the locked-down posture
# below (no open server, no self-signup, no attachments, no plugin
# uploads/marketplace, no personal access tokens).
expose_public = false
# Public hostname routed by tls-edge when expose_public = true. Same domain
# convention as ntfy's nyxloom.{{ env.PUBLIC_FQDN }}.
public_host = "mattermost.{{ env.PUBLIC_FQDN }}"

# ── Personal access tokens — DELIBERATELY OFF BY DEFAULT (nyxloom-P109) ──
# Drives MM_SERVICESETTINGS_ENABLEUSERACCESSTOKENS on the app service. It is
# a SERVER-WIDE setting, not a per-account one: turning it on lets any system
# admin mint a bearer token for any account through the UI, and lets a user
# holding the `system_user_access_token` role mint their own. That is a real
# widening of the credential surface on a service that is expected to face
# the internet, and it is why this is its own flag rather than something the
# `[[mattermost.provision.tokens]]` table quietly implies.
#
# It is required by the B9 intake bridge's `rest` transport and by nothing
# else — the `mmctl` transport needs no server change at all, which is why
# both exist. Leave this false and the bridge still works over `mmctl`.
#
# That is also why a [[mattermost.provision.tokens]] table can ship while
# this stays false, and why merging one cannot break the next `ciu up` here:
# the hook's token step is a NO-OP under a false flag. It does not raise, and
# it does not skip silently either -- it PRINTS the declared secret names it
# is not minting and returns nothing to persist. So the accounts, channels
# and webhooks provision as usual and only the PAT waits, visibly, on an
# operator flipping this line.
enable_user_access_tokens = true
# tls-edge shared ingress network (external) — joined only when exposed.
ingress_network = "ingress_public"

[mattermost.app]
# `name` exists so S6.1 can auto-generate this service's hostdir paths as
# <stack>/vol-mattermost-<purpose>; nothing else reads it.
name = "mattermost"
# Pinned image; verify the tag exists before bumping (docker manifest
# inspect). 11.10.1 (2026-08-24) rather than the 11.11.0 cut from
# 2026-09-07: a one-day-old release is not what a notification channel
# should be pinned to.
image = "mattermost/mattermost-team-edition"
image_tag = "11.10.1"
# In-container HTTP port; never published on the host.
port = 8065

# ── Bind-mounted hostdirs (S6.1/S6.3/S6.7(a)) — nyxloom-P107 ────────────────
# `path = ""` auto-generates <stack>/vol-mattermost-<purpose>, which is what
# makes these WIPEABLE ON DEMAND: S6.4 removes the stack dir's `vol-*` trees
# on `ciu up --reset` / `ciu clean`, degrading to the S6.5 root helper (and,
# under DooD, routing to the PHYSICAL path unconditionally) for subtrees the
# operator does not own. That is the deliberate OPPOSITE of marking the
# volumes `external` — the operator asked to keep the ability to wipe.
#
# uid 2000 is FORCED by the image, and it is why these hostdirs must be
# pre-owned rather than left to the container: the mattermost image's default
# user IS `mattermost` (uid 2000) — there is no root phase at all, and no
# /bin/sh to add one. Measured on 11.10.1 (nyxloom-P107): a bind mount owned
# by the operator gives
#   `failed to load configuration: could not create config file: open
#    /mattermost/config/config.json: permission denied`
# while the same dir pre-chowned 2000:<DOCKER_GID> mode 0770 starts cleanly
# and leaves config.json 0644 — readable from the host through the docker
# group, which is the whole point of moving off a named volume.
#
# `gid` is omitted on purpose: S6.3's default is CONTAINER_UID:DOCKER_GID, so
# the group is already DOCKER_GID and hardcoding 994 here would rot.
[mattermost.app.hostdir]
config = { path = "", uid = 2000, mode = "0770" }
logs = { path = "", uid = 2000, mode = "0770" }

[mattermost.postgres]
# See [mattermost.app].name — auto-generates <stack>/vol-postgres-data.
name = "postgres"
# Mattermost's REQUIRED database — dedicated to this stack, deliberately
# NOT shared with dstdns's postgres or any other project's.
image = "postgres"
image_tag = "16-alpine"
port = 5432
db = "mattermost"
user = "mmuser"
# Per-service governance narrowing (S15.3 author precedence): these are
# emitted by the compose template onto the postgres service, so ciu's
# stack-wide [mattermost.governance] values below apply to the Mattermost
# app service only. A dedicated single-tenant Postgres with one small
# schema does not need the app's ceiling.
mem_limit = "512m"
mem_swap_limit = "4g"
cpus = "0.5"

# ── The data hostdir (S6.1/S6.7(a)) — nyxloom-P107 ─────────────────────────
# uid 70, NOT 999. `postgres:16-alpine`'s postgres account is uid/gid 70
# (`postgres:x:70:70:` in the image's /etc/passwd); 999 is the DEBIAN-based
# `postgres:16` image. The P106 comments said 999 for this alpine image and
# were simply wrong — harmless while the data lived in a named volume the
# image initialised itself, load-bearing the moment it becomes a bind mount.
#
# mode 0700 matches what postgres ENFORCES, and that matters for more than
# tidiness: S6.3 accepts a pre-existing hostdir whose owner+group match the
# declaration, so declaring 0770 here (S6.7(a)'s suggested "operator keeps
# docker-group access") would be a lie the first `initdb` overwrites — it
# chmods PGDATA to 0700 unconditionally. Consequence, stated plainly: the
# postgres hostdir is host-VISIBLE but not host-READABLE; backups still go
# through `pg_dump` in the container (README), and a wipe goes through S6.4's
# root helper. That is a real limit of bind-mounting postgres, not a defect.
#
# NO init container. dstdns's db-core carries a root `postgres_init` that
# chowns the bind mount before postgres starts — that is required THERE
# because it forces `user: "1000:${DOCKER_GID}"` onto timescaledb-ha, which
# removes the entrypoint's root phase. Tested directly on THIS image
# (nyxloom-P107): with no `user:` override, `postgres:16-alpine` self-
# initialises a bind mount it does not own (its entrypoint starts as root,
# chowns to 70 and chmods 0700 itself); with `user: "70:994"` over a dir it
# does not own it fails exactly the way dstdns's would —
#   `initdb: error: could not change permissions of directory
#    "/var/lib/postgresql/data": Operation not permitted`.
# So the stack keeps the image's own root->postgres drop and lets ciu S6.5
# pre-own the directory, which is also what S6.5 asks for: "stacks SHOULD NOT
# carry init containers for ownership fixes".
[mattermost.postgres.hostdir]
data = { path = "", uid = 70, mode = "0700" }

# ── Secrets (S4) ────────────────────────────────────────────────────────
# GEN_LOCAL: created once, then stable; lands in the PROJECT store
# <ciu-root>/.ciu/secrets/mattermost/postgres_password (0700 dir, gitignored
# via `**/.ciu/`). Never in this file, never in the rendered ciu.toml
# (S4.24), never in the compose (S4.21/S4.22 abort if a resolved value is
# stringified into a template or appears in the rendered output).
#
# mode 0444, not the 0440 default: the consumer is a fixed-UID image
# (postgres, uid 70 in this ALPINE image — not 999, which is the Debian
# `postgres:16`; this was the second of P106's two "999" slips and the
# conclusion below is unaffected by which number it is) that the host-side
# owner/group of the store file cannot match, and the store DIRECTORY stays
# 0700, so the widened FILE mode does not widen host access.
#
# expose_env (S4.19) is ciu's own "discouraged" escape hatch and is used
# here only because the Mattermost image forces it: it is minimal (no
# /bin/sh at all, verified live), so the S4.18 entrypoint-wrapper that
# would read /run/secrets in-container cannot run, and Mattermost has no
# *_FILE form for its SQL datasource. Postgres still consumes the FILE;
# only the app service gets the env copy.
[mattermost.secrets]
postgres_password = { directive = "GEN_LOCAL:mattermost/postgres_password", mode = "0444", expose_env = "MM_DB_PASSWORD" }
# The system-admin account's password. Generated and stored by ciu so the
# provisioning step (README) never invents a credential by hand and never
# commits one; `consumed_by = "hook"` tells S4.20 this one is deliberately
# consumed OUTSIDE compose (by `docker exec ... mmctl`), so its
# "declared but unconsumed" warning stays meaningful for real mistakes.
mattermost_admin_password = { directive = "GEN_LOCAL:mattermost/admin_password", consumed_by = "hook" }
# nyxloom-P107: the three non-bootstrap accounts. Same shape and same
# `consumed_by = "hook"` reason as the admin password — they are consumed by
# `hooks/post_compose_provision.py` via `docker exec ... mmctl`, never by
# compose. GEN_LOCAL is "created once, then stable", which is what makes the
# provisioning hook safe to re-run: the value it would set is the value the
# account already has.
mattermost_daemon_password = { directive = "GEN_LOCAL:mattermost/daemon_password", consumed_by = "hook" }
mattermost_operator_password = { directive = "GEN_LOCAL:mattermost/operator_password", consumed_by = "hook" }
mattermost_installer_password = { directive = "GEN_LOCAL:mattermost/installer_password", consumed_by = "hook" }
# nyxloom-P109: the intake chatbot account. Same shape and same reason as the
# three above. The account's PAT is NOT declared here and could not be — it
# does not exist until Mattermost mints it, which is what S9.4a is for; see
# [[mattermost.provision.tokens]] below.
mattermost_intake_password = { directive = "GEN_LOCAL:mattermost/intake_password", consumed_by = "hook" }

# ── Provisioning (S9.1 post_compose hook) — nyxloom-P107 ────────────────────
# Replaces the manual `mmctl` recipe P106's README carried. The hook is
# idempotent by construction: every mutating step is guarded by a state probe,
# so it runs on EVERY `ciu up` and converges rather than duplicating. Read the
# module docstring for why a hook beats a one-shot init container here (the
# short version: S9.4a is the only sanctioned way to get a minted webhook id
# back into the secret store, and `mmctl --local` needs the app container's
# own local-mode socket, which is not on a shared volume).
[mattermost.hooks]
post_compose = ["hooks/post_compose_provision.py"]

[mattermost.provision]
team = "nyxloom"
team_display_name = "nyxloom"

# `alerts` already exists (P106). `installs` is new: the separate channel the
# 3rd-party service account posts host-provisioning progress into.
#
# `alerts` IS private as of the go-public cutover (2026-09-09) — README.md
# step 2b's decision point, resolved Option A ("close it") by the operator.
# nyxloom-P110 had measured what leaving it public cost: ANY team member
# browsed and joined it (`GET .../posts` 200, `POST .../members` 201 as
# `nyxloom-installer`, an account deliberately excluded from it), which made
# the comment on that account below — a compromised install host "cannot read
# nyxloom's own operator traffic" — weaker than it read.
#
# P110 itself could not flip it, for a mechanical reason: this hook only ever
# CREATES channels, so `private = true` alone changes nothing about an
# ALREADY-EXISTING channel. Closing it therefore took both halves, in the same
# pass — `mmctl --local channel modify nyxloom:alerts --private` against the
# live instance (done; installer read went 200 -> 403, no members dropped,
# the daemon webhook still delivers), and this flag, which exists purely so a
# future fresh create comes up private too. Same shape as `intake` below.
#
# `installs` stays PUBLIC deliberately: it is the channel the third-party
# install host posts INTO, its webhook is post-only, and it carries no
# operator traffic.
[[mattermost.provision.channels]]
name = "alerts"
display_name = "Alerts"
private = true

[[mattermost.provision.channels]]
name = "installs"
display_name = "Host Installs"

# nyxloom-P109 (B9): the feature-intake interview's own channel.
#
# PRIVATE, and that is the security boundary, not decoration. Measured on
# 11.10.1 with a plain `system_user` account: a team member who is NOT a
# channel member reads a PUBLIC channel's posts (HTTP 200) and is REFUSED on
# a PRIVATE one (HTTP 403). Since the intake account holds a personal access
# token that inherits its account's FULL permissions, "which channels is that
# account a member of" is the only thing bounding what a leaked token can
# read — and on a public channel that bound would be "the whole team".
#
# This is also the first use of `private = true` from the shipped config
# surface. `_channel_names`' ` (private)` suffix handling (P107) was written
# for exactly this and had never been exercised live; it was re-verified
# against a throwaway 11.10.1 instance during P109 and prints, as it says,
# `intake (private)`.
[[mattermost.provision.channels]]
name = "intake"
display_name = "Feature Intake"
private = true

# ── Accounts ───────────────────────────────────────────────────────────────
# ORDER MATTERS on an EMPTY instance and nowhere else: Mattermost promotes the
# FIRST-EVER account on a server with no users to `system_admin` (measured on
# 11.10.1 — account #1 comes out `system_admin system_user`, account #2 plain
# `system_user`). `nyxloom-admin` is listed first so that promotion lands on
# the account that is *supposed* to be the bootstrap administrator. The hook
# also strips the role from any account it creates that declares
# `system_admin = false` and got promoted anyway, so this ordering is a
# belt-and-braces preference, not the only guard — but relying on the strip
# alone would mean deliberately mis-provisioning and then repairing.
#
# `nyxloom-admin` IS declared, reversing P107's decision to leave it out
# (nyxloom-P110). Two measured reasons, not a change of taste:
#   * The operator's requirement is "our 4 users are created on fresh stack
#     create". Measured on a genuinely empty instance, P107's config produced
#     THREE: nothing creates `nyxloom-admin`, so it existed only as an
#     artefact of P106's manual bootstrap on the live server. On any rebuild —
#     including a `ciu up --reset` — it would simply have been gone.
#   * `mattermost_admin_password` is declared with `consumed_by = "hook"`,
#     which is S4.20's marker for "deliberately consumed outside compose". No
#     hook step consumed it. The marker was suppressing an accurate warning.
# P107's actual concern is preserved intact: the hook still never TOUCHES an
# account that already exists — no password is re-sent and no role revoked —
# so on the live instance this entry reconciles to a no-op.
[[mattermost.provision.accounts]]
username = "nyxloom-admin"
email = "admin@nyxloom.local"
password_secret = "mattermost_admin_password"
channels = ["alerts"]
system_admin = true

# nyxloom's own daemon posts as a REGULAR account with its own webhook,
# replacing P106's `override_username` display trick — a real identity, a
# credential of its own, and no system-admin rights on the thing that only
# ever needs to POST.
[[mattermost.provision.accounts]]
username = "nyxloom-daemon"
email = "daemon@nyxloom.local"
password_secret = "mattermost_daemon_password"
channels = ["alerts"]
system_admin = false

# The human operator account. `system_admin = true`: "operator admin" is an
# account that ADMINISTERS the server — the role `nyxloom-admin` has been
# doing by accident — and the literal requirement ("access to all channels")
# is met separately and explicitly by `all_channels`, because system-admin
# alone does NOT make you a member of a private channel; it only lets you
# manage one from the console.
[[mattermost.provision.accounts]]
username = "nyxloom-operator"
email = "operator@nyxloom.local"
password_secret = "mattermost_operator_password"
all_channels = true
system_admin = true

# The 3rd-party service account: scripts/netcup + scripts/debian-install-v2
# host-installation progress. Scoped to `installs` ONLY — it is deliberately
# not a member of `alerts`, so a compromised install host cannot read nyxloom's
# own operator traffic. (The blast radius that actually matters is its webhook
# URL, which is post-only and targets `installs` alone.)
[[mattermost.provision.accounts]]
username = "nyxloom-installer"
email = "installer@nyxloom.local"
password_secret = "mattermost_installer_password"
channels = ["installs"]
system_admin = false

# nyxloom-P109 (B9): the feature-intake chatbot's identity. A FIFTH account
# rather than reuse, on the same boundary logic P107 used for
# `nyxloom-installer` — team membership plus channel scoping, not "which
# account posts".
#
# What is new here is a capability none of the other four has: this is the
# only account that READS. Its personal access token is a bearer credential
# that inherits the account's FULL permissions (Team Edition has no
# per-token scoping), so the account IS the scope, and each alternative
# fails on exactly that:
#   nyxloom-operator  — system_admin. A leaked PAT would be a system-admin
#                       bearer token on a service headed for public
#                       exposure. Not a candidate.
#   nyxloom-daemon    — a PAT here could read all of `alerts` (decision
#                       pushes, budget figures, operator traffic) and POST
#                       as the daemon, i.e. forge notifications. It also
#                       fuses the notification identity with the
#                       conversational one.
#   nyxloom-installer — scoped to `installs` for a third party; giving the
#                       install-host credential a second, unrelated
#                       capability is the opposite of what it is for.
#   nyxloom-admin     — system_admin, and disqualified for exactly the same
#                       reason `nyxloom-operator` is. (P109 gave a different
#                       reason — "the bootstrap account this hook deliberately
#                       never touches" — which nyxloom-P110 made untrue by
#                       declaring it above. The CONCLUSION is unchanged and
#                       actually stronger: it is not a candidate because of
#                       what it CAN DO, not because of what the hook does or
#                       does not manage.)
# So: regular (never system_admin), member of `intake` and nothing else.
# A leaked intake PAT can read and post in one private channel it was
# already conversing in, and can do nothing else.
[[mattermost.provision.accounts]]
username = "nyxloom-intake"
email = "intake@nyxloom.local"
password_secret = "mattermost_intake_password"
channels = ["intake"]
system_admin = false

# ── Incoming webhooks ──────────────────────────────────────────────────────
# Two, not three: the operator account is a HUMAN login and has nothing to
# post programmatically. Minting an unused credential would be strictly worse
# than not having one. The URLs are persisted by the hook via S9.4a into the
# STACK store (<stack>/.ciu/secrets/<name>) — a different directory from the
# GEN_LOCAL passwords above, which live in the PROJECT store
# (<ciu-root>/.ciu/secrets/mattermost/). Both are gitignored by `**/.ciu/`.
[[mattermost.provision.webhooks]]
secret = "daemon_webhook_url"
channel = "alerts"
user = "nyxloom-daemon"
display_name = "nyxloom-daemon"
description = "nyxloom operator notifications"
# nyxloomd reaches Mattermost over the stack's private bridge, so the internal
# address is correct whether or not the stack is publicly exposed.
url_base = "internal"

[[mattermost.provision.webhooks]]
secret = "installer_webhook_url"
channel = "installs"
user = "nyxloom-installer"
display_name = "host-installer"
description = "scripts/netcup + debian-install-v2 host installation progress"
# Tracks MM_SERVICESETTINGS_SITEURL. While `expose_public = false` that is the
# internal address, so this URL is NOT yet reachable from an install host —
# the credential is provisioned and waiting, and becomes usable in the same
# edit that flips `expose_public`. Said out loud in the README too.
url_base = "siteurl"

# nyxloom-P109 (B9): the intake bridge's REPLY path. Three webhooks now, and
# the third is not a contradiction of the "the operator account is a human
# login and gets none" rule above — `nyxloom-intake` is a service account
# that genuinely posts. It exists because a Mattermost incoming webhook is
# bound to ONE channel at creation: the daemon's webhook can only ever write
# into `alerts`, so an intake reply has no way to reach `intake` without a
# webhook of its own. (This is the same one-channel-per-webhook constraint
# decision_chat's docstring records as the reason its two logical channels
# collapsed to one.)
#
# The reply path is a webhook, NOT the PAT, even though the PAT could post:
# a webhook is post-only and channel-bound, so the reply path cannot be used
# to read anything or to write anywhere else. Keeping the two directions on
# two credentials is what makes that true.
[[mattermost.provision.webhooks]]
secret = "intake_webhook_url"
channel = "intake"
user = "nyxloom-intake"
display_name = "nyxloom-intake"
description = "nyxloom feature-intake chatbot replies (B9)"
# nyxloomd/the CLI reach Mattermost over the stack's private bridge.
url_base = "internal"

# ── Personal access tokens (nyxloom-P109 / B9) ─────────────────────────────
# The `rest` read transport's credential. Minted by the hook through S9.4a
# for the same reason as the webhook URLs: it does not exist until Mattermost
# mints it, so no S4 directive can express it. Lands in the STACK store at
# `nyxloom/mattermost/.ciu/secrets/intake_pat`, 0440, gitignored by `**/.ciu/`.
#
# REQUIRES `[mattermost].enable_user_access_tokens = true` (which drives
# MM_SERVICESETTINGS_ENABLEUSERACCESSTOKENS). While that is false this entry
# is INERT BY DESIGN, not broken: `_ensure_tokens` prints the names it is not
# minting and returns, so this table can ship — and the account, channel and
# reply webhook can be provisioned — before the operator decides to widen the
# server. Exactly the "provisioned and waiting" shape `installer_webhook_url`
# already has against `expose_public`. The measured evidence for why the flip
# is genuinely unavoidable (the bot-account exemption is unreachable from
# local mode) is in the hook's module docstring.
#
# `description` is the deduplication key the hook matches on, so it is stable
# and must not be edited casually: changing it makes the next `ciu up` mint a
# SECOND token and leave the first live.
#
# `expires_in` is deliberately unset. An expiring token would silently break
# the bridge between two `ciu up` runs, and there is no daemon to notice; a
# revoked token vanishes from `token list` entirely, so the hook self-heals
# on the next run either way. Set it (e.g. "90d") only alongside a schedule
# that actually re-runs provisioning.
[[mattermost.provision.tokens]]
secret = "intake_pat"
user = "nyxloom-intake"
description = "nyxloom-intake-bridge"

[mattermost.health]
# Mattermost's first boot runs the full schema migration before /api/v4/ping
# answers; start_period is sized for that, not for a steady-state restart.
interval = "20s"
timeout = "10s"
retries = 6
start_period = "120s"

[mattermost.logging]
max_size = "10m"
max_file = "3"

# ── Resource governance (ciu S15) ───────────────────────────────────────
# S15.10: this table is SHALLOW-MERGED over the root's top-level
# [governance] (../ciu.global.defaults.toml.j2), last-wins — `enabled`,
# `cgroup_parent` (dev-background.slice) and `device` (/dev/vda) inherit and
# MUST NOT be restated here. (Restating one key no longer drops the rest:
# CIU-13, fixed 2026-08-03.)
#
# The compose template deliberately emits NO cgroup_parent/mem_limit/cpus
# for the app service: ciu never overwrites a key the author already set
# (S15.3), which is exactly how the live ntfy container ended up pinned to
# a fictional `nyxloom.slice` and running unconfined for weeks (NL-6).
#
# mem_limit 2g: Mattermost's own hardware guidance for a small deployment is
# 1 vCPU / 2GB RAM for the whole machine, of which the server process is the
# bulk; this host is SHARED with a live production game server (8 cores,
# has hit load 85 from uncapped containers), so the ceiling is set at that
# documented figure rather than above it. Interim value pending real
# docker-stats measurement, exactly like nyxloomd's (NL-11).
# mem_swap_limit is Docker's COMBINED mem+swap total (S15.1), i.e. 2g RAM +
# 16g swap headroom on this swap-rich dev tier.
# cpus 1.5: explicit, because ciu never defaults a CPU cap (S15.21) and an
# uncapped Go server on a shared host is the load-85 failure mode.
[mattermost.governance]
mem_limit = "2g"
mem_swap_limit = "18g"
cpus = "1.5"
