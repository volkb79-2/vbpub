  "known_gaps": [
    {
      "wait": "dispatch-skip:no-healthy-route",
      "scenarios": ["provider_pause"],
      "owner": "CR-08",
      "detail": "A queued task whose tier has no healthy route neither progresses nor parks in an operator-visible state: it stays QUEUED and the only record is a per-pass reconcile trace breadcrumb. Durable route health (CR-08) plus the operator trace (CR-14) must give this wait a persisted, bounded form."
    },
    {
      "wait": "operator-signalled-retry",
      "scenarios": ["merge_conflict"],
      "owner": "CR-05",
      "detail": "After an auto-merge conflict emits NEEDS_OPERATOR the task stays MERGE_READY and every subsequent pass re-plans AutoMergeTask, so the conflict is retried indefinitely with no backoff and no durable wait state. The CR-05 effect boundary must record the failed effect and stop re-planning it unchanged."
    }
  ],
