# ==========================================================================
# nyxloom — CIU ROOT global (multi-stack). nyxloom is a ciu root; its stacks
# (ntfy, controller) live in subdirectories and inherit this global.
# ntfy never terminates TLS (tls-edge does, via ingress_public) and the
# controller is a loopback/host-network admin daemon — neither needs certs
# or an FQDN of its own.
# ==========================================================================

[deploy]
project_name = "nyxloom"
# $INSTANCE_ID (S3.2 $VAR expansion), not a fixed literal. This root's
# `environment_tag` was "prod" until 2026-09-10 -- deliberately, on the
# mistaken belief this devcontainer checkout WAS the real production
# deployment. It is not: this is dev, and a fixed environment_tag collided
# with the primary checkout's live containers from any `ciu worktree`
# (CIU-104, live-reproduced against nyxloom-prod-mattermost). Matches
# dstdns's own convention and vbpub/pwmcp + vbpub/topos (both migrated the
# same day, commit 28a70b24). A REAL dedicated-host production deployment
# of nyxloom would set its own fixed environment_tag deliberately, the way
# this file used to -- that is a different, not-yet-existing checkout, not
# this one.
environment_tag = "$INSTANCE_ID"
network_name = "$DOCKER_NETWORK_INTERNAL"
log_level = "INFO"

# Hostdir ownership values (ciu S6/S7), expanded from ciu.env.
[deploy.env.shared]
CONTAINER_UID = "$CONTAINER_UID"
CONTAINER_GID = "$DOCKER_GID"
DOCKER_GID = "$DOCKER_GID"

# The stacks under this root. `ciu up` (default profile) brings these up.
# nyxloom-P106 / NL-17: `mattermost` is the notification channel now; `ntfy`
# moved to the `legacy` profile below rather than being deleted, so a bare
# `ciu up` no longer restarts the container the operator deliberately stopped.
# Registration here is not just cosmetic: a single-stack `ciu up --dir` runs
# NEITHER the producer preflight NOR the S15.12 named-slice existence check —
# and a slice systemd does not know fails OPEN to an unbounded cgroup (NL-6).
[deploy.profiles.default]
stacks = ["mattermost", "nyxloomd"]

# Retired but intact (operator: "deactivate paths to it, do not delete it").
# Bring it back with `ciu up --profile legacy` or `ciu up --dir nyxloom/ntfy`.
[deploy.profiles.legacy]
stacks = ["ntfy"]

# Optional tooling, deliberately OUTSIDE the default up/down waves — the operator's
# "shared dev-tool, like a skywalking instance" property. pwmcp-instance is nyxloom's
# own browser / UI-testing service (Playwright-as-a-Service). A default `ciu up` /
# `ciu down` (default profile above) never touches it; bring it up explicitly with
# `ciu up --profile tools` or `ciu up --dir pwmcp-instance`.
[deploy.profiles.tools]
stacks = ["pwmcp-instance"]

# Resource governance (ciu S15.10). Copied per root; RETIRED by ciu v8's
# `[ciu] inherit` (SPEC-V8 draft.5 S3.1.5), which lets one vbpub-root file
# carry this for every subproject. v7 roots are islands -- nothing inherits
# between vbpub/nyxloom, vbpub/pwmcp and dstdns -- so until then each root
# declares its own. See nyxloom-P103 / backlog NL-6.
#
# cgroup_parent is EXPLICIT, never "": ciu has no hardcoded slice default, so
# "" falls back to the AMBIENT $CGROUP_PARENT_DEV_BACKGROUND -- which IS set in
# this devcontainer's process environment (devcontainer.json containerEnv), and
# is absent on other hosts and in CI, where it raises [S15.2]. Naming the slice
# here keeps the committed config host-independent instead of silently
# depending on an environment variable. dev-background.slice is the
# installed, in-use host slice; nyxloom.slice was never installed anywhere and
# a name systemd does not know fails OPEN to an unbounded transient cgroup.
# The nyxloom-*.slice units in infra/slices/ (D-G1) need an operator install
# with host root before they can be named here.
#
# device is EXPLICIT for the same fail-open reason: ciu's autodetect
# (`findmnt --target /var/lib/docker`) returns nothing under
# docker-outside-of-docker, and blkio caps would then be skipped silently.
#
# mem_limit is a first-pass ceiling only. Per D-G4
# (docs/plan-resource-governance.md) absolute limits are HOST-owned and live
# in the slice unit; the slice's MemoryMax is the real backstop, so a generous
# per-container value costs nothing. Tighten once docker-stats data exists.
[governance]
enabled = true
cgroup_parent = "dev-background.slice"
mem_limit = "2g"
device = "/dev/vda"

[ciu]
# S1.2 — independent root: refuse to run if $REPO_ROOT points elsewhere
# (this devcontainer's shell auto-sources a sibling repo's ciu.env).
standalone_root = true
require_certs = false
require_fqdn = false
auto_connect_network = false
