{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vbpub.invalid/nyxloom/schemas/spine-product-definition.schema.json",
  "title": "nyxloom spine: 2-product-definition.md frontmatter",
  "description": "Versioned features + acceptance -- the machine-diffed target (docs/spine-documents-spec.md; the F5 gap-engine diffs this against code, out of scope for F1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "product_version", "features"],
  "properties": {
    "kind": {"const": "product-definition"},
    "schema_version": {"const": 1},
    "product_version": {"type": "integer", "minimum": 1},
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "acceptance", "status"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F[0-9]{3,}$",
            "description": "Stable, unique; referenced by roadmap.milestones[].features and backlog.items[].folds_into"
          },
          "title": {"type": "string", "minLength": 1},
          "acceptance": {
            "type": "array",
            "items": {
              "oneOf": [
                {"type": "string", "minLength": 1},
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "text", "status"],
                  "description": "CR-12a: a STRUCTURED criterion -- id/text/status/evidence -- for the small subset of features migrated onto per-criterion evidence tracking. Optional per item; an item may stay a plain string.",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^F[0-9]{3,}-A[0-9]+$",
                      "description": "Stable within this feature; '<feature id>-A<n>'"
                    },
                    "text": {"type": "string", "minLength": 1},
                    "status": {
                      "enum": ["proven", "absent"],
                      "description": "Deliberately not the charter's full four-state vocabulary (absent/building/proven/degraded) -- 'building'/'degraded' have no forcing function yet; see the CR-12 split ledger row."
                    },
                    "evidence": {
                      "type": "array",
                      "items": {"type": "string", "minLength": 1},
                      "description": "Pytest node ids (e.g. 'tests/test_x.py::TestFoo::test_bar'), resolved by nyxloom.product_evidence.evidence_resolves"
                    }
                  }
                }
              ]
            },
            "minItems": 1,
            "description": ">=1 checkable criterion (EARS-style), schema-enforced (also the S2 cross-doc requirement)"
          },
          "status": {"enum": ["planned", "building", "shipped"]},
          "milestone": {
            "type": "string",
            "pattern": "^M[0-9]+$",
            "description": "Optional; which roadmap milestone delivers this feature"
          }
        }
      }
    },
    "non_goals": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
