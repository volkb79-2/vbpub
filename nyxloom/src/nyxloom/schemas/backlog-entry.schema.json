{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vbpub.invalid/nyxloom/schemas/backlog-entry.schema.json",
  "title": "nyxloom backlog entry frontmatter",
  "description": "One managed issue/feature record per file under [backlog_entries].dir (docs/backlog-entries-spec.md). The machine trusts only this frontmatter; the markdown body is human narrative. Status vocabulary extends the P28 inbox enum (open|carved|merged) with terminal states fixed|withdrawn|obsolete; merged is written ONLY by the merge auto-tick.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "id",
    "title",
    "status"
  ],
  "properties": {
    "kind": {
      "const": "backlog-entry"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-?[0-9]+$",
      "description": "<PREFIX>-<NN> recommended (CIU-41); legacy dash-less padded shapes (B001) remain valid so a migrating project keeps pointer stability."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "open",
        "carved",
        "merged",
        "fixed",
        "withdrawn",
        "obsolete"
      ]
    },
    "type": {
      "enum": [
        "feature",
        "bugfix"
      ]
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "priority": {
      "type": "integer"
    },
    "component": {
      "type": "string",
      "minLength": 1
    },
    "context_estimate": {
      "enum": [
        "small",
        "medium",
        "large"
      ]
    },
    "folds_into": {
      "type": "string",
      "minLength": 1
    },
    "filed_by": {
      "type": "string",
      "minLength": 1
    },
    "filed_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Quoted YYYY-MM-DD string -- an unquoted YAML date parses as datetime.date and must fail the schema, not silently pass."
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "spec_owner": {
      "type": "string",
      "minLength": 1
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^D-[0-9]+$"
      }
    },
    "carved_handoff": {
      "type": "string",
      "minLength": 1
    },
    "merge_commit": {
      "type": "string",
      "minLength": 1
    },
    "promoted_from": {
      "type": "string",
      "minLength": 1
    },
    "closed_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "closed_reason": {
      "type": "string",
      "minLength": 1
    }
  }
}
