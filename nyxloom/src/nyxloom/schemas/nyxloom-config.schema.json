{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vbpub.invalid/nyxloom/schemas/nyxloom-config.schema.json",
  "title": "nyxloom project config (nyxloom.toml)",
  "description": "Structural validation for a project's nyxloom.toml (or legacy .nyxloom/project.toml). Cross-file checks (refs resolution, gate id cross-references) are done by lint.lint_config, not this schema.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "project"
  ],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "handoff_globs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "default_branch": {
          "type": "string",
          "minLength": 1
        },
        "worktree_root": {
          "type": "string"
        },
        "handoff_globs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "infra_globs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "trove": {
          "type": "string",
          "minLength": 1
        },
        "reports_dir": {
          "type": "string",
          "minLength": 1
        },
        "decisions_inbox": {
          "type": "string",
          "minLength": 1
        },
        "north_star": {
          "type": "string",
          "minLength": 1
        },
        "product_definition": {
          "type": "string",
          "minLength": 1
        },
        "roadmap": {
          "type": "string",
          "minLength": 1
        },
        "backlog": {
          "type": "string",
          "minLength": 1
        },
        "archive_dir": {
          "type": "string",
          "minLength": 1
        },
        "archive_keep_visible": {
          "type": "integer",
          "minimum": 0
        },
        "agent_logs": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "argv",
          "phase",
          "timeout_seconds"
        ],
        "properties": {
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "phase": {
            "enum": [
              "implementation",
              "review",
              "pre-merge",
              "post-merge",
              "mutation"
            ]
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "asserts": {
            "type": "array",
            "items": {
              "enum": [
                "tests-pass",
                "changed-line-coverage",
                "mutation",
                "canary-verified",
                "assay-verdict"
              ]
            }
          }
        }
      }
    },
    "mutexes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "enum": [
              "project",
              "host"
            ]
          },
          "capacity": {
            "type": "integer",
            "minimum": 1
          },
          "global_alias": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_active_tasks": {
          "type": "integer",
          "minimum": 0
        },
        "ready_queue_target": {
          "type": "integer",
          "minimum": 0
        },
        "max_attempts_per_task": {
          "type": "integer",
          "minimum": 0
        },
        "merge_mode": {
          "enum": [
            "manual",
            "guarded-automatic"
          ]
        },
        "retention_days": {
          "type": "integer",
          "minimum": 0
        },
        "max_cost": {
          "type": [
            "number",
            "null"
          ]
        },
        "cost_currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "max_consecutive_zero_progress_merges": {
          "type": "integer",
          "minimum": 0
        },
        "stall_log_quiet_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "attempt_max_wall_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "max_resume_failures": {
          "type": "integer",
          "minimum": 0
        },
        "resume_progress_grace_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "reconcile_interval_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "wave_max_diffs": {
          "type": "integer",
          "minimum": 0
        },
        "http_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "carve_ahead_target": {
          "type": "integer",
          "minimum": 0
        },
        "carve_authority": {
          "enum": [
            "branch",
            "main",
            "files"
          ]
        },
        "headroom_warn": {
          "type": "integer",
          "minimum": 0
        },
        "test_health_interval_days": {
          "type": "integer",
          "minimum": 0
        },
        "gate_verify_interval_days": {
          "type": "integer",
          "minimum": 0
        },
        "gap_audit_after_changed_lines": {
          "type": "integer",
          "minimum": 0
        },
        "gap_audit_source_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pre_merge_gate": {
          "type": "boolean"
        },
        "mutation_gate": {
          "type": "boolean"
        },
        "auto_revert_failed_merge": {
          "type": "boolean"
        },
        "gate_diagnosis_after_failures": {
          "type": "integer",
          "minimum": 1
        },
        "reviewer_repair": {
          "type": "boolean"
        },
        "reviewer_repair_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verdict_audit_sample_size": {
          "type": "integer",
          "minimum": 0
        },
        "deadman_multiple": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "notify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ntfy_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "ntfy_topic": {
          "type": [
            "string",
            "null"
          ]
        },
        "notifications_topic": {
          "type": "string"
        },
        "token_env": {
          "type": "string",
          "minLength": 1
        },
        "cmd_topic": {
          "type": [
            "string",
            "null"
          ]
        },
        "feedback_topic": {
          "type": "string"
        },
        "cmd_token_env": {
          "type": "string",
          "minLength": 1
        },
        "webhook_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "push_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "digest_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "refs": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "redact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "stage": {
      "type": "object",
      "description": "Per-stage overrides (B3). Each key is a stage name; each value is that stage's config.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "concurrency": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string",
                "pattern": "^serial$"
              }
            ]
          },
          "compact_context_ratio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "compact_after_turns": {
            "type": "integer",
            "minimum": 0
          },
          "compact_hard_after_turns": {
            "type": "integer",
            "minimum": 0
          },
          "retain_merge_digests": {
            "type": "integer",
            "minimum": 0
          },
          "max_resume_failures": {
            "type": "integer",
            "minimum": 0
          },
          "max_proposal_repairs": {
            "type": "integer",
            "minimum": 0
          },
          "session": {
            "type": "string",
            "enum": [
              "fresh",
              "project-persistent"
            ]
          }
        }
      }
    },
    "backlog_entries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id_prefix"
      ],
      "properties": {
        "dir": {
          "type": "string",
          "minLength": 1,
          "description": "Trove-relative home of the managed per-entry backlog files. Default nyxloom-trove/backlog (docs/backlog-entries-spec.md)."
        },
        "id_prefix": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*$",
          "description": "The project's issue-id sequence (CIU, KI, B, ...). Entry ids are <PREFIX>-<NN>."
        }
      },
      "description": "Managed per-entry backlog (docs/backlog-entries-spec.md). Omitting the section entirely means the project does not use entries: every BLG2/BLG3 lint rule is silent."
    },
    "lint": {
      "type": "object",
      "additionalProperties": false,
      "description": "NL-3: per-project overrides of nyxloom lint's own rule thresholds. Omitting the section entirely means the project uses lint's tool-wide defaults.",
      "properties": {
        "l10": {
          "type": "object",
          "additionalProperties": false,
          "description": "Override for L10's handoff-size thresholds (src/nyxloom/lint.py's _check_l10). Either key may be omitted -- a partial override leaves the other at its tool-wide default (10000 warn / 18000 error). ProjectConfig.load additionally enforces warn_tokens < error_tokens and both > 0 at load time, failing loudly on a malformed table.",
          "properties": {
            "warn_tokens": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "error_tokens": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    }
  }
}
