# Shared by the consumer examples.  Copy next to a compose file as `.env`
# (or pass --env-file).  After `get.py install` the edge writes the same value
# to <instance>/stack/consumer.env, so a real consumer can use
#   docker compose --env-file /srv/tls-edge-instance/stack/consumer.env up -d
#
# example.test is a reserved placeholder; use your own domain.
TLS_EDGE_DOMAIN=example.test
