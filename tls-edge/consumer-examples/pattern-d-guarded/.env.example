# pattern-d-guarded/.env  (copy from .env.example; the .env file is a secret)
TLS_EDGE_DOMAIN=example.test
# user:bcrypt-hash from scripts/gen-guard-secret.sh.  Keep the SINGLE QUOTES:
# they stop Compose from interpolating the `$2y$12$...` segments.
# The value below is a syntactically valid placeholder hash, not a credential.
GUARD_HASH='user:$2y$12$abcdefghijklmnopqrstuuABCDEFGHIJKLMNOPQRSTUVWXYZ0123456'
