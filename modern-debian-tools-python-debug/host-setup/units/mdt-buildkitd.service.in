# RENDERED by host-setup/install.sh from host-setup.env — do not edit the
# installed copy; edit /etc/mdt/host-setup.env and re-run install.sh.
#
# Runs a rootless BuildKit worker AS A CONTAINER via a plain `docker run`
# (never through `buildx create` / any Buildx driver) — Buildx's own
# `cgroup-parent` driver-opt does not reliably place a `docker-container`
# builder under a named slice with Docker's systemd cgroup driver
# (source-verified, docs/BUILD-ARCHITECTURE.md); a plain `docker run
# --cgroup-parent=...` places correctly (verified live, see
# plan-buildkitd-service.md §0). Buildx then reaches this worker via its
# `remote` driver over the Unix socket this unit exposes at
# /run/mdt-buildkitd/buildkitd.sock (see templates/devcontainer.json for the
# consumer-side bind-mount).
#
# `docker run` (foreground, no -d) AS ExecStart= is systemd's own
# established pattern for supervising a container — Restart= gives crash
# recovery for free, and a config change just needs `systemctl restart`
# after re-running install.sh. No bespoke drift-detection script.
#
# Rootless image variant (not a hand-rolled privilege setup): a build daemon
# executes arbitrary Dockerfile RUN content, so rootless is the meaningfully
# safer default, not merely a tolerable one. Cgroup placement/accounting is
# unaffected either way — enforced by the kernel on the outer cgroup
# regardless of the UID of processes inside it. The --device /dev/fuse
# --security-opt seccomp=unconfined --security-opt apparmor=unconfined trio
# is the SAME relaxation the mdt devcontainer already grants itself, for the
# identical FUSE (fuse-overlayfs) reason — not a new category of exposure.
#
# --oci-worker-no-process-sandbox: without it, every RUN step's nested runc
# fails with "error mounting proc to rootfs ... operation not permitted"
# (verified live, 2026-08-04) — the container's own unprivileged user
# namespace can't recursively unshare a second one for the per-exec mount
# namespace under this host's runc/kernel combination, even with
# unprivileged_userns_clone=1 and seccomp/apparmor unconfined. This is
# buildkit's own documented flag for exactly "running as an unprivileged
# user" (its startup warning names this case explicitly), not a workaround
# outside the rootless design — trades per-RUN-step process isolation
# (a build step could in principle signal another process in the same
# worker) for working nested execution at all, which for a shared,
# non-multi-tenant dev builder is the correct trade.
[Unit]
Description=mdt host-setup — host-managed BuildKit worker (dev-buildkitd.slice)
Documentation=file:/etc/mdt/host-setup.env
After=docker.service
Wants=docker.service

[Service]
Type=simple
# Creates /run/mdt-buildkitd before ExecStart, removes it after — /run is
# tmpfs, so this must happen every boot; RuntimeDirectory= does it natively
# instead of a one-shot mkdir in install.sh that would only apply to the run
# install.sh itself happened in.
#
# RuntimeDirectoryMode=0777 is required, not just permissive: this unit has
# no User=/Group=, so RuntimeDirectory='s default mode (0755, root:root)
# only lets ROOT write into it — but the container that mounts it is the
# ROOTLESS buildkit image (deliberately, see above), whose buildkitd process
# runs as uid 1000 inside its OWN, unrelated user namespace (no
# --userns-remap on this `docker run`, so that uid is exactly what the HOST
# kernel sees on the bind-mounted directory too). Without 0777, buildkitd
# fails at startup: "listen unix /run/buildkit/buildkitd.sock: bind:
# permission denied" (verified live). The directory holds nothing but this
# one socket for this one container's lifetime, so world-writable here
# carries no meaningful exposure beyond what local docker-group access
# already grants.
RuntimeDirectory=mdt-buildkitd
RuntimeDirectoryMode=0777
# Clear any stale container from an unclean shutdown before starting fresh
# (the "-" prefix makes a failure here non-fatal — nothing to clear is fine).
ExecStartPre=-/usr/bin/docker rm -f mdt-buildkitd
ExecStartPre=-/usr/bin/docker pull @DEV_BUILDKITD_IMAGE@
ExecStart=/usr/bin/docker run --rm --name mdt-buildkitd \
  --cgroup-parent=dev-buildkitd.slice \
  --device /dev/fuse \
  --security-opt seccomp=unconfined \
  --security-opt apparmor=unconfined \
  -v /run/mdt-buildkitd:/run/buildkit \
  -v mdt-buildkitd-cache:/home/user/.local/share/buildkit \
  @DEV_BUILDKITD_IMAGE@ \
  --addr unix:///run/buildkit/buildkitd.sock \
  --oci-worker-no-process-sandbox
ExecStop=/usr/bin/docker stop -t 30 mdt-buildkitd
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
