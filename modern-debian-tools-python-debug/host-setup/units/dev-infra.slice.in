# RENDERED by host-setup/install.sh from host-setup.env — do not edit the
# installed copy; edit /etc/mdt/host-setup.env and re-run install.sh.
[Unit]
Description=host-level dev infrastructure daemons that observe and act (cgprofile-host-daemon)
Before=slices.target

[Slice]
# NOTE: no explicit parent directive — systemd derives nesting from the
# dash-separated name: "dev-infra.slice" nests under "dev.slice" automatically
# once dev.slice.in is also installed, same mechanism as
# dev-interactive.slice/dev-background.slice/dev-memory_min_guaranteed.slice.
# SIBLING of those, not a child of any of them. See
# run-gate-project/nyxloom-trove/DESIGN-2026-09-12-liveness-placement-admission.md
# D-18/D-19/D-24 for the full design; CGROUP-NOTES.md "Per-container
# memory.min guarantees" for the ancestor-chain mechanism this MemoryMin
# depends on.

# A small, always-ON floor (NOT opt-in like dev-memory_min_guaranteed.slice's
# ceiling below) for the daemon's own cgroup against zswap-refault thrashing
# when the rest of the estate is under pressure — the daemon is the estate's
# liveness oracle (D-18) and must keep sampling even then. At container start
# the daemon itself (root, cgroupns=host) also declares memory.min on its OWN
# leaf cgroup under here — D-18: "the only way a floor is real on this host."
# Like dev-memory_min_guaranteed.slice, this number is only effective if
# dev.slice hands down enough of its own MemoryMin to cover it: see
# units/dev.slice.in, which sums this value with
# DEV_MEMORY_MIN_GUARANTEED_CEILING at render time (never a third,
# independently-set value — same anti-drift discipline as that section).
MemoryMin=@DEV_INFRA_MEMORY_MIN@
MemoryHigh=@DEV_INFRA_MEMORY_HIGH@
MemoryMax=@DEV_INFRA_MEMORY_MAX@
CPUWeight=@DEV_INFRA_CPU_WEIGHT@
# See CGROUP-NOTES.md §BFQ before raising above 100 on a BFQ host — this
# stays <= 100 so the ratio against the other tiers is the number it looks
# like, not silently compressed.
IOWeight=@DEV_INFRA_IO_WEIGHT@

# Deliberately NO ManagedOOM* here: the daemon is the estate's liveness
# oracle (D-18) and cgroup actuator (D-20/D-25) — killing it removes
# liveness AND placement for every lane at once, strictly worse than letting
# MemoryHigh throttle it. Mirrors dev-interactive.slice's "never OOM-kill"
# choice, for a different reason (there: don't kill the IDE; here: don't
# kill the estate's only liveness oracle).
#
# Containers join via an explicit `docker run --cgroup-parent=dev-infra.slice`
# (cgprofile-host-daemon's own compose/run invocation — see
# scripts/cgroup-profiler/, out of this project's scope) or
# $CGROUP_PARENT_DEV_INFRA exported into whatever creates the daemon
# container (D-24: unset → falls back to dev-interactive.slice, today's
# placement). No Docker daemon-wide fallback into this tier — landing here
# must always be a deliberate, per-daemon choice, same reasoning as
# dev-memory_min_guaranteed.slice below.
