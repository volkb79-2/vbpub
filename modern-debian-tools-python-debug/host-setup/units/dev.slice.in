# RENDERED by host-setup/install.sh from host-setup.env — do not edit the
# installed copy; edit /etc/mdt/host-setup.env and re-run install.sh.
[Unit]
Description=Dev/build/interactive estate — one absolute IOPS/bandwidth ceiling for everything below it
Before=slices.target

[Slice]
# Root parent for dev-interactive.slice + dev-background.slice + dev-gates.slice +
# dev-memory_min_guaranteed.slice + dev-buildkitd.slice (systemd derives the
# nesting from the dash-separated names — no parent directive needed on any
# child). IO/CPU/swap ceilings and (see below) the guaranteed-tier's MemoryMin
# live here (host dev-tier cgroup governance rollout); CPUWeight/memory-high/
# max/OOM policy stay per-child, since interactive and background work
# genuinely need different shapes there. IO/CPU/swap are different — even
# interactive/IDE activity must not be able to starve production, so ONE
# absolute cap bounds every child COMBINED rather than being duplicated (and
# potentially summed past a safe total) on each separately. Every child ALSO
# carries its OWN tighter ceiling for these three so no single tier can
# alone claim this whole parent budget — see each child's own unit for its
# number; this parent number is what still binds when MULTIPLE tiers are
# busy at once.
CPUQuota=@DEV_CPU_QUOTA@
MemorySwapMax=@DEV_SWAP_MAX@
#
# MemoryZSwapWriteback does NOT inherit like MemoryMin below does — it is a
# PLAIN PER-CGROUP TOGGLE with no ancestor-chain "effective value" the way
# MemoryMin/MemoryLow have. **Setting it here does not, by itself, apply it
# to any child** (verified live 2026-09-12: writing 0 here left a leaf
# scope's own file reading 1, unaffected). What IS true, per
# CGROUP-NOTES.md "zswap writeback — who may page to disk": enforcement is
# hierarchical the OTHER direction — a 0 on ANY ancestor silently disables
# writeback for the WHOLE subtree below it, even for a child whose own file
# still reads 1. So this line is not a way to set the policy for children —
# each child needs its OWN explicit MemoryZSwapWriteback= to state its own
# intent (see each child's unit) — it exists here ONLY as a safety anchor
# against a FUTURE accident where something sets an ancestor to 0 and
# silently denies every descendant with no other symptom.
MemoryZSwapWriteback=@DEV_ZSWAP_WRITEBACK@
#
# MemoryMin below exists ONLY to back dev-memory_min_guaranteed.slice's own
# floor -- cgroup v2's ancestor-chain rule means a child's MemoryMin is
# inert unless every ancestor up to here also carries an adequate value
# (CGROUP-NOTES.md "Per-container memory.min guarantees"). It MUST stay
# exactly equal to that slice's own MemoryMin, never more: any surplus here
# beyond what the guaranteed tier actually claims leaks, via cgroup v2's
# proportional redistribution, to dev-interactive.slice and
# dev-background.slice too -- both rendered from the SAME
# DEV_MEMORY_MIN_GUARANTEED_CEILING env var for exactly this reason.
# DEV_MEMORY_MIN_GUARANTEED_CEILING is the authoritative dev.slice MemoryMin
# and is deliberately shared with dev-memory_min_guaranteed.slice. The three
# other root controls have their own DEV_MEMORY_* keys below.
MemoryMin=@DEV_MEMORY_MIN_GUARANTEED_CEILING@
MemoryLow=@DEV_MEMORY_LOW@
MemoryHigh=@DEV_MEMORY_HIGH@
MemoryMax=@DEV_MEMORY_MAX@
#
# Static boot-window fallbacks (deliberately tight — mdt-host-slices.service
# overrides them at runtime with DEV_IO_CAP_PCT% (60% by default) of the
# measured ceilings from io-baseline.env; a static unit file cannot express
# "a percentage of what this disk actually does"). If no baseline has been
# measured yet, these statics stay in force indefinitely — see
# CGROUP-NOTES.md §3.
IOReadBandwidthMax=@IO_DEV_PATH@ @DEV_STATIC_RBW@
IOWriteBandwidthMax=@IO_DEV_PATH@ @DEV_STATIC_WBW@
IOReadIOPSMax=@IO_DEV_PATH@ @DEV_STATIC_RIOPS@
IOWriteIOPSMax=@IO_DEV_PATH@ @DEV_STATIC_WIOPS@
