# RENDERED by host-setup/install.sh from host-setup.env — do not edit the
# installed copy; edit /etc/mdt/host-setup.env and re-run install.sh.
[Unit]
Description=Dev/build/interactive estate — one absolute IOPS/bandwidth ceiling for everything below it
Before=slices.target

[Slice]
# Root parent for dev-interactive.slice + dev-background.slice +
# dev-memory_min_guaranteed.slice (systemd derives the nesting from the
# dash-separated names — no parent directive needed on any child). ONLY an IO
# ceiling and (see below) the guaranteed-tier's MemoryMin live here (host
# dev-tier cgroup governance rollout): CPUWeight/memory-high/max/OOM policy
# stay per-child, since interactive and background work genuinely need
# different shapes there. IO is different — even interactive/IDE activity
# must not be able to starve production I/O, so ONE absolute cap bounds both
# tiers combined rather than being duplicated (and potentially summed past a
# safe total) on each child separately.
#
# MemoryMin below exists ONLY to back the memory.min floors declared by its
# own children -- cgroup v2's ancestor-chain rule means a child's MemoryMin
# is inert unless every ancestor up to here also carries an adequate value
# (CGROUP-NOTES.md "Per-container memory.min guarantees"). Two children
# currently declare one: dev-memory_min_guaranteed.slice (opt-in,
# DEV_MEMORY_MIN_GUARANTEED_CEILING, default unset=0) and dev-infra.slice
# (always-on, DEV_INFRA_MEMORY_MIN, default 256M -- the estate's liveness
# oracle needs a real floor even under pressure, D-18). This value MUST stay
# exactly equal to the SUM of both, never more: any surplus here beyond what
# those two tiers actually claim leaks, via cgroup v2's proportional
# redistribution, to dev-interactive.slice and dev-background.slice too --
# computed once at render time by install.sh from those same two env vars
# (never a third, independently-set number -- same anti-drift discipline as
# the two-var case this extends).
MemoryMin=@DEV_SLICE_MEMORY_MIN@
#
# Static boot-window fallbacks (deliberately tight — mdt-host-slices.service
# overrides them at runtime with DEV_IO_CAP_PCT% (60% by default) of the
# measured ceilings from io-baseline.env; a static unit file cannot express
# "a percentage of what this disk actually does"). If no baseline has been
# measured yet, these statics stay in force indefinitely — see
# CGROUP-NOTES.md §3.
IOReadBandwidthMax=@IO_DEV_PATH@ @DEV_STATIC_RBW@
IOWriteBandwidthMax=@IO_DEV_PATH@ @DEV_STATIC_WBW@
IOReadIOPSMax=@IO_DEV_PATH@ @DEV_STATIC_RIOPS@
IOWriteIOPSMax=@IO_DEV_PATH@ @DEV_STATIC_WIOPS@
