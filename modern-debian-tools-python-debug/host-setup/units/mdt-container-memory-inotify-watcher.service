# Optional mdt host-setup watcher for explicitly configured per-container
# MemoryHigh/MemoryMax values. It watches dev-interactive.slice,
# dev-background.slice, and dev-gates.slice via inotify. All shipped values
# are '-', so install.sh leaves this unit disabled unless the validated host
# config explicitly enables the policy and sets at least one value. This
# watcher applies no memory fallback when disabled; parent slice limits remain
# the aggregate control.
# The separate Docker-events watcher and periodic reconcile service manage IO.
# See scripts/mdt-container-memory-inotify-watcher.py and host-setup/README.md.
[Unit]
Description=mdt host-setup — container memory inotify watcher
Documentation=file:/etc/mdt/host-setup.env
After=docker.service mdt-dev-governance-reconcile.service
Wants=docker.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/mdt-container-memory-inotify-watcher.py
Restart=always
RestartSec=2
EnvironmentFile=-/etc/mdt/host-setup.env

[Install]
WantedBy=multi-user.target
