# mdt host-setup configuration — ALL tunables for the dev-tier slices AND
# /etc/docker/daemon.json (this file has the ONE owner now — host dev-tier
# cgroup governance rollout; do not also manage daemon.json elsewhere).
#
# install.sh copies this file to /etc/mdt/host-setup.env on first install (it
# never overwrites an existing one). Edit THAT copy, then:
#   - render-time values (slice sizes, weights, statics, timer interval,
#     daemon.json keys): re-run install.sh to re-render + reinstall.
#   - runtime values (DEV_IO_CAP_PCT, patterns, CGROUP2_FLAGS): picked up by
#     mdt-apply-dev-caps.sh on its next run — no reinstall needed.
#
# Sizing guidance: the example values below are from a 15.6Gi mixed-use host
# that also runs a production game server, with ~70G of swap available (see
# README.md "Tiering model"). Scale MemoryHigh/Max to what your host can
# spare below its production tiers — these are a starting point to review,
# not a number this project can pick for you.

## ── Device for IO caps ──────────────────────────────────────────────────────
# Block device NODE (path, not MAJ:MIN) backing the docker data dir.
# Empty = auto-discover via findmnt of /var/lib/docker, falling back to /.
IO_DEV_PATH=""

## ── dev.slice — root parent, IO/CPU/swap ceilings (render-time) ─────────────
# One absolute cap for dev-interactive.slice + dev-background.slice + every
# other child COMBINED (cgroup v2 hierarchical accounting). This is
# deliberate: even interactive/IDE activity must not be able to starve
# production, and a single ceiling is simpler to reason about than one per
# tier. Memory-high/max/OOM policy stay per-child (see below) — only IO/CPU/
# swap ceilings move to the shared parent, and every child ALSO carries its
# own tighter sub-ceiling for these same three — see each child's own
# CPU_QUOTA/MEMORY_SWAP_MAX below.
#
# Static boot-window fallbacks (deliberately tight — mdt-apply-dev-caps.sh
# replaces them with measured-baseline values as soon as it runs; without a
# baseline these stay in force, so ALL dev/build/interactive IO will crawl
# until you run/bootstrap the benchmark — see "Baseline benchmark cache" below).
DEV_STATIC_RIOPS=500
DEV_STATIC_WIOPS=500
DEV_STATIC_RBW=150M
DEV_STATIC_WBW=150M
#
# CPUQuota: auto-detected as (nproc - DEV_CPU_RESERVE_CORES)
# cores at install time when left empty, floored at 1 core — mirrors the
# existing IO_DEV_PATH/DEV_BUILDKITD_CPU_QUOTA auto-discovery convention. An
# explicit value here always overrides. Default reserves 1 core for the
# host/production regardless of how many dev-tier children are busy at once.
DEV_CPU_RESERVE_CORES=1
DEV_CPU_QUOTA=""
# Same auto-detect shape, applied to EVERY child slice's own CPUQuota below
# (each gets nproc - this many cores, tighter than the parent's own quota
# above so no single tier can alone claim dev.slice's whole budget).
DEV_SUBSLICE_CPU_RESERVE_CORES=3
#
# Swap ceiling: auto-detected from this host's real
# total swap (/proc/meminfo SwapTotal) when left empty, at DEV_SWAP_CASCADE_PCT%
# — then EVERY child slice's own MemorySwapMax auto-detects as the SAME
# percentage of THIS value (not of the host total again), and the reactive
# watcher's per-container MemorySwapMax applies the same percentage a third
# time, of whichever child's derived value matches (see "Reactive
# per-container cap watcher" below). Absolute ceiling at every level, same
# "multiple children combined still bounded by the parent" reasoning as CPU.
DEV_SWAP_CASCADE_PCT=80
DEV_SWAP_MAX=""
#
# IOPS sub-ceiling for dev-gates.slice/dev-buildkitd.slice
# specifically — see those sections below. Runtime-only (mdt-apply-dev-caps.sh
# applies it, no static unit-file line), tighter than the shared IO ceiling
# above so neither can alone claim the whole dev.slice IOPS budget. IOPS
# only, deliberately — bandwidth is left at whatever the shared ceiling
# above allows for both of them.
DEV_SUBSLICE_IOPS_PCT=60
#
# Whether the WHOLE dev tier's coldest pages may drain from zswap out to
# disk swap. See dev-interactive.slice's own DEV_INTERACTIVE_ZSWAP_WRITEBACK
# below for the yes/no tradeoff — same choice, just at the shared parent.
# IMPORTANT: this does NOT cascade to children (verified live 2026-09-12 —
# writing 0 here left a child's own file reading 1, unaffected). What IS
# true: enforcement is hierarchical the OTHER way — a 0 on ANY ancestor
# silently disables writeback for the WHOLE subtree below it. So this is
# NOT how you set the policy for children (each needs its own explicit line,
# see below) — it exists ONLY as a safety anchor against a future accident
# where something sets an ancestor to 0. Full reasoning: units/dev.slice.in's
# own MemoryZSwapWriteback comment, CGROUP-NOTES.md "zswap writeback — who
# may page to disk".
DEV_ZSWAP_WRITEBACK=yes

# Every governed slice is asked for all four cgroup-v2 memory controls. For
# dev.slice, DEV_MEMORY_MIN_GUARANTEED_CEILING (declared in the guaranteed
# sibling section below) is the one authoritative MemoryMin key and is also
# rendered on dev-memory_min_guaranteed.slice; there is intentionally no second
# root MemoryMin variable. An
# empty value means the operator explicitly chose no directive; MemoryHigh and
# MemoryMax below are live-host suggestions and should normally remain set.
# MemoryMin <= MemoryLow <= MemoryHigh <= MemoryMax is checked in KiB by the
# wizard; an empty field is not silently substituted or clamped.
DEV_MEMORY_LOW=
DEV_MEMORY_HIGH=
DEV_MEMORY_MAX=

## ── dev-interactive.slice — devcontainers + IDE (render-time) ───────────────
DEV_INTERACTIVE_MEMORY_MIN=
DEV_INTERACTIVE_MEMORY_LOW=2G
DEV_INTERACTIVE_MEMORY_HIGH=5G
DEV_INTERACTIVE_MEMORY_MAX=8G
DEV_INTERACTIVE_CPU_WEIGHT=200
# Absolute ceiling too — see DEV_SUBSLICE_CPU_RESERVE_CORES
# above; auto-detects the same way as dev.slice's own DEV_CPU_QUOTA.
DEV_INTERACTIVE_CPU_QUOTA=""
# Same swap-capacity reasoning as dev-background.slice's own, below — auto-
# detected from DEV_SWAP_CASCADE_PCT% of dev.slice's own derived ceiling
# when left empty.
DEV_INTERACTIVE_MEMORY_SWAP_MAX=""
# KEEP IO WEIGHTS <= 100 ON A BFQ HOST. systemd's IOWeight is 1..10000 but BFQ
# schedules on io.bfq.weight (1..1000); systemd maps 1..100 through unchanged
# and compresses everything above 100 by ~11x. So 100-vs-10 below is a true
# 10:1, while "improving" this to 1000-vs-10 would silently be 181-vs-10.
# Full mapping table + verification commands: CGROUP-NOTES.md §BFQ.
DEV_INTERACTIVE_IO_WEIGHT=100
# Whether this tier's coldest pages may drain out of zswap onto disk swap.
#
#   yes (default) — zswap stays a CACHE. Its LRU evicts only the coldest-of-cold
#                   to disk, which frees pool RAM for pages that are actually
#                   warm, including other tiers'. On a memory-tight host this
#                   is what keeps the pool useful rather than full of an IDE's
#                   long-idle tail.
#   no            — the tier's cold tail is pinned in compressed RAM forever.
#                   Protects against disk swap-in stalls (an IDE freeze of a
#                   few hundred ms), at the cost of permanently occupying pool
#                   RAM with pages nobody is touching.
#
# Set "no" only if you measure IDE stalls attributable to swap-in. Note the
# pool is a fixed share of RAM (zswap max_pool_percent): pinning one tier's
# cold tail there takes that RAM away from every other tier.
DEV_INTERACTIVE_ZSWAP_WRITEBACK=yes

## ── dev-background.slice — test/build/gate containers (render-time) ─────────
# Merged tier (host dev-tier cgroup governance rollout): this is BOTH the
# Docker daemon-wide fallback for anything that names no cgroup-parent at all
# (see "Docker daemon.json" below) AND the explicit convention every project's
# test/gate/build container opts into ($CGROUP_PARENT_DEV_BACKGROUND, see
# vbpub's AGENTS.md) — one slice, two ways to land in it. Only this tier gets
# OOMD protection; dev-interactive.slice (the IDE) never does.
DEV_BACKGROUND_MEMORY_HIGH=6G
DEV_BACKGROUND_MEMORY_MAX=8G
DEV_BACKGROUND_MEMORY_MIN=
DEV_BACKGROUND_MEMORY_LOW=
# Relaxed on purpose: a gate/build that swaps just finishes slowly, while one
# that OOMs fails outright. Auto-detected from DEV_SWAP_CASCADE_PCT% of
# dev.slice's own derived ceiling when left empty — see the dev.slice
# section above.
DEV_BACKGROUND_MEMORY_SWAP_MAX=""
# See the IOWeight note above: 10 vs interactive's 100 is a true 10:1 on BFQ
# only because both sides stay <= 100.
DEV_BACKGROUND_CPU_WEIGHT=20
# Absolute ceiling too — see DEV_SUBSLICE_CPU_RESERVE_CORES
# above; auto-detects the same way as dev.slice's own DEV_CPU_QUOTA.
DEV_BACKGROUND_CPU_QUOTA=""
DEV_BACKGROUND_IO_WEIGHT=10
# Relaxed on purpose, same swap-capacity reasoning as MEMORY_SWAP_MAX above:
# let sustained pressure run longer before oomd kills the worst offender in
# this tier, rather than reacting to a moderate, swap-absorbable spike.
DEV_BACKGROUND_OOM_PRESSURE_LIMIT=75%
# Cold background pages MAY be written back to disk, which is the point of
# the tier. Does NOT inherit from DEV_ZSWAP_WRITEBACK above — see that
# variable's own comment for the full non-inheritance reasoning.
DEV_BACKGROUND_ZSWAP_WRITEBACK=yes

## ── dev-gates.slice — gate and lane containers + placed lane leaves (render-time) ──
# SIBLING of dev-background.slice under dev.slice — the admission capacity
# object (D-19): every lane container and every placed lane leaf rg-<token>
# (D-20) lives here instead of sharing dev-background.slice with long-running
# dev stacks (dstdns, ...), which stay there. Filed from the 2026-08-04
# finding recorded in memory `soulmask-memory-pressure-findings.md`: gates
# used to start with only ~2 GiB of dev-background.slice's memory.high before
# throttling, behind an unrelated ~4 GiB stack. See
# run-gate-project/nyxloom-trove/DESIGN-2026-09-12-liveness-placement-admission.md
# D-19/D-20/D-25, and units/dev-gates.slice.in.
#
# Sizing below is for a 16 GiB host, defaults from the design's D-19/§3 table
# — expected to be re-tuned from admission-usage data (design doc §7).
DEV_GATES_MEMORY_HIGH=4G
DEV_GATES_MEMORY_MAX=6G
DEV_GATES_MEMORY_MIN=
DEV_GATES_MEMORY_LOW=
# Relaxed on purpose, same swap-capacity reasoning as
# DEV_BACKGROUND_MEMORY_SWAP_MAX above. Auto-detected from
# DEV_SWAP_CASCADE_PCT% of dev.slice's own derived ceiling when left empty.
DEV_GATES_MEMORY_SWAP_MAX=""
# See the IOWeight note above: keep <= 100 on a BFQ host.
DEV_GATES_CPU_WEIGHT=20
# Absolute ceiling too — see DEV_SUBSLICE_CPU_RESERVE_CORES
# above; auto-detects the same way as dev.slice's own DEV_CPU_QUOTA. This
# tier ALSO gets a runtime IOPS sub-ceiling (DEV_SUBSLICE_IOPS_PCT, dev.slice
# section above) — no separate variable here, it's applied directly by
# mdt-apply-dev-caps.sh against whatever it just measured for dev.slice.
DEV_GATES_CPU_QUOTA=""
DEV_GATES_IO_WEIGHT=10
# Independent knob from DEV_BACKGROUND_OOM_PRESSURE_LIMIT (not literally
# shared) so the two tiers can be tuned apart later; ships with the same
# default and the same reasoning: let sustained pressure run longer before
# oomd kills the worst offender in this tier, given this host's ample swap.
DEV_GATES_OOM_PRESSURE_LIMIT=75%
# Does NOT inherit from DEV_ZSWAP_WRITEBACK above — see that variable's own
# comment for the full non-inheritance reasoning.
DEV_GATES_ZSWAP_WRITEBACK=yes

## ── dev-memory_min_guaranteed.slice — individually-governed containers (render-time) ──
# SIBLING of dev-interactive.slice/dev-background.slice under dev.slice, for
# containers that need a real memory.min floor against zswap-refault
# thrashing (continuously-processing workloads sharing this host with a
# production tier — see CGROUP-NOTES.md "Per-container memory.min
# guarantees", filed from dstdns's P165 sql-mutation-gate incident, D-373).
#
# Left UNSET by default (empty = the MemoryMin directive is dropped from
# BOTH this slice and dev.slice below, per install.sh's render rule — the
# whole mechanism is inert until a host operator deliberately opts in).
#
# THE ONE RULE THAT MATTERS: MemoryMin is read by BOTH
# dev-memory_min_guaranteed.slice.in AND dev.slice.in -- the SAME variable,
# never two. The wizard asks the sibling's complete MemoryMin/MemoryLow/
# MemoryHigh/MemoryMax sequence; only MemoryMin is shared, while the other
# three are sibling-local controls. Setting the shared value any higher than
# what containers actually placed in
# this slice currently claim leaks the surplus to dev-interactive.slice and
# dev-background.slice via cgroup v2's proportional redistribution (see the
# CGROUP-NOTES.md section for the full mechanism and the accepted, bounded
# residual leak when the slice is under-utilized relative to this ceiling).
# Measure the real hot-set size before choosing a number (scripts/damon-analysis
# + scripts/cgroup-profiler's `--damon` flag, ATTACH-GUIDE.md §6) rather than
# guessing -- soulmask_tmpfs.slice's own T1 floor was corrected 250M->30M
# after measurement showed the initial estimate was 8x too generous; treat
# any number here the same way. Keep it small: this host had ~367M genuinely
# free under normal production load at time of writing (D-373).
DEV_MEMORY_MIN_GUARANTEED_CEILING=
DEV_MEMORY_MIN_GUARANTEED_LOW=
DEV_MEMORY_MIN_GUARANTEED_HIGH=
DEV_MEMORY_MIN_GUARANTEED_MAX=

## ── dev-buildkitd.slice — host-managed BuildKit worker (render-time) ────────
# A SIBLING of dev-interactive.slice/dev-background.slice under dev.slice,
# not nested under either — see plan-buildkitd-service.md §1 for why (one
# shared, long-lived builder serving every project, not a per-invocation
# background job). Runs as a plain `docker run --cgroup-parent=
# dev-buildkitd.slice` container (mdt-buildkitd.service), never through
# Buildx's own driver machinery — Buildx's `cgroup-parent` driver-opt does
# not reliably place a container with Docker's systemd cgroup driver
# (source-verified, docs/BUILD-ARCHITECTURE.md); a plain `docker run
# --cgroup-parent=...` does (verified live, see plan-buildkitd-service.md
# §0). Reached from the devcontainer via a Unix socket bind-mount — see
# templates/devcontainer.json's mandatory BUILDKIT_HOST and socket mount.
#
# Every memory control is represented explicitly below. Leave a value empty
# only when the operator chooses the documented "none" state; install.sh then
# drops that one directive rather than inventing a limit. The wizard rejects
# MemoryMin > MemoryLow > MemoryHigh > MemoryMax and aggregate violations.
# Other resource settings below are OPTIONAL: leave a value empty and install.sh drops
# that directive from the rendered unit entirely — "not set" means "not
# applied," not "apply some fallback number" (install.sh's render() strips
# any line that resolves to a bare `Key=`). Concurrency: this needs to cover
# CONCURRENT multi-project builds (mdt release, pwmcp, anything else that
# adopts the shared builder), not just one build at a time — size
# accordingly, these are starting points to review like every other tier.
DEV_BUILDKITD_MEMORY_MIN=
DEV_BUILDKITD_MEMORY_LOW=
DEV_BUILDKITD_MEMORY_HIGH=6G
DEV_BUILDKITD_MEMORY_MAX=10G
# Auto-detected from DEV_SWAP_CASCADE_PCT% of dev.slice's own derived
# ceiling when left empty — see the dev.slice section above.
DEV_BUILDKITD_MEMORY_SWAP_MAX=""
# See the IOWeight note above: keep <= 100 on a BFQ host. A running build IS
# latency-sensitive to whoever is waiting on it (unlike dev-background.slice's
# idle soak work), so this sits between interactive's 100 and background's 10.
DEV_BUILDKITD_CPU_WEIGHT=50
DEV_BUILDKITD_IO_WEIGHT=50
# Does NOT inherit from DEV_ZSWAP_WRITEBACK above — see that variable's own
# comment for the full non-inheritance reasoning.
DEV_BUILDKITD_ZSWAP_WRITEBACK=yes
# Hard CPU cap (CPUQuota, not just proportional share) — DIFFERENT rule from
# every other setting in this section: empty here does NOT mean "not
# applied" — it means "auto-detect (nproc - DEV_SUBSLICE_CPU_RESERVE_CORES)
# cores at install time" (dev.slice section above), floored at 1 core. An
# explicit percentage (e.g. "400%" = 4 cores) always overrides the
# auto-detected value; every sibling child slice gets the same treatment.
# This tier ALSO gets a runtime IOPS sub-ceiling (DEV_SUBSLICE_IOPS_PCT,
# dev.slice section above) — no separate variable here, it's applied
# directly by mdt-apply-dev-caps.sh against whatever it just measured for
# dev.slice.
DEV_BUILDKITD_CPU_QUOTA=""
# One shared BuildKit version for every consumer of this builder (decided —
# see plan-buildkitd-service.md §2): cmru itself isn't version-sensitive,
# but an individual project's Dockerfile is capped at whatever BuildKit
# features this one pinned version supports. Rootless variant: a build
# daemon executes arbitrary Dockerfile RUN content, so this is the
# meaningfully safer default, not merely a tolerable one — see
# plan-buildkitd-service.md §2 for the root-vs-rootless tradeoffs.
DEV_BUILDKITD_IMAGE="moby/buildkit:buildx-stable-1-rootless"

## ── accidental Buildx worker policy (render/install-time) ──────────────────
# The host-managed service is the only normal BuildKit worker. Buildx's
# docker-container driver creates buildx_buildkit_* (or buildkit_buildkit_*)
# containers outside that service, so the event-driven guard treats them as
# unapproved workers after Docker inspect verifies their identity.
#
# Closed vocabulary:
#   terminate  — remove an unapproved BuildKit worker (the default policy)
#   report-only — log the decision and leave it running
BUILDX_ACCIDENTAL_CONTAINER_POLICY=terminate

## ── Runtime caps — mdt-apply-dev-caps.sh (re-read every run) ────────────────
# Both percentages are of the MEASURED device ceilings in io-baseline.env, and
# both belong in the 60-80% band. Never cap at 100%: a device driven to
# saturation queues everything, and the whole point of the caps is that the
# host's latency-sensitive work (production, elsewhere) never waits behind a
# build storm. Below ~60% you stop bounding a burst and start throttling
# ordinary work — builds crawl for no protective gain.
#
# These two percentages answer DIFFERENT questions and are not interchangeable
# with a single number — see docs/BUILD-ARCHITECTURE.md "Resource-governance
# boundaries" and ciu/docs/DESIGN-NOTES.md D3 for the fuller reasoning:
#   DEV_IO_CAP_PCT protects PRODUCTION from the whole dev tier combined (an
#     aggregate ceiling on dev.slice) — it does NOT protect dev containers
#     from EACH OTHER: one greedy container can claim the entire budget
#     without ever exceeding this cap.
#   SWEEP_IO_CAP_PCT protects dev containers from EACH OTHER (a per-container
#     ceiling) — it does NOT protect production by itself, and for the
#     containers it targets (see below), it is CURRENTLY THEIR ONLY ceiling:
#     source-verified (docs/BUILD-ARCHITECTURE.md "How the cgroup controls
#     compose"), Buildx's own `cgroup-parent` driver-opt is unreliable under
#     Docker's systemd cgroup driver, so buildx_buildkit_* workers cannot be
#     PLACED under dev.slice at all (verified live: they land in
#     system.slice, not dev-background.slice) — DEV_IO_CAP_PCT's aggregate
#     genuinely does not reach them; this sweep's per-scope cap is the only
#     governance that does. True buildkit slice placement would need a
#     host-managed buildkitd systemd service + a Buildx `remote` driver, not
#     a driver-opt.
# cgroup limits nest (effective = the tightest applicable control, at leaf AND
# every ancestor) — the two are complementary layers, not either/or, per
# scripts/gstammtisch-guide/plan-host-resource-governance.md item #7/#12.
#
# Whole-estate ceiling for dev.slice (the root — see above) — bounds EVERY
# dev/interactive/background container together. Low end of the band, because
# "the estate" can be 15+ containers.
DEV_IO_CAP_PCT=60
# Per-container ceiling for the containers this sweep targets: test-runner-
# style ("bench") containers, buildkit workers, and the devcontainer itself —
# see CGROUP-NOTES.md §2, "containers we don't directly control the invocation
# of." (Anything cmru/mdt itself spawns directly instead gets explicit
# --memory/--cpus/--device-*-iops flags at create time — see
# cmru/src/cmru/tester_gate.py's CMRU_TESTER_* defaults (8g/20g/1.5 cores) —
# which is a stronger, create-time guarantee this sweep doesn't need to
# duplicate.) High end of the band: this is ONE container's share, not an
# aggregate.
SWEEP_IO_CAP_PCT=80
# Container matching for the per-container sweep (shell case patterns,
# space-separated). Image patterns match .Config.Image, name patterns match
# the container name. Matched against the script's own log labels: an image
# match here logs as "bench:<name>", a name match below as "buildkit:<name>".
TESTRUNNER_IMAGE_PATTERNS="*test-runner*"
BUILDKIT_NAME_PATTERNS="buildx_buildkit_*"
# Devcontainers are capped (io.max) but NOT de-prioritized: unlike bench and
# buildkit containers they do not get IOWeight=1, because this tier is the IDE
# and losing every IO race to a sibling is exactly the stall we are preventing.
DEVCONTAINER_NAME_PATTERNS="*devcontainer*"
# cgroup2 mount flags (nsdelegate,memory_recursiveprot, + memory_hugetlb_
# accounting on kernel >= 6.6). systemd mounts these at boot, but a runtime
# remount from the init cgroup namespace can strip them (observed live) — and
# without memory_recursiveprot every MemoryLow/MemoryMin on a slice silently
# stops protecting the container pages below it, with no other symptom.
#   fix = remount to restore, every sweep (default)   warn = log only, don't touch
CGROUP2_FLAGS=fix

## ── Reactive per-container cap watcher (mdt-dev-cap-watcher.py) ─────────────
# Applied the moment a new docker-*.scope appears under dev-interactive.slice,
# dev-background.slice, or dev-gates.slice (inotify — proven live 2026-08-28
# to fire within the same second), not just on the next mdt-host-slices.timer
# sweep. A container's own explicit `docker run --memory` always wins; this
# only fills in ones that asked for nothing. Default exists to bound the
# blast radius of any single unlabelled container ballooning and forcing
# reclaim on every OTHER cgroup in the tier before the tier's own
# MemoryHigh/Max ever triggers.
#
# The DEV_* namespace above is for SLICE-level settings; these are
# PER-CONTAINER, hence the separate WATCHER_PER_CONTAINER_* prefix.
WATCHER_PER_CONTAINER_MEMORY_MAX=1G
# dev-gates.slice's OWN knob (RW-32/D1) — deliberately NOT
# WATCHER_PER_CONTAINER_MEMORY_MAX above. Today's run-gate lane containers
# pass no --memory and land in dev-background.slice; the moment a consumer
# honours CGROUP_PARENT_DEV_GATES they move here instead, unlabelled, so
# this is the same watcher this section already exists for. 1G would be
# BELOW the ~2 GiB of headroom the 2026-08-04 incident (see "dev-gates.slice"
# below) says a gate already needed — re-creating that incident inside the
# tier built to fix it. Default = the tier's own MemoryHigh: one unlabelled
# lane alone can drive the tier into throttle but never past MemoryMax (6G);
# two such lanes are bounded by the tier's own oomd pressure kill instead,
# not by this watcher. This coarse, tier-wide cap COMPOSES with (is not
# withdrawn by) a future daemon's per-lane placement caps (D-20/D-25) — it
# still catches whatever a lane did not itself ask for, same as it already
# does for the other tiers.
WATCHER_PER_CONTAINER_GATES_MEMORY_MAX=4G
# Soft throttle-into-reclaim step below the hard Max above, same pairing the
# slices themselves already use. A percentage, not a separate absolute
# value, so it automatically tracks gates' different Max above without
# needing its own override variable.
WATCHER_PER_CONTAINER_MEMORY_HIGH_PCT=80
# Per-container swap ceiling: the "tight ceiling, generous swap" pairing
# that's the real answer to "I want an anon ceiling per
# container" — cgroup v2 has no anon-only cap, so bounding total resident
# (Max/High above) while letting swap absorb anon growth beyond it is the
# standard way to express that in kernel terms. Reuses DEV_SWAP_CASCADE_PCT
# from the dev.slice section above (same percentage, applied a third time —
# host swap -> dev.slice -> child slice -> this) rather than a separate
# variable, since it's the same design decision repeated at another level.
# Computed from the matched slice's own LIVE memory.swap.max, not re-derived
# from this file — see scripts/mdt-dev-cap-watcher.py's
# read_slice_swap_max_bytes() for why.

## ── Periodic sweep timer (render-time) ──────────────────────────────────────
# How often mdt-host-slices.timer re-runs the apply script. Left at 5min even
# though the per-container IO caps are only a backstop here (mdt-io-cap-
# watcher.service applies those within the same second via `docker events`)
# — deliberately NOT raised, because the SAME script/timer also carries the
# cgroup2 mount-flag check, which has no event trigger of its own for drift
# caused by something other than mdt's own host-exec/mdt-shell tooling (that
# specific case self-heals instantly via `mdt doctor`, run automatically
# after every host-exec/host-shell — see customization/mdt). Raising this
# would trade a real, incident-documented exposure window (CGROUP-NOTES.md
# §5) for no real benefit, since the IO-cap improvement already comes from
# the watcher, not this interval.
SWEEP_INTERVAL=5min

## ── docker-.scope.d default-limits backstop (render-time, D-G8) ─────────────
# A container placed under a TYPO'D or nonexistent slice name fails OPEN:
# systemd silently auto-creates an unlimited transient slice and the container
# starts normally (verified — see nyxloom/docs/plan-resource-governance.md).
# This is the host-wide "never truly unbounded" floor for EVERY container
# docker starts, regardless of which parent slice it named — including
# production's (Soulmask/Jitsi containers get the same generic docker-<id>.scope
# naming, so this floor reaches them too). Size it GENEROUSLY, above any
# legitimate single container's real ceiling on this host: this is a backstop
# for the fail-open case, not a tier ceiling — do not use it for the tight
# per-container defaults dev/test/build containers get instead (explicit
# docker run flags in whatever spawns them, e.g. cmru's tester-gate).
# alternative interpretation/use: if we need to protect anon memory of runnning 
# prod services in a stable state (prohibit a large container starting to 
# cause evictions), rather limit `memory.max`. every container may declare a 
# higher limit, but the backstop is a hard limit for all containers. oom is still
# prevented by large swap space, but the backstop prevents a single container from 
# hurting the stable state.
DOCKER_SCOPE_BACKSTOP_MEMORY_MAX=12G
DOCKER_SCOPE_BACKSTOP_MEMORY_SWAP_MAX=16G

## ── /etc/docker/daemon.json (render-time) ────────────────────────────────────
# Ownership split (D-F1): this tool owns ONLY cgroup-parent — assigning a
# default container cgroup placement is squarely an mdt/dev-workload
# concern. Base docker daemon policy (live-restore, log rotation) moved to
# debian-install-v2's own installer.py (_configure_docker_daemon()), which
# merges its own disjoint keys the same order-independent way. install.sh
# MERGES this key into any existing /etc/docker/daemon.json rather than
# overwriting it wholesale — never touches a key it doesn't own.
#
# cgroup-parent: the Docker daemon-wide default (D-G7) — placement ONLY, for
# any container that names no --cgroup-parent of its own (an ad hoc host-admin
# `docker run`, a tool nobody's wired up yet). Requires a `dockerd` RESTART
# (not a reload) to take effect — this restarts every running container,
# schedule it.
DOCKER_DAEMON_CGROUP_PARENT=dev-background.slice

## ── Baseline benchmark cache ─────────────────────────────────────────────────
# Where mdt-io-baseline.py caches the measured device ceilings and where
# mdt-apply-dev-caps.sh reads them from. install.sh bootstraps this from an
# existing gstammtisch-guide measurement (/var/lib/gstammtisch/io-baseline.env)
# if present and this file doesn't exist yet, rather than re-running the ~4min
# disk-saturating fio benchmark — mdt owns its OWN copy at its own canonical
# path from then on (no runtime cross-reference to gstammtisch, which is
# scoped to wings/soulmask/tmpfs only and shouldn't be a dependency here).
IO_BASELINE_ENV=/var/lib/mdt/io-baseline.env
# Interop with ciu governance (it caps compose services per-container and reads
# the same file format, deriving read_iops as 2/3 of RIOPS_MAX). ciu searches
# /var/lib/ciu/io-baseline.env, NOT this path — so measure once and share it:
#   echo 'CIU_GOV_BASELINE_PATH=/var/lib/mdt/io-baseline.env' >> /etc/environment
# or set IO_BASELINE_ENV=/var/lib/ciu/io-baseline.env here and let ciu find it
# at its own default. Two independently measured baselines on one host is the
# thing to avoid: the tiers and the per-service caps then disagree.
