{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vbpub:rigor-record:1",
  "title": "rigor-record/1",
  "description": "One record per project per release, at most 64 KiB. Every level key is always present; a missing fact is a named status or an explicit null, never an absent key.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "project", "revision", "adopted_from", "release", "toolsets", "levels", "qualifications", "perf",
    "machine_classes"
  ],
  "properties": {
    "schema": {"const": "urn:vbpub:rigor-record:1"},
    "project": {"$ref": "rigor-common-1.json#/$defs/project"},
    "revision": {"type": "integer", "minimum": 1},
    "adopted_from": {"oneOf": [{"type": "null"}, {"$ref": "rigor-common-1.json#/$defs/tag"}]},
    "release": {"$ref": "#/$defs/release"},
    "toolsets": {
      "type": "object",
      "propertyNames": {"type": "string", "pattern": "^t[0-9]{1,3}$"},
      "additionalProperties": {"$ref": "#/$defs/toolset"}
    },
    "levels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["R0", "R1", "R3", "review", "R2"],
      "properties": {
        "R0": {"$ref": "#/$defs/gate_level"},
        "R1": {"$ref": "#/$defs/gate_level"},
        "R3": {"$ref": "#/$defs/gate_level"},
        "review": {"$ref": "#/$defs/review"},
        "R2": {"$ref": "#/$defs/r2"}
      }
    },
    "qualifications": {
      "type": "object",
      "propertyNames": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
      "additionalProperties": {"$ref": "#/$defs/gate_level"}
    },
    "perf": {"type": "array", "maxItems": 64, "items": {"$ref": "rigor-common-1.json#/$defs/perf_entry"}},
    "machine_classes": {"type": "array", "maxItems": 16, "items": {"$ref": "rigor-common-1.json#/$defs/machine_class"}}
  },
  "$defs": {
    "toolset_id": {"type": "string", "pattern": "^t[0-9]{1,3}$"},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "version", "commit", "project_tree", "published_at", "artifacts", "state", "withdrawn"],
      "properties": {
        "tag": {"$ref": "rigor-common-1.json#/$defs/tag"},
        "version": {"$ref": "rigor-common-1.json#/$defs/semver"},
        "commit": {"$ref": "rigor-common-1.json#/$defs/git_oid"},
        "project_tree": {"$ref": "rigor-common-1.json#/$defs/git_oid"},
        "published_at": {"$ref": "rigor-common-1.json#/$defs/timestamp"},
        "artifacts": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "sha256"],
            "properties": {
              "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"},
              "sha256": {"$ref": "rigor-common-1.json#/$defs/sha256"}
            }
          }
        },
        "state": {"type": "string", "enum": ["current", "withdrawn"]},
        "withdrawn": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["reason", "replacement"],
              "properties": {
                "reason": {"$ref": "rigor-common-1.json#/$defs/short_reason"},
                "replacement": {"$ref": "rigor-common-1.json#/$defs/tag"}
              }
            }
          ]
        }
      }
    },
    "toolset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assay": {"$ref": "rigor-common-1.json#/$defs/judge"},
        "run_gate": {"$ref": "rigor-common-1.json#/$defs/run_gate_tool"},
        "tester_image": {"$ref": "rigor-common-1.json#/$defs/tester_image"},
        "cgprofile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["daemon_version", "observer_contract", "ctl_contract"],
          "properties": {
            "daemon_version": {"oneOf": [{"type": "null"}, {"$ref": "rigor-common-1.json#/$defs/semver"}]},
            "observer_contract": {"type": "integer", "minimum": 1},
            "ctl_contract": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "waiver_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason"],
      "properties": {
        "id": {"$ref": "rigor-common-1.json#/$defs/identifier"},
        "reason": {"$ref": "rigor-common-1.json#/$defs/short_reason"}
      }
    },
    "lane_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "outcome", "verdict_sha256", "config_sha256"],
      "properties": {
        "lane": {"$ref": "rigor-common-1.json#/$defs/lane"},
        "outcome": {"$ref": "rigor-common-1.json#/$defs/outcome"},
        "verdict_sha256": {"oneOf": [{"type": "null"}, {"$ref": "rigor-common-1.json#/$defs/sha256"}]},
        "config_sha256": {"$ref": "rigor-common-1.json#/$defs/sha256"},
        "waiver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "plan_item", "expires_before"],
          "properties": {
            "reason": {"$ref": "rigor-common-1.json#/$defs/short_reason"},
            "plan_item": {"oneOf": [{"type": "null"}, {"$ref": "rigor-common-1.json#/$defs/identifier"}]},
            "expires_before": {"$ref": "rigor-common-1.json#/$defs/semver"}
          }
        }
      }
    },
    "gate_level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "toolset", "judged_commit", "lanes", "waiver"],
      "properties": {
        "status": {"type": "string", "enum": ["pass", "pass-with-waivers", "not-applicable", "waived", "unknown"]},
        "toolset": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/toolset_id"}]},
        "judged_commit": {"oneOf": [{"type": "null"}, {"$ref": "rigor-common-1.json#/$defs/git_oid"}]},
        "lanes": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/lane_entry"}},
        "waiver": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/waiver_ref"}]},
        "coverage": {"$ref": "rigor-fragment-1.json#/$defs/coverage"},
        "canaries": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lane", "mechanism", "targets", "outcome"],
            "properties": {
              "lane": {"$ref": "rigor-common-1.json#/$defs/lane"},
              "mechanism": {"$ref": "rigor-common-1.json#/$defs/identifier"},
              "targets": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "rigor-common-1.json#/$defs/relpath"}},
              "outcome": {"$ref": "rigor-common-1.json#/$defs/outcome"}
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "range", "reviewer_role", "document_sha256"],
      "properties": {
        "status": {"type": "string", "enum": ["accept", "missing"]},
        "range": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "to"],
              "properties": {
                "from": {"oneOf": [{"type": "null"}, {"$ref": "rigor-common-1.json#/$defs/tag"}]},
                "to": {"$ref": "rigor-common-1.json#/$defs/git_oid"}
              }
            }
          ]
        },
        "reviewer_role": {"oneOf": [{"type": "null"}, {"$ref": "rigor-common-1.json#/$defs/role"}]},
        "document_sha256": {"oneOf": [{"type": "null"}, {"$ref": "rigor-common-1.json#/$defs/sha256"}]}
      }
    },
    "listed_survivor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "path", "line", "operator", "disposition", "reason", "resolved_by"],
      "properties": {
        "candidate_id": {"$ref": "rigor-common-1.json#/$defs/identifier"},
        "path": {"$ref": "rigor-common-1.json#/$defs/relpath"},
        "line": {"type": "integer", "minimum": 1},
        "operator": {"$ref": "rigor-common-1.json#/$defs/operator"},
        "disposition": {"type": "string", "enum": ["open", "equivalent", "accepted", "resolved"]},
        "reason": {"oneOf": [{"type": "null"}, {"$ref": "rigor-common-1.json#/$defs/short_reason"}]},
        "resolved_by": {"oneOf": [{"type": "null"}, {"$ref": "rigor-common-1.json#/$defs/tag"}]}
      }
    },
    "r2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "toolset", "judged_commit", "deviations", "scope", "campaign", "candidates", "buckets", "score",
        "worker_counts", "survivors", "lanes", "waiver", "history"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending", "pass", "pass-with-waivers", "survivors", "incomplete", "error", "partial", "not-applicable",
            "waived", "unknown"
          ]
        },
        "toolset": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/toolset_id"}]},
        "judged_commit": {"oneOf": [{"type": "null"}, {"$ref": "rigor-common-1.json#/$defs/git_oid"}]},
        "deviations": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "tag_sha256", "used_sha256", "note"],
            "properties": {
              "file": {"$ref": "rigor-common-1.json#/$defs/relpath"},
              "tag_sha256": {"$ref": "rigor-common-1.json#/$defs/sha256"},
              "used_sha256": {"$ref": "rigor-common-1.json#/$defs/sha256"},
              "note": {"$ref": "rigor-common-1.json#/$defs/short_reason"}
            }
          }
        },
        "scope": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "base_tag", "anchored"],
              "properties": {
                "kind": {"type": "string", "enum": ["whole-source", "changed-since"]},
                "base_tag": {"oneOf": [{"type": "null"}, {"$ref": "rigor-common-1.json#/$defs/tag"}]},
                "anchored": {"type": "boolean"}
              }
            }
          ]
        },
        "campaign": {"oneOf": [{"type": "null"}, {"$ref": "rigor-common-1.json#/$defs/campaign"}]},
        "candidates": {"oneOf": [{"type": "null"}, {"$ref": "rigor-common-1.json#/$defs/candidates"}]},
        "buckets": {"oneOf": [{"type": "null"}, {"$ref": "rigor-common-1.json#/$defs/survivor_buckets"}]},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "worker_counts": {"$ref": "rigor-common-1.json#/$defs/worker_counts"},
        "survivors": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["open", "equivalent", "accepted", "resolved", "listed", "by_file", "sidecar_sha256"],
              "properties": {
                "open": {"$ref": "rigor-common-1.json#/$defs/count"},
                "equivalent": {"$ref": "rigor-common-1.json#/$defs/count"},
                "accepted": {"$ref": "rigor-common-1.json#/$defs/count"},
                "resolved": {"$ref": "rigor-common-1.json#/$defs/count"},
                "listed": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/listed_survivor"}},
                "by_file": {
                  "type": "object",
                  "propertyNames": {"$ref": "rigor-common-1.json#/$defs/relpath"},
                  "additionalProperties": {"$ref": "rigor-common-1.json#/$defs/count"}
                },
                "sidecar_sha256": {"oneOf": [{"type": "null"}, {"$ref": "rigor-common-1.json#/$defs/sha256"}]}
              }
            }
          ]
        },
        "lanes": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lane", "state"],
            "properties": {
              "lane": {"$ref": "rigor-common-1.json#/$defs/lane"},
              "state": {"type": "string", "enum": ["complete", "not-runnable"]}
            }
          }
        },
        "waiver": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/waiver_ref"}]},
        "history": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/r2"}}
      }
    }
  }
}
