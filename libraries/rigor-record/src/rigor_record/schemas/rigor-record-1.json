{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vbpub:rigor-record:1",
  "title": "rigor-record/1",
  "description": "One record per project per commit, at most 64 KiB. A result describes the commit it was judged on; a release tag is only a label on a commit. Every key of a result is always present; a missing fact is an explicit null.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "project", "commit", "revision", "labels", "inventory", "toolsets", "results", "review",
    "qualifications", "perf", "machine_classes"
  ],
  "properties": {
    "schema": {"const": "urn:vbpub:rigor-record:1"},
    "project": {"$ref": "rigor-common-1.json#/$defs/project"},
    "commit": {"$ref": "rigor-common-1.json#/$defs/git_oid"},
    "revision": {"type": "integer", "minimum": 1},
    "labels": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/label"}},
    "inventory": {"$ref": "#/$defs/inventory"},
    "toolsets": {
      "type": "object",
      "propertyNames": {"type": "string", "pattern": "^t[0-9]{1,3}$"},
      "additionalProperties": {"$ref": "#/$defs/toolset"}
    },
    "results": {"type": "array", "maxItems": 96, "items": {"oneOf": [{"$ref": "#/$defs/lane_result"}, {"$ref": "#/$defs/sequence_result"}]}},
    "review": {"$ref": "#/$defs/review"},
    "qualifications": {
      "type": "object",
      "propertyNames": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
      "additionalProperties": {"$ref": "#/$defs/qualification"}
    },
    "perf": {"type": "array", "maxItems": 64, "items": {"$ref": "rigor-common-1.json#/$defs/perf_entry"}},
    "machine_classes": {"type": "array", "maxItems": 16, "items": {"$ref": "rigor-common-1.json#/$defs/machine_class"}}
  },
  "$defs": {
    "toolset_id": {"type": "string", "pattern": "^t[0-9]{1,3}$"},
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "tag", "version", "published_at", "artifacts", "state", "withdrawn"],
      "properties": {
        "kind": {"const": "release"},
        "tag": {"$ref": "rigor-common-1.json#/$defs/tag"},
        "version": {"$ref": "rigor-common-1.json#/$defs/semver"},
        "published_at": {"$ref": "rigor-common-1.json#/$defs/timestamp"},
        "artifacts": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "sha256"],
            "properties": {
              "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"},
              "sha256": {"$ref": "rigor-common-1.json#/$defs/sha256"}
            }
          }
        },
        "state": {"type": "string", "enum": ["current", "withdrawn"]},
        "withdrawn": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["reason", "replacement"],
              "properties": {
                "reason": {"$ref": "rigor-common-1.json#/$defs/short_reason"},
                "replacement": {"$ref": "rigor-common-1.json#/$defs/tag"}
              }
            }
          ]
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "members", "r2_lanes"],
      "properties": {
        "sequence": {"oneOf": [{"type": "null"}, {"$ref": "rigor-common-1.json#/$defs/lane"}]},
        "members": {"type": "array", "maxItems": 64, "items": {"$ref": "rigor-common-1.json#/$defs/lane"}},
        "r2_lanes": {"type": "array", "maxItems": 64, "items": {"$ref": "rigor-common-1.json#/$defs/lane"}}
      }
    },
    "toolset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assay": {"$ref": "rigor-common-1.json#/$defs/judge"},
        "run_gate": {"$ref": "rigor-common-1.json#/$defs/run_gate_tool"},
        "tester_image": {"$ref": "rigor-common-1.json#/$defs/tester_image"},
        "cgprofile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["daemon_version", "observer_contract", "ctl_contract"],
          "properties": {
            "daemon_version": {"oneOf": [{"type": "null"}, {"$ref": "rigor-common-1.json#/$defs/semver"}]},
            "observer_contract": {"type": "integer", "minimum": 1},
            "ctl_contract": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "levels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "R0": {"$ref": "rigor-common-1.json#/$defs/stored_status"},
        "R1": {"$ref": "rigor-common-1.json#/$defs/stored_status"},
        "R2": {"$ref": "rigor-common-1.json#/$defs/stored_status"},
        "R3": {"$ref": "rigor-common-1.json#/$defs/stored_status"}
      }
    },
    "lane_waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "plan_item", "expires_before"],
      "properties": {
        "reason": {"$ref": "rigor-common-1.json#/$defs/short_reason"},
        "plan_item": {"oneOf": [{"type": "null"}, {"$ref": "rigor-common-1.json#/$defs/identifier"}]},
        "expires_before": {"$ref": "rigor-common-1.json#/$defs/semver"}
      }
    },
    "sequence_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "kind", "members", "outcome", "toolset"],
      "properties": {
        "lane": {"$ref": "rigor-common-1.json#/$defs/lane"},
        "kind": {"const": "sequence"},
        "members": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "rigor-common-1.json#/$defs/lane"}},
        "outcome": {"$ref": "rigor-common-1.json#/$defs/outcome"},
        "toolset": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/toolset_id"}]}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "base_commit", "anchored"],
      "properties": {
        "kind": {"type": "string", "enum": ["whole-source", "changed-since"]},
        "base_commit": {"oneOf": [{"type": "null"}, {"$ref": "rigor-common-1.json#/$defs/git_oid"}]},
        "base_label": {"$ref": "rigor-common-1.json#/$defs/tag"},
        "anchored": {"type": "boolean"}
      }
    },
    "deviation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "committed_sha256", "used_sha256", "note"],
      "properties": {
        "file": {"$ref": "rigor-common-1.json#/$defs/relpath"},
        "committed_sha256": {"$ref": "rigor-common-1.json#/$defs/sha256"},
        "used_sha256": {"$ref": "rigor-common-1.json#/$defs/sha256"},
        "note": {"$ref": "rigor-common-1.json#/$defs/short_reason"}
      }
    },
    "listed_survivor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "path", "line", "operator", "disposition", "reason", "resolved_by"],
      "properties": {
        "candidate_id": {"$ref": "rigor-common-1.json#/$defs/identifier"},
        "path": {"$ref": "rigor-common-1.json#/$defs/relpath"},
        "line": {"type": "integer", "minimum": 1},
        "operator": {"$ref": "rigor-common-1.json#/$defs/operator"},
        "disposition": {"type": "string", "enum": ["open", "equivalent-reviewed", "accepted", "resolved"]},
        "reason": {"oneOf": [{"type": "null"}, {"$ref": "rigor-common-1.json#/$defs/short_reason"}]},
        "resolved_by": {"oneOf": [{"type": "null"}, {"$ref": "rigor-common-1.json#/$defs/git_oid"}]}
      }
    },
    "survivors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["open", "equivalent_reviewed", "accepted", "resolved", "listed", "by_file", "sidecar_sha256"],
      "properties": {
        "open": {"$ref": "rigor-common-1.json#/$defs/count"},
        "equivalent_reviewed": {"$ref": "rigor-common-1.json#/$defs/count"},
        "accepted": {"$ref": "rigor-common-1.json#/$defs/count"},
        "resolved": {"$ref": "rigor-common-1.json#/$defs/count"},
        "listed": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/listed_survivor"}},
        "by_file": {
          "type": "object",
          "propertyNames": {"$ref": "rigor-common-1.json#/$defs/relpath"},
          "additionalProperties": {"$ref": "rigor-common-1.json#/$defs/count"}
        },
        "sidecar_sha256": {"oneOf": [{"type": "null"}, {"$ref": "rigor-common-1.json#/$defs/sha256"}]}
      }
    },
    "r2_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "toolset", "scope", "campaign", "candidates", "buckets", "score", "worker_counts"],
      "properties": {
        "status": {"type": "string", "enum": ["incomplete", "error"]},
        "toolset": {"$ref": "#/$defs/toolset_id"},
        "scope": {"$ref": "#/$defs/scope"},
        "campaign": {"$ref": "rigor-common-1.json#/$defs/campaign"},
        "candidates": {"$ref": "rigor-common-1.json#/$defs/candidates"},
        "buckets": {"$ref": "rigor-common-1.json#/$defs/survivor_buckets"},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "worker_counts": {"$ref": "rigor-common-1.json#/$defs/worker_counts"}
      }
    },
    "lane_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "kind", "judged_by", "levels", "toolset", "targets", "verdict_sha256", "config_sha256"],
      "properties": {
        "lane": {"$ref": "rigor-common-1.json#/$defs/lane"},
        "kind": {"type": "string", "enum": ["assay", "command"]},
        "judged_by": {"type": "string", "enum": ["assay", "run-gate"]},
        "levels": {"$ref": "#/$defs/levels"},
        "toolset": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/toolset_id"}]},
        "targets": {"$ref": "rigor-common-1.json#/$defs/targets"},
        "verdict_sha256": {"oneOf": [{"type": "null"}, {"$ref": "rigor-common-1.json#/$defs/sha256"}]},
        "config_sha256": {"oneOf": [{"type": "null"}, {"$ref": "rigor-common-1.json#/$defs/sha256"}]},
        "note": {"const": "declared, not judged"},
        "unresolved_inputs": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "rigor-common-1.json#/$defs/target_path"}},
        "waiver": {"$ref": "#/$defs/lane_waiver"},
        "coverage": {"$ref": "rigor-fragment-1.json#/$defs/coverage"},
        "canary": {"$ref": "rigor-fragment-1.json#/$defs/canary"},
        "scope": {"$ref": "#/$defs/scope"},
        "campaign": {"$ref": "rigor-common-1.json#/$defs/campaign"},
        "candidates": {"$ref": "rigor-common-1.json#/$defs/candidates"},
        "buckets": {"$ref": "rigor-common-1.json#/$defs/survivor_buckets"},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "worker_counts": {"$ref": "rigor-common-1.json#/$defs/worker_counts"},
        "survivors": {"$ref": "#/$defs/survivors"},
        "deviations": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/deviation"}},
        "attributed_from": {"oneOf": [{"type": "null"}, {"$ref": "rigor-common-1.json#/$defs/git_oid"}]},
        "history": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/r2_attempt"}}
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["judged_commit", "results"],
      "properties": {
        "judged_commit": {"$ref": "rigor-common-1.json#/$defs/git_oid"},
        "results": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/lane_result"}}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "range", "reviewer_role", "document_sha256"],
      "properties": {
        "status": {"type": "string", "enum": ["accept", "missing"]},
        "range": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "to"],
              "properties": {
                "from": {"oneOf": [{"type": "null"}, {"$ref": "rigor-common-1.json#/$defs/tag"}]},
                "to": {"$ref": "rigor-common-1.json#/$defs/git_oid"}
              }
            }
          ]
        },
        "reviewer_role": {"oneOf": [{"type": "null"}, {"$ref": "rigor-common-1.json#/$defs/role"}]},
        "document_sha256": {"oneOf": [{"type": "null"}, {"$ref": "rigor-common-1.json#/$defs/sha256"}]}
      }
    }
  }
}
