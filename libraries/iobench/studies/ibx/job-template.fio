[global]
ioengine=libaio
direct=1
filename={{FILENAME}}
offset={{OFFSET}}
size={{SIZE}}
rw={{RW}}
bs={{BS}}
iodepth={{IODEPTH}}
runtime={{RUNTIME}}
time_based={{TIME_BASED}}
io_size={{IO_SIZE}}
rate_iops={{RATE_IOPS}}
write_bw_log={{LOG_PREFIX}}
write_iops_log={{LOG_PREFIX}}
log_avg_msec=1000
group_reporting=1
output-format=json
percentile_list=50:90:95:99:99.9

[{{NAME}}]
