# cmru-orchestration-template-revision: 2
schema_version = 1

[orchestration]
project_order = ["example"]
default_projects = ["example"]
default_steps = ["run-tests", "build", "push"]
execution_mode = "project-first"
# Credentials default from gitignored repository-root cmru.secret.toml:
# [github] token = "…"
# A project override belongs in example/cmru.secret.toml, same [github] table.

[orchestration.project.example]
config = "example/cmru.toml"
depends_on = []

[cleanup]
release_tag_prefixes = ["*"]
keep_release_tags = ["example-latest"]
ghcr_packages = ["*"]
ghcr_delete_packages = []
