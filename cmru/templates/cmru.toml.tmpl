# cmru-project-template-revision: 4
# Complete portable CMRU project contract. Copy to <project>/cmru.toml.
schema_version = 1

[github]
owner = "your-github-owner"
repo = "your-repository"
owner_type = "user"

[targets]
host = "github"
registry = ["ghcr.io"]

[env]
# These are required by the stock tester-gate and wheel-build commands below.
# Pin image digests in a production project; CMRU deliberately has no source
# fallback for images or resource limits.
CMRU_WHEEL_BUILDER_IMAGE = "wheel-builder:local"
CMRU_TESTER_UNIFIED_IMAGE = "tester-unified:local"
CMRU_TESTER_MEMORY = "3g"
CMRU_TESTER_MEMORY_SWAP = "16g"
CMRU_TESTER_CPUS = "1.5"
CMRU_TESTER_CGROUP_PROBE_IMAGE = "debian:trixie-slim"

[project]
id = "example"
description = "Describe the product and consumer."
template_revision = 4
prefix = "example-v"
artifacts = ["wheel"]
scm_dist = "example"

[project.version]
strategy = "scm"
bump = "conventional"

[project.release]
git_tag = true
build_step = "build"
artifact_dirs = ["dist"]

[steps.run-tests]
quiet = true
commands = [
  { label = "example: tester-unified gate", argv = ["cmru", "tester-gate", "--cwd", ".", "--", "/opt/tester-venv/bin/python", "-m", "pytest", "tests", "-q"], cwd = "." },
]

[steps.build]
quiet = true
commands = [
  { label = "example: build wheel", argv = ["python3", "-m", "cmru.handlers", "wheel-build", "--cwd", "."], cwd = "." },
]

[steps.push]
quiet = true
commands = [
  { label = "example: publish wheel", argv = ["python3", "-m", "cmru.handlers", "wheel-publish", "--prefix", "example", "--cwd", ".", "--notes-env", "EXAMPLE_RELEASE_NOTES"], cwd = "." },
]
