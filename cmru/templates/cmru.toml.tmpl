# cmru-project-template-revision: 5
# Complete portable CMRU project contract. Copy to <project>/cmru.toml.
# In a monorepo with a cmru.orchestration.toml, delete the [github] and
# [targets] tables below: they are central orchestration facts there.
schema_version = 1

[runtime]
kind = "none"

[github]
owner = "your-github-owner"
repo = "your-repository"
owner_type = "user"

[targets]
host = "github"
registry = ["ghcr.io"]

[env]
# These are required by the stock tester-gate and wheel-build commands below.
# Pin image digests in a production project; CMRU deliberately has no source
# fallback for images or resource limits.
CMRU_WHEEL_BUILDER_IMAGE = "wheel-builder:local"
CMRU_TESTER_UNIFIED_IMAGE = "tester-unified:local"
CMRU_TESTER_MEMORY = "3g"
CMRU_TESTER_MEMORY_SWAP = "16g"
CMRU_TESTER_CPUS = "1.5"
CMRU_TESTER_PIDS_LIMIT = "4096"
# Privileged + --pull=never: digest-pin a locally present image (placeholder below).
CMRU_TESTER_CGROUP_PROBE_IMAGE = "debian@sha256:<digest>"

[project]
id = "example"
description = "Describe the product and consumer."
template_revision = 5
prefix = "example-v"
artifacts = ["wheel"]
scm_dist = "example"

[project.version]
strategy = "scm"
bump = "conventional"

[project.release]
git_tag = true
build_step = "build"
artifact_dirs = ["dist"]

[versions]
age_window_days = 14

[versions.discovery]
scope = "shipped"
# Optional: list files/directories actually produced by the release gate.
# evidence_paths = ["coverage.json"]

[steps.run-tests]
quiet = true
commands = [
  { label = "example: tester-unified gate", argv = ["cmru", "tester-gate", "--cwd", ".", "--", "/opt/tester-venv/bin/python", "-m", "pytest", "tests", "-q"], cwd = "." },
]

[steps.build]
quiet = true
commands = [
  { label = "example: build wheel", argv = ["cmru", "handler", "wheel-build", "--cwd", "."], cwd = "." },
]

[steps.push]
quiet = true
commands = [
  { label = "example: publish wheel", argv = ["cmru", "handler", "wheel-publish", "--prefix", "example", "--cwd", ".", "--notes-env", "EXAMPLE_RELEASE_NOTES"], cwd = "." },
]
