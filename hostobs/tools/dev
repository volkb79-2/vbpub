#!/usr/bin/env bash
# hostobs developer container: compile, test, debug and run user-space Rust code against the
# offline fixtures, in the tester-unified-rust-dev image, resource-capped and network-less.
#
# usage: dev [--dry-run] [--local] SUBCOMMAND [ARGS...]
#   shell | fixtures-shell      interactive bash in the container
#   run -- CMD...               any command
#   build|check|clippy [ARGS]   cargo through tools/cargo-offline.sh (offline, locked, cache verified)
#   fmt [ARGS]                  cargo fmt --all ARGS
#   test [--no-nextest] [ARGS]  cargo nextest run (or plain cargo test) offline, locked
#   example CRATE NAME [ARGS]   cargo run -p CRATE --example NAME -- ARGS
#   gdb ARGS | strace ARGS      rust-gdb / strace; the only subcommands with CAP_SYS_PTRACE
#   status                      container (with age), volume, checkout of this worktree
#   stop                        remove this worktree's container by exact name
#   clean [--checkout]          remove this worktree's target volume (and host checkout)
#
# MODES. REMOTE is the default and the mode every real use takes: the caller's worktree (HEAD as
# a git bundle plus the uncommitted changes as a patch and an untracked-files tar, 20 MiB cap) is
# shipped to the gate host through the controller's host table (scripts/controller/hx.sh, which
# runs the provider identity check and the on-host guard on every call) and the container runs
# there. LOCAL (--local) uses the docker daemon of THIS machine; it is refused unless
# HOSTOBS_DEV_ALLOW_LOCAL=1 because the devcontainer is capped and shares a production host.
#
# Exit codes: 2 usage/refusal, 3 identity/transport failure, a hostobs-dev-* container already
# runs or another call for this worktree is in progress, 75 host under memory/PSI pressure (or
# unreadable) or no admission slot free, 124 stopped by the runtime limit, otherwise the
# command's own.
# Environment (all optional): HOSTOBS_DEV_HOST (default: the only alias in
# CONTROLLER_REMOTE_GATE_HOSTS; only v1001 is accepted), HOSTOBS_DEV_IMAGE, HOSTOBS_DEV_MEMORY (3g;
# 512m..4g), HOSTOBS_DEV_CPUS (2; >0..3), HOSTOBS_DEV_PIDS (1024; may only be lowered),
# HOSTOBS_DEV_MAX_S (3600; ceiling 14400), HOSTOBS_DEV_ALLOW_PARALLEL=1, HOSTOBS_DEV_ALLOW_LOCAL=1,
# HOSTOBS_DEV_SLICE_MEM_MAX_MB (3584), CONTROLLER_REMOTE_SLOTS/CONTROLLER_REMOTE_SLOT_WAIT_S/
# CONTROLLER_HOME (the remote-gate.sh admission slots). Test-only seams: HOSTOBS_DEV_HX,
# HOSTOBS_DEV_TEST_SLICE_MEM_FILE, HOSTOBS_DEV_TEST_PSI_DIR, HOSTOBS_DEV_SELF_CONTAINER.
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
worktree=$(cd "$script_dir/../.." && pwd -P)

readonly TARGET_MOUNT=/home/gate/.cache/hostobs-target
readonly WORK_MOUNT=/work
readonly WORKDIR=/work/hostobs
readonly SYNC_CAP_BYTES=$((20 * 1024 * 1024))
readonly REQUIRED_HOST=v1001
readonly REQUIRED_SLICE=dev-gates.slice

image=${HOSTOBS_DEV_IMAGE:-tester-unified-rust-dev:local}
memory=${HOSTOBS_DEV_MEMORY-3g}
cpus=${HOSTOBS_DEV_CPUS-2}
pids=${HOSTOBS_DEV_PIDS-1024}
max_s=${HOSTOBS_DEV_MAX_S-3600}
allow_parallel=${HOSTOBS_DEV_ALLOW_PARALLEL:-0}
mem_max_mb=${HOSTOBS_DEV_SLICE_MEM_MAX_MB-3584}
mem_file=${HOSTOBS_DEV_TEST_SLICE_MEM_FILE:-/sys/fs/cgroup/dev.slice/$REQUIRED_SLICE/memory.current}
psi_dir=${HOSTOBS_DEV_TEST_PSI_DIR:-/proc/pressure}

dry_run=0
mode=remote
tmpdirs=()
stage=''
stty_saved=''
ctl_env_file=''

die() {
  local code=$1; shift
  printf 'dev: %s\n' "$*" >&2
  exit "$code"
}

cleanup() {
  local d
  for d in "${tmpdirs[@]}"; do [[ -z $d ]] || rm -rf -- "$d"; done
  if [[ -n $stty_saved ]]; then stty "$stty_saved" 2>/dev/null || true; fi
}
trap cleanup EXIT

usage() {
  sed -n '2,/^set -euo/p' "${BASH_SOURCE[0]}" | sed '$d' | sed 's/^# \{0,1\}//' >&2
  exit "${1:-2}"
}

# ---- identity of this worktree: container, volume and host directory names ---------------------
worktree_hex=$(printf '%s' "$worktree" | sha256sum | cut -c1-12)
[[ $worktree_hex =~ ^[0-9a-f]{12}$ ]] || die 2 'cannot derive the worktree identity'
cname="hostobs-dev-$worktree_hex"
vname="hostobs-dev-target-$worktree_hex"

# ---- argument parsing ---------------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) dry_run=1; shift ;;
    --local) mode=local; shift ;;
    -h|--help) usage 0 ;;
    --) break ;;
    -*) die 2 "unknown global option: $1 (see --help)" ;;
    *) break ;;
  esac
done
[[ $# -ge 1 ]] || usage 2
sub=$1; shift

# limits cannot be lifted through the environment: every one is parsed and bounded
[[ $memory =~ ^([0-9]{1,6})([mg])$ ]] || die 2 "HOSTOBS_DEV_MEMORY must look like 3g or 2048m (512m..4g), got '$memory'"
mem_mib=$((10#${BASH_REMATCH[1]}))
[[ ${BASH_REMATCH[2]} == g ]] && mem_mib=$((mem_mib * 1024))
(( mem_mib >= 512 && mem_mib <= 4096 )) || die 2 "HOSTOBS_DEV_MEMORY must be between 512m and 4g, got '$memory'"
[[ $cpus =~ ^[0-9]{1,3}(\.[0-9]{1,3})?$ ]] || die 2 "HOSTOBS_DEV_CPUS must be a number, got '$cpus'"
awk -v c="$cpus" 'BEGIN { exit !(c + 0 > 0 && c + 0 <= 3) }' || die 2 "HOSTOBS_DEV_CPUS must be above 0 and at most 3, got '$cpus'"
[[ $pids =~ ^[0-9]{1,5}$ ]] || die 2 "HOSTOBS_DEV_PIDS must be 1..1024, got '$pids'"
(( 10#$pids >= 1 && 10#$pids <= 1024 )) || die 2 "HOSTOBS_DEV_PIDS must be 1..1024, got '$pids'"
pids=$((10#$pids))
[[ $max_s =~ ^[0-9]{1,6}$ ]] || die 2 "HOSTOBS_DEV_MAX_S must be 1..14400, got '$max_s'"
(( 10#$max_s >= 1 && 10#$max_s <= 14400 )) || die 2 "HOSTOBS_DEV_MAX_S must be 1..14400, got '$max_s'"
max_s=$((10#$max_s))
[[ $allow_parallel == 0 || $allow_parallel == 1 ]] || die 2 'HOSTOBS_DEV_ALLOW_PARALLEL must be 0 or 1'
[[ $mem_max_mb =~ ^[0-9]{1,4}$ ]] || die 2 "HOSTOBS_DEV_SLICE_MEM_MAX_MB must be a number of MiB between 1 and 3584, got '$mem_max_mb'"
(( 10#$mem_max_mb >= 1 && 10#$mem_max_mb <= 3584 )) || die 2 "HOSTOBS_DEV_SLICE_MEM_MAX_MB must be between 1 and 3584 (it can only be lowered), got '$mem_max_mb'"
mem_max_mb=$((10#$mem_max_mb))
[[ $image =~ ^[A-Za-z0-9][A-Za-z0-9._/:@-]*$ ]] || die 2 "invalid HOSTOBS_DEV_IMAGE '$image'"

if [[ $mode == local && ${HOSTOBS_DEV_ALLOW_LOCAL:-0} != 1 ]]; then
  die 2 'LOCAL mode runs a container on this machine'\''s docker daemon, which on the shared devcontainer is capped and shares a production host: not recommended and refused. The default REMOTE mode runs on the gate host. Set HOSTOBS_DEV_ALLOW_LOCAL=1 to override.'
fi

# ---- subcommand -> container command ------------------------------------------------------------
cmd=()
want_ptrace=0
case "$sub" in
  shell|fixtures-shell)
    [[ $# -eq 0 ]] || die 2 "$sub takes no arguments"
    cmd=(bash) ;;
  run)
    [[ ${1:-} == -- ]] || die 2 'usage: dev run -- CMD...'
    shift
    [[ $# -ge 1 ]] || die 2 'usage: dev run -- CMD... (a command is required)'
    cmd=("$@") ;;
  build|check)
    cmd=(tools/cargo-offline.sh "$sub" --offline --locked "$@") ;;
  clippy)
    if [[ $# -eq 0 ]]; then set -- --workspace --all-targets -- -D warnings; fi
    cmd=(tools/cargo-offline.sh clippy --offline --locked "$@") ;;
  fmt)
    cmd=(tools/cargo-offline.sh fmt --all "$@") ;;
  test)
    if [[ ${1:-} == --no-nextest ]]; then
      shift; cmd=(tools/cargo-offline.sh test --offline --locked "$@")
    else
      cmd=(tools/cargo-offline.sh nextest run --offline --locked "$@")
    fi ;;
  example)
    [[ $# -ge 2 ]] || die 2 'usage: dev example CRATE NAME [ARGS...]'
    [[ $1 =~ ^[A-Za-z0-9_-]+$ && $2 =~ ^[A-Za-z0-9_-]+$ ]] || die 2 'crate and example names must be plain identifiers'
    cmd=(tools/cargo-offline.sh run --offline --locked -p "$1" --example "$2")
    ex_args=("${@:3}")
    if [[ ${ex_args[0]:-} == -- ]]; then ex_args=("${ex_args[@]:1}"); fi
    if [[ ${#ex_args[@]} -gt 0 ]]; then cmd+=(-- "${ex_args[@]}"); fi ;;
  gdb)
    cmd=(rust-gdb -iex 'set cwd '"$TARGET_MOUNT" -iex 'set disable-randomization off' "$@")
    want_ptrace=1 ;;
  strace)
    cmd=(strace "$@"); want_ptrace=1 ;;
  status|stop|clean) ;;
  *) die 2 "unknown subcommand '$sub' (see --help)" ;;
esac
clean_checkout=0
if [[ $sub == clean ]]; then
  case "${1:-}" in
    '') ;;
    --checkout) clean_checkout=1 ;;
    *) die 2 'usage: dev clean [--checkout]' ;;
  esac
elif [[ ($sub == status || $sub == stop) && $# -gt 0 ]]; then
  die 2 "$sub takes no arguments"
fi

# ---- common checks ------------------------------------------------------------------------------
command -v docker >/dev/null 2>&1 || [[ $mode == remote ]] || die 2 'docker is not on PATH'

cgroup_parent=${CGROUP_PARENT_DEV_GATES:-}
if [[ $sub != status && $sub != clean && $sub != stop ]]; then
  [[ -n $cgroup_parent ]] || die 2 'CGROUP_PARENT_DEV_GATES is required; refusing an ungoverned container'
  [[ $cgroup_parent == "$REQUIRED_SLICE" ]] || die 2 "CGROUP_PARENT_DEV_GATES must be exactly $REQUIRED_SLICE, got '$cgroup_parent'"
fi

tty=0
if [[ -t 0 && -t 1 ]]; then tty=1; fi

# ---- docker run argv (shared by REMOTE and LOCAL) -----------------------------------------------
# Parts, so the remote script can quote every word and still emit the one mount source literally:
#   dpre   = everything before the cidfile and the worktree mounts
#   dmount = the worktree mount and the read-only .git mount (source from $1, or the host-side literal)
#   dpost  = the volume mount, workdir, env, image and the nice/ionice prefix; then the user words
# $1 = host directory that is bind-mounted at /work, $2 = cidfile path ('' for none)
build_docker_argv() {
  local src=$1 cid=$2
  dpre=(docker run --rm --init --pull never --stop-timeout 10 --name "$cname")
  if (( tty )); then dpre+=(-it -e "TERM=${TERM:-xterm}"); fi
  dpre+=(--network none --cap-drop ALL)
  if (( want_ptrace )); then dpre+=(--cap-add SYS_PTRACE); fi
  dpre+=(--security-opt no-new-privileges
    --pids-limit "$pids" --memory "$memory" --memory-swap "$memory" --cpus "$cpus"
    --cgroup-parent "$cgroup_parent" --user 1003:1003 --ulimit core=0:0)
  dcid=()
  if [[ -n $cid ]]; then dcid=(--cidfile "$cid"); fi
  dmount=(-v "$src:$WORK_MOUNT" -v "$src/.git:$WORK_MOUNT/.git:ro")
  dpost=(-v "$vname:$TARGET_MOUNT" -w "$WORKDIR"
    -e CARGO_NET_OFFLINE=true -e RUST_BACKTRACE=1 -e RUST_LIB_BACKTRACE=1
    "$image" nice -n 10 ionice -c3 timeout --foreground -k 5 "$max_s")
  dargv=("${dpre[@]}" "${dcid[@]}" "${dmount[@]}" "${dpost[@]}" "${cmd[@]}")
}

# EVERY word is quoted with printf %q, whatever it contains; nothing inspects user text.
shell_words() {
  local first=1 a
  for a in "$@"; do
    if (( first )); then first=0; else printf ' '; fi
    printf '%q' "$a"
  done
}

# ---- the script text that runs ON THE HOST (or locally in LOCAL mode) -----------------------------
# Every docker call below is by exact container or volume name; the only listing is by the name
# prefix of our own containers. Values interpolated here are validated: hex digits, a sha, small integers.
remote_prelude() {
  cat <<EOF
set -u
HEX=$worktree_hex
SHA=${sync_sha:-0}
SEED=${sync_seed:-}
UPID=${upload_id:-0}
D=\$HOME/hostobs-dev/\$HEX
W=\$D/work
UP=\$D/up-\$UPID
NAME=$cname
VOL=$vname
ALLOW_PARALLEL=$allow_parallel
CHECK_HOST=$1
MEM_MAX_MB=$mem_max_mb
MEM_FILE=$(printf '%q' "$mem_file")
PSI_DIR=$(printf '%q' "$psi_dir")
PSI_LIMIT=25
EOF
  cat <<'EOF'
# memory some avg10 and io full avg10 only; CPU PSI is a stall measure, not utilisation (the same rule and the
# same limit as scripts/netcup/runner/remote-gate.py). Fails CLOSED: 0 = quiet, 1 = unreadable, 2 = high.
psi_state() {
  local mem io
  [ -r "$PSI_DIR/memory" ] && [ -r "$PSI_DIR/io" ] || return 1
  mem=$(awk '/^some/ { sub("avg10=", "", $2); print $2; exit }' "$PSI_DIR/memory" 2>/dev/null) || return 1
  io=$(awk '/^full/ { sub("avg10=", "", $2); print $2; exit }' "$PSI_DIR/io" 2>/dev/null) || return 1
  case $mem in ''|*[!0-9.]*|.*|*.|*.*.*) return 1 ;; esac
  case $io in ''|*[!0-9.]*|.*|*.|*.*.*) return 1 ;; esac
  awk -v m="$mem" -v i="$io" -v lim="$PSI_LIMIT" 'BEGIN { exit !(m + 0 > lim || i + 0 > lim) }' && return 2
  return 0
}
dev_admit() {
  local cur running rc
  if [ "$(id -u):$(id -g)" != 1003:1003 ]; then
    echo "dev: the user here is $(id -u):$(id -g) but the image bakes 1003:1003 and the checkout must be owned by it; refusing" >&2
    return 2
  fi
  if [ "$CHECK_HOST" = 1 ]; then
    cur=$(cat "$MEM_FILE" 2>/dev/null) || cur=''
    case $cur in
      ''|*[!0-9]*) echo "dev: cannot read $MEM_FILE; refusing to start (exit 75)" >&2; return 75 ;;
    esac
    if [ "$cur" -gt $((MEM_MAX_MB * 1048576)) ]; then
      echo "dev: dev-gates.slice memory.current is $((cur / 1048576)) MiB (it includes page cache), above $MEM_MAX_MB MiB; refusing to start, retry when the host is quieter" >&2
      return 75
    fi
    rc=0
    psi_state || rc=$?
    case $rc in
      0) ;;
      1) echo "dev: cannot read the PSI files in $PSI_DIR; refusing to start (exit 75)" >&2; return 75 ;;
      *) echo "dev: PSI above $PSI_LIMIT (memory some / io full); refusing to start, retry when the host is quieter" >&2; return 75 ;;
    esac
  fi
  running=$(docker ps --filter 'name=^hostobs-dev-' --format '{{.Names}}') || { echo "dev: cannot list hostobs-dev-* containers" >&2; return 3; }
  if [ -n "$running" ] && [ "$ALLOW_PARALLEL" != 1 ]; then
    echo "dev: a dev container is already running ($(echo $running)); one heavy dev job at a time (HOSTOBS_DEV_ALLOW_PARALLEL=1 overrides)" >&2
    return 3
  fi
  return 0
}
EOF
}

preflight_script() {
  remote_prelude "$1"
  cat <<'EOF'
dev_admit || exit $?
if [ -d "$W/.git" ]; then
  if git -c core.hooksPath=/dev/null -c core.fsmonitor=false -C "$W" cat-file -e "$SHA^{commit}" 2>/dev/null; then echo HASSHA=1; else echo HASSHA=0; fi
  echo "HAVE=$(git -c core.hooksPath=/dev/null -c core.fsmonitor=false -C "$W" rev-parse HEAD 2>/dev/null || true)"
else
  echo HASSHA=0
  echo HAVE=
  for s in "$HOME"/checkouts/*; do
    b=${s##*/}
    case $b in *[!0-9a-f]*|'') continue ;; esac
    if [ ${#b} -ge 40 ]; then echo "SEED=$b"; fi
  done
fi
exit 0
EOF
}

# the upload step: only unpacks the overlay into a private directory; takes no lock, changes no checkout
upload_script() {
  remote_prelude 1
  cat <<'EOF'
set -e
mkdir -p -m 0700 "$D"
find "$D" -maxdepth 1 -name 'up-*' -mmin +120 -exec rm -rf {} + 2>/dev/null || true
mkdir -m 0700 "$UP"
tar -xf - -C "$UP"
echo "uploaded $UPID"
EOF
}

# the sync, run under the per-worktree lock; every host-side git call is hardened (no hooks, no fsmonitor,
# only the file transport, no system or global config) because the checkout is shared with a container
sync_text() {
  cat <<'EOF'
export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null
g() { git -c core.hooksPath=/dev/null -c core.fsmonitor=false -c protocol.allow=never -c protocol.file.allow=always "$@"; }
if [ ! -d "$W/.git" ]; then
  rm -rf "$W"
  if [ -n "$SEED" ]; then g clone -q --no-checkout "$HOME/checkouts/$SEED" "$W"; else g init -q "$W"; fi
fi
rm -rf "$W/.git/hooks"
mkdir -m 0755 "$W/.git/hooks"
if [ -f "$UP/in.bundle" ]; then g -C "$W" fetch -q "$UP/in.bundle" HEAD; fi
g -C "$W" checkout -q -f --detach "$SHA"
g -C "$W" reset -q --hard "$SHA"
g -C "$W" clean -q -ffdx
if [ -s "$UP/tracked.patch" ]; then g -C "$W" apply --binary --whitespace=nowarn "$UP/tracked.patch"; fi
if [ -s "$UP/untracked.tar" ]; then tar -xf "$UP/untracked.tar" -C "$W"; fi
rm -rf "$UP"
echo "synced $SHA"
EOF
}

# the command text that starts the container; $1 = 1 for a pty. Quoting: every user word through %q; the
# worktree mounts are emitted literally from $W, which the prelude builds from the validated hex only.
container_command_text() {
  local pre post
  pre=$(shell_words "${dpre[@]}")
  post=$(shell_words "${dpost[@]}" "${cmd[@]}")
  # shellcheck disable=SC2016 # $HOME, $D and $W are expanded on the host
  printf 'D="$HOME/hostobs-dev/%s"; W="$D/work"; ' "$worktree_hex"
  # shellcheck disable=SC2016
  printf 'timeout --foreground -s TERM -k 15 %s %s --cidfile "$D/cid" -v "$W:/work" -v "$W/.git:/work/.git:ro" %s\n' "$max_s" "$pre" "$post"
}

run_script() {
  local text
  remote_prelude "$1"
  cat <<'EOF'
set -e
mkdir -p -m 0700 "$D"
exec 9>"$D/lock"
if ! flock -n 9; then
  rm -rf "$UP"
  echo "dev: another dev call for this worktree is in progress (lock $D/lock); HOSTOBS_DEV_ALLOW_PARALLEL does not apply to one worktree" >&2
  exit 3
fi
# a cidfile left by an earlier call names a container that is not ours: forget it BEFORE the cleanup can see it
rm -f "$D/cid"
cleanup() {
  if [ -s "$D/cid" ]; then docker rm -f "$(cat "$D/cid")" >/dev/null 2>&1 || true; fi
  rm -f "$D/cid"
  rm -rf "$UP"
}
trap cleanup EXIT HUP INT TERM
# one dev container at a time across ALL worktrees: a host-global non-blocking lock, taken before the admission
# check and held through the container run (the docker client inherits fd 8). HOSTOBS_DEV_ALLOW_PARALLEL=1 skips
# only this lock; the memory/PSI admission and the per-worktree lock above still apply.
if [ "$ALLOW_PARALLEL" != 1 ]; then
  exec 8>"$HOME/hostobs-dev/.all.lock"
  if ! flock -n 8; then
    echo "dev: another dev container call is in progress on this host (lock $HOME/hostobs-dev/.all.lock); one heavy dev job at a time (HOSTOBS_DEV_ALLOW_PARALLEL=1 skips this lock only)" >&2
    exit 3
  fi
fi
dev_admit || exit $?
if docker inspect --format '{{.Id}}' "$NAME" >/dev/null 2>&1; then
  echo "dev: container $NAME exists (an earlier run still up? use: dev stop); refusing to sync under it" >&2
  exit 3
fi
EOF
  sync_text
  # shellcheck disable=SC2016
  printf 'rm -f "$D/cid"\n'
  text=$(container_command_text)
  printf 'rc=0\n'
  if (( tty )); then
    printf 'SHELL=/bin/bash script -qefc %s /dev/null || rc=$?\n' "$(printf '%q' "bash -c $(printf '%q' "$text")")"
  else
    printf '%s </dev/null || rc=$?\n' "$text"
  fi
  cat <<'EOF'
if [ "$rc" = 124 ]; then echo "dev: stopped by the runtime limit; the container is removed" >&2; fi
exit $rc
EOF
}

status_script() {
  remote_prelude "$1"
  cat <<'EOF'
echo "container: $NAME"
state=$(docker inspect --format '{{.State.Running}}' "$NAME" 2>/dev/null) || state=absent
echo "running:   $state"
if [ "$state" = true ]; then
  started=$(docker inspect --format '{{.State.StartedAt}}' "$NAME" 2>/dev/null || true)
  start_s=$(date -d "$started" +%s 2>/dev/null || true)
  if [ -n "$start_s" ]; then echo "age:       $(( $(date +%s) - start_s )) s (started $started); stop it with: dev stop"; else echo "age:       unknown (started '$started')"; fi
fi
echo "volume:    $VOL"
if docker volume inspect --format '{{.Name}}' "$VOL" >/dev/null 2>&1; then
  echo "volume present: yes"
  if [ "$state" = true ]; then
    echo "volume size: $(docker exec "$NAME" du -sh /home/gate/.cache/hostobs-target 2>/dev/null | cut -f1)"
  else
    echo "volume size: unknown while the container is not running (dev run -- du -sh /home/gate/.cache/hostobs-target)"
  fi
else
  echo "volume present: no"
fi
echo "checkout:  $W $(if [ -d "$W/.git" ]; then echo "(present, $(du -sh "$W" 2>/dev/null | cut -f1), at $(git -c core.hooksPath=/dev/null -c core.fsmonitor=false -C "$W" rev-parse --short HEAD 2>/dev/null))"; else echo '(absent)'; fi)"
echo "running hostobs-dev-* containers: $(docker ps --filter 'name=^hostobs-dev-' --format '{{.Names}}' | tr '\n' ' ')"
EOF
}

stop_script() {
  remote_prelude "$1"
  cat <<'EOF'
# a call holds the per-worktree lock from before the sync through the end of the run; hold it ourselves while we act
LOCKED=0
if [ -d "$D" ]; then
  exec 7>"$D/lock"
  flock -n 7 || LOCKED=1
fi
if docker inspect --format '{{.Id}}' "$NAME" >/dev/null 2>&1; then
  docker rm -f "$NAME" >/dev/null
  echo "stopped and removed container $NAME"
elif [ "$LOCKED" = 1 ]; then
  echo "dev: a call for this worktree is in progress (syncing); retry in a moment" >&2
  exit 3
else
  echo "container $NAME does not exist, nothing to stop"
fi
EOF
}

clean_script() {
  remote_prelude "$1"
  cat <<EOF
CLEAN_CHECKOUT=$clean_checkout
EOF
  cat <<'EOF'
echo "volume: $VOL"
state=$(docker inspect --format '{{.State.Running}}' "$NAME" 2>/dev/null) || state=absent
if [ "$state" = true ]; then echo "dev: container $NAME is running; stop it first (dev stop)" >&2; exit 3; fi
if [ -d "$D" ]; then
  exec 7>"$D/lock"
  if ! flock -n 7; then
    echo "dev: a call for this worktree is in progress (syncing); retry in a moment" >&2
    exit 3
  fi
fi
if docker volume inspect --format '{{.Name}}' "$VOL" >/dev/null 2>&1; then
  docker volume rm "$VOL"
  echo "removed volume $VOL"
else
  echo "volume $VOL does not exist, nothing to remove"
fi
if [ "$CLEAN_CHECKOUT" = 1 ]; then
  echo "checkout: $D"
  rm -rf -- "$D"
  echo "removed $D"
fi
EOF
}

simple_script() {
  case $sub in
    status) status_script "$1" ;;
    stop) stop_script "$1" ;;
    clean) clean_script "$1" ;;
  esac
}

# ---- transport ------------------------------------------------------------------------------------
resolve_host() {
  host=${HOSTOBS_DEV_HOST:-}
  if [[ -z $host ]]; then
    # shellcheck disable=SC2206 # an alias list is whitespace separated by definition
    local aliases=(${CONTROLLER_REMOTE_GATE_HOSTS:-})
    [[ ${#aliases[@]} -eq 1 ]] || die 2 'set HOSTOBS_DEV_HOST (CONTROLLER_REMOTE_GATE_HOSTS does not name exactly one alias)'
    host=${aliases[0]}
  fi
  [[ $host =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die 2 "invalid host alias '$host'"
  [[ $host == "$REQUIRED_HOST" ]] || die 2 "the dev container runs on $REQUIRED_HOST only, not '$host'"
  if [[ -n ${CONTROLLER_REMOTE_GATE_HOSTS:-} ]]; then
    case " $CONTROLLER_REMOTE_GATE_HOSTS " in
      *" $host "*) ;;
      *) die 2 "host '$host' is not in CONTROLLER_REMOTE_GATE_HOSTS" ;;
    esac
  fi
  hx=${HOSTOBS_DEV_HX:-$worktree/scripts/controller/hx.sh}
}

load_controller_env() {
  # the same configuration remote-gate.sh reads (controller.local.env): slots, hosts, CONTROLLER_HOME
  local lib=$worktree/scripts/controller/lib.sh
  [[ -f $lib && -z ${HOSTOBS_DEV_HX:-} ]] || return 0
  set +e
  # shellcheck disable=SC1090
  ( export CONTROLLER_INIT_READONLY=1; . "$lib"; controller_init; declare -p CONTROLLER_HOME CONTROLLER_REMOTE_GATE_HOSTS CONTROLLER_REMOTE_SLOTS CONTROLLER_REMOTE_SLOT_WAIT_S 2>/dev/null ) >"$ctl_env_file" 2>/dev/null
  set -e
  return 0
}

hx_call() {
  # $1 = script; stdin is passed through. hx.sh exit codes 97 (identity), 98 (guard), 255 (ssh) are transport failures.
  local rc=0
  "$hx" "$host" "$1" || rc=$?
  case $rc in
    97|98|255) printf 'dev: transport or identity failure talking to %s (exit %s)\n' "$host" "$rc" >&2; return 3 ;;
  esac
  return "$rc"
}

# the admission slot: the same flock files, ticket and slot count as scripts/controller/remote-gate.sh, weight 1
slot_fd=''
take_slot() {
  local slots=${CONTROLLER_REMOTE_SLOTS:-4} deadline=${CONTROLLER_REMOTE_SLOT_WAIT_S:-7200} home lockdir waited=0 i sfd mfd
  [[ $slots =~ ^[1-8]$ ]] || die 2 'CONTROLLER_REMOTE_SLOTS must be 1..8'
  [[ $deadline =~ ^[0-9]+$ ]] || die 2 'CONTROLLER_REMOTE_SLOT_WAIT_S must be a non-negative integer'
  home=${CONTROLLER_HOME:-$HOME/controller}
  lockdir=$home/remote-gate-locks
  mkdir -p -- "$lockdir"
  exec {mfd}>"$lockdir/$host.admit"
  flock -w "$deadline" "$mfd" || die 75 "admission ticket not obtained within ${deadline}s"
  while :; do
    for i in $(seq 1 "$slots"); do
      exec {sfd}>"$lockdir/$host.slot$i"
      if flock -n "$sfd"; then slot_fd=$sfd; break 2; fi
      exec {sfd}>&-
    done
    (( waited >= deadline )) && die 75 "no $host admission slot free after ${waited}s"
    (( waited % 300 == 0 )) && printf 'dev: waiting for a %s admission slot (%ss)\n' "$host" "$waited" >&2
    sleep 5; waited=$((waited + 5))
  done
  exec {mfd}>&-
}

# ---- dry-run printing -----------------------------------------------------------------------------
print_argv() {
  printf 'DOCKER-ARGV-BEGIN\n'
  printf '%s\n' "${dargv[@]}"
  printf 'DOCKER-ARGV-END\n'
}
print_step() { printf 'STEP %s: %s\n' "$1" "$2"; }
print_script() { printf 'SCRIPT-BEGIN %s\n%s\nSCRIPT-END %s\n' "$1" "$2" "$1"; }

# ---- LOCAL mode -----------------------------------------------------------------------------------
resolve_local_host_path() {
  # Docker resolves bind sources in the HOST namespace: map the worktree through this container's own mounts.
  local self=${HOSTOBS_DEV_SELF_CONTAINER:-} mounts dest src best_dest='' best_src=''
  if [[ -z $self && -r /etc/hostname ]]; then self=$(</etc/hostname); fi
  if [[ -n $self ]] && mounts=$(docker inspect --format '{{range .Mounts}}{{.Destination}}{{"\t"}}{{.Source}}{{"\n"}}{{end}}' "$self" 2>/dev/null); then
    while IFS=$'\t' read -r dest src; do
      [[ -n $dest && $dest != / ]] || continue
      if [[ $worktree == "$dest" || $worktree == "$dest"/* ]] && (( ${#dest} > ${#best_dest} )); then
        best_dest=$dest; best_src=$src
      fi
    done <<< "$mounts"
    [[ -n $best_dest ]] || die 2 "the worktree $worktree is not on a bind mount of this container; Docker would resolve it on the host and mount an empty directory"
    local_src=$best_src${worktree#"$best_dest"}
  else
    printf 'dev: not inside a container the daemon knows; using the worktree path as the host path\n' >&2
    local_src=$worktree
  fi
  [[ $local_src != *:* && $local_src != *,* ]] || die 2 "host path '$local_src' contains ':' or ','; Docker cannot mount it with -v"
}

run_local() {
  local rc=0
  case $sub in
    status|stop|clean)
      local script
      script=$(simple_script 0)
      if (( dry_run )) && [[ $sub != status ]]; then print_script "$sub" "$script"; return 0; fi
      exec bash -c "$script" ;;
  esac
  resolve_local_host_path
  build_docker_argv "$local_src" ''
  bash -c "$(preflight_script 0)" >/dev/null || rc=$?
  (( rc == 0 )) || exit "$rc"
  if (( dry_run )); then print_argv; return 0; fi
  exec "${dargv[@]}"
}

# ---- REMOTE mode ----------------------------------------------------------------------------------
sync_sha=''
sync_seed=''
upload_id=''
patch_bytes=0

stage_overlay() {
  # stage: tracked.patch (git diff HEAD --binary), untracked.list (NUL) and untracked.tar; refuses past the cap
  local total=0 f size
  git -C "$worktree" rev-parse --verify --quiet 'HEAD^{commit}' >/dev/null || die 2 'the worktree has no HEAD commit'
  sync_sha=$(git -C "$worktree" rev-parse HEAD)
  [[ $sync_sha =~ ^[0-9a-f]{40,64}$ ]] || die 2 "unexpected HEAD id '$sync_sha'"
  git -C "$worktree" diff HEAD --binary > "$stage/tracked.patch"
  git -C "$worktree" ls-files -o --exclude-standard -z > "$stage/untracked.list"
  total=$(stat -c %s "$stage/tracked.patch")
  while IFS= read -r -d '' f; do
    if [[ $f == */ || ( -d $worktree/$f && ! -L $worktree/$f ) ]]; then
      die 2 "untracked directory '$f' (a nested git repository?) cannot be synced: add it to .gitignore, commit it or remove it"
    fi
    size=$(stat -c %s -- "$worktree/$f" 2>/dev/null || echo 0)
    total=$((total + size))
  done < "$stage/untracked.list"
  patch_bytes=$total
  if (( total > SYNC_CAP_BYTES )); then
    die 2 "the uncommitted changes are $((total / 1048576)) MiB (tracked patch plus untracked files), above the $((SYNC_CAP_BYTES / 1048576)) MiB sync cap; commit them (a commit travels in the bundle) or drop them"
  fi
  if [[ -s $stage/untracked.list ]]; then
    tar -cf "$stage/untracked.tar" --no-recursion --null -C "$worktree" -T "$stage/untracked.list"
  fi
}

pick_seed_and_bundle() {
  # $1 = HASSHA, $2 = HAVE (host's last synced head), then SEED shas. Creates stage/in.bundle when objects are missing.
  local hassha=$1 have=$2 c n best='' best_n='' base=''; shift 2
  sync_seed=''
  if [[ $hassha == 1 ]]; then return 0; fi
  if [[ -n $have ]] && git -C "$worktree" cat-file -e "$have^{commit}" 2>/dev/null; then
    base=$have
  else
    for c in "$@"; do
      git -C "$worktree" cat-file -e "$c^{commit}" 2>/dev/null || continue
      n=$(git -C "$worktree" rev-list --count HEAD "^$c")
      if [[ -z $best_n ]] || (( n < best_n )); then best=$c; best_n=$n; fi
    done
    if [[ -z $have && -n $best ]]; then sync_seed=$best; fi
    base=$best
  fi
  if [[ -n $base ]]; then
    git -C "$worktree" bundle create "$stage/in.bundle" HEAD "^$base" >/dev/null 2>&1 || rm -f "$stage/in.bundle"
  else
    git -C "$worktree" bundle create "$stage/in.bundle" HEAD >/dev/null 2>&1 || die 2 'git bundle failed'
  fi
}

run_remote() {
  local rc=0 mounted_src
  # shellcheck disable=SC2016 # $HOME is expanded on the host, not here
  mounted_src='$HOME/hostobs-dev/'"$worktree_hex"'/work'
  stage=$(mktemp -d); tmpdirs+=("$stage")
  ctl_env_file=$stage/ctl.env
  load_controller_env
  # shellcheck disable=SC1090
  [[ -s $ctl_env_file ]] && . "$ctl_env_file"
  resolve_host

  case $sub in
    status|stop|clean)
      local script
      script=$(simple_script 1)
      if (( dry_run )); then
        print_step 1 "$hx $host <remote script>"
        print_script "$sub" "$script"
        return 0
      fi
      hx_call "$script" </dev/null
      return $? ;;
  esac

  upload_id=$(printf '%s%s%s' "$$" "$(date +%s%N)" "$RANDOM" | sha256sum | cut -c1-16)
  [[ $upload_id =~ ^[0-9a-f]{16}$ ]] || die 2 'cannot derive an upload id'
  stage_overlay
  # the cidfile is where the host-side cleanup finds OUR container id
  # shellcheck disable=SC2016
  build_docker_argv "$mounted_src" '$HOME/hostobs-dev/'"$worktree_hex"'/cid'
  local preflight
  preflight=$(preflight_script 1)
  if (( dry_run )); then
    print_step 1 "admission: ticket then 1 slot of ${CONTROLLER_REMOTE_SLOTS:-4} ($host.slotN under ${CONTROLLER_HOME:-$HOME/controller}/remote-gate-locks, weight 1)"
    print_step 2 "preflight: $hx $host <remote script> (identity and guard, uid, slice memory, PSI, one-at-a-time, host checkout state)"
    print_script preflight "$preflight"
    print_step 3 "bundle: git bundle create in.bundle HEAD ^<base> in the stage directory when the host lacks $sync_sha"
    print_step 4 "patch: git diff HEAD --binary > tracked.patch ($patch_bytes bytes of uncommitted changes counted, cap $SYNC_CAP_BYTES)"
    print_step 5 "untracked: git ls-files -o --exclude-standard -z, tar -cf untracked.tar --no-recursion"
    print_step 6 "upload: tar stream of the stage directory on stdin: $hx $host <remote script> (unpacks into a private directory on the host)"
    print_script upload "$(upload_script)"
    print_step 7 "run: $hx $host <remote script> (per-worktree lock, then admission, sync to $sync_sha with hardened git, then the container under a ${max_s}s limit; exit code propagated)"
    print_script run "$(run_script 1)"
    print_argv
    return 0
  fi

  take_slot
  # children must not inherit the slot descriptor: a process that outlived this one would hold the slot
  local out
  out=$( { eval "exec $slot_fd>&-"; hx_call "$preflight" </dev/null; } ) || rc=$?
  (( rc == 0 )) || exit "$rc"
  local hassha=0 have='' seeds=() line f
  while IFS= read -r line; do
    case $line in
      HASSHA=1) hassha=1 ;;
      HAVE=*) have=${line#HAVE=} ;;
      SEED=*) seeds+=("${line#SEED=}") ;;
    esac
  done <<< "$out"
  # what the host printed is data: only full commit ids may reach the next remote script
  [[ $have =~ ^[0-9a-f]{40,64}$ ]] || have=''
  local valid_seeds=() s
  for s in "${seeds[@]}"; do
    if [[ $s =~ ^[0-9a-f]{40,64}$ ]]; then valid_seeds+=("$s"); fi
  done
  seeds=("${valid_seeds[@]}")
  pick_seed_and_bundle "$hassha" "$have" "${seeds[@]}"
  local files=() upload run
  upload=$(upload_script)
  for f in in.bundle tracked.patch untracked.tar; do
    [[ ! -e $stage/$f ]] || files+=("$f")
  done
  tar -cf - -C "$stage" "${files[@]}" \
    | { eval "exec $slot_fd>&-"; hx_call "$upload" >&2; } || exit $?
  run=$(run_script 1)
  if (( tty )); then
    stty_saved=$(stty -g)
    stty -echo -icanon -isig
    if ( eval "exec $slot_fd>&-"; hx_call "$run" ); then rc=0; else rc=$?; fi
    stty "$stty_saved"; stty_saved=''
  else
    if ( eval "exec $slot_fd>&-"; hx_call "$run" </dev/null ); then rc=0; else rc=$?; fi
  fi
  exit "$rc"
}

if [[ $mode == local ]]; then run_local; else run_remote; fi
