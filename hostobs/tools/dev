#!/usr/bin/env bash
# Compatibility shim: the hostobs dev container is now the generic remote dev tool (scripts/controller/dev, profile
# `hostobs`). HOSTOBS_DEV_{HOST,MEMORY,CPUS,PIDS,MAX_S} map to AGENT_DEV_*; any other HOSTOBS_DEV_* makes the tool exit 2.
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
for v in HOST MEMORY CPUS PIDS MAX_S; do
  old=HOSTOBS_DEV_$v
  if [[ -n ${!old+x} ]]; then export "AGENT_DEV_$v=${!old}"; unset "$old"; fi
done
if [[ ${1:-} == clean ]]; then shift; [[ $# -eq 0 || ( $# -eq 1 && $1 == --checkout ) ]] || { echo 'usage: dev clean [--checkout]' >&2; exit 2; }; set -- gc --this; fi
if [[ ${1:-} == gc ]]; then exec "$here/../../scripts/controller/dev" "$@"; fi
exec "$here/../../scripts/controller/dev" -p hostobs "$@"
