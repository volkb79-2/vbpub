[Unit]
Description=hostobs observe-level UNIX socket
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/hostobs/observe/hostobs.sock
FileDescriptorName=observe
Accept=no
SocketUser=root
SocketGroup=hostobs-observe
SocketMode=0660
# The directory comes from tmpfiles.d, not DirectoryMode (which would be root:root).
DirectoryMode=0750
Service=hostobs-probe.service

[Install]
WantedBy=sockets.target
