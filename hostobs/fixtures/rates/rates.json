      "previous": {
        "quality": "ok",
        "mono_ns": 2000000000,
        "type": "u64",
        "value": 1000
      },
      "current": {
        "quality": "ok",
        "mono_ns": 3000000000,
        "type": "u64",
        "value": 1500
      },
      "expect": {
        "delta": 500,
        "denominator": 1000000000,
        "per_second": 500,
        "missed": 0
      }
    },
