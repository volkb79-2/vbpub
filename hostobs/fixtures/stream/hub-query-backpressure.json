{
  "case": "hub-query-backpressure",
  "doc": "query_room and push_query first refuse over the connection pool while the global pool still fits, then refuse over the global pool alone; nothing is queued or dropped, and reading a block restores room",
  "limits": {
    "client_queue_bytes": 1000,
    "global_live_bytes": 8000,
    "query_queue_bytes": 1000,
    "global_query_bytes": 1500,
    "control_queue_bytes": 500,
    "stall_ms": 5000,
    "frame_completion_ms": 5000
  },
  "conns": 2,
  "steps": [
    {
      "t_ms": 0,
      "op": "query_room",
      "c": 0,
      "len": 600
    },
    {
      "t_ms": 0,
      "op": "push_query",
      "c": 0,
      "s": 1,
      "len": 600,
      "watch": [
        "c0",
        "g"
      ]
    },
    {
      "t_ms": 0,
      "op": "query_room",
      "c": 0,
      "len": 600
    },
    {
      "t_ms": 0,
      "op": "push_query",
      "c": 0,
      "s": 1,
      "len": 600
    },
    {
      "t_ms": 0,
      "op": "push_query",
      "c": 1,
      "s": 2,
      "len": 600,
      "watch": [
        "g"
      ]
    },
    {
      "t_ms": 0,
      "op": "query_room",
      "c": 1,
      "len": 400
    },
    {
      "t_ms": 0,
      "op": "push_query",
      "c": 1,
      "s": 2,
      "len": 400
    },
    {
      "t_ms": 0,
      "op": "head",
      "c": 0,
      "block": true
    },
    {
      "t_ms": 0,
      "op": "query_room",
      "c": 1,
      "len": 400
    },
    {
      "t_ms": 0,
      "op": "wrote",
      "c": 0,
      "n": 600
    },
    {
      "t_ms": 0,
      "op": "query_room",
      "c": 1,
      "len": 400
    },
    {
      "t_ms": 0,
      "op": "push_query",
      "c": 1,
      "s": 2,
      "len": 400,
      "watch": [
        "c1",
        "g"
      ]
    },
    {
      "t_ms": 0,
      "op": "query_room",
      "c": 1,
      "len": 1
    },
    {
      "t_ms": 0,
      "op": "end_stream",
      "c": 0,
      "s": 1
    },
    {
      "t_ms": 0,
      "op": "end_stream",
      "c": 1,
      "s": 2
    }
  ],
  "expect": [
    [
      {
        "room": true
      }
    ],
    [
      "queued",
      {
        "pools": {
          "c0": [
            0,
            600,
            0
          ],
          "g": [
