// The MDT templates already apply this profile as the default. Copy it into another
// settings layer when applying the same profile outside an MDT template.
// Each terminal gets its own timestamped tmux session; it does not share a pane with
// other VS Code terminals. /etc/tmux.conf supplies the defaults (prefix Ctrl+Space,
// mouse, true colour). See README.md for reconnect and migration steps.
{
  "terminal.integrated.profiles.linux": {
    "tmux": {
      "path": "bash",
      "args": ["-lc", "exec tmux new-session -s \"vscode-$(date -u +%Y%m%dT%H%M%SZ)-$$\" /usr/bin/zsh"],
      "icon": "terminal-tmux"
    }
  },
  "terminal.integrated.defaultProfile.linux": "tmux",
  "terminal.integrated.enablePersistentSessions": true
}
