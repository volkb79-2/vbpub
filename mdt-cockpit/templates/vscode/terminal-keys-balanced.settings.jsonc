// OPT-IN terminal key profile "balanced": VS Code shortcuts keep working, and the keys that
// mc, vim, readline, tmux and agent CLIs need are released to the terminal. Merge into the settings
// layer you use (see README.md). A leading "-" removes a command from VS Code's skip-shell list,
// so its key is sent to the program instead.
//
// Keep ONE key profile: do not combine this file with terminal-keys-terminal-first.settings.jsonc.
// The list is not exhaustive. When a key is still stolen, run "Developer: Toggle Keyboard
// Shortcuts Troubleshooting", press the key once in the terminal and add the command it names.
{
  "terminal.integrated.sendKeybindingsToShell": false,
  "terminal.integrated.allowChords": false,
  "terminal.integrated.allowMnemonics": false,
  "terminal.integrated.commandsToSkipShell": [
    // Ctrl+J newline in agent CLIs; Ctrl+M
    "-workbench.action.togglePanel",
    "-editor.action.toggleTabFocusMode",
    // Ctrl+P / Ctrl+E (readline, agent CLIs), F1
    "-workbench.action.quickOpen",
    "-workbench.action.showCommands",
    // mc: F2 user menu, F3 view
    "-workbench.action.terminal.renameActiveTab",
    "-workbench.action.terminal.focusFindWidget",
    "-workbench.action.terminal.findNext",
    "-workbench.action.terminal.findPrevious",
    // mc: F4 edit, Shift+F4
    "-goToNextReference",
    "-goToPreviousReference",
    // mc: F5 copy, F6 move, F8 delete, F10 quit, F11 (debugger and full-screen defaults)
    "-workbench.action.debug.start",
    "-workbench.action.debug.run",
    "-workbench.action.debug.continue",
    "-workbench.action.debug.pause",
    "-workbench.action.debug.restart",
    "-workbench.action.debug.stop",
    "-workbench.action.debug.stepOver",
    "-workbench.action.debug.stepInto",
    "-workbench.action.debug.stepOut",
    "-workbench.action.toggleFullScreen",
    // PageUp / PageDown in less, mc, vim and agent transcripts
    "-workbench.action.terminal.scrollUpPage",
    "-workbench.action.terminal.scrollDownPage"
  ]
}
