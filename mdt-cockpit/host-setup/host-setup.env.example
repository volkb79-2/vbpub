# mdt host-setup configuration
#
# One file configures everything mdt host-setup owns on a Docker host:
#   - the dev-tier cgroup slices: dev.slice and its five children,
#   - the IO governance around them: caps, scheduler, io.cost, writeback,
#   - the host policies for BuildKit and devcontainers,
#   - the cgroup-parent key of /etc/docker/daemon.json. This tool is that key's ONE
#     owner; do not also manage it elsewhere.
#
# LIFECYCLE
#   install.sh copies this file to /etc/mdt/host-setup.env on first install and never
#   overwrites an existing one: edit THAT copy. `install.sh --wizard` walks the keys
#   interactively and replaces only the KEY=value lines, keeping every comment byte
#   for byte. So assign each key exactly once, as a plain KEY=value line at column 0
#   (some readers parse this file without executing it), and keep one
#   `# Allowed KEY: grammar` line per key. A test enforces both.
#   The wizard asks the keys as nine numbered steps (host-setup/README.md): steps 1-6
#   follow sections 1-3 and 5-7 of this file; the IO caps of section 4 come last
#   (steps 7-9) because they wait for the optional benchmark.
#
# HOW A CHANGE TAKES EFFECT - every section heading below carries one of these tags:
#   [render]   substituted into a systemd unit or config file when install.sh renders
#              it                                   -> re-run install.sh
#   [install]  read by install.sh itself (auto-detection, udev/sysctl rules, checks)
#                                                   -> re-run install.sh
#   [runtime]  re-read by a script or service each time it runs
#                                                   -> no reinstall; picked up on its
#              next run (the reconcile timer: WATCHER_INTERVAL, section 6)
#   A service that reads this file only once, when it starts, says so in its section
#   (6.3): restart it after editing.
#   Two things to know:
#   - The DEV_IO_*_MAX pins are runtime keys, but ALSO the static fallback rendered
#     into the dev.slice unit. Re-run install.sh once to refresh the unit file; the
#     runtime already follows the new value.
#   - After a KERNEL UPDATE the io baseline is rejected as stale (its KERNEL_RELEASE no
#     longer matches); dev.slice then holds the pinned/static values until
#     `mdt-io-baseline.py --force` is re-run. Pin the four DEV_IO_*_MAX values (section
#     4.2) so the cap does not depend on a baseline at all.
#
# THE SLICE TREE (sections 2 and 3 configure it)
#   dev.slice                            parent: aggregate IO/CPU/swap ceiling
#   |- dev-interactive.slice             devcontainers + IDE
#   |- dev-background.slice              long-running stacks; Docker's default parent
#   |- dev-gates.slice                   gate and lane containers
#   |- dev-memory_min_guaranteed.slice   containers that need a real memory.min floor
#   `- dev-buildkitd.slice               the host-managed BuildKit worker
#
# VOCABULARY used by the `Allowed` lines
#   sizes    a positive number with an optional K/M/G/T suffix (base 1024), or a bare
#            byte count; e.g. 500M, 2.5G, 2048K
#   `-`      omit this directive on purpose
#   auto     derive from this host at install time (nproc, SwapTotal)
#   kernel   leave the kernel's own value untouched and render no line
#   empty    means something different per key (not pinned / omit / auto / not
#            managed); the key's Allowed line says which
#
# START HERE - what to decide for YOUR host (every default below is an example):
#   1. Memory sizes of every tier (sections 2.4 and 3): the illustrative values suit an
#      approximately 16 GiB host that is mostly available to development. The wizard
#      derives its starting MemoryHigh/Max from the physical MemTotal of the host being
#      configured (MemAvailable is shown only as transient context). This example is
#      not a host fact.
#   2. On a VIRTUAL disk, pin the dev.slice IO caps from a sustained measurement
#      (section 4.2).
#   3. DOCKER_DAEMON_CGROUP_PARENT (section 7): changing it restarts dockerd and with it
#      every running container.
#   4. The writeback, scheduler and io.cost keys (4.6, 4.7) ship as `kernel` / not
#      managed: change them only from a benchmark.
#
# CONTENTS
#   1  Host facts and global switches                 IO_DEV_PATH, DAMON
#   2  dev.slice - the parent ceiling                 CPU, swap, zswap, memory
#   3  Tier slices - the five children                shared rules, then one block per tier
#   4  IO governance                                  4.1 static fallbacks   4.2 operator pins
#                                                     4.3 per-tier pins      4.4 runtime caps
#                                                     4.5 baseline file      4.6 writeback + queue
#                                                     4.7 scheduler + io.cost
#   5  BuildKit and devcontainer policies
#   6  Reconcile sweep and container watchers
#   7  Docker: default-limits backstop and daemon.json

## -- 1. Host facts and global switches ---------------------------------------
# [install] / [render]

# Block device NODE (a /dev/... path, not MAJ:MIN) backing the Docker data dir.
# Empty = auto-discover via findmnt of /var/lib/docker, falling back to /. Static IO
# caps are omitted when no /dev node is available; runtime memory/CPU governance still
# applies.
# Run install.sh and the wizard from the Docker HOST shell, never from the MDT
# devcontainer: UID 0 in that container is not host root, and the host-only preflight
# refuses it before reading or writing host policy. If findmnt reports `overlay`, stop:
# that is a container filesystem, not a host block-device node. From the host shell,
# type the host's /dev/... node if discovery cannot expose it.
# Allowed IO_DEV_PATH: empty (auto-discover) or a /dev/... block-device node path (e.g. /dev/sda, /dev/mapper/vg-root)
IO_DEV_PATH=""

# Whether MDT persistently disables the kernel's global DAMON_STAT monitor, so the
# cgroup-profiler daemon can use the generic DAMON sysfs interface. `yes` is the DEFAULT
# (operator decision 2026-10-20); set `no` to keep the kernel's configured default.
# Applies now and at boot through systemd-tmpfiles. `no` removes MDT's boot override; a
# currently disabled monitor stays disabled until the next boot.
# Allowed DAMON_STAT_DISABLE_DEFAULT: yes | no
DAMON_STAT_DISABLE_DEFAULT="yes"

## -- 2. dev.slice - the parent ceiling ----------------------------------------
# One ceiling for dev-interactive + dev-background + every other child COMBINED (cgroup
# v2 hierarchical accounting). Deliberate: even interactive/IDE activity must not be
# able to starve production, and one ceiling is simpler to reason about than one per
# tier. Only the IO, CPU and swap ceilings sit on this shared parent (IO: section 4);
# memory high/max and OOM policy stay per child. Every child ALSO carries its own,
# tighter sub-ceiling for CPU and swap (section 3).

## 2.1 Capacity unavailable to MDT, and CPU           [install + render]
# Three numbers name the capacity that is UNAVAILABLE to MDT because other services on
# this host (a game server, a database, anything that is not MDT) use it. Everything else
# is MDT's. They are the only host facts the operator supplies; every dev-tier default
# is derived from them:
#   RAM_MDT  = MemTotal - MDT_EXCLUDED_RAM                      (refused below 1G)
#   SWAP_MDT = SwapTotal - MDT_EXCLUDED_SWAP - MDT_HOST_SWAP_MARGIN
#                                                               (<= 0: MDT gets no disk swap)
#   CPU_MDT  = nproc - MDT_EXCLUDED_CPU_CORES                   (refused below 0.5)
# Only DISK swap counts (the swap space on the swap device); zswap is ignored. RAM and CPU
# are overcommitted across the tiers on purpose: the tier limits sum to more than RAM_MDT
# and the cold part is absorbed by zswap and disk swap. Protection of the other services
# comes from weights, from memory.min on their own cgroups (mirroring MDT_EXCLUDED_RAM)
# and from pressure (PSI), not from carving RAM out of dev.slice. `mdt-host-setup-wizard.py
# --probe-excluded` suggests the three numbers from the named units' live cgroups
# (read-only; nothing is applied silently).
# MDT_EXCLUDED_RAM: RAM the other services use, e.g. 6500M. 0 = none.
# MDT_EXCLUDED_SWAP: disk swap the other services occupy, e.g. 14G. 0 = none.
# MDT_EXCLUDED_CPU_CORES: cores the other services use, fractions allowed (0.5, 1.5);
#   0 on a host without other load.
# DEV_TIER_EXCLUDED_CPU_CORES: cores no single tier may use on top of the above (each
#   tier's CPUQuota is (CPU_MDT - this) cores). 0 = tiers are capped only by dev.slice.
# MDT_PROTECTED_UNITS: the other services' systemd units (space-separated) that
#   `mdt-host-check.sh` verifies and the probe reads. Empty = none named.
# MDT_HOST_SWAP_MARGIN: disk swap kept for the host itself, never given to MDT.
# CPUQuota of dev.slice is auto-derived as CPU_MDT cores when DEV_CPU_QUOTA is `auto`; each
# tier's as (CPU_MDT - DEV_TIER_EXCLUDED_CPU_CORES) cores. An explicit percentage always
# overrides; `-` omits the directive.
# Allowed MDT_EXCLUDED_RAM, MDT_EXCLUDED_SWAP, MDT_HOST_SWAP_MARGIN: a size with an optional K/M/G/T suffix (e.g. 6500M, 14G) or a bare byte count; 0 is allowed
# Allowed MDT_EXCLUDED_CPU_CORES, DEV_TIER_EXCLUDED_CPU_CORES: a number of cores with at most one decimal place (0, 0.5, 1.5); never empty
# Allowed MDT_PROTECTED_UNITS: empty or space-separated systemd unit names (e.g. wings.slice docker.service)
# Allowed DEV_CPU_QUOTA, DEV_{INTERACTIVE,BACKGROUND,GATES,BUILDKITD}_CPU_QUOTA: auto | - | N% with N > 0 (e.g. 400%); empty means auto
MDT_EXCLUDED_RAM=0
MDT_EXCLUDED_SWAP=0
MDT_EXCLUDED_CPU_CORES=0
DEV_TIER_EXCLUDED_CPU_CORES=0
MDT_PROTECTED_UNITS=""
MDT_HOST_SWAP_MARGIN=512M

## 2.1b Pressure guard                                      [install + runtime]
# mdt-psi-guard (a small service outside dev.slice) watches pressure-stall information
# (PSI): the protected units' memory pressure (some 10%), the host's memory pressure
# (full 5%) and the protected units' CPU pressure (some 25%), each held 10 s before it
# fires and released after 60 s below half the threshold. In `enforce` it first sets
# CPUWeight and IOWeight of dev-gates, dev-background and dev-buildkitd to 1, and 30 s
# later, if the pressure persists, lowers MemoryHigh of dev-gates and dev-background to
# max(256M, 90% of their memory.current). Every change is reverted on release, on stop and
# at the next start. It never freezes or kills anything.
#   off      the service is disabled
#   report   events are written to /run/mdt/psi-guard/events.jsonl; nothing is changed
#            (the shipped default, until the live validation has been done)
#   enforce  the staged actions above are applied
# Allowed MDT_PSI_GUARD: off | report | enforce
MDT_PSI_GUARD=report
DEV_CPU_QUOTA=auto

## 2.2 Swap                                                  [install + render]
# DEV_SWAP_MAX=auto is SWAP_MDT (section 2.1: SwapTotal minus the disk swap unavailable to
# MDT minus MDT_HOST_SWAP_MARGIN). EVERY child slice's own MemorySwapMax then
# auto-detects as DEV_SWAP_CASCADE_PCT% of THIS value, not of the host total. If a
# per-container memory pair is configured (section 6), the reactive watcher applies the
# percentage a third time to the matched child's live swap ceiling; with both of its
# memory values `-` it adds no per-container swap cap. The parent stays the aggregate
# ceiling at every level, same "children combined are still bounded by the parent"
# reasoning as CPU.
#
# DECIDED (operator, 2026-10-19; D-HS-01-3): swap stays AMPLE (80% of SWAP_MDT,
# cascading). The protection against a gate thrashing the shared disk is not a small
# swap allowance but a TIGHT IO cap on the gate tier (DEV_GATES_IO_*_MAX, section 4.3):
# swap-out IO is charged to the page owner's cgroup (per kernel source, not measured here:
# swap writeback bios are associated with the page owner's blkcg via
# `bio_associate_blkg_from_page` in `mm/page_io.c`), so a gate that swaps is throttled by
# its own IO cap. That also needs the swap devices to sit on a disk with a dev.slice
# io.max entry; the reconcile and mdt-host-check.sh warn "UNCAPPED SWAP" otherwise.
# Absolute values (DEV_SWAP_MAX=8G, DEV_GATES_MEMORY_SWAP_MAX=2G) remain available if you
# also want a smaller allowance. A large allowance lets a disposable gate swap a lot,
# which the IO cap then slows rather than prevents.
# Allowed DEV_SWAP_CASCADE_PCT: a whole number 1-100, no `%` sign
# Allowed DEV_SWAP_MAX, DEV_{INTERACTIVE,BACKGROUND,GATES,BUILDKITD}_MEMORY_SWAP_MAX: auto | - | a positive size with an optional K/M/G/T suffix (e.g. 500M, 2.5G, 2048K) or a bare byte count; empty means auto
DEV_SWAP_CASCADE_PCT=80
DEV_SWAP_MAX=auto

## 2.3 zswap writeback anchor                                          [render]
# Whether the WHOLE dev tier's coldest pages may drain from zswap out to disk swap. The
# yes/no tradeoff is explained once, at DEV_INTERACTIVE_ZSWAP_WRITEBACK (section 3).
# IMPORTANT: this does NOT cascade to children (verified live 2026-09-12: writing 0 here
# left a child's own file reading 1). Enforcement is hierarchical the OTHER way: a 0 on
# ANY ancestor silently disables writeback for the WHOLE subtree below it. So this is NOT
# how you set the policy for children (each tier has its own explicit line); it exists
# ONLY as a safety anchor against a future accident that sets an ancestor to 0. Full
# reasoning: units/dev.slice.in's MemoryZSwapWriteback comment, CGROUP-NOTES.md "zswap
# writeback - who may page to disk".
# Allowed DEV_ZSWAP_WRITEBACK, DEV_{INTERACTIVE,BACKGROUND,GATES,BUILDKITD}_ZSWAP_WRITEBACK: yes | no
DEV_ZSWAP_WRITEBACK=yes

## 2.4 Memory                                                          [render]
# Every governed slice is asked for all four cgroup-v2 memory controls. For dev.slice,
# DEV_MEMORY_MIN_GUARANTEED_CEILING (section 3, the guaranteed sibling) is the one
# authoritative MemoryMin key and is also rendered on dev-memory_min_guaranteed.slice;
# there is intentionally no second root MemoryMin variable. The other rules (empty,
# `-`, ordering, MemoryMax = RAM only) are in section 3's shared rules.
# Allowed DEV_MEMORY_{LOW,HIGH,MAX}: empty or `-` (omit this directive) or a positive size with an optional K/M/G/T suffix (e.g. 500M, 2.5G, 2048K) or a bare byte count; keep MemoryMin <= MemoryLow <= MemoryHigh <= MemoryMax
DEV_MEMORY_LOW=
DEV_MEMORY_HIGH=
DEV_MEMORY_MAX=

## -- 3. Tier slices - the five children of dev.slice --------------------------
# [render]
# The tiers share one set of controls, so the rules are stated ONCE here; each tier's
# block below says only what is different about it.
#
# MEMORY. MemoryMin <= MemoryLow <= MemoryHigh <= MemoryMax is checked in KiB by the
# wizard; an empty field is not silently substituted or clamped. An empty or `-` value
# means the operator chose no directive. This holds for every optional setting of a tier,
# not only memory: install.sh drops any rendered line that resolves to a bare `Key=`, so
# "not set" means "not applied", never "apply some fallback number". The wizard shows host-sized suggestions for every field (Enter
# accepts one, `-` omits). It re-prompts when one slice's fields violate the order, or
# when one child's High/Max exceeds the configured dev.slice parent. Siblings are
# independent: their combined Low/High totals may exceed the parent and are reported as
# advisory warnings, not a summed-budget error. MemoryMax is RAM only; MemorySwapMax is a
# separate swap-only ceiling (section 2.2): `auto` derives it from DEV_SWAP_CASCADE_PCT%
# of dev.slice's own derived ceiling. It is relaxed on purpose for the batch tiers: a
# gate/build that swaps just finishes slowly, while one that OOMs fails outright.
#
# CPU. CPU_WEIGHT is a relative share. CPU_QUOTA is an absolute ceiling and auto-detects
# per section 2.1 ((nproc - MDT_EXCLUDED_CPU_CORES - DEV_TIER_EXCLUDED_CPU_CORES) cores; `-` omits it).
#
# IO. Absolute caps live in section 4. IO WEIGHTS depend on the weight mechanism
# (IO_ROOT_SCHEDULER / IO_COST_QOS, section 4.7):
#   io.cost enabled (IO_COST_QOS not off): io.weight 1..10000 is used DIRECTLY, no
#     rescaling; any ratio is exact. Needs a device model (IO_COST_MODEL).
#   BFQ scheduler: KEEP IO WEIGHTS <= 100. systemd's IOWeight is 1..10000 but BFQ
#     schedules on io.bfq.weight (1..1000); systemd maps 1..100 through unchanged
#     and compresses everything above 100 by ~11x. So 100-vs-10 below is a true
#     10:1, while "improving" this to 1000-vs-10 would silently be 181-vs-10.
#     Full mapping table + verification commands: CGROUP-NOTES.md §BFQ.
#   neither (none / mq-deadline without io.cost): weights are inert; only the
#     io.max caps enforce. mdt-host-check.sh reports which mechanism is live.
#
# ZSWAP WRITEBACK does NOT inherit from DEV_ZSWAP_WRITEBACK (section 2.3): each tier has
# its own explicit line.
#
# OOM. Only dev-background and dev-gates have an oomd pressure limit; dev-interactive
# (the IDE) never gets OOMD protection.
#
# Grammars shared by all four per-tier blocks (the guaranteed sibling has its own line):
# Allowed DEV_{INTERACTIVE,BACKGROUND,GATES,BUILDKITD}_MEMORY_{MIN,LOW,HIGH,MAX}: empty or `-` (omit this directive) or a positive size with an optional K/M/G/T suffix (e.g. 500M, 2.5G, 2048K) or a bare byte count; keep MemoryMin <= MemoryLow <= MemoryHigh <= MemoryMax
# Allowed DEV_{INTERACTIVE,BACKGROUND,GATES,BUILDKITD}_CPU_WEIGHT, DEV_{INTERACTIVE,BACKGROUND,GATES,BUILDKITD}_IO_WEIGHT: a whole number 1-10000 (on a BFQ host keep <= 100)
# Allowed DEV_{BACKGROUND,GATES}_OOM_PRESSURE_LIMIT: N% with N in 1-100 (the `%` is required)

## 3.1 dev-interactive.slice - devcontainers + IDE
DEV_INTERACTIVE_MEMORY_MIN=
DEV_INTERACTIVE_MEMORY_LOW=2.5G
DEV_INTERACTIVE_MEMORY_HIGH=3G
DEV_INTERACTIVE_MEMORY_MAX=5G
DEV_INTERACTIVE_MEMORY_SWAP_MAX=auto
DEV_INTERACTIVE_CPU_WEIGHT=200
DEV_INTERACTIVE_CPU_QUOTA=auto
DEV_INTERACTIVE_IO_WEIGHT=100
# Whether this tier's coldest pages may drain out of zswap onto disk swap.
#
#   yes (default) - zswap stays a CACHE. Its LRU evicts only the coldest-of-cold
#                   to disk, which frees pool RAM for pages that are actually
#                   warm, including other tiers'. On a memory-tight host this
#                   is what keeps the pool useful rather than full of an IDE's
#                   long-idle tail.
#   no            - the tier's cold tail is pinned in compressed RAM forever.
#                   Protects against disk swap-in stalls (an IDE freeze of a
#                   few hundred ms), at the cost of permanently occupying pool
#                   RAM with pages nobody is touching.
#
# Set "no" only if you measure IDE stalls attributable to swap-in. The pool is a fixed
# share of RAM (zswap max_pool_percent): pinning one tier's cold tail there takes that
# RAM away from every other tier.
DEV_INTERACTIVE_ZSWAP_WRITEBACK=yes

## 3.2 dev-background.slice - long-running stacks
# BOTH the Docker daemon-wide fallback for anything that names no cgroup-parent at all
# (section 7) AND the explicit tier for long-running application stacks. Gate/lane
# containers use the sibling dev-gates.slice; short builds use their declared build tier.
# Cold background pages MAY be written back to disk: that is the point of the tier.
# The oomd limit is relaxed on purpose, same swap-capacity reasoning as the swap rule
# above: let sustained pressure run longer before oomd kills the worst offender in this
# tier, rather than reacting to a moderate, swap-absorbable spike.
# IO weight 10 vs interactive's 100 is a true 10:1 on io.cost, and on BFQ only because
# both sides stay <= 100.
DEV_BACKGROUND_MEMORY_MIN=
DEV_BACKGROUND_MEMORY_LOW=
DEV_BACKGROUND_MEMORY_HIGH=5G
DEV_BACKGROUND_MEMORY_MAX=8G
DEV_BACKGROUND_MEMORY_SWAP_MAX=auto
DEV_BACKGROUND_CPU_WEIGHT=20
DEV_BACKGROUND_CPU_QUOTA=auto
DEV_BACKGROUND_IO_WEIGHT=10
DEV_BACKGROUND_OOM_PRESSURE_LIMIT=75%
DEV_BACKGROUND_ZSWAP_WRITEBACK=yes

## 3.3 dev-gates.slice - gate and lane containers + placed lane leaves
# SIBLING of dev-background.slice under dev.slice: the admission capacity object (D-19).
# Every lane container and every placed lane leaf rg-<token> (D-20) lives here instead
# of sharing dev-background.slice with long-running dev stacks (dstdns, ...), which stay
# there. Filed from the 2026-08-04 finding recorded in memory
# `soulmask-memory-pressure-findings.md`: gates used to start with only ~2 GiB of
# dev-background.slice's memory.high before throttling, behind an unrelated ~4 GiB stack.
# See run-gate-project/nyxloom-trove/DESIGN-2026-09-12-liveness-placement-admission.md
# D-19/D-20/D-25 and units/dev-gates.slice.in.
# Sizing is for a 16 GiB host (defaults from the design's D-19/§3 table), expected to be
# re-tuned from admission-usage data (design doc §7). This tier ALSO gets a tight
# absolute IO cap and the runtime IOPS sub-ceiling (section 4).
# DEV_GATES_OOM_PRESSURE_LIMIT is an independent knob from the background one (not
# literally shared) so the two can be tuned apart later; it ships with the same default
# and reasoning: let sustained pressure run longer, given this host's ample swap.
DEV_GATES_MEMORY_MIN=
DEV_GATES_MEMORY_LOW=
DEV_GATES_MEMORY_HIGH=800M
DEV_GATES_MEMORY_MAX=1.5G
DEV_GATES_MEMORY_SWAP_MAX=auto
DEV_GATES_CPU_WEIGHT=20
DEV_GATES_CPU_QUOTA=auto
DEV_GATES_IO_WEIGHT=10
DEV_GATES_OOM_PRESSURE_LIMIT=75%
DEV_GATES_ZSWAP_WRITEBACK=yes

## 3.4 dev-memory_min_guaranteed.slice - individually-governed containers
# SIBLING of the other tiers under dev.slice, for containers that need a real memory.min
# floor against zswap-refault thrashing (continuously-processing workloads sharing this
# host with a production tier; see CGROUP-NOTES.md "Per-container memory.min
# guarantees", filed from dstdns's P165 sql-mutation-gate incident, D-373).
#
# Left UNSET by default: an empty ceiling drops the MemoryMin directive from BOTH this
# slice and dev.slice (install.sh's render rule), so the whole mechanism is inert until a
# host operator deliberately opts in.
#
# THE ONE RULE THAT MATTERS: MemoryMin is read by BOTH dev-memory_min_guaranteed.slice.in
# AND dev.slice.in -- the SAME variable, never two. The wizard asks this sibling's
# complete MemoryMin/MemoryLow/MemoryHigh/MemoryMax sequence; only MemoryMin (the
# CEILING) is shared, the other three are sibling-local. Setting the shared value higher
# than what the containers placed in this slice currently claim leaks the surplus to
# dev-interactive.slice and dev-background.slice via cgroup v2's proportional
# redistribution (CGROUP-NOTES.md has the mechanism and the accepted, bounded residual
# leak when the slice is under-utilized relative to this ceiling). Measure the real
# hot-set size before choosing a number (scripts/damon-analysis + scripts/cgroup-profiler's
# `--damon` flag, ATTACH-GUIDE.md §6) rather than guessing: soulmask_tmpfs.slice's own T1
# floor was corrected 250M->30M after measurement showed the first estimate was 8x too
# generous. Keep it small: this host had ~367M genuinely free under normal production
# load at time of writing (D-373).
# Allowed DEV_MEMORY_MIN_GUARANTEED_{CEILING,LOW,HIGH,MAX}: empty or `-` (omit this directive) or a positive size with an optional K/M/G/T suffix (e.g. 500M, 2.5G, 2048K) or a bare byte count; keep MemoryMin <= MemoryLow <= MemoryHigh <= MemoryMax; empty CEILING keeps the whole mechanism inert
DEV_MEMORY_MIN_GUARANTEED_CEILING=
DEV_MEMORY_MIN_GUARANTEED_LOW=
DEV_MEMORY_MIN_GUARANTEED_HIGH=
DEV_MEMORY_MIN_GUARANTEED_MAX=

## 3.5 dev-buildkitd.slice - host-managed BuildKit worker
# A SIBLING of the other tiers under dev.slice, not nested under either: one shared,
# long-lived builder serving every project, not a per-invocation background job (see
# plan-buildkitd-service.md §1). It runs as a plain `docker run
# --cgroup-parent=dev-buildkitd.slice` container (mdt-buildkitd.service), never through
# Buildx's own driver machinery: Buildx's `cgroup-parent` driver-opt does not reliably
# place a container with Docker's systemd cgroup driver (source-verified,
# docs/BUILD-ARCHITECTURE.md), while a plain `docker run --cgroup-parent=...` does
# (verified live, plan-buildkitd-service.md §0). The devcontainer reaches it through a
# Unix socket bind mount (templates/devcontainer.json's mandatory BUILDKIT_HOST and
# socket mount).
# Sizing must cover CONCURRENT multi-project builds (mdt release, pwmcp, anything that
# adopts the shared builder), not one build at a time; these are starting points to
# review like every other tier. A running build IS latency-sensitive to whoever waits
# on it (unlike dev-background.slice's idle soak work), so its weights sit between
# interactive's 100 and background's 10.
# This tier ALSO gets the runtime IOPS sub-ceiling (section 4.4).
DEV_BUILDKITD_MEMORY_MIN=
DEV_BUILDKITD_MEMORY_LOW=
DEV_BUILDKITD_MEMORY_HIGH=1.5G
DEV_BUILDKITD_MEMORY_MAX=2G
DEV_BUILDKITD_MEMORY_SWAP_MAX=auto
DEV_BUILDKITD_CPU_WEIGHT=50
DEV_BUILDKITD_CPU_QUOTA=auto
DEV_BUILDKITD_IO_WEIGHT=50
DEV_BUILDKITD_ZSWAP_WRITEBACK=yes
# One shared BuildKit version for every consumer of this builder (decided, see
# plan-buildkitd-service.md §2): cmru itself isn't version-sensitive, but an individual
# project's Dockerfile is capped at whatever BuildKit features this one pinned version
# supports. Rootless variant: a build daemon executes arbitrary Dockerfile RUN content,
# so this is the meaningfully safer default, not merely a tolerable one (root-vs-rootless
# tradeoffs: plan-buildkitd-service.md §2).
# Allowed DEV_BUILDKITD_IMAGE: a shell-safe OCI image reference (letters, digits and . _ / @ : + [ ] -); Docker decides whether it exists
DEV_BUILDKITD_IMAGE="moby/buildkit:buildx-stable-1-rootless"
# Where the managed BuildKit worker keeps its build cache and unpacked layer snapshots, the data every build
# reads and writes heavily. The only process that uses it is the `mdt-buildkitd` container (rootless BuildKit, uid
# 1000 inside), at /home/user/.local/share/buildkit; clients (buildx in a devcontainer) never touch it, they talk to
# the worker over its socket. Two forms, both a plain `docker run -v SOURCE:...` source:
#   a Docker volume name (the default `mdt-buildkitd-cache`): Docker keeps it under its data root, on that filesystem;
#   an absolute HOST path: bind-mounted, so the cache can live on any filesystem you choose (for example a compressed
#   btrfs subvolume, see docs/BTRFS-COW.md). The path must exist as a real directory (not a symlink) owned by 1000:1000;
#   install.sh and the unit refuse to start otherwise, so Docker never creates a missing directory on the root
#   filesystem. (An existing but unmounted mountpoint directory still passes: keep the mount itself reliable, for
#   example `RequiresMountsFor=` on a drop-in.) Changing it starts with a cold cache (nothing is migrated).
# Allowed DEV_BUILDKITD_CACHE: a Docker volume name (letters, digits and . _ -) or an absolute path (letters, digits and . _ / + -)
DEV_BUILDKITD_CACHE="mdt-buildkitd-cache"
# Maximum concurrent solver operations inside the managed daemon. This limits BuildKit's
# internal parallel work; it does not serialize client requests and is separate from the
# release repack controls REPACK_JOBS/REPACK_CONCURRENCY.
# Allowed DEV_BUILDKITD_MAX_PARALLELISM: a positive whole number
DEV_BUILDKITD_MAX_PARALLELISM=4
# Upper bound of the BuildKit build cache, in GB (gckeepstorage). Beyond it BuildKit deletes the least recently used cache
# entries that no running build needs; a later build that needs them rebuilds them. Size it below the free space of the
# DEV_BUILDKITD_CACHE filesystem, counting what it shares with other users (with compression the on-disk size is smaller than
# the logical size BuildKit counts). Applied by install.sh plus `systemctl restart mdt-buildkitd` (interrupts running builds).
# Allowed DEV_BUILDKITD_GC_KEEP: a positive whole number of GB
DEV_BUILDKITD_GC_KEEP=50

## -- 4. IO governance ---------------------------------------------------------
# How the dev tier's disk IO is bounded, from the last-resort static value up to the
# measured baseline. For every dev.slice value the EFFECTIVE cap is:
#   the operator pin (4.2), when set; else DEV_IO_CAP_PCT% of a current, PLAUSIBLE
#   baseline (4.4, 4.5); else the static fallback (4.1). A pin AND a baseline: the
#   smaller wins.

## 4.0 Host role                                                      [render]
# WHO ELSE USES THIS DISK decides how hard the dev tier may press it.
#   shared-prod    production workloads (a game server, a live service) run on this host.
#                  dev.slice keeps the CONSERVATIVE rule above (pin, else a percentage of a
#                  baseline, else the static fallback 4.1): protecting production wins.
#   dedicated-dev  sole-tenant dev/test host (e.g. the netcup test hosts): nothing to protect
#                  but the dev tier's own responsiveness.  dev.slice's absolute ceiling is
#                  the MEASURED device capacity from the iobench calibration
#                  (/var/lib/iobench/result.json, proposals.caps.dev_aggregate; iobench already
#                  leaves its utilisation headroom), or your pin (4.2) per value.  The
#                  goal is HIGH device utilisation WITHOUT losing responsiveness: the
#                  gate/BuildKit sub-ceilings (4.3), IOWeight, the PSI guard and the optional
#                  io.cost QoS latency targets (4.7) stay in force.  There is NO static
#                  fallback on this role (a guessed 500 IOPS throttled every gate lane of a
#                  disk that does 8000): without a pin or a verified measurement for the
#                  root disk, install.sh refuses and the reconcile keeps the cap in force and
#                  fails, naming the remedy (run `iobench calibrate`, or pin 4.2).
#                  Memory (4.0b): dev.slice MemoryMax = RAM + swap - DEV_HOST_MEMORY_KEEP, no per-tier
#                  memory ceilings, the host's services protected (MemoryLow, OOM score).
#   empty          not decided: treated as shared-prod, with a NOTICE on every install. The
#                  wizard (install.sh --wizard) asks this FIRST.
# Allowed HOST_ROLE: empty | shared-prod | dedicated-dev
HOST_ROLE=

## 4.0b Memory of the dedicated-dev role (MDT-TESTHOST-MEM)                [render]
# Read ONLY when HOST_ROLE=dedicated-dev; shared-prod keeps every memory value of sections 2.4 and 3
# exactly as configured. A sole-tenant dev/test host is planned for OVERCOMMIT: the whole of RAM plus
# disk swap is the dev tier's, except what the host itself keeps. The tiers (3.1-3.5) must not hit an
# artificial ceiling tighter than dev.slice (one cmru lane is 1-1.75 GiB, an mdt-cockpit test peaks
# above 4 GiB, and 4-5 run in parallel), so on this role:
#   dev.slice MemoryMax   = MemTotal + SwapTotal - MDT_EXCLUDED_RAM - MDT_EXCLUDED_SWAP - DEV_HOST_MEMORY_KEEP
#                           (the combined RAM+swap ceiling; the kernel's memory.max itself counts RAM only,
#                           so with swap it is the leak backstop and the real limits are the two below)
#   dev.slice MemoryHigh  = MemTotal - MDT_EXCLUDED_RAM - DEV_HOST_MEMORY_KEEP   (the RAM the dev tier may
#                           hold; above it the kernel reclaims the tier into zswap/swap, throttling it
#                           instead of taking pages from the host)
#   dev.slice MemoryLow   = the sum of the tiers' MemoryLow values (a tier's Low only protects when its
#                           ancestors carry it too)
#   tiers                 : DEV_{INTERACTIVE,BACKGROUND,GATES,BUILDKITD}_MEMORY_{HIGH,MAX} are IGNORED (no
#                           directive is rendered; install.sh names the values it ignored). Protection
#                           instead: MemoryLow/MemoryMin (kept as configured), CPU/IO weights, oomd.
#                           A tier's MemorySwapMax equals dev.slice's (DEV_SWAP_CASCADE_PCT is not applied).
#   explicit pins         : a non-empty DEV_MEMORY_HIGH / DEV_MEMORY_MAX / DEV_MEMORY_LOW is a pin and wins
#                           per value; `-` omits the directive.
#   host protection       : system.slice MemoryLow = DEV_HOST_MEMORY_KEEP (reclaim takes dev pages first),
#                           OOMScoreAdjust=-900 drop-in on every DEV_HOST_PROTECTED_UNITS member (the kernel
#                           OOM killer takes the dev tier first; a unit that already has a lower value, e.g.
#                           containerd -999, is left alone), and mdt-psi-guard watches those units' pressure.
#                           A running service's score is lowered in place; nothing is restarted.
# DEV_HOST_MEMORY_KEEP: RAM and swap kept for the host itself. Not named *_RESERVE_*: those keys are refused
#   (host-setup/README.md "Renamed keys (2026-11)"). Refused: 0, empty, or so large that less than 1G of RAM is left.
# DEV_HOST_PROTECTED_UNITS: empty = ssh.service docker.service containerd.service cgpd.service
#   mdt-psi-guard.service systemd-journald.service systemd-oomd.service; `-` = none; else space-separated units.
# Allowed DEV_HOST_MEMORY_KEEP: a positive size with an optional K/M/G/T suffix (e.g. 512M, 1G) or a bare byte count; 0 and empty are refused
# Allowed DEV_HOST_PROTECTED_UNITS: empty (the default list) | `-` (none) | space-separated systemd unit names (e.g. ssh.service docker.service)
DEV_HOST_MEMORY_KEEP=512M
DEV_HOST_PROTECTED_UNITS=

## 4.1 Static fallbacks                                                [render]
# Boot-window values. The wizard asks for them explicitly because they are real hard
# caps, not merely explanatory defaults. They are written into dev.slice's unit file and
# apply to the aggregate dev tier from boot, and whenever no identity-verified baseline
# is available; the reconciliation service replaces them at runtime with measured
# percentage caps after a valid baseline. They do NOT apply per container: per-container
# limits require current identity-verified benchmark results, and no rate is invented
# when results are absent. They are used only when no DEV_IO_*_MAX pin (4.2) is set for
# that value: ONE source renders the unit file AND the runtime fallback.
# Allowed DEV_STATIC_{R,W}IOPS: a positive whole number (IOPS)
# Allowed DEV_STATIC_{R,W}BW: a positive size with an optional K/M/G/T suffix (e.g. 500M, 2.5G, 2048K) or a bare byte count (bytes/s)
DEV_STATIC_RIOPS=500
DEV_STATIC_WIOPS=500
DEV_STATIC_RBW=150M
DEV_STATIC_WBW=150M

## 4.2 Operator pins for dev.slice                                    [runtime]
# Absolute dev.slice caps (empty = not pinned; no reinstall needed). Recommended on a
# VIRTUAL disk, where a benchmark can read the hypervisor's write-back cache: one host
# measured 4.3 GB/s / 94k IOPS from a disk that saturated at ~20 MB/s with 35-60 ms
# write latency, so a percentage of that baseline never bound. Pinned values also become
# the static fallback in the unit (re-run install.sh once to refresh it).
# Positive integers with an optional K/M/G/T suffix (base 1024; bytes/s for the
# bandwidth pair). 0 is refused: in io.max it halts IO, it is not unlimited.
# Take them from a SUSTAINED measurement (fio --direct=1 --fsync=1 for minutes, last
# minute only, or `iostat -x 5` while saturated), never from a burst.
# ILLUSTRATION ONLY, not a host fact: the numbers one 16 GiB virtio host was pinned to
# after the incident above were
#   DEV_IO_RBPS_MAX=80M  DEV_IO_WBPS_MAX=40M  DEV_IO_RIOPS_MAX=800  DEV_IO_WIOPS_MAX=600
# Allowed DEV_IO_{R,W}{BPS,IOPS}_MAX: empty (not pinned) or a positive whole number with an optional K/M/G/T suffix (base 1024); 0 is refused
DEV_IO_RBPS_MAX=
DEV_IO_WBPS_MAX=
DEV_IO_RIOPS_MAX=
DEV_IO_WIOPS_MAX=

## 4.3 Per-tier pins                                                  [runtime]
# Absolute IO caps per tier (empty = not set), same value rules as 4.2.
# THE GATE TIER IS THE POINT: swap stays ample (section 2.2), and instead the disposable
# gate tier gets a TIGHT IO cap. Swap-out IO is charged to the page owner's cgroup, so a
# gate that swaps is throttled by its own IO cap and cannot thrash the shared disk. A
# throttled gate stalls and runs slowly: that is an infrastructure-classified slowdown,
# not a product failure.
# The IOPS pair is combined with the DEV_SUBSLICE_IOPS_PCT sub-ceiling (4.4) as
# min(sub-ceiling, absolute); bandwidth is applied only when set.
# ILLUSTRATION ONLY (one host): dev-gates 40M / 20M / 300 / 200 under the 80M / 40M /
# 800 / 600 dev.slice pins above.
# Clearing a pin on a gates or buildkitd slice takes effect on the next run. For
# interactive/background, clearing ALL their pins leaves the last runtime value until
# reboot (or run `systemctl set-property --runtime <slice> IOReadBandwidthMax=` once).
# Allowed DEV_{GATES,BUILDKITD,INTERACTIVE,BACKGROUND}_IO_{R,W}{BPS,IOPS}_MAX: empty (not set) or a positive whole number with an optional K/M/G/T suffix (base 1024); 0 is refused
DEV_GATES_IO_RBPS_MAX=
DEV_GATES_IO_WBPS_MAX=
DEV_GATES_IO_RIOPS_MAX=
DEV_GATES_IO_WIOPS_MAX=
DEV_BUILDKITD_IO_RBPS_MAX=
DEV_BUILDKITD_IO_WBPS_MAX=
DEV_BUILDKITD_IO_RIOPS_MAX=
DEV_BUILDKITD_IO_WIOPS_MAX=
DEV_INTERACTIVE_IO_RBPS_MAX=
DEV_INTERACTIVE_IO_WBPS_MAX=
DEV_INTERACTIVE_IO_RIOPS_MAX=
DEV_INTERACTIVE_IO_WIOPS_MAX=
DEV_BACKGROUND_IO_RBPS_MAX=
DEV_BACKGROUND_IO_WBPS_MAX=
DEV_BACKGROUND_IO_RIOPS_MAX=
DEV_BACKGROUND_IO_WIOPS_MAX=

## 4.4 Runtime caps - percentages of the measured baseline            [runtime]
# Re-read by mdt-dev-governance-reconcile.sh on every run. Both percentages are of the
# MEASURED device ceilings in io-baseline.env (4.5), and both belong in the 60-80% band.
# Never cap at 100%: a device driven to saturation queues everything, and the whole point
# of the caps is that the host's latency-sensitive work (production, elsewhere) never
# waits behind a build storm. Below ~60% you stop bounding a burst and start throttling
# ordinary work: builds crawl for no protective gain.
#
# The two percentages answer DIFFERENT questions and are not interchangeable (see
# docs/BUILD-ARCHITECTURE.md "Resource-governance boundaries" and ciu/docs/DESIGN-NOTES.md
# D3):
#   DEV_IO_CAP_PCT protects PRODUCTION from the whole dev tier combined (an aggregate
#     ceiling on dev.slice). It does NOT protect dev containers from EACH OTHER: one
#     greedy container can claim the whole budget without exceeding this cap. It
#     sits at the low end of the band because "the estate" can be 15+ containers.
#   WATCHER_IO_CAP_PCT protects dev containers from EACH OTHER (a per-container ceiling).
#     It does NOT protect production by itself, and for the containers it targets it is
#     CURRENTLY THEIR ONLY ceiling: source-verified (docs/BUILD-ARCHITECTURE.md "How the
#     cgroup controls compose"), Buildx's own `cgroup-parent` driver-opt is unreliable
#     under Docker's systemd cgroup driver, so buildx_buildkit_* workers cannot be PLACED
#     under dev.slice at all (verified live: they land in system.slice, not
#     dev-background.slice). DEV_IO_CAP_PCT's aggregate genuinely does not reach them;
#     this sweep's per-scope cap is the only governance that does. True buildkit slice
#     placement would need a host-managed buildkitd service plus a Buildx `remote`
#     driver, not a driver-opt. It sits at the high end of the band: ONE container's
#     share, not an aggregate.
#     Targets: test-runner-style ("bench") containers, buildkit workers, and the
#     devcontainer itself (CGROUP-NOTES.md §2, "containers we don't directly control the
#     invocation of"). Anything cmru/mdt itself spawns directly instead gets explicit
#     --memory/--cpus/--device-*-iops flags at create time (cmru/src/cmru/tester_gate.py's
#     CMRU_TESTER_* defaults: 8g/20g/1.5 cores), a stronger create-time guarantee this
#     sweep does not duplicate.
# cgroup limits nest (effective = the tightest applicable control, at the leaf AND every
# ancestor), so the two are complementary layers, not either/or (see
# scripts/gstammtisch-guide/plan-host-resource-governance.md item #7/#12).
#
# DEV_IO_CAP_PCT is applied to a baseline ONLY when that baseline is current (same kernel,
# same disk) and plausible; the reconcile reads the kernel io.max back after every apply
# and exits non-zero if it differs from what was intended.
# Allowed DEV_IO_CAP_PCT, WATCHER_IO_CAP_PCT: a whole number 1-99, no `%` sign (outside the 60-80 band is accepted with a warning)
DEV_IO_CAP_PCT=60
WATCHER_IO_CAP_PCT=80
# IOPS sub-ceiling for dev-gates.slice and dev-buildkitd.slice specifically. Runtime-only
# (the reconcile applies it against whatever it just measured for dev.slice; there is no
# static unit-file line), tighter than the shared ceiling so neither can alone claim the
# whole dev.slice IOPS budget. IOPS only, deliberately: bandwidth is left at whatever the
# shared ceiling allows both of them.
# Allowed DEV_SUBSLICE_IOPS_PCT: a whole number 1-100, no `%` sign
DEV_SUBSLICE_IOPS_PCT=60

## 4.5 Baseline file (benchmark results)                              [runtime]
# Where mdt-io-baseline.py writes the shared Linux-derived io.cost coefficient matrix and
# where mdt-dev-governance-reconcile.sh reads it. The benchmark always targets the
# persistent file below, never a raw block device, and it must be on the same
# filesystem/device as Docker data. Result reuse is identity-based (device, topology,
# target and benchmark implementation), not a time limit: a disk replacement or target
# move requires a new measurement.
#
# IO_BASELINE_ROTATIONAL_FLAG (runtime-optional): empty = trust queue/rotational.
# virtio-blk reports rotational=1 by default, so a genuinely fast virtio disk can have
# its baseline refused as implausible (a rotational device above 1 GiB/s sequential or
# 20,000 random 4 KiB IOPS is treated as a cache reading). Set `ignore` only if you know
# the disk is fast and not cache-inflated, and pin DEV_IO_*_MAX (4.2) from a sustained
# measurement either way.
# Allowed IO_BASELINE_ROTATIONAL_FLAG: empty (trust queue/rotational) | ignore
IO_BASELINE_ROTATIONAL_FLAG=
# Allowed IO_BASELINE_{ENV,TESTFILE}: an absolute path without whitespace or shell-special characters
IO_BASELINE_ENV=/var/lib/mdt/io-baseline.env
IO_BASELINE_TESTFILE=/var/lib/mdt/iocost-coef-fio.testfile
# Interop with ciu governance: it caps compose services per container and reads the same
# file format, deriving read_iops as 2/3 of RIOPS_MAX. ciu searches
# /var/lib/ciu/io-baseline.env, NOT this path, so measure once and share it:
#   echo 'CIU_GOV_BASELINE_PATH=/var/lib/mdt/io-baseline.env' >> /etc/environment
# or set IO_BASELINE_ENV=/var/lib/ciu/io-baseline.env here and let ciu find it at its own
# default. Two independently measured baselines on one host is the thing to avoid: the
# tiers and the per-service caps then disagree.

## 4.6 Writeback and root-queue settings (host-global)                 [install]
# Bound how much dirty data and how many in-flight requests a slow shared disk can hold,
# so a journal commit or fsync does not wait behind a long backlog (measured: game
# D-state max 26.9 s -> 0.14 s, fsync max 39 s -> 0.5 s on one host). Why and how
# measured: scripts/gstammtisch-guide/HOST-IO-INTERFERENCE.md section 4.2 (A/B), 4.3 and
# 4.4 (matrices), recommendations in section 5, caveats in section 4.5; this repo's
# DESIGN-GUIDE (MDT-HS-05).
#
# Value grammar: a positive integer (bytes; KB for max_sectors_kb), or the explicit word
# `kernel` = leave the kernel's own value untouched and render no line. An empty value
# means the same as `kernel`. These are runtime-optional keys: an existing env file
# without them is NOT refused, they read as `kernel` (runtime-optional-keys.re); run
# install.sh --wizard to review them.
#
# Measured on gstammtisch 2026-10-20 (an EXAMPLE, NOT a default; your disk may differ;
# the wizard proposes from a current benchmark result when one exists):
#   dirty_bytes=16777216  dirty_background_bytes=4194304  nr_requests=16
#   max_sectors_kb=64
# Cost: sequential reads fell from ~1.2-1.4 GB/s to ~0.25-0.3 GB/s at 64 KB (section 4.4
# of that document); buffered reads were equal across 64-256 KB.
#
# vm.dirty_bytes / vm.dirty_background_bytes are HOST-GLOBAL: they also bound every
# production container's writeback (section 4.5 of that document). When both are set,
# dirty_background_bytes must be < dirty_bytes.
# Allowed IO_WRITEBACK_DIRTY_{,BACKGROUND_}BYTES: kernel | a positive whole number of bytes (dirty_bytes: at least two pages; dirty_background_bytes < dirty_bytes)
IO_WRITEBACK_DIRTY_BYTES=kernel
IO_WRITEBACK_DIRTY_BACKGROUND_BYTES=kernel
# Root disk queue: the whole disk under / is derived at install, never a typed name.
# nr_requests >= 4; max_sectors_kb in [4, the disk's max_hw_sectors_kb], checked at
# install time against the live disk.
# Allowed IO_ROOT_QUEUE_NR_REQUESTS: kernel | a whole number >= 4
# Allowed IO_ROOT_QUEUE_MAX_SECTORS_KB: kernel | a whole number of KB from 4 up to the disk's max_hw_sectors_kb
IO_ROOT_QUEUE_NR_REQUESTS=kernel
IO_ROOT_QUEUE_MAX_SECTORS_KB=kernel

## 4.7 IO scheduler and io.cost (the weight mechanism)                 [install]
# io.cost replaces BFQ as the way cgroup io.weight is enforced. Measured on one host
# (IO-STALL-TESTING-GUIDE.md section 11; bfq C0, mq-deadline C1, mq-deadline + io.cost
# C2) under the same load: game D-state total/max 1.15 s / 96 ms (bfq), 0.61 s / 75 ms
# (mq-deadline alone, WORSE for sync writes: probe fdatasync p99 491 ms vs 205 ms),
# 0 / 0 (mq-deadline + io.cost), at no gate cost. io.latency is NOT available in
# Debian's kernel (CONFIG_BLK_CGROUP_IOLATENCY is not set). Enabling io.cost turns the
# writeback throttle (wbt) off. DESIGN-GUIDE (MDT-HS-07) has the reasoning.
#
# IO_ROOT_SCHEDULER: mq-deadline | none | bfq | kernel. Must be one of the schedulers the
# derived root disk lists in queue/scheduler (the wizard reads that list). `kernel`
# leaves the kernel's choice untouched and renders no rule. EMPTY or ABSENT = not
# managed: an old env file keeps the legacy BFQ rule until the wizard is run. Rendered as
# 60-mdt-io-scheduler.rules for the derived disk; the bfq module is loaded at boot only
# when this is `bfq`.
# Allowed IO_ROOT_SCHEDULER: mq-deadline | none | bfq | kernel (must be listed in the root disk's queue/scheduler); empty = not managed
IO_ROOT_SCHEDULER="kernel"
# IO_COST_MODEL: `kernel` (writes ctrl=auto: the kernel's default model is a
# rotational/ssd HEURISTIC) or six positive integers, in quotes, in this order:
# "rbps rseqiops rrandiops wbps wseqiops wrandiops" (the linear model). A wrong model
# throttles at the wrong rate. Measured example, NOT a default (gstammtisch 2026-10-20,
# section 11): "290000000 4900 4900 14680064 2800 2800". The wizard proposes one from an
# identity-verified benchmark result when it exists. Empty/absent = not managed.
# Allowed IO_COST_MODEL: kernel | six positive integers in quotes "rbps rseqiops rrandiops wbps wseqiops wrandiops"; empty = not managed
IO_COST_MODEL="kernel"
# IO_COST_QOS: `off` (writes enable=0) or six numbers, in quotes:
# "rpct rlat wpct wlat min max" (percentiles 0..100 with at most 2 decimals; latencies in
# microseconds; min/max 1.00..10000.00 with min <= max: the kernel clamps silently outside
# that and refuses min > max, block/blk-iocost.c ioc_qos_write, Linux v6.12). Measured
# example, NOT a default (gstammtisch, section 11): "95 5000 95 20000 5 400" removed the
# game's IO waits entirely. The policy default is `off` (explicit). Empty/absent = not
# managed.
# Allowed IO_COST_QOS: off | six numbers in quotes "rpct rlat wpct wlat min max"; empty = not managed
IO_COST_QOS="off"

## -- 5. BuildKit and devcontainer policies ------------------------------------

## 5.1 Accidental Buildx workers                          [install] / [runtime]
# [install] install.sh validates the policy and starts/keeps mdt-buildkit-guard.service
# accordingly (`terminate` needs a recorded second confirmation); the name pattern below
# is [runtime], read by the IO sweep.
# The host-managed service (3.5) is the only normal BuildKit worker. Buildx's
# docker-container driver creates buildx_buildkit_* (or buildkit_buildkit_*) containers
# outside that service, so the event-driven guard treats them as unapproved workers once
# Docker inspect has verified their identity.
#
# Closed vocabulary:
#   report-only - log the decision and leave an unapproved worker running (default)
#   terminate   - remove an unapproved BuildKit worker (explicit opt-in)
# Allowed BUILDX_ACCIDENTAL_CONTAINER_POLICY: report-only | terminate (`terminate` needs a recorded second confirmation: install.sh --wizard)
BUILDX_ACCIDENTAL_CONTAINER_POLICY=report-only
# Correctly placed containers are selected by their cgroup path, not by an image/name
# guess. This pattern is only for an unapproved Buildx worker that landed outside the
# governed tree; the IO sweep (4.4, WATCHER_IO_CAP_PCT) then caps and deprioritizes it.
# Allowed WATCHER_BUILDKIT_NAME_PATTERNS: one or more space-separated shell globs (letters, digits and * ? [ ] / : . _ ^ ! -)
WATCHER_BUILDKIT_NAME_PATTERNS="buildx_buildkit_*"

## 5.2 Devcontainer host bootstrap                                  [runtime]
# Read by initialize_container_environment.py on the HOST at every devcontainer start.
# How it handles a missing bind source under $HOME. Its
# default policy creates a missing source from the raw source path: a trailing `/` means
# a directory, no `/` means an empty regular file. `fail` requires every `$HOME` source
# managed by the bootstrap to exist before Docker starts the devcontainer; the bootstrap
# then refuses with a message that names this variable, the allowed values and the exact
# path to create.
# Allowed DEVCONTAINER_MISSING_BIND_SOURCE_POLICY: create-by-spelling | fail
DEVCONTAINER_MISSING_BIND_SOURCE_POLICY=create-by-spelling

## -- 6. Reconcile sweep and container watchers --------------------------------

## 6.1 Periodic sweep timer                                            [render]
# How often mdt-dev-governance-reconcile.timer re-runs the reconciliation script. Left
# at 5min even though the per-container IO caps are only a backstop here
# (mdt-container-io-events-watcher.service applies those within the same second via
# `docker events`). Deliberately NOT raised: the SAME script/timer also carries the
# cgroup2 mount-flag check (6.2), which has no event trigger of its own for drift caused
# by something other than mdt's own host-exec/mdt-shell tooling (that case self-heals
# instantly via `mdt doctor`, run automatically after every host-exec/host-shell; see
# customization/mdt). Raising the interval would trade a real, incident-documented
# exposure window (CGROUP-NOTES.md §5) for no benefit, since the IO-cap improvement
# already comes from the watcher, not this interval.
# Allowed WATCHER_INTERVAL: one systemd duration token greater than zero (e.g. 5min, 30s, 1.5h); a bare number means seconds
WATCHER_INTERVAL=5min

## 6.2 cgroup2 mount flags                                            [runtime]
# nsdelegate, memory_recursiveprot, plus memory_hugetlb_accounting on kernel >= 6.6.
# systemd mounts these at boot, but a runtime remount from the init cgroup namespace can
# strip them (observed live), and without memory_recursiveprot every MemoryLow/MemoryMin
# on a slice silently stops protecting the container pages below it, with no other
# symptom.
#   fix = remount to restore, every sweep (default)   warn = log only, don't touch
# Allowed CGROUP2_FLAGS: fix | warn
CGROUP2_FLAGS=fix

## 6.3 Per-container memory watcher (mdt-container-memory-inotify-watcher.py)
# [install + service start]
# install.sh validates the policy; the watcher service reads this file ONCE at start, so
# restart mdt-container-memory-inotify-watcher.service after editing.
# Optional per-container MemoryHigh/MemoryMax defaults, applied when a new docker-*.scope
# appears under dev-interactive.slice, dev-background.slice or dev-gates.slice. `-` means
# no extra per-container memory directive; each tier's own slice limits still bound the
# combined workload. All shipped defaults are disabled (`-`) so MDT does not impose an
# unexpected leaf cap: configure explicit values only when this host wants this watcher
# to own the cap. A container's Docker `--memory` limit takes precedence, and CIU-managed
# Compose services normally have one already.
#
# Each watched slice has its own pair. The wizard asks MemoryHigh before MemoryMax and
# checks the relationship. `-` omits that directive; if both are `-`, the watcher applies
# no per-container memory or swap cap for it. The service itself is opt-in: `enabled`
# requires at least one configured per-container memory value; `disabled` requires all
# six values below to be `-`.
#
# Per-container SWAP ceiling: the "tight ceiling, generous swap" pairing, the real answer
# to "I want an anon ceiling per container". cgroup v2 has no anon-only cap, so bounding
# total resident (Max/High) while letting swap absorb anon growth beyond it is the
# standard way to express that in kernel terms. It reuses DEV_SWAP_CASCADE_PCT (section
# 2.2; the same percentage applied a third time: host swap -> dev.slice -> child slice ->
# this) rather than a separate variable, since it is the same design decision repeated
# at another level. It is computed from the matched slice's own LIVE memory.swap.max, not
# re-derived from this file; see read_slice_swap_max_bytes() in
# scripts/mdt-container-memory-inotify-watcher.py for why.
# Allowed WATCHER_MEMORY_POLICY: enabled | disabled
# Allowed WATCHER_{INTERACTIVE,BACKGROUND,GATES}_MEMORY_{HIGH,MAX}: `-` (no per-container directive) or a positive size with an optional K/M/G/T suffix (e.g. 500M, 2.5G, 2048K) or a bare byte count
WATCHER_MEMORY_POLICY=disabled
WATCHER_INTERACTIVE_MEMORY_HIGH=-
WATCHER_INTERACTIVE_MEMORY_MAX=-
WATCHER_BACKGROUND_MEMORY_HIGH=-
WATCHER_BACKGROUND_MEMORY_MAX=-
WATCHER_GATES_MEMORY_HIGH=-
WATCHER_GATES_MEMORY_MAX=-

## -- 7. Docker: default-limits backstop and daemon.json -----------------------

## 7.1 docker-.scope.d default-limits backstop (D-G8)                  [render]
# A container placed under a TYPO'D or nonexistent slice name fails OPEN: systemd silently
# auto-creates an unlimited transient slice and the container starts normally (verified;
# see nyxloom/docs/plan-resource-governance.md). This is the host-wide "never truly
# unbounded" floor for EVERY container docker starts, whichever parent slice it named,
# including production's (Soulmask/Jitsi containers get the same generic docker-<id>.scope
# naming, so this floor reaches them too).
# Size it GENEROUSLY, above any legitimate single container's real ceiling on this host:
# it is a backstop for the fail-open case, not a tier ceiling. Do not use it for the
# tight per-container defaults that dev/test/build containers get instead (explicit
# `docker run` flags in whatever spawns them, e.g. cmru's tester-gate).
# Other use: to protect the anon memory of running production services in a stable state
# (so a large container starting cannot cause evictions), lower `memory.max` here. Every
# container may still declare a higher limit of its own, but this backstop is the hard
# limit for all containers; OOM is still prevented by large swap space, and the backstop
# stops a single container from disturbing the stable state.
# Allowed DOCKER_SCOPE_BACKSTOP_MEMORY_{MAX,SWAP_MAX}: a positive size with an optional K/M/G/T suffix (e.g. 500M, 2.5G, 2048K) or a bare byte count
DOCKER_SCOPE_BACKSTOP_MEMORY_MAX=12G
DOCKER_SCOPE_BACKSTOP_MEMORY_SWAP_MAX=16G

## 7.2 /etc/docker/daemon.json                                         [render]
# Ownership split (D-F1): this tool owns ONLY cgroup-parent; assigning a default
# container cgroup placement is squarely an mdt/dev-workload concern. Base docker daemon
# policy (live-restore, log rotation) lives in debian-install-v2's installer.py
# (_configure_docker_daemon()), which merges its own disjoint keys the same
# order-independent way. install.sh MERGES this key into any existing
# /etc/docker/daemon.json rather than overwriting it, and never touches a key it does
# not own.
#
# cgroup-parent is the Docker daemon-wide default (D-G7): placement ONLY, for any
# container that names no --cgroup-parent of its own (an ad hoc host-admin `docker run`,
# a tool nobody has wired up yet). It needs a `dockerd` RESTART, not a reload, to take
# effect, and that restarts every running container: schedule it.
# Allowed DOCKER_DAEMON_CGROUP_PARENT: the name of an INSTALLED systemd slice ending in .slice (letters, digits and . _ @ : -)
DOCKER_DAEMON_CGROUP_PARENT=dev-background.slice

## -- 8. cgprofile host service (MDT-055) -----------------------------------------
# host-setup installs and pins the cgprofile daemon `cgpd` from the RELEASED wheel as a native
# systemd service (cgpd.service in cgprofile.slice). Everything is installed under /opt/cgprofile
# (one immutable venv per version, a `current` symlink), configured through /etc/cgprofile/cgpd.toml
# rendered from the keys below, and restarted only on drift, only after the live sessions drained.
# A host that never set CGPROFILE_ENABLE=1 is left exactly as it was (these keys are optional in an
# older /etc/mdt/host-setup.env and mean "not managed" when absent).

## 8.1 Pin                                                          [install]
# CGPROFILE_ENABLE=1 installs/updates the service; 0 leaves an existing install alone and
# mdt-host-check.sh reports it. CGPROFILE_WHEEL pins the cgprofile wheel as <version>@sha256:<hex>
# (the sha256 of cgprofile-<version>-py3-none-any.whl from the GitHub release, which the release
# publishes as a .sha256 sidecar); it is refused when empty while the service is enabled, and the
# digest is verified BEFORE anything is unpacked. cgprofile's only dependency is cli-extended, pinned
# the same way in CGPROFILE_CLI_EXTENDED_WHEEL (cli_extended-<version>-py3-none-any.whl), because the
# venv is built with `pip --no-index` (no network at service start, nothing from a checkout, nothing
# in a system interpreter). CGPROFILE_WHEEL_SOURCE says where the files come from: empty = the
# GitHub release downloads of the vbpub project, an https:// base URL laid out like those downloads
# (<base>/cgprofile-v<version>/<file>), or an absolute directory holding both files (an air-gapped
# host). A version directory is immutable: the same version with a different digest is refused.
# Allowed CGPROFILE_ENABLE: 0 | 1
CGPROFILE_ENABLE=0
# Allowed CGPROFILE_WHEEL, CGPROFILE_CLI_EXTENDED_WHEEL: empty, or <version>@sha256:<64 lowercase hex> (the cgprofile pin must be a 2.x or newer version)
CGPROFILE_WHEEL=""
CGPROFILE_CLI_EXTENDED_WHEEL=""
# Allowed CGPROFILE_WHEEL_SOURCE: empty, an https:// base URL, or an absolute directory path
CGPROFILE_WHEEL_SOURCE=""

## 8.2 Upgrade drain                                                [install]
# An upgrade (or a changed unit) restarts the daemon, which finalizes live sessions as
# `daemon-stopped`. host-setup therefore installs the new version directory first, then waits up to
# this deadline for `cgpctl sessions --state live` to be empty (polled every 10 s, one fixed
# deadline, never stopping a session). Still busy at the deadline: the old daemon and the old
# `current` stay, the live sessions are printed, the pending version is recorded and install.sh exits
# non-zero. `install.sh --force-cgprofile-restart` proceeds anyway and names the sessions it aborts.
# Allowed CGPROFILE_DRAIN_TIMEOUT: a positive whole number with a unit s, m or h (e.g. 90s, 10m, 1h)
CGPROFILE_DRAIN_TIMEOUT=10m

## 8.3 Daemon config (rendered into /etc/cgprofile/cgpd.toml)         [install]
# These become the keys of the same name (lower case). host-setup owns the file and never touches
# /var/lib/cgprofile/overrides.toml (runtime `cgpctl config set --persist` overrides); a change here
# is applied with `systemctl reload cgpd`, not a restart. Only keys the pinned version supports are
# rendered. An empty value renders no key (the daemon default applies).
# CGPROFILE_GATES_SLICE: the slice that bounds where the daemon may write cgroup.kill (exact
# gates-slice container leaves only); dev-gates.slice is host-setup's own gates tier.
# Allowed CGPROFILE_GATES_SLICE: empty, or a systemd slice name ending in .slice without '/' or '--'
CGPROFILE_GATES_SLICE=dev-gates.slice
# CGPROFILE_OBSERVE_SLICES: the slices the daemon observes in `cgpctl host` (space-separated).
# Allowed CGPROFILE_OBSERVE_SLICES: empty, or space-separated systemd slice names ending in .slice
CGPROFILE_OBSERVE_SLICES=""
# CGPROFILE_ALLOW_UIDS: uids allowed to use the control socket in addition to its group members;
# empty = group membership alone decides.
# Allowed CGPROFILE_ALLOW_UIDS: empty, or whole numbers separated by spaces or commas
CGPROFILE_ALLOW_UIDS=""
