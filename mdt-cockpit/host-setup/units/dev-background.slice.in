# RENDERED by host-setup/install.sh from host-setup.env — do not edit the
# installed copy; edit /etc/mdt/host-setup.env and re-run install.sh.
[Unit]
Description=Long-running dev stacks — bounded, OOM-first, yields to every other tier
Before=slices.target

[Slice]
# NOTE: no explicit parent directive — systemd derives nesting from the
# dash-separated name: "dev-background.slice" nests under "dev.slice"
# automatically once dev.slice.in is also installed. See units/dev.slice.in
# for the shared IOPS/bandwidth ceiling this tier inherits from there — this
# is the merged besteffort.slice + dev-workloads.slice tier (host dev-tier
# cgroup governance rollout): the Docker daemon-wide fallback for anything
# unconfigured and the explicit tier for long-running application stacks.

# Soft ceiling first (throttle into zswap), hard cap so a leak can never
# poison the host, swap cap so it can't poison swap/zswap either. Swap cap
# auto-detected from this host's real total swap (DEV_SWAP_CASCADE_PCT% of
# dev.slice's own derived ceiling) unless set explicitly — see
# host-setup.env.example.
MemoryMin=@DEV_BACKGROUND_MEMORY_MIN@
MemoryLow=@DEV_BACKGROUND_MEMORY_LOW@
MemoryHigh=@DEV_BACKGROUND_MEMORY_HIGH@
MemoryMax=@DEV_BACKGROUND_MEMORY_MAX@
MemorySwapMax=@DEV_BACKGROUND_MEMORY_SWAP_MAX@

CPUWeight=@DEV_BACKGROUND_CPU_WEIGHT@
# Absolute ceiling too, same "single tier can't alone claim the whole
# parent budget" reasoning as dev.slice's own CPUQuota — see
# units/dev.slice.in.
CPUQuota=@DEV_BACKGROUND_CPU_QUOTA@
# On a BFQ host this is only a true ratio against dev-interactive.slice
# because both weights are <= 100 (systemd compresses IOWeight > 100 into
# BFQ's 1..1000 range). See CGROUP-NOTES.md §BFQ before raising it.
IOWeight=@DEV_BACKGROUND_IO_WEIGHT@

# NO absolute IO cap here — the shared parent dev.slice carries the one
# IOPS/bandwidth ceiling for this tier AND dev-interactive.slice combined. See
# units/dev.slice.in for the static boot-window fallback + the runtime
# measured-baseline override this used to carry per-tier. (Unlike CPU and
# swap, no per-tier IOPS sub-ceiling for this tier either — that's only on
# dev-gates.slice/dev-buildkitd.slice, see those units.)

# systemd-oomd: under sustained pressure, kill inside this tier first.
# Silent no-op unless systemd-oomd is installed and running (install.sh
# installs it; ManagedOOM* settings do nothing without the daemon).
ManagedOOMMemoryPressure=kill
ManagedOOMMemoryPressureLimit=@DEV_BACKGROUND_OOM_PRESSURE_LIMIT@
ManagedOOMSwap=kill

# Cold background pages MAY be written back to disk, which is the point of
# the tier. NOTE: this is a per-cgroup toggle, NOT inherited from
# dev.slice's own value — every tier needs its own explicit line. Full
# reasoning: units/dev.slice.in's own MemoryZSwapWriteback comment,
# CGROUP-NOTES.md "zswap writeback — who may page to disk".
MemoryZSwapWriteback=@DEV_BACKGROUND_ZSWAP_WRITEBACK@
# Containers join via the Docker daemon-wide default (cgroup-parent in
# /etc/docker/daemon.json — see host-setup.env.example), an explicit
# `docker run --cgroup-parent=dev-background.slice`, or compose
# `cgroup_parent: dev-background.slice` (ciu governance injects it). Gate/lane
# launchers use the sibling dev-gates.slice instead.
