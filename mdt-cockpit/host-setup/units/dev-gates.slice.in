# RENDERED by host-setup/install.sh from host-setup.env — do not edit the
# installed copy; edit /etc/mdt/host-setup.env and re-run install.sh.
[Unit]
Description=gate and lane containers + placed lane leaves rg-<token> — the admission capacity object
Before=slices.target

[Slice]
# NOTE: no explicit parent directive — dash-name nesting under dev.slice,
# same mechanism as every sibling tier. SIBLING of dev-background.slice, not
# a child of it — long-running dev stacks (dstdns, ...) stay in
# dev-background.slice; gates leave it for here. See
# run-gate-project/nyxloom-trove/DESIGN-2026-09-12-liveness-placement-admission.md
# D-19/D-20/D-25, and memory `soulmask-memory-pressure-findings.md` (the
# 2026-08-04 finding this slice fixes: "gates share dev-background.slice
# with the ~4 GiB dstdns stack ... the user's own instinct was a separate
# dev-gates.slice; this shipped sibling is the resulting capacity object").
#
# All lane containers AND every placed lane leaf rg-<token> (D-20 — exec and
# bare-host lanes whose pids the daemon migrates out of a container scope
# into a sibling leaf here) live under this slice. Its memory.max is what
# admission (RG-56 in run-gate, S16.6.1 in ciu v8) keys on; its
# memory.pressure is THE pressure signal admission reads (D-6: "swap usage
# is never the gate; PSI is").
# HOST_ROLE=dedicated-dev renders NO MemoryHigh here: MemoryMax (= dev Max, P-plat-19h)
# is the paging point and the OOM domain of the load (P-plat-19e).
MemoryMin=@DEV_GATES_MEMORY_MIN@
MemoryLow=@DEV_GATES_MEMORY_LOW@
MemoryHigh=@DEV_GATES_MEMORY_HIGH@
MemoryMax=@DEV_GATES_MEMORY_MAX@
# Relaxed swap ceiling, same reasoning as dev-background.slice's own: a gate
# that swaps just finishes slowly; one that OOMs fails outright. Auto-
# detected from this host's real total swap (DEV_SWAP_CASCADE_PCT% of
# dev.slice's own derived ceiling) unless set explicitly — see
# host-setup.env.example.
MemorySwapMax=@DEV_GATES_MEMORY_SWAP_MAX@
# See the IOWeight note in dev-background.slice.in: on a BFQ host keep <= 100, or
# the ratio against sibling tiers silently stops being what it says; with io.cost
# enabled io.weight is used directly (1..10000).
CPUWeight=@DEV_GATES_CPU_WEIGHT@
IOWeight=@DEV_GATES_IO_WEIGHT@
# Absolute CPU ceiling too, same "single tier can't alone claim the whole
# parent budget" reasoning as dev.slice's own CPUQuota — see
# units/dev.slice.in.
CPUQuota=@DEV_GATES_CPU_QUOTA@
# Absolute IOPS sub-ceiling too, tighter than the shared dev.slice IO
# ceiling this tier otherwise inherits — RUNTIME-ONLY (not a
# static directive here): mdt-dev-governance-reconcile.sh applies
# IOReadIOPSMax/IOWriteIOPSMax at DEV_SUBSLICE_IOPS_PCT% (default 60%) of
# whatever it just derived for dev.slice itself, every time it runs
# (same reason dev.slice's own IO ceiling is runtime-derived rather than a
# static unit-file number — a static line here can't express "a percentage
# of what dev.slice just measured"). Bandwidth is deliberately left
# untouched — only IOPS gets the tighter sub-ceiling; a gate/lane doing a
# few large sequential ops should not be penalized the same way a workload
# doing many small ones is. Same mechanism, same reasoning, applies to
# dev-buildkitd.slice — see that unit.

# No systemd-oomd ManagedOOM* directives on any dev tier (operator directive
# 2026-11-24). The finite MemoryMax plus the large MemorySwapMax above are the
# overcommit design: cgroup v2 reclaims to swap before an OOM kill. Fleetd,
# not host-setup, owns the freeze at host memory PSI full avg10 >= 3.

# NOTE: this is a per-cgroup toggle, NOT inherited from dev.slice's own
# value — every tier needs its own explicit line. Full reasoning:
# units/dev.slice.in's own MemoryZSwapWriteback comment, CGROUP-NOTES.md
# "zswap writeback — who may page to disk".
MemoryZSwapWriteback=@DEV_GATES_ZSWAP_WRITEBACK@

# Containers join via an explicit `docker run --cgroup-parent=dev-gates.slice`
# / compose `cgroup_parent: dev-gates.slice` (run-gate's ephemeral-lane create
# path — see run-gate-project/, out of this project's scope), or
# $CGROUP_PARENT_DEV_GATES exported into whatever creates the lane container.
# Consumers must fail closed when it is absent; there is no fallback to
# dev-background.slice and no Docker daemon-wide fallback into this tier, same reasoning as
# dev-memory_min_guaranteed.slice: landing here is always a deliberate
# per-lane choice, never an accident of an unconfigured default.
