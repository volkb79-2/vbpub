# Image-owned shell defaults for mdt-cockpit (sourced by profile.sh with `set -a`).
# Override any of them by exporting the variable in ~/.config/mdt-cockpit/shell.env
# (sourced after this file) or in your own ~/.bashrc / ~/.zshrc.

if command -v nvim >/dev/null 2>&1; then
    export EDITOR="${EDITOR:-nvim}"
    export VISUAL="${VISUAL:-nvim}"
else
    export EDITOR="${EDITOR:-nano}"
    export VISUAL="${VISUAL:-nano}"
fi
export PAGER="${PAGER:-less}"
export LESSCHARSET="${LESSCHARSET:-utf-8}"
export LESS="${LESS:--R -M}"
# less pipes files through the image-owned syntax-highlighting preprocessor.
export LESSOPEN="${LESSOPEN:-|/usr/local/share/mdt-cockpit/lesspipe.sh %s}"
