# TEMPLATE, NOT INSTALLED. Cheap raw 4 KiB read probes + passive snapshot. Exits 0 on a skip; a skip is not a failure.
[Unit]
Description=iogov tick (read-only probes, recommend-only)
ConditionPathExists=!@IOGOV_KILL_SWITCH_FILE@

[Service]
Type=oneshot
User=@IOGOV_USER@
Slice=iogov-probe.slice
Environment=PYTHONPATH=@IOGOV_PYTHONPATH@ IOGOV_CONFIG=@IOGOV_CONFIG@
ExecStart=@IOGOV_PYTHON@ -m iogov tick
ExecStopPost=-@IOGOV_PYTHON@ -m iogov cleanup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
KillSignal=SIGTERM
TimeoutStopSec=30
# The unit can read exactly one disk, read-only, and cannot write anywhere but its own state directory.
DevicePolicy=closed
DeviceAllow=@IOGOV_DISK_NODE@ r
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=@IOGOV_STATE_DIR@ @IOGOV_SCRATCH_DIR@
LimitCORE=0
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
