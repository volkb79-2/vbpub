diff --git a/assay/src/assay/runner.py b/assay/src/assay/runner.py
--- a/assay/src/assay/runner.py
+++ b/assay/src/assay/runner.py
@@
+# One private binding helper derives exact ordered declarations from the lane.
+# Call it at run_lane/refuse_lane entry AND in assemble_verdict before output.
+# The sink-level check protects direct public assemble_verdict callers; the
+# entry checks refuse omissions before any lane side effect.
+
def run_lane(
     lane: Lane,
     *,
     commit: str,
     repo: Path,
     project_root: Path,
     adapter: LanguageAdapter | None,
     assay_version: str,
+    evidence: tuple[Evidence, ...] = (),
+    declared_evidence: tuple[EvidenceDeclaration, ...] = (),
+    deadline: LaneDeadline | None = None,
     ...
) -> Verdict:
+    # Derive the authoritative declarations from lane.judge.evidence and
+    # require exact ordered identity equality with BOTH supplied tuples
+    # before Git/plan/command work.  Empty defaults are legal only when that
+    # derived source is empty; they never substitute for known declarations.
+    # None is a derived library convenience: start from lane.budget_seconds
+    # immediately.  CLI always passes the instance it started before HEAD.
+    if deadline is None:
+        deadline = LaneDeadline.start(
+            budget_seconds=lane.budget_seconds, monotonic=monotonic
+        )
+    # TODO: pass deadline.remaining to every lane-reachable generic Git call;
+    # direct R0 executes the already-resolved plan with deadline.remaining().
@@
def refuse_lane(
    ...,
+    evidence: tuple[Evidence, ...] = (),
+    declared_evidence: tuple[EvidenceDeclaration, ...] = (),
) -> Verdict: ...

