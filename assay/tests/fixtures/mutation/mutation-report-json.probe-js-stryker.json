ull | undefined): string {\n  if (value === null || value === undefined || value === '') return '—'\n\n  // Numbers < 1e12 are almost certainly epoch *seconds*, not milliseconds.\n  const date =\n    value instanceof Date\n      ? value\n      : new Date(typeof value === 'number' && value < 1e12 ? value * 1000 : value)\n\n  const ms = date.getTime()\n  if (Number.isNaN(ms)) return '—'\n\n  const diffSec = Math.round((ms - Date.now()) / 1000)\n  const abs = Math.abs(diffSec)\n  const rtf = new Intl.RelativeTimeFormat(undefined, { numeric: 'auto', style: 'short' })\n\n  const units: [Intl.RelativeTimeFormatUnit, number][] = [\n    ['year', 31536000],\n    ['month', 2592000],\n    ['week', 604800],\n    ['day', 86400],\n    ['hour', 3600],\n    ['minute', 60],\n    ['second', 1],\n  ]\n  for (const [unit, secs] of units) {\n    if (abs >= secs || unit === 'second') {\n      return rtf.format(Math.round(diffSec / secs), unit)\n    }\n  }\n  return '—'\n}\n"},"src/hinted.ts":{"language":"typescript","mutants":[{"id":"94","mutatorName":"BlockStatement","replacement":"{}","status":"NoCoverage","static":false,"coveredBy":[],"location":{"end":{"column":4,"line":5},"start":{"column":14,"line":3}}},{"id":"95","mutatorName":"StringLiteral","replacement":"\"\"","status":"NoCoverage","static":false,"coveredBy":[],"location":{"end":{"column":22,"line":4},"start":{"column":12,"line":4}}},{"id":"89","mutatorName":"BlockStatement","replacement":"{}","statusReason":"expected undefined to be 'ok' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"killedBy":["5"],"coveredBy":["5"],"location":{"end":{"column":2,"line":7},"start":{"column":43,"line":1}}},{"id":"90","mutatorName":"ConditionalExpression","replacement":"true","statusReason":"expected 'negative' to be 'ok' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"killedBy":["5"],"coveredBy":["5"],"location":{"end":{"column":12,"line":3},"start":{"column":7,"line":3}}},{"id":"91","mut