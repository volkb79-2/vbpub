{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "reporters": ["json", "clear-text"],
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "mutate": ["src/**/*.ts", "src/**/*.tsx", "!src/**/*.spec.tsx", "!src/**/*.test.ts", "!src/**/*.d.ts"],
  "thresholds": { "break": null },
  "concurrency": 2,
  "timeoutMS": 30000
}
