{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:assay:schema:verdict:3",
  "title": "assay verdict artifact",
  "description": "One verdict, one lane, one commit. Computed R0-R3 claims and externally sourced evidence are separate arrays because provenance is not rigor. This hand-written schema ships as data and is never generated from the Python model.",
  "type": "object",
  "required": [
    "schema_version",
    "assay_version",
    "lane",
    "commit",
    "outcome",
    "exit_code",
    "started",
    "ended",
    "claims",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "description": "The verdict schema version, independent of assay.toml's lane schema version.",
      "type": "integer",
      "const": 3
    },
    "assay_version": {"type": "string", "minLength": 1},
    "lane": {"type": "string", "minLength": 1},
    "commit": {"type": "string", "minLength": 1},
    "outcome": {"$ref": "#/$defs/outcome"},
    "reason_code": {"$ref": "#/$defs/reason_code"},
    "exit_code": {"type": "integer", "minimum": 0, "maximum": 5},
    "started": {"$ref": "#/$defs/timestamp"},
    "ended": {"$ref": "#/$defs/timestamp"},
    "declared_rigor": {
      "description": "The computed rigor levels the resolved lane declared.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/rigor"}
    },
    "declared_evidence": {
      "description": "External requirements, keyed independently by source and key. Empty means the resolved lane declared none; absent means no lane resolved.",
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/evidence_declaration"}
    },
    "argv_declared": {"$ref": "#/$defs/argv_nonempty"},
    "argv_appended": {"$ref": "#/$defs/argv"},
    "argv_effective": {"$ref": "#/$defs/argv_nonempty"},
    "argv_modified": {"type": "boolean"},
    "env_declared": {"$ref": "#/$defs/env"},
    "env_effective": {"$ref": "#/$defs/env"},
    "scope": {"$ref": "#/$defs/scope"},
    "enforcement": {"$ref": "#/$defs/enforcement"},
    "judgment": {"$ref": "#/$defs/judgment"},
    "claims": {
      "description": "Exactly one computed claim per declared rigor level; model construction enforces the cross-array equality.",
      "type": "array",
      "items": {"$ref": "#/$defs/claim"}
    },
    "evidence": {
      "description": "Exactly one result per declared external evidence identity; model construction enforces the cross-array equality.",
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    }
  },
  "dependentRequired": {
    "declared_rigor": ["declared_evidence", "argv_declared", "argv_appended", "argv_effective", "argv_modified", "env_declared", "env_effective", "scope", "enforcement"],
    "declared_evidence": ["declared_rigor", "argv_declared", "argv_appended", "argv_effective", "argv_modified", "env_declared", "env_effective", "scope", "enforcement"],
    "argv_declared": ["declared_rigor", "declared_evidence", "argv_appended", "argv_effective", "argv_modified", "env_declared", "env_effective", "scope", "enforcement"],
    "argv_appended": ["declared_rigor", "declared_evidence", "argv_declared", "argv_effective", "argv_modified", "env_declared", "env_effective", "scope", "enforcement"],
    "argv_effective": ["declared_rigor", "declared_evidence", "argv_declared", "argv_appended", "argv_modified", "env_declared", "env_effective", "scope", "enforcement"],
    "argv_modified": ["declared_rigor", "declared_evidence", "argv_declared", "argv_appended", "argv_effective", "env_declared", "env_effective", "scope", "enforcement"],
    "env_declared": ["declared_rigor", "declared_evidence", "argv_declared", "argv_appended", "argv_effective", "argv_modified", "env_effective", "scope", "enforcement"],
    "env_effective": ["declared_rigor", "declared_evidence", "argv_declared", "argv_appended", "argv_effective", "argv_modified", "env_declared", "scope", "enforcement"],
    "scope": ["declared_rigor", "declared_evidence", "argv_declared", "argv_appended", "argv_effective", "argv_modified", "env_declared", "env_effective", "enforcement"],
    "enforcement": ["declared_rigor", "declared_evidence", "argv_declared", "argv_appended", "argv_effective", "argv_modified", "env_declared", "env_effective", "scope"]
  },
  "allOf": [
    {
      "if": {"required": ["outcome"], "properties": {"outcome": {"const": "PASS"}}},
      "then": {"not": {"required": ["reason_code"]}, "properties": {"exit_code": {"const": 0}}}
    },
    {
      "if": {"required": ["outcome"], "properties": {"outcome": {"const": "FAIL"}}},
      "then": {"required": ["reason_code"], "properties": {"exit_code": {"const": 1}, "reason_code": {"$ref": "#/$defs/reason_codes/FAIL"}}}
    },
    {
      "if": {"required": ["outcome"], "properties": {"outcome": {"const": "ERROR"}}},
      "then": {"required": ["reason_code"], "properties": {"exit_code": {"const": 2}, "reason_code": {"$ref": "#/$defs/reason_codes/ERROR"}}}
    },
    {
      "if": {"required": ["outcome"], "properties": {"outcome": {"const": "NO_MEASUREMENT"}}},
      "then": {"required": ["reason_code"], "properties": {"exit_code": {"const": 3}, "reason_code": {"$ref": "#/$defs/reason_codes/NO_MEASUREMENT"}}}
    },
    {
      "if": {"required": ["outcome"], "properties": {"outcome": {"const": "BUDGET_EXCEEDED"}}},
      "then": {"required": ["reason_code"], "properties": {"exit_code": {"const": 4}, "reason_code": {"$ref": "#/$defs/reason_codes/BUDGET_EXCEEDED"}}}
    },
    {
      "if": {"required": ["outcome"], "properties": {"outcome": {"const": "INCONCLUSIVE"}}},
      "then": {"required": ["reason_code"], "properties": {"exit_code": {"const": 5}, "reason_code": {"$ref": "#/$defs/reason_codes/INCONCLUSIVE"}}}
    },
    {
      "if": {"required": ["argv_appended"], "properties": {"argv_appended": {"minItems": 1}}},
      "then": {"properties": {"argv_modified": {"const": true}}}
    },
    {
      "if": {"required": ["argv_appended"], "properties": {"argv_appended": {"maxItems": 0}}},
      "then": {"properties": {"argv_modified": {"const": false}}}
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "outcome": {"enum": ["PASS", "FAIL", "ERROR", "NO_MEASUREMENT", "BUDGET_EXCEEDED", "INCONCLUSIVE"]},
    "rigor": {"enum": ["R0", "R1", "R2", "R3"]},
    "evidence_source": {"enum": ["adjudicated", "attested"]},
    "scope": {"enum": ["S0", "S1", "S2", "S3", "S4"]},
    "enforcement": {"enum": ["gate", "advisory"]},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
    },
    "argv": {"type": "array", "items": {"type": "string"}},
    "argv_nonempty": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "env": {"type": "object", "additionalProperties": {"type": "string"}},
    "reason_code": {
      "enum": [
        "UNCOVERED_LINES", "EXCLUDED_LINES", "UNCLASSIFIED_LINES",
        "MUTANTS_SURVIVED", "CANARY_SURVIVED", "COMMAND_FAILED",
        "GIT_FAILED", "UNREADABLE_ARTIFACT", "FORMAT_MISMATCH",
        "BAD_LANE_CONFIG", "EXEC_FAILED", "DIRTY_TREE", "BASE_IS_HEAD",
        "EMPTY_COVERAGE", "MISSING_ATTESTATION", "STALE_ATTESTATION",
        "LANE_TIMEOUT", "NO_MUTANTS", "CANARY_INCONCLUSIVE"
      ]
    },
    "reason_codes": {
      "FAIL": {"enum": ["UNCOVERED_LINES", "EXCLUDED_LINES", "UNCLASSIFIED_LINES", "MUTANTS_SURVIVED", "CANARY_SURVIVED", "COMMAND_FAILED"]},
      "ERROR": {"enum": ["GIT_FAILED", "UNREADABLE_ARTIFACT", "FORMAT_MISMATCH", "BAD_LANE_CONFIG", "EXEC_FAILED"]},
      "NO_MEASUREMENT": {"enum": ["DIRTY_TREE", "BASE_IS_HEAD", "EMPTY_COVERAGE", "MISSING_ATTESTATION", "STALE_ATTESTATION"]},
      "BUDGET_EXCEEDED": {"enum": ["LANE_TIMEOUT"]},
      "INCONCLUSIVE": {"enum": ["NO_MUTANTS", "CANARY_INCONCLUSIVE"]}
    },
    "status_contract": {
      "allOf": [
        {"if": {"required": ["status"], "properties": {"status": {"const": "PASS"}}}, "then": {"not": {"required": ["reason_code"]}}},
        {"if": {"required": ["status"], "properties": {"status": {"const": "FAIL"}}}, "then": {"required": ["reason_code"], "properties": {"reason_code": {"$ref": "#/$defs/reason_codes/FAIL"}}}},
        {"if": {"required": ["status"], "properties": {"status": {"const": "ERROR"}}}, "then": {"required": ["reason_code"], "properties": {"reason_code": {"$ref": "#/$defs/reason_codes/ERROR"}}}},
        {"if": {"required": ["status"], "properties": {"status": {"const": "NO_MEASUREMENT"}}}, "then": {"required": ["reason_code"], "properties": {"reason_code": {"$ref": "#/$defs/reason_codes/NO_MEASUREMENT"}}}},
        {"if": {"required": ["status"], "properties": {"status": {"const": "BUDGET_EXCEEDED"}}}, "then": {"required": ["reason_code"], "properties": {"reason_code": {"$ref": "#/$defs/reason_codes/BUDGET_EXCEEDED"}}}},
        {"if": {"required": ["status"], "properties": {"status": {"const": "INCONCLUSIVE"}}}, "then": {"required": ["reason_code"], "properties": {"reason_code": {"$ref": "#/$defs/reason_codes/INCONCLUSIVE"}}}}
      ]
    },
    "coverage": {
      "type": "object",
      "required": ["covered", "changed_executable", "pct", "considered", "missing_lines", "files_missing_coverage", "unclassified_lines", "files_with_unclassified_lines", "excluded_lines", "files_with_excluded_lines"],
      "properties": {
        "covered": {"type": "integer", "minimum": 0},
        "changed_executable": {"type": "integer", "minimum": 0},
        "pct": {"type": "number", "minimum": 0, "maximum": 100},
        "considered": {"type": "integer", "minimum": 0},
        "missing_lines": {
          "description": "Changed, executable, non-excluded lines that were not executed, keyed by path (A-096). A file contributing none is absent, never present with an empty array.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1}
          }
        },
        "files_missing_coverage": {
          "description": "Changed files under the source roots contributing executable lines with no entry at all in the coverage artifact, sorted (A-096).",
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "unclassified_lines": {
          "description": "Changed lines whose enclosing multi-line statement could not be confidently attributed -- overlapping/malformed spans, or a genuinely untracked enclosing statement (A-100/A-101), keyed by path. A file contributing none is absent, never present with an empty array.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1}
          }
        },
        "files_with_unclassified_lines": {
          "description": "Paths appearing in unclassified_lines, sorted (A-096's pattern, P07's third pair).",
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "excluded_lines": {
          "description": "Changed, considered lines the coverage artifact classifies EXCLUDED, keyed by path (P16). A file contributing none is absent, never present with an empty array. Present so an independent consumer can re-derive a FAIL/EXCLUDED_LINES claim from the payload plus judgment.r1.allow_excluded alone.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1}
          }
        },
        "files_with_excluded_lines": {
          "description": "Paths appearing in excluded_lines, sorted (P16, the same pattern files_with_unclassified_lines already established).",
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "canary": {
      "description": "The R3 claim payload (P09, A-092/A-108): a known-good control run alongside a deliberately minimal known-bad transform of the same input, both through the real pipeline, compared by cause -- not merely by pass/fail.",
      "type": "object",
      "required": ["mechanism", "description", "control_outcome"],
      "properties": {
        "mechanism": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "control_outcome": {"$ref": "#/$defs/outcome"},
        "transformed_outcome": {
          "description": "Absent exactly when the transformed half was never genuinely run: a malformed/unrecognised mechanism, or a transform that changed nothing to judge (O3).",
          "$ref": "#/$defs/outcome"
        },
        "expected_reason_code": {"$ref": "#/$defs/reason_codes/FAIL"},
        "observed_reason_code": {"$ref": "#/$defs/reason_code"}
      },
      "allOf": [
        {
          "if": {"not": {"required": ["transformed_outcome"]}},
          "then": {"not": {"required": ["observed_reason_code"]}}
        },
        {
          "if": {"required": ["transformed_outcome"], "properties": {"transformed_outcome": {"const": "PASS"}}},
          "then": {"not": {"required": ["observed_reason_code"]}}
        },
        {
          "if": {
            "required": ["transformed_outcome"],
            "properties": {"transformed_outcome": {"not": {"const": "PASS"}}}
          },
          "then": {"required": ["observed_reason_code"]}
        }
      ],
      "additionalProperties": false
    },
    "mutation_operator": {"enum": ["compare-swap", "boolop-swap", "bool-const-flip", "falsy-swap"]},
    "mutant_outcome": {
      "description": "One attempted mutant's identity, projected for the artifact (A-116): deliberately WITHOUT the full mutated text.",
      "type": "object",
      "required": ["path", "lineno", "operator", "description"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "lineno": {"type": "integer", "minimum": 1},
        "operator": {"$ref": "#/$defs/mutation_operator"},
        "description": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "mutation": {
      "description": "The R2 claim payload (P12, A-116): baseline-gated mutation execution against changed-line mutants, isolated per mutant, bounded by a caller-declared jobs count. Four buckets: killed is a bare count; survived/crashed/budget_exceeded carry the actual mutant identities.",
      "type": "object",
      "required": ["total", "killed", "survived", "crashed", "budget_exceeded"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "killed": {"type": "integer", "minimum": 0},
        "survived": {"type": "array", "items": {"$ref": "#/$defs/mutant_outcome"}},
        "crashed": {"type": "array", "items": {"$ref": "#/$defs/mutant_outcome"}},
        "budget_exceeded": {"type": "array", "items": {"$ref": "#/$defs/mutant_outcome"}}
      },
      "additionalProperties": false
    },
    "judgment_r1": {
      "description": "The effective R1 policy (P16, sol finding 2): what decided the R1 claim's PASS/FAIL, so an independent consumer can re-derive it from coverage alone.",
      "type": "object",
      "required": ["language", "source_roots", "coverage_format", "coverage_artifact", "fail_under", "allow_excluded", "base"],
      "properties": {
        "language": {"type": "string", "minLength": 1},
        "source_roots": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "coverage_format": {"type": "string", "minLength": 1},
        "coverage_artifact": {"type": "string", "minLength": 1},
        "fail_under": {"type": "number", "minimum": 0, "maximum": 100},
        "allow_excluded": {"type": "boolean"},
        "base": {"description": "The full resolved comparison commit, never a symbolic ref.", "type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "judgment_r2": {
      "description": "The effective R2 policy populated by the R2 CLI pipeline (P18) and correspondence-checked against the R2 claim (A-148).",
      "type": "object",
      "required": ["jobs", "operators"],
      "properties": {
        "jobs": {"type": "integer", "minimum": 1},
        "operators": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "judgment_r3": {
      "description": "The effective R3 policy populated by the isolated R3 CLI pipeline (P19) and correspondence-checked against the R3 claim where schema v3 can witness it (A-148/A-152).",
      "type": "object",
      "required": ["mechanism", "target"],
      "properties": {
        "mechanism": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "judgment": {
      "description": "The resolved judge policy for whichever declared rigor levels rendered a real computed judgment (P16). Independently optional -- a lane may resolve and render only R0.",
      "type": "object",
      "minProperties": 1,
      "properties": {
        "r1": {"$ref": "#/$defs/judgment_r1"},
        "r2": {"$ref": "#/$defs/judgment_r2"},
        "r3": {"$ref": "#/$defs/judgment_r3"}
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": ["rigor", "source", "status", "verified_by_assay"],
      "properties": {
        "rigor": {"$ref": "#/$defs/rigor"},
        "source": {"const": "computed"},
        "status": {"$ref": "#/$defs/outcome"},
        "verified_by_assay": {"const": true},
        "reason_code": {"$ref": "#/$defs/reason_code"},
        "coverage": {"$ref": "#/$defs/coverage"},
        "canary": {"$ref": "#/$defs/canary"},
        "mutation": {"$ref": "#/$defs/mutation"}
      },
      "allOf": [
        {"$ref": "#/$defs/status_contract"},
        {"not": {"required": ["reason_code"], "properties": {"reason_code": {"enum": ["MISSING_ATTESTATION", "STALE_ATTESTATION"]}}}},
        {"if": {"not": {"required": ["rigor"], "properties": {"rigor": {"const": "R1"}}}}, "then": {"not": {"required": ["coverage"]}}},
        {"if": {"not": {"required": ["rigor"], "properties": {"rigor": {"const": "R3"}}}}, "then": {"not": {"required": ["canary"]}}},
        {"if": {"not": {"required": ["rigor"], "properties": {"rigor": {"const": "R2"}}}}, "then": {"not": {"required": ["mutation"]}}},
        {"if": {"required": ["status"], "properties": {"status": {"const": "NO_MEASUREMENT"}}}, "then": {"not": {"anyOf": [{"required": ["coverage"]}, {"required": ["canary"]}, {"required": ["mutation"]}]}}}
      ],
      "additionalProperties": false
    },
    "evidence_declaration": {
      "type": "object",
      "required": ["source", "key"],
      "properties": {
        "source": {"$ref": "#/$defs/evidence_source"},
        "key": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["source", "key", "status", "verified_by_assay"],
      "properties": {
        "source": {"$ref": "#/$defs/evidence_source"},
        "key": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/outcome"},
        "verified_by_assay": {"type": "boolean"},
        "reason_code": {"$ref": "#/$defs/reason_code"},
        "producer": {"type": "string", "minLength": 1},
        "attested_commit": {"type": "string", "minLength": 1},
        "reviewed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {"$ref": "#/$defs/status_contract"},
        {
          "if": {"required": ["source"], "properties": {"source": {"const": "attested"}}},
          "then": {"properties": {"verified_by_assay": {"const": false}}},
          "else": {"not": {"anyOf": [{"required": ["producer"]}, {"required": ["attested_commit"]}, {"required": ["reviewed_paths"]}]}}
        },
        {
          "if": {"required": ["source", "status"], "properties": {"source": {"const": "attested"}, "status": {"const": "PASS"}}},
          "then": {"required": ["producer", "attested_commit", "reviewed_paths"]}
        },
        {
          "if": {"required": ["source", "reason_code"], "properties": {"source": {"const": "attested"}, "reason_code": {"const": "STALE_ATTESTATION"}}},
          "then": {"required": ["producer", "attested_commit", "reviewed_paths"]}
        },
        {
          "if": {"required": ["reason_code"], "properties": {"reason_code": {"const": "MISSING_ATTESTATION"}}},
          "then": {"properties": {"source": {"const": "attested"}}, "not": {"anyOf": [{"required": ["producer"]}, {"required": ["attested_commit"]}, {"required": ["reviewed_paths"]}]}}
        },
        {
          "if": {"required": ["reason_code"], "properties": {"reason_code": {"const": "STALE_ATTESTATION"}}},
          "then": {"properties": {"source": {"const": "attested"}}}
        },
        {
          "if": {"anyOf": [{"required": ["producer"]}, {"required": ["attested_commit"]}, {"required": ["reviewed_paths"]}]},
          "then": {"required": ["producer", "attested_commit", "reviewed_paths"]}
        }
      ],
      "additionalProperties": false
    }
  }
}
