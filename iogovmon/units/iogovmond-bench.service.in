# TEMPLATE, NOT INSTALLED. The mini write bench. The timer fires every 15 minutes; `iogovmond bench` is a no-op unless the ~6 h
# (jittered) schedule says it is due and the host is calm (see the gates in the design note).
[Unit]
Description=iogovmond bench (bounded scratch-file write bench, recommend-only)
ConditionPathExists=!@IOGOVMON_KILL_SWITCH_FILE@

[Service]
Type=oneshot
User=@IOGOVMON_USER@
Slice=iogovmon.slice
Environment=PYTHONPATH=@IOGOVMON_PYTHONPATH@ IOGOVMON_CONFIG=@IOGOVMON_CONFIG@
ExecStart=/usr/local/bin/iogovmond bench
ExecStopPost=-/usr/local/bin/iogovmond cleanup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# SIGTERM only sets a flag: the run stops submitting, removes its scratch file and journals the abort.
KillSignal=SIGTERM
TimeoutStopSec=60
# Hard backstop: an fdatasync blocked in the kernel cannot see the flag (the watchdog only stops FURTHER submissions). For Type=oneshot the
# runtime bound is TimeoutStartSec (RuntimeMaxSec= is IGNORED on oneshot units): after it systemd sends SIGTERM, after TimeoutStopSec more
# SIGKILL. A killed bench keeps its whole reservation charged and its scratch file is removed by ExecStopPost (`iogovmond cleanup`) or by the next
# run, under the scratch lock. Three phases x phase_wall_s plus flushes fit in minutes.
TimeoutStartSec=30min
DevicePolicy=closed
DeviceAllow=@IOGOVMON_DISK_NODE@ r
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=@IOGOVMON_STATE_DIR@ @IOGOVMON_SCRATCH_DIR@
LimitCORE=0
# Read-only view of kernel and cgroup tunables (the tool only READS /sys, /proc and the cgroup tree), no capabilities, no network,
# a minimal syscall set, and a private state directory that systemd creates for the service user.
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
CapabilityBoundingSet=
PrivateNetwork=yes
SystemCallFilter=@system-service
StateDirectory=iogovmon
StateDirectoryMode=0700
UMask=0077
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
