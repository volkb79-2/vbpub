# TEMPLATE, NOT INSTALLED. Cheap raw 4 KiB read probes + passive snapshot. Exits 0 on a skip; a skip is not a failure.
[Unit]
Description=iogovmond tick (read-only probes, recommend-only)
ConditionPathExists=!@IOGOVMON_KILL_SWITCH_FILE@

[Service]
Type=oneshot
User=@IOGOVMON_USER@
Slice=iogovmon.slice
Environment=PYTHONPATH=@IOGOVMON_PYTHONPATH@ IOGOVMON_CONFIG=@IOGOVMON_CONFIG@
ExecStart=/usr/local/bin/iogovmond tick
ExecStopPost=-/usr/local/bin/iogovmond cleanup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
KillSignal=SIGTERM
TimeoutStopSec=30
# Hard backstop: a syscall blocked in the kernel (a hung read) cannot see the stop flag. For Type=oneshot the runtime bound is
# TimeoutStartSec (RuntimeMaxSec= is IGNORED on oneshot units): after it systemd sends SIGTERM, after TimeoutStopSec more SIGKILL; the next
# run then refunds nothing (the reservation stays charged) and removes any leftover under the lock.
TimeoutStartSec=10min
# The unit can read exactly one disk, read-only, and cannot write anywhere but its own state directory.
DevicePolicy=closed
DeviceAllow=@IOGOVMON_DISK_NODE@ r
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=@IOGOVMON_STATE_DIR@ @IOGOVMON_SCRATCH_DIR@
LimitCORE=0
# Read-only view of kernel and cgroup tunables (the tool only READS /sys, /proc and the cgroup tree), no capabilities, no network,
# a minimal syscall set, and a private state directory that systemd creates for the service user.
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
CapabilityBoundingSet=
PrivateNetwork=yes
SystemCallFilter=@system-service
StateDirectory=iogovmon
StateDirectoryMode=0700
UMask=0077
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
