# TEMPLATE, NOT INSTALLED. Optional resident sampler of protected-side distress episodes. Performs NO probe IO: it reads
# /proc and cgroup files once a second. Needs no device access at all.
[Unit]
Description=iogovmon watch (protected-side distress episodes, recommend-only)
ConditionPathExists=!@IOGOVMON_KILL_SWITCH_FILE@

[Service]
Type=simple
User=@IOGOVMON_USER@
Slice=iogovmon.slice
Environment=PYTHONPATH=@IOGOVMON_PYTHONPATH@ IOGOVMON_CONFIG=@IOGOVMON_CONFIG@
ExecStart=@IOGOVMON_PYTHON@ -m iogovmon watch
Restart=on-failure
RestartSec=30
Nice=10
KillSignal=SIGTERM
DevicePolicy=closed
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=@IOGOVMON_STATE_DIR@
LimitCORE=0
# Read-only view of kernel and cgroup tunables (the tool only READS /sys, /proc and the cgroup tree), no capabilities, no network,
# a minimal syscall set, and a private state directory that systemd creates for the service user.
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
CapabilityBoundingSet=
PrivateNetwork=yes
SystemCallFilter=@system-service
StateDirectory=iogovmon
StateDirectoryMode=0700
UMask=0077
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
