# ============================================================================
# @@STACK_DIR@@ — stack defaults (generated by `ciu init`)
# ============================================================================
# Rendered with the global chain into gitignored ciu.toml at up time.
# Root key @@ROOT_KEY@@ must be unique per stack (S3.5).

[@@ROOT_KEY@@]
stack_name = "@@STACK_NAME@@"

# Provisioning dependencies (S13): declare what this stack REQUIRES and what
# it PROVIDES so preflight can lint/probe the graph. Start empty; examples:
#   requires = ["stack:infra/vault:healthy", "pg:db/mydb"]
requires = []
provides = []

[@@ROOT_KEY@@.app]
name = "@@STACK_NAME@@"
image_name = "@@IMAGE_NAME@@"
image_tag = "@@IMAGE_TAG@@"
internal_port = @@PORT@@

# Hostdir: auto-created under this stack dir, ownership fixed via the S6.5
# helper when needed (S6.1/S6.5).
[@@ROOT_KEY@@.app.hostdir]
data = ""

# Secrets (S4.2). GEN_LOCAL mints once and reuses; swap for ASK_VAULT:<path>
# once a Vault exists.
[@@ROOT_KEY@@.secrets]
api_key = "GEN_LOCAL:demo/@@STACK_NAME@@_api_key"
