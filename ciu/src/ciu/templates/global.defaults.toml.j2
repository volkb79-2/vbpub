[ciu]
# Set require_fqdn/require_certs = true only when you actually serve TLS.
require_certs = false
auto_connect_network = true

[deploy]
project_name = "@@PROJECT_NAME@@"
environment_tag = "@@ENVIRONMENT_TAG@@"
network_name = "$DOCKER_NETWORK_INTERNAL"
log_level = "INFO"

[deploy.labels]
prefix = "@@PROJECT_NAME@@"

[deploy.health]
interval = "5s"
timeout = "3s"
retries = 3
start_period = "5s"

[deploy.env.defaults]
TZ = "UTC"
PYTHONUNBUFFERED = "1"
