# ============================================================================
# CIU global defaults — generated by @@GENERATED_BY@@
# ============================================================================
# Committed global config (S3.1). Rendered through the S3.2 pipeline
# (Jinja2 -> $VAR expansion from ciu.env -> TOML parse) into the gitignored
# `ciu.global.toml`. Every dollar-VAR below is a machine fact supplied by
# `ciu env generate` (S2.7) — run that first.

[ciu]
# Set require_fqdn/require_certs = true only when you actually serve TLS.
require_certs = false
auto_connect_network = true

[deploy]
project_name = "@@PROJECT_NAME@@"
environment_tag = "@@ENVIRONMENT_TAG@@"
# Resolved from ciu.env (S2.6); every stack's compose declares it as an
# EXTERNAL network, so all stacks in this workspace share one bridge.
network_name = "$DOCKER_NETWORK_INTERNAL"
log_level = "INFO"

# Container label prefix for orphan cleanup (S6.4) — keep in sync with
# project_name so `ciu clean` matches this workspace's containers only.
[deploy.labels]
prefix = "@@PROJECT_NAME@@"

[deploy.health]
interval = "5s"
timeout = "3s"
retries = 3
start_period = "5s"

[deploy.env.defaults]
TZ = "UTC"
PYTHONUNBUFFERED = "1"

# --- [deploy.env.shared] : machine facts exposed to templates (S2.6 / S2.7) --
# REQUIRED for hostdir/secret-file ownership (S6.3/S4.10): the hostdir step
# resolves CONTAINER_UID/DOCKER_GID from here. All four expand from ciu.env —
# another reason `ciu env generate` must run first.
[deploy.env.shared]
CONTAINER_UID = "$CONTAINER_UID"
DOCKER_GID = "$DOCKER_GID"
REPO_ROOT = "$REPO_ROOT"
PHYSICAL_REPO_ROOT = "$PHYSICAL_REPO_ROOT"

# --- [deploy.phases.phase_1] : orchestration registration -------------------
# Registers the scaffolded stacks with phase-based orchestration so
# `ciu render` / `ciu up` see them without --dir. Extend per stack added.
[deploy.phases.phase_1]
@@PHASE_SERVICES@@
