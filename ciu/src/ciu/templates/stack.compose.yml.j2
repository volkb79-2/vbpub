{# Compose template for @@STACK_DIR@@ (generated by `ciu init`). The service
   KEY must equal the configfile/section service key below the root — here
   `app` from [@@ROOT_KEY@@.app]. #}
services:
  app:
    image: {{ @@ROOT_KEY@@.app.image_name }}:{{ @@ROOT_KEY@@.app.image_tag }}
    container_name: {{ deploy.project_name }}-{{ deploy.environment_tag }}-{{ @@ROOT_KEY@@.app.name }}
    hostname: {{ deploy.project_name }}-{{ deploy.environment_tag }}-{{ @@ROOT_KEY@@.app.name }}
    secrets:
      - api_key   # file wiring arrives via CIU's overlay (S4.17)
    command: ["python", "-m", "http.server", "{{ @@ROOT_KEY@@.app.internal_port }}"]
    environment:
      {% for key, value in deploy.env.defaults.items() %}
      - {{ key }}={{ value }}
      {% endfor %}
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider",
             "http://127.0.0.1:{{ @@ROOT_KEY@@.app.internal_port }}/"]
      interval: {{ deploy.health.interval }}
      timeout: {{ deploy.health.timeout }}
      retries: {{ deploy.health.retries }}
      start_period: {{ deploy.health.start_period }}
    volumes:
      - {{ @@ROOT_KEY@@.app.hostdir.data }}:/data
    labels:
      - {{ deploy.project_name }}.component=@@STACK_NAME@@
    networks:
      - workspace

networks:
  workspace:
    external: true
    name: {{ deploy.network_name }}

