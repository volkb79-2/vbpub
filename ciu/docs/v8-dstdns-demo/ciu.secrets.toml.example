# ciu.secrets.toml — the ONE materialized-secrets store (gitignored, mode 0600,
# CIU-owned; replaces every <stack>/.ciu/secrets/<name> file, the project
# store, and the Vault bootstrap values that used to sit in a stack's [state]).
# Shape: [secrets.<realization>.<service>.<key>] value/source/created, where
# `source` is `<from>[:<resolved path | var | entry>]` or `hook:<script>` (S10.6).
# `ciu secrets show` explains each entry; `ciu migrate --secrets` fills this from
# a v7 checkout without re-minting anything. Written atomically under the
# instance lock (the checkout directory, S14.4); the file is never a lock.
#
# What travels on `ciu push` is derived per source (S17.3.1): generate+local,
# ask and file values travel; host entries travel to their host; vault-sourced
# values travel only to a host that has no resolution to the vault service.
#
# Values below are placeholders. This file is never rendered into a compose
# file: `file` delivery bind-mounts a per-run temp copy, `env` delivery goes
# through the compose process environment.

[secrets.vault.vault.root_token]
value = "hvs.<redacted>"
source = "hook:post_compose_vault.py"
created = 2026-09-02T09:00:00Z

[secrets.vault.vault.unseal_key]
value = "<redacted>"
source = "hook:post_compose_vault.py"
created = 2026-09-02T09:00:00Z

[secrets.db_core.postgres.postgres_superuser_password]
value = "<redacted>"
source = "generate:vault:db/postgres/superuser_password"       # from = "generate", store = "vault" — the resolved [vault.paths] value
created = 2026-09-02T09:01:12Z

[secrets.redis_core.redis.redis_password]
value = "<redacted>"
source = "generate:vault:redis/password"
created = 2026-09-02T09:01:20Z

[secrets.controller.controller.postgres_password]
value = "<redacted>"
source = "vault:db/postgres/controller_password#password"      # from = "vault" (+ field)
created = 2026-09-02T09:04:02Z

[secrets.registry_lightweight.registry.registry_http_secret]
value = "<redacted>"
source = "generate:local"                                      # from = "generate" (store = "local"): travels with every bundle that needs it
created = 2026-09-02T09:05:00Z

[secrets.hosts.tsstammtisch.tls_cert_pem]          # host-scoped entries keep their own namespace
value = "-----BEGIN CERTIFICATE-----<redacted>"
source = "ask:EDGE_TLS_CRT"
created = 2026-09-02T09:06:00Z
