# infra/cadvisor/ciu.defaults.toml.j2 — v8 notation
# Realization `cadvisor` (bound by the registry) = the `cadvisor` LogicalService;
# one service keyed like the realization, so its container is
# dstdns-<instance>-cadvisor. What became derived: the container/host name, the
# network, the image string (one key), the host-port publication (an endpoint).
# Inclusion is a deploy.control flag evaluated by ciu — no Jinja expression.

[ciu_stack.cadvisor]
image = "gcr.io/cadvisor/cadvisor:v0.47.2"
enabled = "enable_observability"     # [deploy.control] flag name
endpoints.http = { port = 8080, protocol = "http", publish = "host", host_port = 8080 }   # metrics UI/API, published on the host as before

[hooks]
pre_compose = []
post_compose = []
