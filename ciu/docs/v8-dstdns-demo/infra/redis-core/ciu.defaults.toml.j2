# infra/redis-core/ciu.defaults.toml.j2 — v8 notation
# Realization `redis_core` (bound by the registry). The password it mints is a
# fact in `redis`'s contract; consumers depend on the LogicalService `redis`,
# never on this stack by name. The former `requires = ["stack:infra/vault:healthy"]`
# is gone: the GEN_TO_VAULT directive below derives that edge.

[ciu_stack.redis]
image = "redis:8-alpine"
# no init_provides: vault:secret/redis/password DERIVES from the GEN_TO_VAULT directive below (S10.1.2); repeating it here is an ERROR (S6.4.2)
endpoints.redis = { port = 6379, protocol = "tcp" }
[ciu_stack.redis.hostdir]
data = ""                            # "" = ciu-generated host path
[ciu_stack.redis.secrets]
redis_password = { directive = "GEN_TO_VAULT:{{ vault.paths.redis_password }}", delivery = "env", env_name = "REDIS_CORE_SECRETS_REDIS_PASSWORD" }
# env delivery kept: redis-server takes --requirepass as an argument; ciu check lists it as restart-bound.

[hooks]
pre_compose = []
post_compose = ["./post_compose_redis.py"]   # ACL users from [registry.redis.users]
