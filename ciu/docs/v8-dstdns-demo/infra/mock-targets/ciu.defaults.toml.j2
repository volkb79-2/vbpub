# infra/mock-targets/ciu.defaults.toml.j2 — v8 notation
# Realization `mock_targets` (bound by the registry): the `simulated` variant of
# the `probe_targets` LogicalService — deterministic DNS + HTTP servers the
# workers probe in tests. Selected per instance (`ciu up --realness
# probe_targets=simulated`, then pinned in [ciu.instance.realness]); consumers
# route to routes.probe_targets.dns / routes.probe_targets.http identically
# whether the realization is this stack or the real internet.
# What became derived: the container/host names (dstdns-<instance>-mock_targets-dns
# and -http), the instance network, the per-service image tags (one image, one key).

[ciu_stack.dns]                      # UDP DNS server (dnslib) answering from fixture data
primary = true                       # the health-bearing service for the realization (contract is [])
image = "{{ deploy.registry.namespace }}/mock-targets:latest"   # built by the compose template from [mock_image]
endpoints.dns = { port = 5353, protocol = "udp" }   # publish = "instance"; host publishing for local debugging is a ciu.toml.j2 override
[ciu_stack.dns.env]
MOCK_DNS_HOST = "0.0.0.0"            # bind address inside the container

[ciu_stack.http]                     # HTTP server (aiohttp): fixture pages + security-test routes
image = "{{ deploy.registry.namespace }}/mock-targets:latest"
endpoints.http = { port = 8880, protocol = "http" }
[ciu_stack.http.env]
MOCK_HTTP_HOST = "0.0.0.0"

[mock_image]                         # consumer data (passed through to the templates): the ONE Dockerfile both services are built from
dockerfile = "tests/_harness/mock_targets/Dockerfile"
context = "."                        # repo root, so the Dockerfile can COPY tests/ and libs/
python_base_image = "{{ build.mock_python_base_image }}"   # from the global [build] user table — one source, no restated tag

[hooks]
pre_compose = []
post_compose = []

# No [state] table: hook-persisted state lives in <location>/ciu.state.toml (S6.10); a [state] table in a stack file is an ERROR.
