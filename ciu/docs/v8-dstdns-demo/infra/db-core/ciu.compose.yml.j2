# infra/db-core/ciu.compose.yml.j2 — v8 notation
# ciu injects per service: container_name, hostname, networks (the instance
# network — the init jobs are pinned to it too, so compose never auto-creates a
# `<project>_default` bridge), base labels, depends_on conditions (from
# depends_on/one_shot), the pgadmin configfile mounts, cgroup fields. Bind-mount
# sources use instance.physical_repo_root: the HOST-visible checkout path (the
# daemon runs on the host — Docker-outside-Docker in the devcontainer).
services:
  postgres_init:
    image: {{ ciu_stack.postgres_init.image }}
    pull_policy: always                # `:latest` is otherwise pulled once and cached forever
    user: "root:root"                  # must chown
    environment:
      - CLEAN_DATA_DIR={{ 'true' if maintenance.clean_data_dirs else 'false' }}
    # the wipe also removes dotfiles, which `*` does not match
    command: >
      sh -c "
      if [ \"$$CLEAN_DATA_DIR\" = 'true' ]; then
        echo '[CLEAN] Removing existing PostgreSQL data directory...' &&
        rm -rf /home/postgres/pgdata/* /home/postgres/pgdata/.[!.]* 2>/dev/null || true &&
        exit 0
      fi &&
      mkdir -p /home/postgres/pgdata &&
      chown -R 1000:{{ instance.docker_gid }} /home/postgres/pgdata &&
      chmod -R 775 /home/postgres/pgdata &&
      echo 'PostgreSQL data directory initialized (1000:docker, group-writable)'
      "
    volumes:
      - {{ ciu_stack.postgres.hostdir.data }}:/home/postgres/pgdata

  postgres:
    image: {{ ciu_stack.postgres.image }}
    user: "1000:{{ instance.docker_gid }}"   # timescaledb-ha (Ubuntu-based) runs postgres as uid 1000
    environment:
      {% for key, value in deploy.env.defaults.items() %}
      - {{ key }}={{ value }}
      {% endfor %}
      # superuser
      - POSTGRES_USER={{ ciu_stack.postgres.settings.superuser }}
      - POSTGRES_PASSWORD=${DB_CORE_SECRETS_POSTGRES_SUPERUSER_PASSWORD}
      - POSTGRES_DB={{ ciu_stack.postgres.settings.superuser_db }}
      # 01-init-users.sh: DBA layer (roles + databases); passwords are env-delivered secrets
      - DATABASE_NAME={{ ciu_stack.postgres.settings.database }}
      - DATABASE_USER_CONTROLLER={{ ciu_stack.postgres.settings.controller_user }}
      - DATABASE_USER_CONTROLLER_DDL={{ ciu_stack.postgres.settings.controller_ddl_user }}
      - DATABASE_USER_WORKERDB={{ ciu_stack.postgres.settings.workerdb_user }}
      - DATABASE_USER_WEBAPP={{ ciu_stack.postgres.settings.webapp_user }}
      - POSTGRES_CONTROLLER_USER={{ ciu_stack.postgres.settings.controller_user }}
      - POSTGRES_CONTROLLER_PASSWORD=${DB_CORE_SECRETS_POSTGRES_CONTROLLER_PASSWORD}
      - POSTGRES_CONTROLLER_DDL_PASSWORD=${DB_CORE_SECRETS_POSTGRES_CONTROLLER_DDL_PASSWORD}
      - POSTGRES_CONTROLLER_DB={{ ciu_stack.postgres.settings.database }}
      - POSTGRES_WORKERDB_USER={{ ciu_stack.postgres.settings.workerdb_user }}
      - POSTGRES_WORKERDB_PASSWORD=${DB_CORE_SECRETS_POSTGRES_WORKERDB_PASSWORD}
      - POSTGRES_WEBAPP_USER={{ ciu_stack.postgres.settings.webapp_user }}
      - POSTGRES_WEBAPP_PASSWORD=${DB_CORE_SECRETS_POSTGRES_WEBAPP_PASSWORD}
      - POSTGRES_AUTHENTIK_PASSWORD=${DB_CORE_SECRETS_POSTGRES_AUTHENTIK_PASSWORD}
      - AUTHENTIK_DATABASE={{ ciu_stack.postgres.settings.authentik_database }}
    volumes:
      # Mount the image's VOLUME parent (/home/postgres/pgdata), NOT the nested PGDATA
      # (/home/postgres/pgdata/data): the entrypoint then creates PGDATA itself (0700,
      # uid 1000) and runs /docker-entrypoint-initdb.d on first start. Mounting PGDATA
      # directly would make it "find existing data" and skip the init scripts.
      - {{ ciu_stack.postgres.hostdir.data }}:/home/postgres/pgdata
      - {{ instance.physical_repo_root }}/infra/db-core/init-scripts:/docker-entrypoint-initdb.d:ro
    healthcheck:
      # accepting connections ≠ roles/databases ready: consumers wait on main_db's
      # contract facts (pg:* probes), not on this check alone
      test: ["CMD-SHELL", "pg_isready -h localhost -U {{ ciu_stack.postgres.settings.superuser }}"]
      interval: {{ ciu_stack.postgres.health.interval }}
      timeout: {{ ciu_stack.postgres.health.timeout }}
      retries: {{ ciu_stack.postgres.health.retries }}
      start_period: {{ ciu_stack.postgres.health.start_period }}
    restart: unless-stopped
    labels:
      - "{{ deploy.labels.prefix }}.service-container=false"

  pgadmin_init:
    image: {{ ciu_stack.pgadmin_init.image }}
    pull_policy: always
    user: "root:root"
    environment:
      - CLEAN_DATA_DIR={{ 'true' if maintenance.clean_data_dirs else 'false' }}
    command: >
      sh -c "
      if [ \"$$CLEAN_DATA_DIR\" = 'true' ]; then
        echo '[CLEAN] Removing existing pgAdmin data...' &&
        rm -rf /data/* /data/.* /certs/* /certs/.* 2>/dev/null || true &&
        exit 0
      fi &&
      mkdir -p /data /certs &&
      chown -R 5050:{{ instance.docker_gid }} /data /certs &&
      chmod -R 775 /data &&
      echo 'pgAdmin directories initialized (5050:docker, group-writable)'
      "
    volumes:
      - {{ ciu_stack.pgadmin.hostdir.data }}:/data
      {% if ciu_stack.pgadmin.settings.enable_tls %}
      # server.cert / server.key are placed here by the operator (the v7 copy from the
      # shell-env PUBLIC_TLS_*_PEM paths has no v8 source: env is not a render input)
      - {{ ciu_stack.pgadmin.hostdir.certs }}:/certs
      {% endif %}

  pgadmin:
    image: {{ ciu_stack.pgadmin.image }}
    pull_policy: always
    user: "5050:{{ instance.docker_gid }}"   # the image's pgadmin uid + docker group
    environment:
      {% for key, value in deploy.env.defaults.items() %}
      - {{ key }}={{ value }}
      {% endfor %}
      - PGADMIN_DEFAULT_EMAIL={{ ciu_stack.pgadmin.settings.email }}
      - PGADMIN_DEFAULT_PASSWORD=${DB_CORE_SECRETS_PGADMIN_PASSWORD}
      - PGADMIN_DISABLE_POSTFIX=true
      {% if ciu_stack.pgadmin.settings.enable_tls %}
      - PGADMIN_ENABLE_TLS=True
      - PGADMIN_SERVER_MODE=True
      {% endif %}
    volumes:
      - {{ ciu_stack.pgadmin.hostdir.data }}:/var/lib/pgadmin
      # servers.json / preferences.json: configfile mounts injected by ciu
      {% if ciu_stack.pgadmin.settings.enable_tls %}
      - {{ ciu_stack.pgadmin.hostdir.certs }}/server.cert:/certs/server.cert:ro
      - {{ ciu_stack.pgadmin.hostdir.certs }}/server.key:/certs/server.key:ro
      {% endif %}
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://127.0.0.1:{{ ciu_stack.pgadmin.endpoints.pgadmin.port }}/misc/ping"]
      interval: {{ ciu_stack.pgadmin.health.interval }}
      timeout: {{ ciu_stack.pgadmin.health.timeout }}
      retries: {{ ciu_stack.pgadmin.health.retries }}
      start_period: {{ ciu_stack.pgadmin.health.start_period }}
    restart: unless-stopped
    labels:
      - "{{ deploy.labels.prefix }}.service-container=false"

  adminer:
    image: {{ ciu_stack.adminer.image }}
    pull_policy: always
    user: "{{ instance.user_uid }}:{{ instance.user_gid }}"
    environment:
      {% for key, value in deploy.env.defaults.items() %}
      - {{ key }}={{ value }}
      {% endfor %}
      - ADMINER_DESIGN=dracula
      - ADMINER_DEFAULT_SERVER={{ ciu_stack.postgres.identity.hostname }}   # own sibling: derived identity, not a route
    healthcheck:
      test: ["CMD", "php", "-r", "if(file_get_contents('http://127.0.0.1:{{ ciu_stack.adminer.endpoints.adminer.port }}')!==false){exit(0);}exit(1);"]
      interval: {{ ciu_stack.adminer.health.interval }}
      timeout: {{ ciu_stack.adminer.health.timeout }}
      retries: {{ ciu_stack.adminer.health.retries }}
      start_period: {{ ciu_stack.adminer.health.start_period }}
    restart: unless-stopped
    labels:
      - "{{ deploy.labels.prefix }}.service-container=false"

  minio_init:
    image: {{ ciu_stack.minio_init.image }}
    pull_policy: always
    user: "root:root"
    environment:
      - CLEAN_DATA_DIR={{ 'true' if maintenance.clean_data_dirs else 'false' }}
    command: >
      sh -c "
      if [ \"$$CLEAN_DATA_DIR\" = 'true' ]; then
        echo '[CLEAN] Removing existing MinIO data...' &&
        rm -rf /data/* /data/.* 2>/dev/null || true &&
        exit 0
      fi &&
      rm -rf /data/.minio.sys/tmp/* &&
      chown -R {{ instance.user_uid }}:{{ instance.docker_gid }} /data &&
      chmod -R 775 /data &&
      echo 'MinIO data directory initialized ({{ instance.user_uid }}:docker, group-writable)'
      "
    volumes:
      - {{ ciu_stack.minio.hostdir.data }}:/data

  minio:
    image: {{ ciu_stack.minio.image }}
    pull_policy: always
    user: "{{ instance.user_uid }}:{{ instance.user_gid }}"
    command: server /data --console-address ":{{ ciu_stack.minio.endpoints.console.port }}"
    environment:
      {% for key, value in deploy.env.defaults.items() %}
      - {{ key }}={{ value }}
      {% endfor %}
      - MINIO_ROOT_USER={{ ciu_stack.minio.settings.root_user }}
      - MINIO_ROOT_PASSWORD=${DB_CORE_SECRETS_MINIO_ROOT_PASSWORD}
      - MINIO_BROWSER_REDIRECT_URL={{ ciu_stack.minio.settings.browser_redirect_url }}
    volumes:
      - {{ ciu_stack.minio.hostdir.data }}:/data
    healthcheck:
      test: ["CMD", "mc", "ready", "local"]
      interval: {{ ciu_stack.minio.health.interval }}
      timeout: {{ ciu_stack.minio.health.timeout }}
      retries: {{ ciu_stack.minio.health.retries }}
      start_period: {{ ciu_stack.minio.health.start_period }}
    restart: unless-stopped
    labels:
      - "{{ deploy.labels.prefix }}.service-container=false"
