# infra/consul-server/ciu.defaults.toml.j2 — v8 notation
# Realization `consul_server` (bound by the global registry; it realizes the
# LogicalService `consul`). DERIVED, never written here: container/host names
# (dstdns-<instance>-consul_server-consul), the compose project, the instance
# network, the wave, and every consumer's route (routes.consul.http/.grpc/.dns).
# The ACL tokens the post_compose hook mints into Vault are `consul`'s contract
# ([hooks.provides] consul below); consumers depend on `consul`, never on this stack.

[ciu_stack.init]
image = "hashicorp/consul:latest"
one_shot = true                      # pre-chowns the data/config hostdirs to the workspace user, exits 0

[ciu_stack.consul]
image = "hashicorp/consul:latest"
primary = true                       # health-bearing service: carries the contract, exec target, image source
depends_on = ["init"]                # rendered as depends_on: init: condition: service_completed_successfully
# The hook writes tokens INTO Vault, so Vault must be up and unsealed first. This
# stack has no *_VAULT directive of its own (the hook authenticates with the
# bootstrap token from ciu.secrets.toml), so nothing derives that edge — it is
# declared. Requiring the LogicalService also waits for its contract (the AppRoles
# vault's own hook mints), which only exist once Vault is unsealed: exactly the
# readiness the hook needs. Replaces `requires = ["stack:infra/vault:healthy"]`.
init_requires = ["vault"]
# Endpoints: instance network only by default. A Mode-B isolated instance that
# wants Consul on host ports sets `endpoints.<e>.publish = "host"` (+ host_port)
# in its own ciu.toml.j2, never here (the former `publish_host_ports` flag).
endpoints.http = { port = 8500, protocol = "http" }   # HTTP API + UI
endpoints.grpc = { port = 8300, protocol = "tcp" }    # server RPC
endpoints.dns  = { port = 8600, protocol = "udp" }    # DNS

[ciu_stack.consul.settings]          # consumer data
datacenter = "dc1"

[ciu_stack.consul.hostdir]
data = ""                            # "" = ciu-generated host path
config = ""

[hooks]
pre_compose = []
post_compose = ["./post_compose_consul.py"]   # ACL bootstrap, policies from [registry.consul.policies], tokens → Vault; identities from ctx
# Facts the hook creates (= [service.consul] contract), keyed by the service they
# are probed in (S8.6.3). cmru_node tokens are issued per node by auto_config at
# enrollment, so they are not pre-minted here.
[hooks.provides]
consul = [
  "vault:secret/consul/controller/token", "vault:secret/consul/worker-io/token",
  "vault:secret/consul/worker-db/token", "vault:secret/consul/webapp-server/token",
  "vault:secret/consul/docker-stats-exporter/token",
  "vault:secret/consul/cmru/bootstrap-bearer-token", "vault:secret/consul/cmru/viewer/token",
]
