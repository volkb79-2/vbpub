# infra/otel-aggregator/ciu.defaults.toml.j2 — v8 notation
# Realization `otel_aggregator` (bound by the registry) = the `otel_aggregator`
# LogicalService: central telemetry processing. Node collectors export to it
# through routes.otel_aggregator.otlp_grpc. What became derived: the container/
# host name (dstdns-<instance>-otel_aggregator-collector), the network, the
# SkyWalking OAP address (a route, was a hard-coded "skywalking-oap:11800"), and
# the config-file mount (a configfile, was a ${PHYSICAL_REPO_ROOT} bind).

[ciu_stack.collector]
image = "otel/opentelemetry-collector-contrib:latest"
uses = ["tracing"]                   # the OAP export target is a route read at run time: no ordering edge (S7.8.3); the sending queue buffers a late OAP
[ciu_stack.collector.endpoints]     # all four published on the host as before (host_port = port)
otlp_grpc = { port = 4317,  protocol = "tcp",  publish = "host", host_port = 4317 }    # OTLP gRPC receiver
otlp_http = { port = 4318,  protocol = "http", publish = "host", host_port = 4318 }    # OTLP HTTP receiver
metrics   = { port = 8888,  protocol = "http", publish = "host", host_port = 8888 }    # Prometheus metrics
health    = { port = 13133, protocol = "http", publish = "host", host_port = 13133 }   # health_check extension

[ciu_stack.collector.processors]     # consumer data: documents the pipeline sizing in the static config file
batch_size = 8192
batch_timeout = "200ms"
memory_limit_mib = 1024
tail_sampling_rate = 100

[ciu_stack.collector.exporters]
skywalking_enabled = true
skywalking_endpoint = "{{ routes.tracing.grpc.host }}:{{ routes.tracing.grpc.port }}"   # OAP gRPC (11800) — a ROUTE, same spelling in every layout
skywalking_oap_host = "{{ routes.tracing.grpc.host }}"

[ciu_stack.collector.hostdir]
data = ""                            # file_storage extension (persistent sending queue); "" = ciu-generated host path

[ciu_stack.collector.configfile.otel]   # rendered to ciu.rendered.collector.otel, mounted read-only at `target`
template = "otel-aggregator-config.yml"   # static YAML: its ${VAR} references are the collector's own env expansion, not Jinja
target = "/etc/otelcol/otel-aggregator-config.yml"

[hooks]
pre_compose = []
post_compose = []
