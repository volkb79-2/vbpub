# infra/db-core-seeded/ciu.defaults.toml.j2 — v8 notation (new stack: no v7 original)
# Realization `db_core_seeded`: the owned-seeded variant of main_db AND app_schema
# ([service.main_db.owned-seeded] / [service.app_schema.owned-seeded] realized_by =
# "db_core_seeded"; selected with `ciu up --realness main_db=owned-seeded`, then
# pinned in [ciu.instance.realness]).
# owned-seeded (§4.1.7): a prepared image this project owns, with the roles, the
# application schema and test fixtures baked in at image-build time. Its pg:*
# contract facts therefore hold BY CONSTRUCTION: `init_provides` is declared
# satisfied — no one-shot job, no entrypoint init script. The vault:secret/*
# facts of the contract are different: a seeded image cannot satisfy them by
# construction (a Vault fact means the value IS in Vault), and no GEN_TO_VAULT
# directive exists here to derive them — so the post_compose hook writes the
# image's baked credentials to Vault and provides them ([hooks.provides] postgres, S8.6.3).
# Consumers change nothing: routes.main_db.sql resolves to this container exactly
# as it would to db_core; app_schema's contract is [] so depending on it here
# means "this service is healthy". Lanes declaring
# `requires.realness = { main_db = "live" }` refuse this variant.

[ciu_stack.postgres]
image = "{{ deploy.registry.namespace }}/db-core-seeded:latest"
probe_user = "postgres"
# The hook needs Vault up and a route to it (routes.vault.* in its context, S12.2):
# with no *_VAULT directive here, nothing derives that edge, so it is declared.
init_requires = ["vault"]
init_provides = [                    # the pg:* half of [service.main_db]'s contract: baked in, holds by construction
  "pg:db/dstdns", "pg:db/authentik",
  "pg:role/controller", "pg:role/controller_ddl", "pg:role/workerdb", "pg:role/workerdb_ddl",
  "pg:role/webapp", "pg:role/authentik",
]
endpoints.sql = { port = 5432, protocol = "tcp" }

[ciu_stack.postgres.hostdir]
data = ""                            # instance-scoped working copy: the image restores its baked snapshot into an empty PGDATA on first start

[hooks]
pre_compose = []
# A seeded image cannot satisfy Vault facts by construction: the credentials are
# baked into the image, but a vault:secret/* fact says the value is in Vault.
# The hook writes the image's baked credentials to Vault (the way authentik's
# hook mints vault:secret/ddcli/service_password); the facts are keyed under the
# service they are probed in (S8.6.3) and probed before the next wave (S8.5).
post_compose = ["./post_compose_seed_vault.py"]
[hooks.provides]
postgres = [                         # the vault:secret/* half of [service.main_db]'s contract
  "vault:secret/db/postgres/controller_password", "vault:secret/db/postgres/controller_ddl_password",
  "vault:secret/db/postgres/workerdb_password", "vault:secret/db/postgres/workerdb_ddl_password",
  "vault:secret/db/postgres/webapp_password", "vault:secret/db/postgres/authentik_password",
]
