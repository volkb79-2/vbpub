# infra/otel-collector-node/ciu.defaults.toml.j2 — v8 notation
# Realization `otel_collector_node` (bound by the registry) = the `otel_collector`
# LogicalService: the per-node telemetry agent. Services send OTLP here
# (routes.otel_collector.otlp_grpc / .otlp_http); it forwards to the aggregator
# through a route of its own. What became derived: the container/host name
# (dstdns-<instance>-otel_collector_node-collector), the network, the aggregator
# address (a route, was "otel-aggregator:4317"), the config-file mount.
# Deliberately NO init edge on otel_aggregator (the original declared no
# `requires` either): the route is used at run time and the file_storage
# sending queue absorbs an aggregator that is still starting — hence `uses`,
# which derives the route and no edge (S7.8.3).

[ciu_stack.collector]
image = "otel/opentelemetry-collector-contrib:latest"
uses = ["otel_aggregator"]
[ciu_stack.collector.endpoints]     # host ports differ from the container ports so this and the aggregator can share a host
otlp_grpc = { port = 4317,  protocol = "tcp",  publish = "host", host_port = 4319 }    # OTLP gRPC receiver
otlp_http = { port = 4318,  protocol = "http", publish = "host", host_port = 4320 }    # OTLP HTTP receiver
metrics   = { port = 8888,  protocol = "http", publish = "host", host_port = 8889 }    # Prometheus metrics
health    = { port = 13133, protocol = "http", publish = "host", host_port = 13134 }   # health_check extension

[ciu_stack.collector.receivers]      # consumer data: documents the static pipeline config (otel-collector-config.yml)
otlp_grpc = true
otlp_http = true
prometheus = false

[ciu_stack.collector.processors]
batch_size = 8192
batch_timeout = "200ms"
memory_limit_mib = 512

[ciu_stack.collector.exporters]
aggregator_enabled = true
aggregator_endpoint = "{{ routes.otel_aggregator.otlp_grpc.host }}:{{ routes.otel_aggregator.otlp_grpc.port }}"   # a ROUTE: same spelling in every layout

[ciu_stack.collector.file_storage]   # persistent sending queue; `directory` also renders the volume target in the compose template (one source)
enabled = true
directory = "/var/lib/otelcol/file_storage"
timeout = "10s"

[ciu_stack.collector.hostdir]
data = ""                            # "" = ciu-generated host path

[ciu_stack.collector.configfile.otel]   # rendered to ciu.rendered.collector.otel, mounted read-only at `target`
template = "otel-collector-config.yml"    # static YAML: its ${VAR} references are the collector's own env expansion, not Jinja
target = "/etc/otelcol/otel-collector-config.yml"

[hooks]
pre_compose = []
post_compose = []
