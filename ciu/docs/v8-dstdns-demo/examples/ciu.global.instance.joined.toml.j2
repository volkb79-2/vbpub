# examples/ciu.global.instance.joined.toml.j2 — the OVERLAY of a package WORKTREE
# that joins the primary instance's Vault, Consul, Redis, database, identity
# provider and observability instead of running its own. `ciu instance add --join
# primary --services vault,consul,redis,main_db,object_store,app_schema,
# identity_provider,tracing,otel_collector` WRITES exactly these tables (formerly
# `ciu worktree add --join`); a hand-written overlay is identical.
#
# Hand-edited only (S14.2): the worktree's OWN identity, host facts, build facts
# and realness record are CIU-owned and live in its generated file
# (examples/ciu.instance.generated.joined.toml), merged after this one.

[ciu.instance]
layout = "local"
bundles = ["apps", "worker-io", "test"]   # only what this worktree develops
label = "p146-fresh"

# Two instances on one machine: the publish = "host" endpoints of this worktree's
# own bundles would collide with the primary's — move them here (S6.3.2, S14.2):
# [ciu.instance.host_ports]
# "cadvisor.cadvisor.http" = 18080

# Joined realizations: kind = "joined" names the reference INSTANCE (registry
# name, or a path for non-git roots) and the LogicalService to borrow. The
# joiner's variant row names the level the reference ACTUALLY runs; at `ciu up`
# ciu reads the reference's rendered [ciu.instance.resolved] and refuses on a
# mismatch, then records the reference's level in this instance's own record
# (generated file). Routes to joined services resolve to the reference's
# container names on the reference's instance network (S7.8 step 2).
# tracing / otel_collector / identity_provider are joined because the apps
# bundle `uses` them (routes, no edges — S7.8.3): every name in init_requires or
# uses must resolve to a selected variant (S6.4.1).
[realization]
primary_vault   = { kind = "joined", instance = "primary", service = "vault" }
primary_consul  = { kind = "joined", instance = "primary", service = "consul" }
primary_redis   = { kind = "joined", instance = "primary", service = "redis" }
primary_db      = { kind = "joined", instance = "primary", service = "main_db" }
primary_store   = { kind = "joined", instance = "primary", service = "object_store" }
primary_schema  = { kind = "joined", instance = "primary", service = "app_schema" }
primary_idp     = { kind = "joined", instance = "primary", service = "identity_provider" }
primary_tracing = { kind = "joined", instance = "primary", service = "tracing" }
primary_otel    = { kind = "joined", instance = "primary", service = "otel_collector" }

[service.vault]
live.realized_by = "primary_vault"
[service.consul]
live.realized_by = "primary_consul"
[service.redis]
live.realized_by = "primary_redis"
[service.main_db]
live.realized_by = "primary_db"           # the primary runs main_db=live (its record says so); a seeded primary would be declared owned-seeded here
[service.object_store]
live.realized_by = "primary_store"
[service.app_schema]
live.realized_by = "primary_schema"
[service.identity_provider]
live.realized_by = "primary_idp"
[service.tracing]
live.realized_by = "primary_tracing"
[service.otel_collector]
live.realized_by = "primary_otel"
