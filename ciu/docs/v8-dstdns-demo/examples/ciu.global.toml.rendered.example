# examples/ciu.global.toml.rendered.example — an EXCERPT of the rendered
# ciu.global.toml (gitignored, CIU-written, regenerated identically on every
# render, also the instance lock). Everything above [ciu.instance.resolved] is
# the merged INPUT (defaults → override → instance overlay → generated file);
# everything under it is DERIVED and read-only. Shown for the primary instance
# (98535c) rendered for layout "prod3" on host "rs1002", plus the same facts
# for "local". Hand-written to illustrate shapes; a real file is longer and
# emits its tables in the canonical order of S3.7.4.
# Identities are DNS-safe: `_` in realization/service names maps to `-` (S4.2.1).

[deploy]
project_name = "dstdns"
revision = 8
landscape_id = "dstdns-dev"
# … merged input continues (service, realization, network, profiles, layouts, testing, …) …

# ---- merged from ciu.instance.generated.toml: CIU-owned INPUT, not derived ----
[ciu.instance.generated]                         # instance IDENTITY — identical on every host of the layout (the generated file travels with the bundle)
instance_id = "98535c"

[ciu.host.generated]                             # HOST-LOCAL facts — regenerated on this host by `ciu instance init --host rs1002`
name = "rs1002"
repo_root = "/opt/ciu/current"
physical_repo_root = "/opt/ciu/current"
public_fqdn = "rs1002.dchive.de"
env_type = "native"
user_uid = 1000
user_gid = 1000
docker_gid = 988

[ciu.instance.build]                             # written by `ciu build`
build_version = "2026.08.30-9f3c1a2"
build_time = "2026-08-30T11:02:41Z"

[ciu.instance.realness.prod3]                    # S9.4: THIS layout's record (other layouts' records are stripped from the pushed bundle, S9.4.4)
main_db = "live"
app_schema = "live"
probe_targets = "live"

# =============================== DERIVED ====================================
[ciu.instance.resolved]
facts_schema = 1
layout = "prod3"
host = "rs1002"
environment = "prod"
waves = [
  ["tailscale_node"],                                           # wave 0: transport (network.mesh.realized_by); per_host → on every host
  ["vault"],                                                    # wave 1: every *_VAULT directive derives an edge here
  ["consul_server", "redis_core", "db_core"],                   # wave 2
  ["db_init", "authentik", "skywalking", "otel_aggregator"],    # wave 3
  ["controller", "docker_stats_exporter", "otel_collector_node"],
  ["worker_io", "worker_db", "webapp_server", "webapp_ui_react"],
  ["reverse_proxy"],
]
edges = [
  { from = "controller.controller", to = "db_core.postgres", kind = "init" },
  { from = "controller.controller", to = "db_init.runner", kind = "init" },
  { from = "controller.controller", to = "vault.vault", kind = "secret→vault" },
  { from = "controller.controller", to = "tailscale_node.tailscale", kind = "network" },   # controller (rs1002) → db_core (gstammtisch) crosses mesh
  { from = "worker_io.worker", to = "controller.controller", kind = "init" },
  # no edge for controller → tracing: it is `uses` — a route (below), never an edge (S7.8.3)
  # …
]

[ciu.instance.resolved.gates.2]                  # before wave 3. Nothing of wave 2 runs on rs1002, so THIS host's entry is empty and the
healthy = []                                     # remote providers are probed for reachability over their routes only (S8.5.3);
completed = []                                   # gstammtisch's own rendered file carries the authoritative gate for them:
facts = []                                       #   healthy = ["consul_server.consul", "redis_core.redis", "db_core.postgres", "db_core.minio"]
                                                 #   completed = ["db_core.postgres_init", "db_core.minio_init"]
                                                 #   facts = ["pg:db/dstdns", "pg:role/controller", "vault:secret/consul/controller/token", …]

[ciu.instance.resolved.services.main_db]         # S9.3.3: level, realization and the VARIANT service — the health/endpoint/exec-target bearer (S5.2, S8.6)
level = "live"
realization = "db_core"
service = "postgres"
[ciu.instance.resolved.services.object_store]    # the same realization backs another capability through another of its services
level = "live"
realization = "db_core"
service = "minio"
[ciu.instance.resolved.services.probe_targets]
level = "live"
realization = "internet"                         # external realization: no service key, no host

[ciu.instance.resolved.networks.instance]        # S7.9: every declared network + the implicit instance network (S7.3.1)
name = "dstdns-98535c-network"
kind = "address"
[ciu.instance.resolved.networks.mesh]
name = "mesh"
kind = "address"
realized_by = "tailscale_node"
[ciu.instance.resolved.networks.public]
name = "public"
kind = "address"
[ciu.instance.resolved.networks.edge]
name = "edge"
kind = "proxy"
realized_by = "reverse_proxy"
fqdn = "gstammtisch.dchive.de"

[ciu.instance.resolved.realizations.tailscale_node]
hosts = ["gstammtisch", "rs1002", "tsstammtisch"]   # placement (S7.7): per_host = true → every host of the layout (S7.6.5)
[ciu.instance.resolved.realizations.tailscale_node.tailscale.identity]
container_name = "dstdns-98535c-tailscale-node-tailscale"   # the SAME identity on every host: names are per daemon (S4.2.4)
hostname = "dstdns-98535c-tailscale-node-tailscale"
compose_key = "tailscale-node-tailscale"
compose_project = "dstdns-98535c-tailscale-node"
network = "dstdns-98535c-network"                # not attached: host_network = true (S11.4)

[ciu.instance.resolved.realizations.db_core]
hosts = ["gstammtisch"]                          # one element unless per_host
[ciu.instance.resolved.realizations.db_core.postgres.identity]
container_name = "dstdns-98535c-db-core-postgres"   # db_core → db-core (S4.2.1)
hostname = "dstdns-98535c-db-core-postgres"
compose_key = "db-core-postgres"
compose_project = "dstdns-98535c-db-core"
network = "dstdns-98535c-network"
[ciu.instance.resolved.realizations.db_core.postgres.endpoints.sql]   # S4.4, S7.4.6
port = 5432
protocol = "tcp"
publish = "instance"
host_port = 5432
published_on = ["mesh"]                          # DERIVED publication (S7.4.1): declared instance-only, but controller/webapp_server/
                                                 # worker_io@rs1002 route to it over mesh, so gstammtisch gets
                                                 # ports: ["100.64.0.11:5432:5432/tcp"] — bound to its mesh address only. [] on the
                                                 # single-host layout "local"; a publish = "host" endpoint is published in every layout.

[ciu.instance.resolved.realizations.controller]
hosts = ["rs1002"]
[ciu.instance.resolved.realizations.controller.controller.identity]
container_name = "dstdns-98535c-controller"       # service == realization → the service part is omitted (S4.2.2)
hostname = "dstdns-98535c-controller"
compose_key = "controller"
compose_project = "dstdns-98535c-controller"
network = "dstdns-98535c-network"
[ciu.instance.resolved.realizations.controller.controller.endpoints.http]
port = 8080
protocol = "http"
publish = "proxy"
host_port = 8083
path = "/api/controller"
published_on = ["mesh"]                          # reverse_proxy@tsstammtisch and worker_db@gstammtisch reach it over mesh (S7.4.3; allow_from admits both)

[ciu.instance.resolved.realizations.worker_io]
hosts = ["rs1002"]
[ciu.instance.resolved.realizations.worker_io.worker.identity]
container_name = "dstdns-98535c-worker-io-worker"    # worker_io → worker-io (S4.2.1)
hostname = "dstdns-98535c-worker-io-worker"
compose_key = "worker-io-worker"                 # injected as an alias on every replica, so it resolves to all of them (S4.2.1, S11.4)
compose_project = "dstdns-98535c-worker-io"
network = "dstdns-98535c-network"
replicas = [
  { index = 1, container_name = "dstdns-98535c-worker-io-worker-1", compose_key = "worker-io-worker-1" },
  { index = 2, container_name = "dstdns-98535c-worker-io-worker-2", compose_key = "worker-io-worker-2" },
]

# Routes are per CONSUMER realization → LogicalService → endpoint (S7.8), derived
# only for the (C, X, e) pairs where C lists X in init_requires or uses (S7.8.3).
# The same consumer template line `{{ routes.main_db.sql.host }}` reads a
# container name on one host and a mesh address on three.
[ciu.instance.resolved.routes.controller.main_db.sql]      # controller@rs1002 → db_core@gstammtisch (tcp: no url; templates build their own scheme)
network = "mesh"
host = "100.64.0.11"
port = 5432
requires = ["tailscale_node"]
[ciu.instance.resolved.routes.controller.redis.redis]
network = "mesh"
host = "100.64.0.11"
port = 6379
requires = ["tailscale_node"]
[ciu.instance.resolved.routes.controller.tracing.grpc]      # `uses`: skywalking is on rs1002 too → same host → instance network (S7.8 step 4)
network = "instance"
host = "dstdns-98535c-skywalking-oap"
port = 11800
requires = []
[ciu.instance.resolved.routes.reverse_proxy.controller.http]   # nginx@tsstammtisch → controller@rs1002 over mesh: port = the endpoint's host_port;
network = "mesh"                                               # `path` drives the location block; `url` carries NO path (S7.8 step 7)
host = "100.64.0.12"
port = 8083
path = "/api/controller"
url = "http://100.64.0.12:8083"
requires = ["tailscale_node"]

# A PROXY-NETWORK route (S7.8 step 5) is derived for a consumer whose host lists
# a proxy-kind network in `reach` (reach = ["edge"], or ["mesh", "edge"] when mesh
# does not admit the endpoint) and targets a publish = "proxy" endpoint. ddcli
# (admin bundle) is in no prod3 bundle, so no such route is in this file; for a
# consumer C on such a host it would read:
# [ciu.instance.resolved.routes.<C>.controller.http]
# network = "edge"
# host = "gstammtisch.dchive.de"          # network.edge.fqdn
# port = 443                              # host_port of the proxy's publish = "host" https endpoint
# path = "/api/controller"
# url = "https://gstammtisch.dchive.de/api/controller"   # the proxy-network form of step 5: the proxy routes BY this path
# requires = ["reverse_proxy"]            # the proxy must be up first (network readiness, S7.3.2)

# ------------- the same facts rendered for layout "local" (one host) ---------
# [ciu.instance.resolved] layout = "local" host = "localhost" environment = "dev"
# [ciu.instance.realness.local] main_db = "live" app_schema = "live" probe_targets = "simulated"   (merged input, generated file)
# [ciu.instance.resolved.realizations.db_core] hosts = ["localhost"]
# [ciu.instance.resolved.realizations.db_core.postgres.endpoints.sql] … published_on = []   (single host: nothing published)
# [ciu.instance.resolved.routes.controller.main_db.sql]
# network = "instance"  host = "dstdns-98535c-db-core-postgres"  port = 5432  requires = []   (tcp: no url)
# [ciu.instance.resolved.services.probe_targets]  level = "simulated"  realization = "mock_targets"  service = "dns"
# [ciu.instance.resolved.realizations.mock_targets.dns.identity]  container_name = "dstdns-98535c-mock-targets-dns"  compose_key = "mock-targets-dns"
# [ciu.instance.resolved.routes.test_runner.browser_service.mcp]   (test_runner `uses` browser_service)
# network = "instance"  host = "dstdns-98535c-pwmcp-unified"  port = 8931  url = "http://dstdns-98535c-pwmcp-unified:8931"  requires = []
# a udp endpoint gets a url too — for a consumer C declaring uses = ["probe_targets"]:
# [ciu.instance.resolved.routes.<C>.probe_targets.dns]  network = "instance"  host = "dstdns-98535c-mock-targets-dns"  port = 5353  url = "udp://dstdns-98535c-mock-targets-dns:5353"

[ciu.instance.resolved.render]                   # ALWAYS the last table of the file: a non-empty file without it is torn (S14.4.2)
complete = true
