# examples/ciu.resolved.toml.example — an EXCERPT of the rendered ciu.resolved.toml
# (gitignored, CIU-written by temp-file + atomic rename, regenerated identically
# on every render; NOT a lock — the instance lock is the checkout directory,
# S14.4). Everything above [resolved] is the merged INPUT (ciu.toml → ciu.site.toml
# → ciu.instance.toml → ciu.instance.generated.toml, plus every stack file
# re-rooted under [realization.<R>]); everything under [resolved] is DERIVED and
# read-only. Shown for the primary instance (98535c) rendered for layout "prod3"
# on host "rs1002", plus the same facts for "local". Hand-written to illustrate
# shapes; a real file is longer and emits its tables in the canonical order of
# S3.7.4. Identities are DNS-safe: `_` in names maps to `-` (S4.2.1).

[project]
name = "dstdns"
revision = 8
landscape_id = "dstdns-dev"
# … merged input continues (service, realization incl. re-rooted stack tables, network, bundles, layouts, testing, …) …

[realization.controller.services.controller]          # a stack file re-rooted into the merged view (S3.6.2): what templates read as realization.controller.services.controller
image = "dstdns/controller:latest"
requires = ["app_schema"]
# … the stack's declared tables, plus the merged `health` and the expanded `requires` sugar as binds …

# ---- merged from ciu.instance.generated.toml: CIU-owned INPUT, not derived ----
[ciu.instance.generated]                         # instance IDENTITY — identical on every host of the layout (the generated file travels with the bundle)
instance_id = "98535c"

[ciu.host.generated]                             # HOST-LOCAL facts — regenerated on this host by `ciu instance init --host rs1002`
name = "rs1002"
hostname = "rs1002"
repo_root = "/opt/ciu/current"
physical_repo_root = "/opt/ciu/current"
env_type = "native"
user_uid = 1000
user_gid = 1000
docker_gid = 988

[ciu.instance.build]                             # written by `ciu build`
build_version = "2026.09.02-9f3c1a2"
build_time = "2026-09-02T11:02:41Z"

[ciu.instance.realness.prod3]                    # S9.4: THIS layout's record (other layouts' records are stripped from the pushed bundle, S9.4.4)
main_db = "live"
app_schema = "live"
probe_targets = "live"

# =============================== DERIVED ====================================
[resolved]
api = "ciu/resolved"                             # artifact discriminator + its own version (S18.4)
api_version = 1
layout = "prod3"
host = "rs1002"
environment = "prod"
rendered_at = 2026-09-03T11:05:12Z
# Waves per S8.4.1 — consumer → provider edges lifted to Realizations, same-Realization
# edges discarded, wave(R) = 0 without providers else 1 + max(wave(provider)); all 22
# Realizations of prod3's closure appear. `wait = "none"` bindings add no bind edge but
# their cross-host resolutions still add network edges (→ tailscale_node); every
# vault-sourced/-stored secret adds a secret→vault edge (S8.3). Derived by the rule,
# reproduced by `ciu check --graph`; hosts deploy only their own placements (S7.7).
waves = [
  ["cadvisor", "github_runner", "github_runner_webhook", "otel_aggregator", "otel_collector_node", "registry_lightweight", "tailscale_node", "vault", "webapp_ui_react", "webhook_listener"],   # wave 0: no providers (vault binds nothing; the collectors' and the UI's bindings are same-host, wait = "none")
  ["consul_server", "db_core", "redis_core", "reverse_proxy", "skywalking"],   # wave 1: secret→vault edges; reverse_proxy: network edges (its wait = "none" upstreams cross mesh)
  ["authentik", "db_init", "docker_stats_exporter"],                           # wave 2
  ["controller", "webapp_server", "worker_db"],                                # wave 3 (requires app_schema → db_init)
  ["worker_io"],                                                               # wave 4 (binds controller.http with the default wait; internal_dlq_token minter edge)
]
edges = [
  { from = "controller.controller", to = "db_core.postgres", kind = "bind" },             # binds.database → main_db.sql (+ facts pg:db/dstdns, pg:role/controller)
  { from = "controller.controller", to = "db_init.runner", kind = "bind" },               # requires = ["app_schema"] (sugar for a binding without data)
  { from = "controller.controller", to = "vault.vault", kind = "secret→vault" },
  { from = "controller.controller", to = "db_core.postgres", kind = "secret→minter" },    # from = "vault" path db/postgres/controller_password → minted by db_core.postgres
  { from = "controller.controller", to = "tailscale_node.tailscale", kind = "network" },  # controller (rs1002) → db_core (gstammtisch) crosses mesh
  { from = "worker_io.worker", to = "controller.controller", kind = "secret→minter" },    # internal_dlq_token is minted by controller
  # no edge for controller → tracing: binds.tracing has wait = "none" — a resolution (below), never an edge (S8.2)
  # …
]

# Gates (S8.5.1, S8.5.4) list the predicates evaluated on THIS host (rs1002) before the next wave — the strongest predicate
# per edge into a provider that runs here. Every `wait = "none"` binding (tracing, otel, the proxy's upstreams) adds no
# predicate; rs1002's first gated provider is controller, which worker_io (wave 4) binds with the default wait:
[resolved.gates.1]                               # before wave 2: no provider on rs1002 has a gated edge from a later wave
healthy = []
completed = []
facts = []
[resolved.gates.3]                               # before wave 4
healthy = ["controller.controller"]
completed = []
facts = ["vault:secret/internal/internal_dlq_token@controller.controller"]   # worker_io's secret→minter edge (S8.3); probed through CIU's vault binding
assumed = []                                     # remote facts accepted without a receipt would be listed here (S17.5)
# Remote providers (db_core, consul_server, redis_core, db_init on gstammtisch) are not gated here: their facts and completions
# come from gstammtisch's RECEIPT when `ciu activate` carried it (`--receipts`, S17.4.3, S8.5.3); a hand-started `ciu up` without
# one records them as `assumed` and WARNs. gstammtisch's own receipt carries healthy = ["consul_server.consul", "redis_core.redis",
# "db_core.postgres", "db_core.minio", …], completed = ["db_core.postgres_init", "db_core.minio_init", "db_init.runner"],
# facts = ["pg:db/dstdns", "pg:role/controller", "vault:secret/consul/controller/token", …].

[resolved.services.main_db]                      # S9.3.3: level, realization and the VARIANT service — the health/endpoint/exec-target bearer (S5.2, S8.6)
level = "live"
realization = "db_core"
service = "postgres"
[resolved.services.object_store]                 # the same realization backs another capability through another of its services
level = "live"
realization = "db_core"
service = "minio"
[resolved.services.probe_targets]
level = "live"
realization = "internet"                         # external realization: no service key, no host

[resolved.networks.instance]                     # S7.9: every declared network + the implicit instance network (S7.3.1)
name = "dstdns-98535c-network"
kind = "address"
[resolved.networks.mesh]
name = "mesh"
kind = "address"
realized_by = "mesh_node"                        # the LogicalService (S7.3); its selected variant service:
realized_service = "tailscale_node.tailscale"    # what readiness (S7.3.2) and the network edges (S8.3) point at
[resolved.networks.public]
name = "public"
kind = "address"
[resolved.networks.edge]
name = "edge"
kind = "proxy"
realized_by = "reverse_proxy"
fqdn = "gstammtisch.dchive.de"

[resolved.placement.tailscale_node]
hosts = ["gstammtisch", "rs1002", "tsstammtisch"]   # S7.7: per_host = true → every host of the layout (S7.6.5)
[resolved.placement.db_core]
hosts = ["gstammtisch"]                          # one element unless per_host
[resolved.placement.controller]
hosts = ["rs1002"]

[resolved.identities.tailscale_node.tailscale]
container_name = "dstdns-98535c-tailscale-node-tailscale"   # the SAME identity on every host: names are per daemon (S4.2.4)
hostname = "dstdns-98535c-tailscale-node-tailscale"
compose_key = "tailscale-node-tailscale"
compose_project = "dstdns-98535c-tailscale-node"
network = "dstdns-98535c-network"                # not attached: host_network = true (S11.4)

[resolved.identities.db_core.postgres]
container_name = "dstdns-98535c-db-core-postgres"   # db_core → db-core (S4.2.1); uniqueness CHECKED, not structural (S4.2.5)
hostname = "dstdns-98535c-db-core-postgres"
compose_key = "db-core-postgres"
compose_project = "dstdns-98535c-db-core"
network = "dstdns-98535c-network"
[resolved.identities.db_core.postgres.endpoints.sql]   # S4.4, S7.4.6
port = 5432
protocol = "tcp"
publish = "instance"
host_port = 5432
publications = [                                 # SOCKET CLAIMS (S7.4.6): DERIVED publication (S7.4.1) — declared instance-only, but controller/
  { scope = "network", network = "mesh", bind = "100.64.0.11", port = 5432, protocol = "tcp" },   # webapp_server/worker_io@rs1002 BIND it over mesh, so gstammtisch gets
]                                                # ports: ["100.64.0.11:5432:5432/tcp"] — bound to its mesh address only. A bare `requires = ["main_db"]`
                                                 # would derive NO publication (R-22). [] on the single-host layout "local". Claims collide per
                                                 # S6.3.2 (same host, protocol, port, and equal or wildcard bind) — which is how T-13 found
                                                 # authentik.http and db_core.minio.s3 both claiming mesh:9000 on gstammtisch (authentik is 9010 now).

[resolved.identities.controller.controller]
container_name = "dstdns-98535c-controller"       # service == realization → the service part is omitted (S4.2.2)
hostname = "dstdns-98535c-controller"
compose_key = "controller"
compose_project = "dstdns-98535c-controller"
network = "dstdns-98535c-network"
[resolved.identities.controller.controller.endpoints.http]
port = 8080
protocol = "http"
publish = "proxy"
host_port = 8083
path = "/api/controller"
publications = [ { scope = "network", network = "mesh", bind = "100.64.0.12", port = 8083, protocol = "tcp" } ]   # reverse_proxy@tsstammtisch and worker_db@gstammtisch bind it over mesh (S7.4.3; allow_from admits both — declared data, consumed by the proxy's nginx template, S7.4.4)

[resolved.identities.worker_io.worker]
container_name = "dstdns-98535c-worker-io-worker"    # worker_io → worker-io (S4.2.1)
hostname = "dstdns-98535c-worker-io-worker"
compose_key = "worker-io-worker"                 # injected as an alias on every replica, so it resolves to all of them (S4.2.1, S11.4)
compose_project = "dstdns-98535c-worker-io"
network = "dstdns-98535c-network"
replicas = [
  { index = 1, container_name = "dstdns-98535c-worker-io-worker-1", compose_key = "worker-io-worker-1" },
  { index = 2, container_name = "dstdns-98535c-worker-io-worker-2", compose_key = "worker-io-worker-2" },
]

# Binding resolutions are per CONSUMER → LOCAL NAME (S7.8.1): `<realization>.<svc>`
# for a stack service, `env.<e>` for a gate environment, `ciu` for CIU's own
# Vault client. A consumer never sees a provider name in its templates: with
# env delivery it sees POSTGRES_HOST=100.64.0.11 on prod3 and
# POSTGRES_HOST=dstdns-98535c-db-core-postgres on local, injected by ciu.
[resolved.bindings.controller.controller.database]     # binds.database = { to = "main_db.sql", delivery = "env", env_prefix = "POSTGRES", facts = [...] }
service = "main_db"
realization = "db_core"
endpoint = "sql"
network = "mesh"                                       # controller@rs1002 → db_core@gstammtisch
host = "100.64.0.11"
port = 5432                                            # tcp: no url
delivery = "env"
variables = ["POSTGRES_HOST", "POSTGRES_PORT"]
requires = ["tailscale_node"]                          # derived readiness edge
[resolved.bindings.controller.controller.redis]
service = "redis"
realization = "redis_core"
endpoint = "redis"
network = "mesh"
host = "100.64.0.11"
port = 6379
delivery = "env"
variables = ["REDIS_HOST", "REDIS_PORT"]
requires = ["tailscale_node"]
[resolved.bindings.controller.controller.tracing]      # wait = "none", delivery = "template": skywalking is on rs1002 too → same host → instance network (S7.8 step 4)
service = "tracing"
realization = "skywalking"
endpoint = "grpc"
network = "instance"
host = "dstdns-98535c-skywalking-oap"
port = 11800
delivery = "template"                                  # read as {{ ciu_stack.controller.binds.tracing.host }} in the compose template
requires = []
[resolved.bindings.controller.controller.app_schema]   # requires = ["app_schema"] expanded (S6.4.4): an edge, no data, no publication
service = "app_schema"
realization = "db_init"
delivery = "none"
requires = []
[resolved.bindings.reverse_proxy.nginx.controller]     # nginx@tsstammtisch → controller@rs1002 over mesh: port = the endpoint's host_port;
service = "controller"                                 # `path` drives the location block; `url` carries NO path (S7.8 step 7)
realization = "controller"
endpoint = "http"
network = "mesh"
host = "100.64.0.12"
port = 8083
path = "/api/controller"
url = "http://100.64.0.12:8083"
delivery = "template"
requires = ["tailscale_node"]
[resolved.bindings.ciu.vault]                          # CIU's own implicit binding to the vault service (S7.8.7, S10.3.1)
service = "vault"
realization = "vault"
endpoint = "api"
network = "mesh"
host = "100.64.0.11"
port = 8200
url = "http://100.64.0.11:8200"
delivery = "none"
requires = ["tailscale_node"]

# A PROXY-NETWORK resolution (S7.8 step 5) is derived for a consumer whose host lists
# a proxy-kind network in `reach` (reach = ["edge"], or ["mesh", "edge"] when mesh
# does not admit the endpoint) and binds a publish = "proxy" endpoint. ddcli
# (admin bundle) is in no prod3 bundle, so no such resolution is in this file; for
# a consumer C on such a host it would read:
# [resolved.bindings.<C>.<local>]
# network = "edge"
# host = "gstammtisch.dchive.de"          # network.edge.fqdn
# port = 443                              # host_port of the proxy's publish = "host" https endpoint
# path = "/api/controller"
# url = "https://gstammtisch.dchive.de/api/controller"   # the proxy-network form of step 5: the proxy routes BY this path
# requires = ["reverse_proxy"]            # the proxy must be up first (network readiness, S7.3.2)

[resolved.capabilities.main_db]                  # S3.7.6: the capability index for machine readers that start from a LogicalService (`ciu query capability main_db`)
level = "live"
realization = "db_core"
service = "postgres"
container_name = "dstdns-98535c-db-core-postgres"
endpoints = { sql = { host = "dstdns-98535c-db-core-postgres", port = 5432 } }   # as seen from the instance network; per-consumer views are the bindings above

[resolved.bundle.rs1002]                         # with --layout: what `ciu push` ships to this host and why (S17.3.2, S15.4) — the secrets CAPSULE per source
store_entries = [
  { entry = "secrets.controller.controller.postgres_password", travels = false, why = "from = vault; rs1002 resolves ciu.vault over mesh — the target fetches" },
  { entry = "secrets.registry_lightweight.registry.registry_http_secret", travels = false, why = "realization not placed on rs1002" },
  { entry = "secrets.hosts.rs1002.*", travels = true, why = "host-scoped entries of this host" },
]

# ------------- the same facts rendered for layout "local" (one host) ---------
# [resolved] layout = "local" host = "localhost" environment = "dev"
# [ciu.instance.realness.local] main_db = "live" app_schema = "live" probe_targets = "simulated"   (merged input, generated file)
# [resolved.placement.db_core] hosts = ["localhost"]
# [resolved.identities.db_core.postgres.endpoints.sql] … publications = []   (single host: nothing published)
# [resolved.bindings.controller.controller.database]
# network = "instance"  host = "dstdns-98535c-db-core-postgres"  port = 5432  delivery = "env"  variables = ["POSTGRES_HOST", "POSTGRES_PORT"]  requires = []
# [resolved.services.probe_targets]  level = "simulated"  realization = "mock_targets"  service = "dns"
# [resolved.identities.mock_targets.dns]  container_name = "dstdns-98535c-mock-targets-dns"  compose_key = "mock-targets-dns"
# [resolved.bindings.test_runner.runner.browser]   (test_runner binds browser_service.mcp with wait = "none", delivery = "template")
# network = "instance"  host = "dstdns-98535c-pwmcp-unified"  port = 8931  url = "http://dstdns-98535c-pwmcp-unified:8931"  requires = []
# a udp endpoint gets a url too — for a consumer C binding probe_targets.dns:
# [resolved.bindings.<C>.<local>]  network = "instance"  host = "dstdns-98535c-mock-targets-dns"  port = 5353  url = "udp://dstdns-98535c-mock-targets-dns:5353"
# [resolved.bindings.env.clean.db]   (the ephemeral gate environment's binding; the lane process gets POSTGRES_HOST/POSTGRES_PORT)
# network = "instance"  host = "dstdns-98535c-db-core-postgres"  port = 5432  delivery = "env"  variables = ["POSTGRES_HOST", "POSTGRES_PORT"]

# There is no closing marker table: the file is written atomically and is either complete or absent (S3.7.5, S14.4.2).
#
# After a successful `ciu up` this host also writes ciu.receipt.json (api = "ciu/receipt", S17.4.3):
# { instance_id = "98535c", host = "rs1002", layout = "prod3", release_digest = "sha256:…", resolved_digest = "sha256:…",
#   services = { "controller.controller" = "healthy", … }, completed = [], facts = ["vault:secret/internal/internal_dlq_token@controller.controller", …],
#   publications = [...], assumed = [], created = 2026-09-03T11:09:40Z }
# `ciu activate apply` carries it to the next host of the layout, which accepts these facts only when instance, layout and
# resolved digest match its own render of rs1002 (S17.4.4).
