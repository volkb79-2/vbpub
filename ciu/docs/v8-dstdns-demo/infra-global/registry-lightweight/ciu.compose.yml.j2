# infra-global/registry-lightweight/ciu.compose.yml.j2 — v8 notation (draft.3)
# Injected by ciu: container_name/hostname (dstdns-<instance>-registry-lightweight-<svc>),
# networks (the init job too — no implicit `<project>_default` bridge), ciu.*
# labels, CIU_* env, depends_on conditions, ports: (tls_proxy's publish = "host"
# endpoint), tls_proxy's config-DIRECTORY mount (/etc/nginx/ciu, S6.9.1),
# healthcheck timing, cgroup fields. `expose:` stanzas are gone: the endpoints
# declare what listens. A disabled tls_proxy is removed from the rendered file by
# ciu after the render (S6.7.1) — no if-guard around its block.
services:
  init:
    image: {{ ciu_stack.init.image }}
    user: "0:0"                              # needs root to chown
    # data dir owned root:docker with group write — the docker gid is a host fact (host.docker_gid)
    command: >
      sh -c "
      mkdir -p /data/docker &&
      chown -R 0:{{ host.docker_gid }} /data &&
      chmod -R 775 /data &&
      echo 'Registry data directory initialized (root:docker, group-writable)'
      "
    volumes:
      - {{ ciu_stack.registry.hostdir.data }}:/data
    labels:
      - "de.vxxu.volkb79.service-container=false"

  registry:
    image: {{ ciu_stack.registry.image }}
    restart: unless-stopped
    user: "0:{{ host.docker_gid }}"          # root:docker — permission management on the data dir
    environment:
      {% for key, value in env_defaults.items() %}
      - {{ key }}={{ value }}
      {% endfor %}
      - REGISTRY_HTTP_SECRET=${REGISTRY_LIGHTWEIGHT_SECRETS_REGISTRY_HTTP_SECRET}   # env-delivered secret (compose process environment, S11.6)
      - REGISTRY_STORAGE_DELETE_ENABLED=true
      # CORS headers for the UI
      - "REGISTRY_HTTP_HEADERS_Access-Control-Origin=[\"*\"]"
      - "REGISTRY_HTTP_HEADERS_Access-Control-Allow-Methods=[\"HEAD\",\"GET\",\"OPTIONS\",\"DELETE\"]"
      - "REGISTRY_HTTP_HEADERS_Access-Control-Allow-Credentials=[\"true\"]"
      - "REGISTRY_HTTP_HEADERS_Access-Control-Allow-Headers=[\"Authorization\",\"Accept\",\"Cache-Control\"]"
      {% if ciu_stack.registry.settings.auth_enabled %}
      # basic authentication — local htpasswd, not shared credentials
      - REGISTRY_AUTH=htpasswd
      - REGISTRY_AUTH_HTPASSWD_REALM=Registry Realm
      - REGISTRY_AUTH_HTPASSWD_PATH=/auth/htpasswd
      {% endif %}
      {% if ciu_stack.registry.settings.proxy_enabled %}
      # pull-through cache
      - REGISTRY_PROXY_REMOTEURL={{ ciu_stack.registry.settings.proxy_remoteurl }}
      {% if ciu_stack.registry.settings.proxy_use_credentials %}
      - REGISTRY_PROXY_USERNAME=${REGISTRY_LIGHTWEIGHT_SECRETS_DOCKERHUB_USERNAME}
      - REGISTRY_PROXY_PASSWORD=${REGISTRY_LIGHTWEIGHT_SECRETS_DOCKERHUB_PASSWORD}
      {% endif %}
      {% endif %}
    volumes:
      - {{ ciu_stack.registry.hostdir.data }}:/var/lib/registry
      {% if ciu_stack.registry.settings.config_file %}
      - "{{ ciu_stack.registry.settings.config_file }}:/etc/docker/registry/config.yml:ro"
      {% endif %}
      {% if ciu_stack.registry.settings.auth_enabled %}
      # htpasswd, written by the pre_compose hook into the auth hostdir from the stack-level auth_password secret
      - {{ ciu_stack.registry.hostdir.auth }}:/auth:ro
      {% endif %}
    healthcheck:
      # process check — works with auth enabled
      test: ["CMD", "pgrep", "-f", "registry serve"]
      # interval / timeout / retries / start_period: injected from ciu_stack.registry.health (S6.6.4)
    labels:
      - "de.vxxu.volkb79.service-container=false"

  ui:
    image: {{ ciu_stack.ui.image }}
    restart: unless-stopped
    user: "0:0"                              # the UI image rewrites its own files at startup
    environment:
      {% for key, value in env_defaults.items() %}
      - {{ key }}={{ value }}
      {% endfor %}
      - REGISTRY_TITLE={{ ciu_stack.ui.settings.title }}
      - REGISTRY_URL=http://{{ ciu_stack.registry.identity.hostname }}:{{ ciu_stack.registry.endpoints.registry.port }}   # own sibling: derived identity, not a binding
      - DELETE_IMAGES={{ ciu_stack.ui.settings.delete_images }}
      - SHOW_CONTENT_DIGEST={{ ciu_stack.ui.settings.show_content_digest }}
      - SHOW_CATALOG_NB_TAGS={{ ciu_stack.ui.settings.show_catalog_nb_tags }}
      - SINGLE_REGISTRY=true
      - CATALOG_MIN_BRANCHES=1
      - CATALOG_MAX_BRANCHES=1
      - TAGLIST_PAGE_SIZE=100
      - REGISTRY_SECURED=false
      - CATALOG_ELEMENTS_LIMIT=1000
    # no healthcheck: dependants get `service_started` (S11.4); nobody binds the ui, so it is never a gate provider (S8.6.3)
    labels:
      - "de.vxxu.volkb79.service-container=false"

  # TLS termination for standalone external HTTPS access. In integrated mode the
  # main reverse proxy fronts the registry and this service is switched off
  # (enabled = false in the stack table; ciu drops the block after the render, S6.7.1).
  tls_proxy:
    image: {{ ciu_stack.tls_proxy.image }}
    restart: unless-stopped
    user: "0:{{ host.docker_gid }}"          # root with the docker group — certificate access via group membership
    command: ["nginx", "-c", "{{ ciu_stack.tls_proxy.configfile.nginx.target }}", "-g", "daemon off;"]   # the ciu-rendered config (S6.9); the image's /etc/nginx (mime.types) stays visible
    environment:
      {% for key, value in env_defaults.items() %}
      - {{ key }}={{ value }}
      {% endfor %}
      - PUBLIC_FQDN={{ host.fqdn }}            # declared per host in ciu.hosts.toml (S7.2), never detected
    volumes:
      # /etc/nginx/ciu (the rendered nginx.conf): the config-directory mount is injected (S6.9.1)
      {% if ciu_stack.tls_proxy.tls.self_signed %}
      # self-signed fallback, generated at container start: the entrypoint still runs /docker-entrypoint.d/* because the command starts with `nginx`
      - {{ host.physical_repo_root }}/infra-global/registry-lightweight/generate-self-signed.sh:/docker-entrypoint.d/90-generate-certs.sh:ro
      - registry-tls-certs:/etc/nginx/certs
      {% else %}
      # the whole /etc/letsencrypt so the live/ symlinks resolve
      - /etc/letsencrypt:/etc/letsencrypt:ro
      {% endif %}
    # ports: injected from [ciu_stack.tls_proxy.endpoints] (publish = "host", S7.4.2)
    healthcheck:
      # process check: nginx is running (the TLS termination layer)
      test: ["CMD", "pgrep", "-f", "nginx"]
      # interval / timeout / retries / start_period: injected from ciu_stack.tls_proxy.health (S6.6.4)
    labels:
      - "de.vxxu.volkb79.service-type=proxy"
      - "de.vxxu.volkb79.service-container=false"

{% if ciu_stack.tls_proxy.tls.self_signed %}
volumes:
  registry-tls-certs:
    name: {{ instance.project }}-{{ instance.id }}-registry-tls-certs   # instance-scoped (S11.3 requires this prefix); merely unused while tls_proxy is disabled
{% endif %}
