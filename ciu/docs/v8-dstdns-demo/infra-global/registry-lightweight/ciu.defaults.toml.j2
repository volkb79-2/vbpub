# infra-global/registry-lightweight/ciu.defaults.toml.j2 — v8 notation
# Realization `registry_lightweight` = the `registry` LogicalService. Services:
#   init       one-shot: data-dir ownership (root:docker), then exits 0
#   registry   PRIMARY: the registry itself (distribution v3)
#   ui         joxit web UI
#   tls_proxy  nginx TLS termination for standalone external access (host-published)
# Derived: identities (dstdns-<instance>-registry_lightweight-<svc>), sibling
# addresses (identity.hostname), depends_on conditions, the docker gid. Gone:
# [registry_lightweight.ports] (endpoints now), version/ui_version (folded into
# the image tags), the REGISTRY__ENABLE_TLS env override (a [deploy.control]
# flag name in `enabled` replaces it — S7.2, no expressions).

[ciu_stack.init]
image = "registry:2"
one_shot = true

[ciu_stack.registry]
image = "registry:3"
primary = true
depends_on = ["init"]
endpoints.registry = { port = 5000, protocol = "http" }    # instance-only; the TLS proxy / reverse proxy front it
[ciu_stack.registry.hostdir]
data = ""
auth = ""                            # reserved for the htpasswd; the hook writes ./htpasswd today
[ciu_stack.registry.settings]
proxy_enabled = false                # pull-through cache mode
proxy_use_credentials = false
proxy_remoteurl = ""
auth_enabled = true                  # local htpasswd, generated by pre_compose_hook.py from the auth_password secret
auth_username = ""                   # "" → the hook's default (admin)
config_file = ""                     # optional registry config.yml to mount
[ciu_stack.registry.secrets]
registry_http_secret = { directive = "GEN_LOCAL:registry_http_secret", delivery = "env", env_name = "REGISTRY_LIGHTWEIGHT_SECRETS_REGISTRY_HTTP_SECRET" }
# Docker Hub credentials for the pull-through cache — read only when proxy_enabled AND proxy_use_credentials.
dockerhub_username   = { directive = "ASK_EXTERNAL:DOCKERHUB_USERNAME", delivery = "env", env_name = "REGISTRY_LIGHTWEIGHT_SECRETS_DOCKERHUB_USERNAME" }
dockerhub_password   = { directive = "ASK_EXTERNAL:DOCKERHUB_PASSWORD", delivery = "env", env_name = "REGISTRY_LIGHTWEIGHT_SECRETS_DOCKERHUB_PASSWORD" }

[ciu_stack.ui]
image = "joxit/docker-registry-ui:latest"
depends_on = ["registry"]
endpoints.ui = { port = 80, protocol = "http", path = "/registry-ui" }   # `path`: what the reverse proxy fronts when enable_registry is on
[ciu_stack.ui.settings]
title = ""
delete_images = "true"
show_content_digest = "true"
show_catalog_nb_tags = "true"

[ciu_stack.tls_proxy]
image = "nginx:alpine"
enabled = true                       # standalone mode; behind the main reverse proxy (integrated mode) switch it off
depends_on = ["registry", "ui"]
endpoints.tls = { port = 443, protocol = "https", publish = "host", host_port = 5443 }
[ciu_stack.tls_proxy.tls]
self_signed = true                   # false = mount /etc/letsencrypt (its live/ symlinks resolve inside the container)
# Certificate material for the public FQDN is host-scoped (ciu.hosts.toml
# [deploy.hosts.<h>.secrets]) — same note as infra-global/reverse-proxy.

# Consumed by the pre_compose hook (ctx.secret_file) to write ./htpasswd, which
# `registry` then mounts — a stack-level secret, not one service's.
[ciu_stack.secrets]
auth_password = { directive = "GEN_LOCAL:registry_auth_password", delivery = "file", consumed_by = "hook" }

[hooks]
# local_secrets_hook: a v2 no-op kept for the S9.2 missing-file check;
# pre_compose_hook: validates registry_http_secret, writes htpasswd, renders nginx-tls.conf;
# post_compose_registry: waits for the registry, checks the catalog, optional push/pull test.
pre_compose = ["../../scripts/ciu/hooks/local_secrets_hook.py", "./pre_compose_hook.py"]
post_compose = ["./post_compose_registry.py"]
