# infra-global/reverse-proxy/ciu.defaults.toml.j2 — v8 notation
# Realization `reverse_proxy`, service `nginx` → dstdns-<instance>-reverse_proxy-nginx.
# It REALIZES [network.edge] (kind = "proxy", fqdn): OTHER consumers reach the
# fronted endpoints as https://<fqdn><path> through it. Its own upstreams are
# ordinary routes (routes.<logical>.http.url) and the paths it fronts are the
# providers' endpoint `path`s — the old [reverse_proxy.routes]/[.backends]
# copies of [topology.*]/[app_identity.*] are gone. Derived too: the identity,
# the network attachment, the consul edge behind the cmru tokens (init_requires).
# Shape change vs v7 (infra-P24/D-006 "HTTP-only behind the on-host tls-edge"):
# here the proxy owns the host-published https endpoint and terminates TLS
# itself, so the traefik labels and the ingress_public network are retired.

# CMRU bootstrap-fallback toggle — single source for the feature flag AND the
# gated init_requires/secrets below. While false (the shipped default) neither
# renders, so this early stack creates no Vault/Consul edge (D-170 M1).
{% set enable_cmru_bootstrap_fallback = false %}

[ciu_stack.nginx]
image = "nginx:alpine"
{% if enable_cmru_bootstrap_fallback %}
init_requires = ["consul"]           # the two cmru tokens are consul's contract facts
{% endif %}
# The fronted backends are routes read at RUN time (the [backends] table below):
# `uses` derives them without an ordering edge (S7.8.3) — the proxy is in the
# last wave anyway, and nginx tolerates an upstream that is not up yet.
uses = ["controller", "webapp_server", "webapp_ui", "identity_provider"]
endpoints.http  = { port = 8080, protocol = "http" }                                     # app router; instance network
endpoints.https = { port = 443,  protocol = "https", publish = "host", host_port = 443 } # public ingress: the edge network's front door
# TLS material for `https`: HOST-scoped secrets consumed through ASK_HOST — see
# [ciu_stack.nginx.secrets] below.

[ciu_stack.nginx.hostdir]
auth = ""

[ciu_stack.nginx.auth]
enabled = false
auth_file = "/etc/nginx/auth/.htpasswd"

# Fronted app endpoints: upstream AND path are ROUTES — the path is declared on
# the provider's endpoint (`path = "/api/controller"` etc.), the upstream is the
# derived route, identical in every layout. nginx.conf.j2 (rendered by the
# pre_compose hook) reads these instead of topology.*.
[ciu_stack.nginx.backends]
controller        = { path = "{{ routes.controller.http.path }}",        url = "{{ routes.controller.http.url }}" }
webapp_server     = { path = "{{ routes.webapp_server.http.path }}",     url = "{{ routes.webapp_server.http.url }}" }
webapp_ui         = { path = "{{ routes.webapp_ui.http.path }}",         url = "{{ routes.webapp_ui.http.url }}" }
identity_provider = { path = "{{ routes.identity_provider.http.path }}", url = "{{ routes.identity_provider.http.url }}" }
# Optional management UIs (flags below, all off) join this table the same way
# when switched on: tracing = routes.tracing.ui, registry = routes.registry.ui,
# browser_service = routes.browser_service.mcp, vault = routes.vault.api
# (db_admin declares no endpoint in the demo yet). Their former proxy-side
# paths (/skywalking-ui, /registry-ui, /pgadmin, /vault-ui, /vault-api,
# /pwmcp-mcp) move onto those endpoints' `path`. Not declared while off: a
# route to a service outside the deploy set cannot resolve.

[ciu_stack.nginx.features]
enable_skywalking = false
enable_registry = false
enable_pgadmin = false
enable_vault = false
enable_pwmcp_mcp = false
enable_authentik = true
# CMRU deployment-control bootstrap fallback (SPEC H §4/§5): bearer-gated
# GET-only paths for freshly-enrolled hosts to fetch desired state before they
# join the tailnet. true only on the host serving as the enrollment endpoint.
enable_cmru_bootstrap_fallback = {{ enable_cmru_bootstrap_fallback | lower }}

[ciu_stack.nginx.cmru_bootstrap]     # non-secret tuning (nginx zone cmru_bootstrap; denials go to error_log)
rate_limit_rps = 10
rate_limit_burst = 20

# TLS material for `https` is HOST-scoped (S10.4): ciu.hosts.toml declares
# [deploy.hosts.<h>.secrets] tls_cert_pem / tls_key_pem (ASK_EXTERNAL on the
# edge host, ASK_FILE on localhost), materialized on the ciu host before the push
# into [secrets.hosts.<h>.*] and pushed only to that host. This stack CONSUMES
# them through ASK_HOST:<entry> (S10.1) with file delivery: ciu mounts them at
# /run/secrets/tls_cert and /run/secrets/tls_key (S10.2.1, S11.4) and nginx.conf.j2
# points ssl_certificate / ssl_certificate_key there. ciu check refuses a layout
# that places this stack on a host without both entries (S10.1.3).
[ciu_stack.nginx.secrets]
tls_cert = { directive = "ASK_HOST:tls_cert_pem", delivery = "file" }
tls_key  = { directive = "ASK_HOST:tls_key_pem",  delivery = "file" }
{% if enable_cmru_bootstrap_fallback %}
# bearer_token: short-lived bearer the enrolling host presents (rotate via
# post_compose_consul.py, 24 h max). consul_viewer_token: pre-minted viewer ACL
# SecretID forwarded to Consul so ACL enforcement still applies behind the proxy.
# file delivery: the hook reads them (ctx.secret_file) into the rendered nginx.conf.
bearer_token        = { directive = "ASK_VAULT:{{ vault.paths.consul_cmru_bootstrap_bearer_token }}", delivery = "file" }
consul_viewer_token = { directive = "ASK_VAULT:{{ vault.paths.consul_cmru_viewer_token }}",           delivery = "file" }
{% endif %}

[hooks]
pre_compose = ["./render_nginx_conf.py"]   # nginx.conf.j2 → nginx.conf (+ etc-nginx/); reads ciu_stack.nginx.* and network.edge.fqdn from ctx
post_compose = []
