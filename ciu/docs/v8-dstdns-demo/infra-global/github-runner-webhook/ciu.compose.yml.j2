# infra-global/github-runner-webhook/ciu.compose.yml.j2 — v8 notation (draft.3)
# Injected by ciu: container_name/hostname (dstdns-<instance>-github-runner-webhook-webhook),
# networks, ciu.* labels, CIU_* env, ports: (the publish = "host" endpoint),
# healthcheck timing, cgroup fields.
services:
  webhook:
    image: {{ ciu_stack.webhook.image }}
    restart: unless-stopped
    user: "{{ host.user_uid }}:{{ host.user_gid }}"
    environment:
      {% for key, value in env_defaults.items() %}
      - {{ key }}={{ value }}
      {% endfor %}
      - WEBHOOK_SECRET=${GITHUB_RUNNER_WEBHOOK_SECRETS_WEBHOOK_SECRET}     # env-delivered secrets (compose process environment, S11.6)
      - WEBHOOK_GIT_PAT=${GITHUB_RUNNER_WEBHOOK_SECRETS_WEBHOOK_GIT_PAT}
      - GIT_USERNAME={{ ciu_stack.webhook.git.git_username }}
      - GIT_REPO_NAME={{ ciu_stack.webhook.git.git_repo_name }}
    # ports: injected from [ciu_stack.webhook.endpoints] (publish = "host", S7.4.2)
    volumes:
      # hook definitions live in the stack dir; bind sources are HOST paths (the daemon reads them, not the devcontainer)
      - {{ host.physical_repo_root }}/infra-global/github-runner-webhook/webhook-hooks.yml:/etc/webhook/hooks.json:ro
      - {{ ciu_stack.webhook.hostdir.data }}:/data
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://127.0.0.1:{{ ciu_stack.webhook.endpoints.http.port }}/hooks/health"]
      # interval / timeout / retries / start_period: injected from ciu_stack.webhook.health (S6.6.4)
    labels:
      - "de.vxxu.volkb79.service-container=false"
