# infra-global/github-runner/ciu.defaults.toml.j2 — v8 notation
# Realization `github_runner` = the `github_runner` LogicalService. Services:
#   init    one-shot: work-dir ownership (runner uid : docker gid), exits 0
#   runner  PRIMARY: the self-hosted Actions runner (docker-socket access)
# Derived: identities (dstdns-<instance>-github_runner-<svc>; the runner's
# container name doubles as its RUNNER_NAME, unique per instance), the init
# depends_on condition, the docker gid (an instance fact, no getent dance).

[ciu_stack.init]
image = "alpine:latest"              # what the v7 compose actually ran (the defaults' github-runner:latest was unused)
one_shot = true

[ciu_stack.runner]
image = "myoung34/github-runner:latest"
primary = true
depends_on = ["init"]
[ciu_stack.runner.hostdir]
work = ""
[ciu_stack.runner.settings]
repository_url = ""                  # set per deployment in ciu.toml.j2
runner_uid = "1001"
runner_gid = "1001"
[ciu_stack.runner.secrets]
runner_token = { directive = "ASK_EXTERNAL:GITHUB_RUNNER_TOKEN", delivery = "env", env_name = "GITHUB_RUNNER_SECRETS_RUNNER_TOKEN" }

# Read by pre_compose_hook.py (ctx.secret_file) to fetch a registration token
# from the GitHub API when no .runner file exists yet — not a service's secret.
[ciu_stack.secrets]
github_api_token = { directive = "ASK_EXTERNAL:GITHUB_API_TOKEN", delivery = "file", consumed_by = "hook" }

[hooks]
pre_compose = ["./pre_compose_hook.py"]   # exposes the registration token via apply_to_config (ciu_stack.runner.settings.runner_registration_token)
post_compose = []
