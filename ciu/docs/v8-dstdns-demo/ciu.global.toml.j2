# ciu.global.toml.j2 — sparse, committed, secret-free override (dstdns v8 DEMO)
# Only keys that differ from ciu.global.defaults.toml.j2. Tables merge, lists
# and scalars replace.

[deploy]
landscape_id = "dstdns-dev"          # REQUIRED, no default anywhere (two landscapes must never share one id)

[auth]
enabled = false                      # greenfield dev deploy: synthetic ADMIN, no real OIDC login

[governance]                         # this host is mixed-use: dstdns is best-effort below the devcontainer and soulmask
enabled = true
cgroup_parent = "dev-background.slice"
memory_max = "2G"
device = "/dev/vda"                  # autodetect fails from inside docker-outside-of-docker
