# ciu.global.defaults.toml.j2 — dstdns in CIU v8 notation (DEMO)
# =============================================================================
# Committed, full defaults. Layering (all TOML deep-merge, no Jinja inheritance):
#   ciu.global.defaults.toml.j2  → ciu.global.toml.j2 (sparse override)
#   → ciu.global.instance.toml.j2 (per-instance OVERLAY: hand-edited, gitignored, ALWAYS present)
#   → ciu.instance.generated.toml (CIU-owned facts: identity, host, build, realness; plain TOML)
#   → rendered ciu.global.toml (gitignored; carries the derived
#     [ciu.instance.resolved.*] tables and doubles as the instance lock)
#
# Reading order for a newcomer: [deploy] → [service.*] (WHAT) → [realization]
# (HOW) → [network.*] / [deploy.profiles] / [deploy.layouts] (WHERE) → [testing].
# Nothing in this file names a container, a hostname, a phase, or a route:
# those are DERIVED (see examples/ciu.global.toml.rendered.example).
# =============================================================================

{% set pubsub = {
    'status': 'dstdns:pubsub:status',
    'events': 'dstdns:pubsub:events',
    'config': 'dstdns:pubsub:config',
    'worker_heartbeats': 'dstdns:pubsub:workers:heartbeat',
    'host_stats': 'dstdns:pubsub:host:stats',
    'container_stats': 'dstdns:pubsub:container:stats',
    'job_progress': 'dstdns:pubsub:jobs:progress',
    'job_completed': 'dstdns:pubsub:jobs:completed',
    'ui_state': 'dstdns:pubsub:ui:state'
} %}
{% set queue_keys = {
    'results': 'dstdns:results:queue:pending',
    'notifications': 'dstdns:notifications:queue:pending',
    'worker_io_jobs': 'dstdns:jobs:queue:worker-io',
    'worker_db_jobs': 'dstdns:jobs:queue:worker-db'
} %}

# -----------------------------------------------------------------------------
# [deploy] — deployment-wide facts. No environment_tag (the instance id is the
# identity), no network_name (derived), no environment (a layout property).
# -----------------------------------------------------------------------------
[deploy]
project_name = "dstdns"
revision = 8
log_level = "INFO"
# landscape_id is REQUIRED and deliberately absent here: it is declared per
# deployment in ciu.global.toml.j2 (two landscapes sharing one id would read
# each other's Consul overrides). ciu check refuses a missing value.

[deploy.registry]
url = ""                 # image registry for project-built images; "" = local daemon
namespace = "dstdns"     # project-built images are <namespace>/<name>:<tag>

[deploy.labels]
prefix = "de.vxxu.volkb79"

[deploy.health]          # defaults merged into every [ciu_stack.<svc>.health] table
interval = "10s"
timeout = "5s"           # one HEALTHCHECK attempt — NOT the gate budget
retries = 6
start_period = "240s"    # slow first boots on this host's storage (authentik migrations)
# gate_timeout (the inter-wave convergence budget) is derived per service:
# start_period + interval * retries + 30s, unless a service declares its own.

[deploy.env.defaults]    # template-context defaults for service environment blocks
TZ = "UTC"
PYTHONUNBUFFERED = "1"
LANG = "en_US.UTF-8"

[deploy.env.shared]      # CONSUMER env only; identity facts come from the `instance` render context
DSTDNS_TELEMETRY = "on"

[deploy.control]
enable_observability = true
enable_admin_ui = true

[deploy.provenance]
vendor_images = ["hashicorp/vault", "hashicorp/consul", "timescale/timescaledb-ha", "redis", "minio/minio"]

# -----------------------------------------------------------------------------
# [service.<n>] — WHAT dstdns needs (LogicalServices). `contract` lists the
# typed facts a consumer may rely on; contract conformance (ciu check stage 5)
# proves the selected realization covers every fact. A service whose contract
# is [] is depended on for its health (or completion, for one-shot jobs).
# `<level>.realized_by` binds each realness level to a realization name.
# -----------------------------------------------------------------------------
[service.vault]
description = "secrets backend; AppRole credentials are minted by its post_compose hook"
contract = [
  "vault:secret/vault/controller/role_id", "vault:secret/vault/controller/secret_id",
  "vault:secret/vault/webapp-server/role_id", "vault:secret/vault/webapp-server/secret_id",
]
live.realized_by = "vault"

[service.consul]
description = "service discovery + ACL-scoped KV config plane"
contract = [
  "vault:secret/consul/controller/token", "vault:secret/consul/worker-io/token",
  "vault:secret/consul/worker-db/token", "vault:secret/consul/webapp-server/token",
  "vault:secret/consul/docker-stats-exporter/token",
  "vault:secret/consul/cmru/bootstrap-bearer-token", "vault:secret/consul/cmru/viewer/token",
]
live.realized_by = "consul_server"

[service.redis]
contract = ["vault:secret/redis/password"]
live.realized_by = "redis_core"

[service.main_db]
description = "TimescaleDB: application DB + roles (DBA layer)"
contract = [
  "pg:db/dstdns", "pg:db/authentik",
  "pg:role/controller", "pg:role/controller_ddl", "pg:role/workerdb", "pg:role/workerdb_ddl",
  "pg:role/webapp", "pg:role/authentik",
  "vault:secret/db/postgres/controller_password", "vault:secret/db/postgres/controller_ddl_password",
  "vault:secret/db/postgres/workerdb_password", "vault:secret/db/postgres/workerdb_ddl_password",
  "vault:secret/db/postgres/webapp_password", "vault:secret/db/postgres/authentik_password",
]
live.realized_by = "db_core"
owned-seeded.realized_by = "db_core_seeded"     # prepared image with schema + fixtures baked in (tests)

[service.object_store]
contract = [
  "minio:user/worker-io", "minio:user/webapp-server", "minio:user/worker-db",
  "vault:secret/minio/worker_io/access_key", "vault:secret/minio/worker_io/secret_key",
  "vault:secret/minio/webapp_server/access_key", "vault:secret/minio/webapp_server/secret_key",
  "vault:secret/minio/worker_db/access_key", "vault:secret/minio/worker_db/secret_key",
]
live = { realized_by = "db_core", service = "minio" }     # one realization may back several services; `service` names which of its services carries THIS capability (health, endpoints, exec target)

[service.db_admin]
description = "pgAdmin + Adminer (operator UIs)"
contract = []
live = { realized_by = "db_core", service = "pgadmin" }

[service.app_schema]
description = "one-shot application schema init (controller_ddl); depending on it = its completion"
contract = []
live.realized_by = "db_init"
owned-seeded.realized_by = "db_core_seeded"     # the seeded image already carries the schema

[service.identity_provider]
description = "Authentik OIDC/RBAC; mints ddcli's service password in its hook"
contract = ["vault:secret/ddcli/service_password", "vault:secret/authentik/bootstrap_token"]
live.realized_by = "authentik"

[service.mesh_node]
description = "Tailscale node — the mesh network's transport daemon"
contract = []
live.realized_by = "tailscale_node"

[service.browser_service]
description = "pwmcp Playwright-as-a-Service (browser gate for UI tests)"
contract = []
live.realized_by = "pwmcp"

[service.probe_targets]
description = "DNS/HTTP targets the workers probe"
contract = []
live.realized_by = "internet"                   # external: the real internet
simulated.realized_by = "mock_targets"          # the mock DNS/HTTP stack

[service.controller]
contract = ["vault:secret/internal/internal_dlq_token"]   # minted by controller, read by worker-io
live.realized_by = "controller"

[service.webapp_server]
contract = []
live.realized_by = "webapp_server"

[service.webapp_ui]
contract = []
live.realized_by = "webapp_ui_react"

[service.worker_io]
contract = []
live.realized_by = "worker_io"

[service.worker_db]
contract = []
live.realized_by = "worker_db"

[service.ddcli]
contract = []
live.realized_by = "ddcli"

[service.reverse_proxy]
contract = []
live.realized_by = "reverse_proxy"

[service.tracing]
description = "SkyWalking OAP/UI/BanyanDB (+ its own Postgres)"
contract = ["vault:secret/skywalking/postgres_password"]
live.realized_by = "skywalking"

[service.otel_aggregator]
contract = []
live.realized_by = "otel_aggregator"

[service.otel_collector]
contract = []
live.realized_by = "otel_collector_node"

[service.docker_stats_exporter]
contract = []
live.realized_by = "docker_stats_exporter"

[service.cadvisor]
contract = []
live.realized_by = "cadvisor"

[service.registry]
contract = []
live.realized_by = "registry_lightweight"

[service.github_runner]
contract = []
live.realized_by = "github_runner"

[service.github_runner_webhook]
contract = []
live.realized_by = "github_runner_webhook"

[service.webhook_listener]
contract = []
live.realized_by = "webhook_listener"

[service.tester]
description = "persistent test-runner container the gate execs into"
contract = []
live.realized_by = "test_runner"

# -----------------------------------------------------------------------------
# [realization] — HOW. One namespace across kinds; the name is identity
# component 3 ({project}-{instance}-{realization}-{service}, service omitted
# when it equals the realization name). A ciu_stack's file never states this
# name; `location` binds it exactly once.
# -----------------------------------------------------------------------------
[realization]
vault                 = { kind = "ciu_stack", location = "infra/vault" }
consul_server         = { kind = "ciu_stack", location = "infra/consul-server" }
redis_core            = { kind = "ciu_stack", location = "infra/redis-core" }
db_core               = { kind = "ciu_stack", location = "infra/db-core" }
db_core_seeded        = { kind = "ciu_stack", location = "infra/db-core-seeded" }
db_init               = { kind = "ciu_stack", location = "infra/db-init" }
authentik             = { kind = "ciu_stack", location = "infra/authentik" }
tailscale_node        = { kind = "ciu_stack", location = "infra/tailscale-node", per_host = true }   # transport daemon: deployed on EVERY host of a layout that reaches it; never a route target (S7.6.5)
pwmcp                 = { kind = "ciu_stack", location = "infra/pwmcp" }
mock_targets          = { kind = "ciu_stack", location = "infra/mock-targets" }
cadvisor              = { kind = "ciu_stack", location = "infra/cadvisor" }
otel_aggregator       = { kind = "ciu_stack", location = "infra/otel-aggregator" }
otel_collector_node   = { kind = "ciu_stack", location = "infra/otel-collector-node" }
docker_stats_exporter = { kind = "ciu_stack", location = "infra/docker-stats-exporter" }
controller            = { kind = "ciu_stack", location = "applications/controller" }
webapp_server         = { kind = "ciu_stack", location = "applications/webapp-server" }
webapp_ui_react       = { kind = "ciu_stack", location = "applications/webapp-ui-react" }
worker_io             = { kind = "ciu_stack", location = "applications/worker-io" }
worker_db             = { kind = "ciu_stack", location = "applications/worker-db" }
ddcli                 = { kind = "ciu_stack", location = "applications/ddcli" }
reverse_proxy         = { kind = "ciu_stack", location = "infra-global/reverse-proxy" }
skywalking            = { kind = "ciu_stack", location = "infra-global/skywalking" }
registry_lightweight  = { kind = "ciu_stack", location = "infra-global/registry-lightweight" }
github_runner         = { kind = "ciu_stack", location = "infra-global/github-runner" }
github_runner_webhook = { kind = "ciu_stack", location = "infra-global/github-runner-webhook" }
webhook_listener      = { kind = "ciu_stack", location = "infra-global/webhook-listener" }
test_runner           = { kind = "ciu_stack", location = "tools/test-runner" }

[realization.internet]      # external: nothing to bring up; endpoints are what consumers route to
kind = "external"
provides = []
[realization.internet.endpoints]
dns  = { url = "udp://1.1.1.1:53" }
http = { url = "https://example.org" }

# -----------------------------------------------------------------------------
# Realness. Selection precedence: `ciu up --realness` > the instance's durable
# [ciu.instance.realness] record > [deploy.realness.pin] > `default`.
# -----------------------------------------------------------------------------
[deploy.realness]
default = "live"                                # one default level for every service
pin = {}                                        # nothing pinned in the committed config; instances select (overlay)

# -----------------------------------------------------------------------------
# [network.<n>] — reachability domains. `instance` (the per-instance compose
# network, name derived) is implicit. Transport readiness and TLS are network
# properties inherited by every route over the network.
# -----------------------------------------------------------------------------
[network.mesh]
kind = "address"                     # an address plane: every host on it carries an address in ciu.hosts.toml
description = "tailscale mesh"       # free text; ciu attaches no semantics to the wording (S7.3)
realized_by = "tailscale_node"      # derived edge: cross-host routes over mesh wait for the tailscale node on both ends

[network.public]
kind = "address"
description = "public internet"
# No `tls` here: the reverse proxy terminates public TLS with its HOST-scoped
# certificate (ASK_HOST secrets, S10.4). A network-level tls/mtls means
# ciu-MANAGED TLS between services (derived tls_* secrets + a pki provider, S10.5).

[network.edge]
kind = "proxy"                       # address-free: hosts carry no address on it; reaching through it resolves to `fqdn` (S7.3.3)
realized_by = "reverse_proxy"
fqdn = "gstammtisch.dchive.de"       # routes over `edge` resolve to https://<fqdn><endpoint.path>

# -----------------------------------------------------------------------------
# Bundles (profiles) — WHICH logical services travel together. Realizations
# follow from the realness selection; the deploy set is the closure.
# -----------------------------------------------------------------------------
[deploy.profiles]
mesh            = { services = ["mesh_node"] }
core            = { services = ["vault", "consul", "redis"] }
db              = { services = ["main_db", "object_store", "db_admin", "app_schema"] }
identity        = { services = ["identity_provider"] }
observability   = { services = ["otel_aggregator", "otel_collector", "docker_stats_exporter", "tracing", "cadvisor"] }
apps            = { services = ["controller", "webapp_server", "webapp_ui"] }
worker-io       = { services = ["worker_io"] }
worker-db       = { services = ["worker_db"] }
edge            = { services = ["reverse_proxy"] }
global-services = { services = ["registry", "github_runner", "github_runner_webhook", "webhook_listener"] }
admin           = { services = ["browser_service", "ddcli"] }
test            = { services = ["probe_targets", "browser_service", "tester"] }
all             = { services = [
  "vault", "consul", "redis", "main_db", "object_store", "db_admin", "app_schema", "identity_provider",
  "otel_aggregator", "otel_collector", "docker_stats_exporter", "tracing",
  "controller", "webapp_server", "webapp_ui", "worker_io", "worker_db", "reverse_proxy",
] }

# -----------------------------------------------------------------------------
# Layouts — WHERE. Always explicit, even for one host. Host declaration order
# = push order (ciu check verifies it against the cross-host init graph).
# `reach` = networks this host may use to reach the others, in preference
# order. Hosts are declared once in ciu.hosts.toml and reused by every layout.
# -----------------------------------------------------------------------------
[deploy.layouts.local]
environment = "dev"
description = "one machine (devcontainer or laptop): everything on the instance network"
hosts.localhost = { bundles = ["all", "test"], reach = ["instance"] }

[deploy.layouts.prod3]
environment = "prod"
description = "three netcup hosts over the tailscale mesh; public ingress on the edge host"
hosts.gstammtisch  = { bundles = ["mesh", "core", "db", "identity", "worker-db"],   reach = ["mesh"] }
hosts.rs1002       = { bundles = ["mesh", "apps", "worker-io", "observability"],    reach = ["mesh"] }
hosts.tsstammtisch = { bundles = ["mesh", "edge", "global-services"],               reach = ["mesh", "public"] }

[deploy.layouts.staging2]
environment = "staging"
description = "same host inventory, two hosts, different bundles: db + apps together, edge separate"
hosts.gstammtisch  = { bundles = ["mesh", "core", "db", "identity", "apps", "worker-io", "worker-db"], reach = ["mesh"] }
hosts.tsstammtisch = { bundles = ["mesh", "edge", "observability"],                                    reach = ["mesh", "public"] }

# An mTLS-over-public layout needs only an address network with tls = "mtls" and
# a pki provider (its contract carries pki:issuer/public_mtls, S10.5); every host
# in its `reach` needs an address on it in ciu.hosts.toml
# ([deploy.hosts.<h>.addresses] public_mtls = "…", S7.6.4). Nothing changes in any
# stack file — the tls_cert/tls_key/tls_ca secrets and the pki edges are derived:
#   [network.public_mtls]
#   kind = "address"
#   description = "public internet, ciu-managed mTLS"
#   tls = "mtls"
#   pki = "vault"
#   [deploy.layouts.mtls-public]
#   environment = "prod"
#   hosts.gstammtisch = { bundles = ["core", "db"], reach = ["public_mtls"] }
#   hosts.rs1002      = { bundles = ["apps"],       reach = ["public_mtls"] }

# -----------------------------------------------------------------------------
# Vault pointer + consumer DRY table for directive paths.
# -----------------------------------------------------------------------------
[vault]
service = "vault"                    # the LogicalService ciu's own secret providers talk to

[vault.paths]                        # consumer user table (ciu never reads it): one spelling per KV path
postgres_superuser_password = "db/postgres/superuser_password"
postgres_controller_password = "db/postgres/controller_password"
postgres_controller_ddl_password = "db/postgres/controller_ddl_password"
postgres_workerdb_password = "db/postgres/workerdb_password"
postgres_workerdb_ddl_password = "db/postgres/workerdb_ddl_password"
postgres_webapp_password = "db/postgres/webapp_password"
postgres_authentik_password = "db/postgres/authentik_password"
redis_password = "redis/password"
minio_root_password = "minio/root_password"
minio_worker_io_access_key = "minio/worker_io/access_key"
minio_worker_io_secret_key = "minio/worker_io/secret_key"
minio_webapp_server_access_key = "minio/webapp_server/access_key"
minio_webapp_server_secret_key = "minio/webapp_server/secret_key"
minio_worker_db_access_key = "minio/worker_db/access_key"
minio_worker_db_secret_key = "minio/worker_db/secret_key"
pgadmin_password = "pgadmin/password"
skywalking_postgres_password = "skywalking/postgres_password"
controller_bootstrap_token = "controller/bootstrap_token"
internal_dlq_token = "internal/internal_dlq_token"
consul_controller_token = "consul/controller/token"
consul_webapp_server_token = "consul/webapp-server/token"
consul_worker_io_token = "consul/worker-io/token"
consul_worker_db_token = "consul/worker-db/token"
consul_docker_stats_exporter_token = "consul/docker-stats-exporter/token"
consul_mgmt_token = "consul/mgmt/token"
consul_cmru_controller_token = "consul/cmru/controller/token"
consul_cmru_viewer_token = "consul/cmru/viewer/token"
consul_cmru_bootstrap_bearer_token = "consul/cmru/bootstrap-bearer-token"
controller_vault_role_id = "vault/controller/role_id"
controller_vault_secret_id = "vault/controller/secret_id"
webapp_server_vault_role_id = "vault/webapp-server/role_id"
webapp_server_vault_secret_id = "vault/webapp-server/secret_id"
authentik_secret_key = "authentik/secret_key"
authentik_redis_password = "authentik/redis_password"
authentik_bootstrap_token = "authentik/bootstrap_token"
authentik_bootstrap_password = "authentik/bootstrap_password"
authentik_oidc_client_secret = "authentik/oidc/client_secret"
ddcli_service_password = "ddcli/service_password"

# -----------------------------------------------------------------------------
# [registry.*] — project metadata (free-form except the ciu-read keys),
# validated by scripts/registry_check.py (ciu.registry_validator).
# -----------------------------------------------------------------------------
[registry.postgresql]
database = "dstdns"                  # ciu-read: target of pg:schema/* probes
authentik_database = "authentik"
superuser = "postgres"

[registry.postgresql.users]
controller = "controller"
controller_ddl = "controller_ddl"
workerdb = "workerdb"
workerdb_ddl = "workerdb_ddl"
webapp = "webapp"
authentik = "authentik"

[registry.minio.users]
worker_io     = { name = "worker-io",     access_key_secret = "minio_worker_io_access_key",     secret_key_secret = "minio_worker_io_secret_key" }
webapp_server = { name = "webapp-server", access_key_secret = "minio_webapp_server_access_key", secret_key_secret = "minio_webapp_server_secret_key" }
worker_db     = { name = "worker-db",     access_key_secret = "minio_worker_db_access_key",     secret_key_secret = "minio_worker_db_secret_key" }

[registry.vault.roles.controller]
service = "controller"
paths = ["db/postgres/controller_password", "redis/password", "consul/controller/token", "internal/internal_dlq_token"]
runtime_paths = ["authentik/bootstrap_token"]

[registry.vault.roles.webapp_server]
service = "webapp_server"
paths = ["db/postgres/webapp_password", "redis/password", "consul/webapp-server/token", "minio/webapp_server/access_key", "minio/webapp_server/secret_key"]
runtime_paths = ["authentik/bootstrap_token"]

[registry.redis.acl]
enabled = true
default_user = "default"

[registry.redis.users.controller]
username = "controller"
permissions = ["+@read", "+@write", "+@pubsub", "~{{ queue_keys.worker_io_jobs }}", "~{{ queue_keys.worker_db_jobs }}", "~{{ queue_keys.notifications }}", "&{{ pubsub.status }}", "&{{ pubsub.events }}", "&{{ pubsub.worker_heartbeats }}", "&{{ pubsub.job_progress }}", "&{{ pubsub.job_completed }}"]
[registry.redis.users.worker_io]
username = "worker-io"
permissions = ["+@read", "+@write", "+@pubsub", "~{{ queue_keys.worker_io_jobs }}", "~{{ queue_keys.results }}", "&{{ pubsub.worker_heartbeats }}", "&{{ pubsub.job_progress }}", "&{{ pubsub.job_completed }}"]
[registry.redis.users.worker_db]
username = "worker-db"
permissions = ["+@read", "+@write", "+@pubsub", "~{{ queue_keys.worker_db_jobs }}", "~{{ queue_keys.results }}", "~{{ queue_keys.notifications }}", "&{{ pubsub.worker_heartbeats }}", "&{{ pubsub.job_progress }}", "&{{ pubsub.job_completed }}"]
[registry.redis.users.webapp_server]
username = "webapp-server"
permissions = ["+@read", "+@pubsub", "&{{ pubsub.status }}", "&{{ pubsub.events }}", "&{{ pubsub.worker_heartbeats }}", "&{{ pubsub.host_stats }}", "&{{ pubsub.container_stats }}", "&{{ pubsub.job_progress }}", "&{{ pubsub.job_completed }}", "&{{ pubsub.ui_state }}"]
[registry.redis.users.docker_stats_exporter]
username = "docker-stats-exporter"
permissions = ["+@pubsub", "&{{ pubsub.host_stats }}", "&{{ pubsub.container_stats }}"]

[registry.consul.acl]
enabled = true
default_policy = "deny"
down_policy = "extend-cache"
enable_token_persistence = true
# Policy rules are Consul HCL (consumer data). __LANDSCAPE_ID__ is substituted by
# post_compose_consul.py from deploy.landscape_id — the ONE landscape id.
[registry.consul.policies.management]
name = "dstdns-management"
rules = """
key_prefix "services/" { policy = "write" }
key_prefix "" { policy = "read" }
session_prefix "" { policy = "write" }
"""
[registry.consul.policies.controller]
name = "dstdns-controller"
rules = """
key_prefix "dstdns/__LANDSCAPE_ID__/services/" { policy = "read" }
key_prefix "dstdns/__LANDSCAPE_ID__/services/controller/" { policy = "write" }
key_prefix "dstdns/__LANDSCAPE_ID__/services/webapp-server/overrides/" { policy = "write" }
key_prefix "dstdns/__LANDSCAPE_ID__/services/worker-io/overrides/" { policy = "write" }
key_prefix "dstdns/__LANDSCAPE_ID__/services/worker-db/overrides/" { policy = "write" }
key_prefix "dstdns/__LANDSCAPE_ID__/services/docker-stats-exporter/overrides/" { policy = "write" }
"""
[registry.consul.policies.webapp_server]
name = "dstdns-webapp-server"
rules = """
key_prefix "dstdns/__LANDSCAPE_ID__/services/" { policy = "read" }
key_prefix "dstdns/__LANDSCAPE_ID__/services/webapp-server/" { policy = "write" }
key_prefix "dstdns/__LANDSCAPE_ID__/services/controller/overrides/" { policy = "write" }
key_prefix "dstdns/__LANDSCAPE_ID__/services/worker-io/overrides/" { policy = "write" }
key_prefix "dstdns/__LANDSCAPE_ID__/services/worker-db/overrides/" { policy = "write" }
key_prefix "dstdns/__LANDSCAPE_ID__/services/docker-stats-exporter/overrides/" { policy = "write" }
"""
[registry.consul.policies.worker_io]
name = "dstdns-worker-io"
rules = """
key_prefix "dstdns/__LANDSCAPE_ID__/services/worker-io/" { policy = "write" }
"""
[registry.consul.policies.worker_db]
name = "dstdns-worker-db"
rules = """
key_prefix "dstdns/__LANDSCAPE_ID__/services/worker-db/" { policy = "write" }
"""
[registry.consul.policies.docker_stats_exporter]
name = "dstdns-docker-stats-exporter"
rules = """
key_prefix "dstdns/__LANDSCAPE_ID__/services/docker-stats-exporter/" { policy = "write" }
"""
[registry.consul.policies.cmru_node]
name = "dstdns-cmru-node"
rules = """
key_prefix "cmru/landscapes/__LANDSCAPE_ID__/" { policy = "read" }
"""
[registry.consul.policies.cmru_controller]
name = "dstdns-cmru-controller"
rules = """
key_prefix "cmru/landscapes/__LANDSCAPE_ID__/" { policy = "write" }
"""
[registry.consul.policies.cmru_viewer]
name = "dstdns-cmru-viewer"
rules = """
key_prefix "cmru/landscapes/__LANDSCAPE_ID__/" { policy = "read" }
"""

[registry.consul.deploy]
kv_root = "cmru/landscapes"
[registry.consul.deploy.auto_config]
enabled = false
jwt_issuer = "dstdns-enrollment"
jwks_url = ""
static_pubkey_vault_path = "consul/enrollment/jwt-pubkey"
node_id_claim = "node_id"

# -----------------------------------------------------------------------------
# [governance] — stack cgroup policy (cgroup-v2 key names). The gate's lanes
# use the same vocabulary and code path.
# -----------------------------------------------------------------------------
[governance]
enabled = false                      # switched on per deployment in ciu.global.toml.j2
cgroup_parent = ""                   # "" = $CGROUP_PARENT_DEV_BACKGROUND
ksm_optin = "builtin"
memory_max = "1G"
memory_swap_max = "0"
memory_low = "256M"
cpu_weight = 100
io_weight = 100
device = ""                          # "" = autodetect

# -----------------------------------------------------------------------------
# [testing] — the gate (run-gate absorbed). Environments name LogicalServices,
# lanes name assay lanes, preconditions read the instance's resolved facts.
# -----------------------------------------------------------------------------
[testing]
cgroup_slice = "ciu-gate.slice"

[testing.judge]
version = ">=2.4"                    # FLOOR; the tester image installs the newest release satisfying it
# judge provenance is ALWAYS required (ciu passes --require-judge-provenance; there is no opt-out key, S16.3.2)

[testing.environments.tester]
mode = "exec"
exec_in = "tester"                   # container from tester's derived identity; must be healthy
forward_env = ["RUN_LIVE_TESTS", "SCHEMA_GATE_PG_IMAGE"]
# CIU-73 / assay B041: the environment owns a lane's dependency closure. assay's
# snapshot holds committed objects only, so [testing.lanes.ui-unit]'s assay lane
# rebuilds node_modules OFFLINE (`npm ci --offline`) out of this cache, populated
# at image build from the committed package-lock.json (or provided by the host).
extra_mounts = ["/var/cache/dstdns/npm:/opt/npm-cache"]

[testing.environments.host]
mode = "host"

[testing.lanes.unit]
kind = "command"
environment = "tester"
argv = ["bash", "-c", "cd {worktree} && MOCK_MODE=true pytest tests/unit tests/harness tests/contract tests/config tests/security libs/common/tests applications/ddcli/tests -q"]
clean_tree = false
budget = "30m"
resources = { memory_max = "3G", cpu_weight = 100 }

[testing.lanes.schema]
kind = "command"
environment = "tester"
description = "throwaway PG + schema tests"
argv = ["scripts/schema-gate.sh", "{worktree}"]
required_env = ["SCHEMA_GATE_PG_IMAGE"]
clean_tree = false
budget = "90m"
resources = { memory_max = "4G", shared = ["main_db"] }

[testing.lanes.assay-dlq]
kind = "assay"
environment = "tester"
assay_lane = "durable_dlq"
clean_tree = false
budget = "15m"
requires = { services = ["redis"] }

[testing.lanes.sql-mutation]
kind = "assay"
environment = "tester"
assay_lane = "cw2b_schema"
clean_tree = false
budget = "90m"
requires = { realness = { main_db = "live" }, services = ["main_db", "app_schema"] }
resources = { memory_max = "4G", shared = ["main_db"] }

[testing.lanes.p129-enumeration-cursor]
kind = "assay"
environment = "tester"
assay_lane = "p129_enumeration_cursor"      # its assay lane declares judge.base_source = "request"
request_base = true                         # → ciu passes --request-base <merge-base of HEAD and upstream, or --base REF> (S16.5, S16.7.1)
required_env = ["SCHEMA_GATE_PG_IMAGE"]
clean_tree = false
budget = "10m"

[testing.lanes.release]
kind = "command"
environment = "tester"
description = "live-stack integration / observability / e2e / infra"
argv = ["bash", "-c", "cd {worktree} && pytest -m 'integration or observability or e2e or infra' -q"]
required_env = ["RUN_LIVE_TESTS"]
clean_tree = false
budget = "60m"
requires = { realness = { main_db = "live", probe_targets = "simulated" }, services = ["controller", "webapp_server", "worker_io", "probe_targets"] }

[testing.lanes.ui]
kind = "command"
environment = "tester"
argv = ["bash", "-c", "cd {worktree}/applications/webapp-ui-react && npm run typecheck && cd {worktree} && export PWMCP_REQUIRED=1 && pytest -m browser tests/e2e/ui/webapp-ui-react -q"]
required_env = ["RUN_LIVE_TESTS"]
clean_tree = false
budget = "60m"
requires = { services = ["webapp_ui", "browser_service"] }

[testing.lanes.ui-unit]                      # CIU-73 / assay B041: a language-bound assay lane (javascript, R1)
kind = "assay"
environment = "tester"                       # needs node/npm on PATH and the npm cache mount above → CIU-72 checks that statically
assay_lane = "ui_unit"                       # assay.toml: `npm ci --offline` out of /opt/npm-cache, then `npx --no-install vitest run --coverage`
request_base = true                          # derivable from the assay lane's base_source (CIU-72); when restated here it must agree
clean_tree = false
budget = "15m"
resources = { memory_max = "2G" }

[testing.lanes.gate]
kind = "command"
environment = "host"
description = "the implementation-gate conjunction; every consumer runs exactly this"
argv = ["bash", "-c", "ciu gate schema && ciu gate unit && ciu gate assay-dlq"]
clean_tree = false
budget = "90m"

# -----------------------------------------------------------------------------
# [ciu] — tool policy; [ciu.instances] — budget / lease (one closed key set).
# No exec-target table in v8: `ciu instance exec --env tester -- <cmd>` runs in a
# gate environment ([testing.environments.tester], S14.6.3, S16.4).
# -----------------------------------------------------------------------------
[ciu]
standalone_root = true
require_fqdn = false
exit_on = "WARN"
auto_connect_network = true
user_tables = ["auth", "authentik", "build", "load_control", "pubsub", "workflow"]
registry_validator = "scripts/registry_check.py"

[ciu.instances]
max_concurrent = 3

# -----------------------------------------------------------------------------
# Consumer user tables (declared in ciu.user_tables; ciu passes them through)
# -----------------------------------------------------------------------------
[build]
python_version = "3.14"
python_base_image = "python:3.14-slim-trixie"
mock_python_base_image = "python:3.14-slim"
devcontainer_image = "ghcr.io/volkb79-2/modern-debian-tools-python-debug-vsc-devcontainer:trixie-py3.14-php8.5-latest"

[authentik]
oidc_slug = "dstdns-ui"

[auth]
enabled = true

[workflow]
work_stream_key = "dstdns:streams:workflow:work"
work_consumer_group = "workflow-workers-io"
work_stream_key_db = "dstdns:streams:workflow:work:db"
work_consumer_group_db = "workflow-workers-db"
cancel_cache_key = "dstdns:workflow:cancelled_runs"
result_stream_key = "dstdns:streams:workflow:results"
result_consumer_group = "workflow-result-processors"
dispatch_batch_size = 20
dispatch_claim_lease_seconds = 30
attempt_deadline_seconds = 60
max_attempts = 3
result_ack_timeout_ms = 30000
retention_safety_margin = 0
max_in_flight = 200
admission_window = 10
max_work_units_per_tick = 4
min_domains_per_work_unit = 1
max_domains_per_work_unit = 1
enumeration_batch_size = 200
max_rows_per_admission_txn = 5000
max_ready_work_units_per_stage = 40
max_ready_work_units_per_run = 200
max_active_attempts_per_run = 100
max_active_attempts_per_resource_class = 500
max_active_attempts_global = 1000
breaker_failure_threshold = 5
breaker_window_seconds = 60
breaker_cooldown_seconds = 300
breaker_probe_size = 1
dispatch_startup_stagger_s = 5
dispatch_poll_interval_s = 1.0
reconcile_startup_stagger_s = 15
reconcile_sweep_interval_s = 5.0
retention_startup_stagger_s = 30
retention_poll_interval_s = 60.0
admission_startup_stagger_s = 20
admission_tick_interval_s = 2.0
consumer_block_ms = 5000
consumer_error_backoff_s = 1

[load_control]
dns_concurrency = 50
http_concurrency = 20
content_concurrency = 10
db_concurrency = 5
dns_interval_ms = 10
http_interval_ms = 50
enable_adaptive_rate = true
latency_target_ms = 100
latency_max_ms = 500

[pubsub]
status = "{{ pubsub.status }}"
events = "{{ pubsub.events }}"
config = "{{ pubsub.config }}"
worker_heartbeats = "{{ pubsub.worker_heartbeats }}"
host_stats = "{{ pubsub.host_stats }}"
container_stats = "{{ pubsub.container_stats }}"
job_progress = "{{ pubsub.job_progress }}"
job_completed = "{{ pubsub.job_completed }}"
ui_state = "{{ pubsub.ui_state }}"
