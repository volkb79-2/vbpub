# applications/controller/ciu.compose.yml.j2 — v8 notation
# Injected by ciu: container_name/hostname (dstdns-<instance>-controller),
# networks, base labels, the config-file and secret mounts, cgroup fields.
services:
  controller:
    image: {{ ciu_stack.controller.image }}
    restart: "no"                            # fail-fast for development
    user: "{{ instance.user_uid }}:{{ instance.user_gid }}"
    environment:
      {% for key, value in deploy.env.defaults.items() %}
      - {{ key }}={{ value }}
      {% endfor %}
      - BUILD_VERSION={{ instance.build_version }}
      - BUILD_TIME={{ instance.build_time }}
      - CONTROLLER_CONFIG_FILE=/etc/controller/config.toml
      - DSTDNS_LANDSCAPE_ID={{ instance.landscape_id }}
      - DSTDNS_INSTANCE_ID={{ ciu_stack.controller.identity.container_name }}
      - DSTDNS_SERVICE_PROFILE=default
      - CONTROLLER_BOOTSTRAP_TOKEN=${CONTROLLER_BOOTSTRAP_TOKEN}          # env delivery
      - CONTROLLER_VAULT_ROLE_ID=${CONTROLLER_VAULT_ROLE_ID}
      - CONTROLLER_VAULT_SECRET_ID=${CONTROLLER_VAULT_SECRET_ID}
      - CONTROLLER_SECRETS_POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password   # file delivery (mount injected)
      - CONTROLLER_SECRETS_REDIS_PASSWORD_FILE=/run/secrets/redis_password
      - CONTROLLER_CONSUL_TOKEN_FILE=/run/secrets/consul_token
      - CONTROLLER_SECRETS_INTERNAL_DLQ_TOKEN_FILE=/run/secrets/internal_dlq_token
      - SW_AGENT_COLLECTOR_BACKEND_SERVICES={{ ciu_stack.controller.tracing.oap }}
      - SW_AGENT_DISABLE_PLUGINS=sw_asyncpg
      - REDIS_HOST={{ ciu_stack.controller.redis.host }}
      - REDIS_PORT={{ ciu_stack.controller.redis.port }}
      - POSTGRES_HOST={{ ciu_stack.controller.database.host }}
      - POSTGRES_PORT={{ ciu_stack.controller.database.port }}
    volumes:
      - {{ ciu_stack.controller.hostdir.logs }}:/app/logs
      - {{ ciu_stack.controller.hostdir.cache }}:/app/cache
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:{{ ciu_stack.controller.endpoints.http.port }}/health').read()"]
      interval: {{ ciu_stack.controller.health.interval }}
      timeout: {{ ciu_stack.controller.health.timeout }}
      retries: {{ ciu_stack.controller.health.retries }}
      start_period: {{ ciu_stack.controller.health.start_period }}
    labels:
      - "{{ deploy.labels.prefix }}.service-type=api"
      - "{{ deploy.labels.prefix }}.service-container=false"
