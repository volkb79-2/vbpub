# applications/controller/ciu.defaults.toml.j2 — v8 notation
# Realization `controller` (bound by the global registry). One service keyed like
# the realization, so its container is dstdns-<instance>-controller.
# What became derived: the container/host name, the compose project, every
# host:port it used to copy from [topology.*]/[app_identity.*] (now routes),
# the vault ordering edge (from its *_VAULT directives), and the wave it runs in.

[ciu_stack.controller]
image = "{{ deploy.registry.namespace }}/controller:latest"
init_requires = ["main_db", "app_schema", "redis", "consul", "vault"]   # by capability; facts come from the contracts
uses = ["tracing"]                   # route only, no ordering edge (S7.8.3): the SkyWalking OAP address is read at run time
# no init_provides: vault:secret/internal/internal_dlq_token (consumed by worker-io) DERIVES from the GEN_TO_VAULT directive below (S10.1.2); repeating it is an ERROR (S6.4.2)
# `path` = what the reverse proxy fronts. In prod3 the proxy (tsstammtisch) is on another host than this stack (rs1002), so
# publish = "proxy" needs host_port + allow_from (S7.4.3). host_port 8083, not 8080: cadvisor (observability bundle, same
# host in prod3) already publishes host_port 8080 (S6.3.2). gstammtisch is admitted too: worker_db (worker-db bundle)
# reaches this API over the mesh in prod3 (its `uses`, S7.8 step 5).
endpoints.http = { port = 8080, protocol = "http", publish = "proxy", host_port = 8083, path = "/api/controller", allow_from = ["host.tsstammtisch", "host.gstammtisch"] }

[ciu_stack.controller.hostdir]
logs = ""
cache = ""

[ciu_stack.controller.settings]      # consumer data (rendered into config.toml via the configfile below)
concurrency = 10
hello_world_interval = 0
log_level = "info"

[ciu_stack.controller.database]      # every host/port is a ROUTE — identical in every layout
host = "{{ routes.main_db.sql.host }}"
port = {{ routes.main_db.sql.port }}
database = "{{ registry.postgresql.database }}"
user = "{{ registry.postgresql.users.controller }}"

[ciu_stack.controller.redis]
host = "{{ routes.redis.redis.host }}"
port = {{ routes.redis.redis.port }}
status_channel = "{{ pubsub.status }}"
job_progress_channel = "{{ pubsub.job_progress }}"
job_completed_channel = "{{ pubsub.job_completed }}"

[ciu_stack.controller.consul]
address = "http://{{ routes.consul.http.host }}:{{ routes.consul.http.port }}"

[ciu_stack.controller.tracing]
oap = "{{ routes.tracing.grpc.host }}:{{ routes.tracing.grpc.port }}"

[ciu_stack.controller.workflow]
work_stream_key = "{{ workflow.work_stream_key }}"
work_consumer_group = "{{ workflow.work_consumer_group }}"
work_stream_key_db = "{{ workflow.work_stream_key_db }}"
work_consumer_group_db = "{{ workflow.work_consumer_group_db }}"
cancel_cache_key = "{{ workflow.cancel_cache_key }}"
result_stream_key = "{{ workflow.result_stream_key }}"
result_consumer_group = "{{ workflow.result_consumer_group }}"
dispatch_batch_size = {{ workflow.dispatch_batch_size }}
dispatch_claim_lease_seconds = {{ workflow.dispatch_claim_lease_seconds }}
attempt_deadline_seconds = {{ workflow.attempt_deadline_seconds }}
max_attempts = {{ workflow.max_attempts }}
result_ack_timeout_ms = {{ workflow.result_ack_timeout_ms }}
retention_safety_margin = {{ workflow.retention_safety_margin }}
max_in_flight = {{ workflow.max_in_flight }}

# Secrets: `delivery` is mandatory. env = process environment (restart-bound;
# ciu check lists these); file = /run/secrets/<key>. The AppRole pair is the
# bootstrap credential — the app fetches the rest of its secrets itself (native).
[ciu_stack.controller.secrets]
postgres_password  = { directive = "ASK_VAULT:{{ vault.paths.postgres_controller_password }}", delivery = "file" }
redis_password     = { directive = "ASK_VAULT:{{ vault.paths.redis_password }}",               delivery = "file" }
consul_token       = { directive = "ASK_VAULT:{{ vault.paths.consul_controller_token }}",      delivery = "file" }
bootstrap_token    = { directive = "GEN_TO_VAULT:{{ vault.paths.controller_bootstrap_token }}", delivery = "env", env_name = "CONTROLLER_BOOTSTRAP_TOKEN" }
internal_dlq_token = { directive = "GEN_TO_VAULT:{{ vault.paths.internal_dlq_token }}",        delivery = "file" }
vault_role_id      = { directive = "ASK_VAULT:{{ vault.paths.controller_vault_role_id }}",     delivery = "env", env_name = "CONTROLLER_VAULT_ROLE_ID" }
vault_secret_id    = { directive = "ASK_VAULT:{{ vault.paths.controller_vault_secret_id }}",   delivery = "env", env_name = "CONTROLLER_VAULT_SECRET_ID" }

[ciu_stack.controller.configfile.app]   # rendered to applications/controller/ciu.rendered.controller.app, mounted read-only
template = "config.toml.j2"
target = "/etc/controller/config.toml"

[hooks]
pre_compose = []
post_compose = []
