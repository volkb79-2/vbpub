# applications/worker-db/ciu.defaults.toml.j2 — v8 notation
# Realization `worker_db` (bound by the global registry): ONE service `worker`
# with `instances = 2` replacing the hand-declared worker-db-1/-2; ciu derives
# dstdns-<instance>-worker_db-worker-1/-2 and the compose template iterates the
# replica identities (`identity.replicas`, S6.5 — a compose-render fact; this
# file cannot read `ciu_stack`, S3.5.2). Also derived: every host:port copied
# from [topology.*]/[app_identity.*] (routes), the environment_tag (instance
# id), the vault edge (ASK_VAULT directives), the schema edge (app_schema
# replaces the stack:infra/db-init:completed probe), the wave. D-095: ciu keeps
# PHYSICAL facts only — app tunables live in config.defaults.toml.

[ciu_stack.worker]
image = "{{ deploy.registry.namespace }}/worker-db:latest"
instances = 2
# main_db (dstdns DB, workerdb role + password), app_schema (db-init's schema —
# the old one-shot-exit-0 probe, by capability now), redis, consul (worker-db
# token), object_store (its OWN MinIO keys, D-116 (5c)), vault.
init_requires = ["main_db", "app_schema", "redis", "consul", "object_store", "vault"]
# Routes read at RUN time only — no ordering edge (S7.8.3): the controller API
# (cross-host over the mesh in prod3) and the SkyWalking OAP.
uses = ["controller", "tracing"]
endpoints.http = { port = 8080, protocol = "http" }    # /health; instance network only

[ciu_stack.worker.hostdir]
logs = ""

[ciu_stack.worker.settings]
controller_url = "{{ routes.controller.http.url }}"
controller_host = "{{ routes.controller.http.host }}"

[ciu_stack.worker.consul]
address = "http://{{ routes.consul.http.host }}:{{ routes.consul.http.port }}"

[ciu_stack.worker.tracing]
oap = "{{ routes.tracing.grpc.host }}:{{ routes.tracing.grpc.port }}"

# External dataset endpoints + their archive buckets: INSTANCE facts (where
# this landscape fetches from and archives to); cadence and enable flags are
# app L0.
[ciu_stack.worker.datasets]
minio_endpoint = "{{ routes.object_store.s3.host }}:{{ routes.object_store.s3.port }}"
archive_bucket = "{{ instance.project }}-{{ instance.id }}"
reports_bucket = "{{ instance.project }}-{{ instance.id }}"
tranco_url = "https://tranco-list.eu/top-1m.csv.zip"
iptoasn_url = "https://iptoasn.com/data/ip2asn-combined.tsv.gz"
maxmind_url = "https://download.maxmind.com/app/geoip_download"
openphish_url = "https://openphish.com/feed.txt"
urlhaus_url = "https://urlhaus.abuse.ch/downloads/csv_recent/"
threatfox_url = "https://threatfox.abuse.ch/export/host_file/?format=host_file&type=all&limit=0"
phishtank_url = "http://data.phishtank.com/data/{app_key}/online-valid.json"
# Optional feed credentials — deliberately NOT secret directives (see [secrets]).
maxmind_license_key = ""
phishtank_app_key = ""
threatfox_auth_key = ""
urlhaus_auth_key = ""

[ciu_stack.worker.database]          # every host/port is a ROUTE — identical in every layout
host = "{{ routes.main_db.sql.host }}"
port = {{ routes.main_db.sql.port }}
database = "{{ registry.postgresql.database }}"
user = "{{ registry.postgresql.users.workerdb }}"

[ciu_stack.worker.redis]
host = "{{ routes.redis.redis.host }}"
port = {{ routes.redis.redis.port }}

# Secrets: `delivery` is mandatory; env kept from the originals' expose_env
# (restart-bound; ciu check lists them).
[ciu_stack.worker.secrets]
postgres_password = { directive = "ASK_VAULT:{{ vault.paths.postgres_workerdb_password }}", delivery = "env", env_name = "WORKER_DB_DATABASE_PASSWORD" }
redis_password    = { directive = "ASK_VAULT:{{ vault.paths.redis_password }}",             delivery = "env", env_name = "WORKER_DB_REDIS_PASSWORD" }
consul_token      = { directive = "ASK_VAULT:{{ vault.paths.consul_worker_db_token }}",      delivery = "env", env_name = "WORKER_DB_CONSUL_TOKEN" }
minio_access_key  = { directive = "ASK_VAULT:{{ vault.paths.minio_worker_db_access_key }}", delivery = "env", env_name = "WORKER_DB_MINIO_ACCESS_KEY" }
minio_secret_key  = { directive = "ASK_VAULT:{{ vault.paths.minio_worker_db_secret_key }}", delivery = "env", env_name = "WORKER_DB_MINIO_SECRET_KEY" }
# The four third-party feed credentials are NOT directives: ASK_EXTERNAL is
# mandatory-by-design (P107 showed a landscape without a MaxMind account could
# not deploy worker-db at all), while these are genuinely optional — the
# importers fall back to the feeds' unauthenticated endpoints. Empty in
# [datasets] is a POLICY value ("this landscape holds no credential", AGENTS.md
# §4.2a). A landscape that has keys declares its own ASK_VAULT rows in its
# ciu.toml.j2; never a live credential in this tracked file.

# dstdns-P84 (CW1): workflow work/result stream consumption topology.
[ciu_stack.worker.workflow]
work_stream_key = "{{ workflow.work_stream_key }}"
work_consumer_group = "{{ workflow.work_consumer_group }}"
work_stream_key_db = "{{ workflow.work_stream_key_db }}"
work_consumer_group_db = "{{ workflow.work_consumer_group_db }}"
cancel_cache_key = "{{ workflow.cancel_cache_key }}"
result_stream_key = "{{ workflow.result_stream_key }}"
result_consumer_group = "{{ workflow.result_consumer_group }}"
dispatch_batch_size = {{ workflow.dispatch_batch_size }}
dispatch_claim_lease_seconds = {{ workflow.dispatch_claim_lease_seconds }}
attempt_deadline_seconds = {{ workflow.attempt_deadline_seconds }}
max_attempts = {{ workflow.max_attempts }}
result_ack_timeout_ms = {{ workflow.result_ack_timeout_ms }}
retention_safety_margin = {{ workflow.retention_safety_margin }}
max_in_flight = {{ workflow.max_in_flight }}

[ciu_stack.worker.configfile.app]    # declared ONCE; ciu renders it per replica (each render sees that replica's identity)
template = "config.toml.j2"
target = "/etc/worker-db/config.toml"

[hooks]
pre_compose = []
post_compose = []
