# applications/worker-db/ciu.compose.yml.j2 — v8 notation
# Injected by ciu per replica: container_name/hostname
# (dstdns-<instance>-worker_db-worker-<n>), networks, base labels, the
# config-file mount, cgroup fields. One service block per replica row.
services:
  {% for r in ciu_stack.worker.identity.replicas %}
  {{ r.compose_key }}:
    image: {{ ciu_stack.worker.image }}
    restart: "no"                            # fail-fast for development
    user: "{{ instance.user_uid }}:{{ instance.user_gid }}"
    environment:
      {% for key, value in deploy.env.defaults.items() %}
      - {{ key }}={{ value }}
      {% endfor %}
      # N8/D-116(7): build metadata is ciu's own; the app REQUIRES it
      - BUILD_VERSION={{ instance.build_version }}
      - BUILD_TIME={{ instance.build_time }}
      # S5.5 bootstrap pointers — all config is in the mounted TOML file; the
      # identity pointers are needed BEFORE the merge, to find the Consul tree.
      - WORKER_DB_CONFIG_FILE=/etc/worker-db/config.toml
      - DSTDNS_LANDSCAPE_ID={{ instance.landscape_id }}
      - DSTDNS_INSTANCE_ID={{ r.container_name }}
      - DSTDNS_SERVICE_PROFILE=default
      # Consul ACL token (env delivery): makes the secret VISIBLE to the service
      # (S4.20); the loader reads it from the rendered config file. Plain ${VAR}:
      # the fail-if-unset interpolation form is refused (S11.3) — the secret's
      # env_name guarantees the variable is present (S10.2.2, S11.6).
      - WORKER_DB_CONSUL_TOKEN=${WORKER_DB_CONSUL_TOKEN}
      # Feed credentials (optional) and report storage are rendered into the
      # config file from [ciu_stack.worker.datasets] — no env layer (D-094).
      # SkyWalking native agent — the OAP address is a route
      - SW_AGENT_COLLECTOR_BACKEND_SERVICES={{ ciu_stack.worker.tracing.oap }}
    volumes:
      - {{ ciu_stack.worker.hostdir.logs }}:/app/logs
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:{{ ciu_stack.worker.endpoints.http.port }}/health')"]
      interval: {{ ciu_stack.worker.health.interval }}
      timeout: {{ ciu_stack.worker.health.timeout }}
      retries: {{ ciu_stack.worker.health.retries }}
      start_period: {{ ciu_stack.worker.health.start_period }}
    labels:
      - "{{ deploy.labels.prefix }}.worker-type=database"
      # no replica label of our own: ciu stamps <prefix>.replica per replica (S4.5.1); the v7 key was a reserved one (S4.5.2)
      - "{{ deploy.labels.prefix }}.service-container=false"
  {% endfor %}
