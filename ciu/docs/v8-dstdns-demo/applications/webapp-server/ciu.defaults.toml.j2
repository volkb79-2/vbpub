# applications/webapp-server/ciu.defaults.toml.j2 — v8 notation
# Realization `webapp_server` (bound by the registry) = the `webapp_server`
# LogicalService, fronted by the reverse proxy at /api/webapp-server.
# D-095 still holds: ciu keeps PHYSICAL facts only (image, endpoints, host dirs,
# secret directives, peer routes); every app tunable lives in the app's own L0
# (config.defaults.toml). What became derived: the container/host name
# (dstdns-<instance>-webapp_server-server), every peer host:port (routes — were
# topology.*/app_identity.* copies), the vault edge (*_VAULT directives), the
# wave, and schema-before-boot (init_requires app_schema replaces the
# stack:infra/db-init:completed stand-in). config.toml.j2 reads the routes it
# needs beyond these tables directly: routes.identity_provider.http (jwks),
# routes.vault.api, routes.otel_collector.otlp_grpc — each declared below in
# init_requires or uses, or the template render refuses (S7.8.3).

[ciu_stack.server]
image = "{{ deploy.registry.namespace }}/webapp-server:latest"
# By capability: pg:db/dstdns, pg:role/webapp, the webapp password (main_db);
# the schema (app_schema); the redis password; the consul token; the minio
# creds (object_store); the AppRole pair (vault) — each a fact of that contract.
init_requires = ["main_db", "app_schema", "redis", "consul", "object_store", "vault"]
# Routes read at RUN time only — no ordering edge (S7.8.3): the controller API,
# the SkyWalking OAP, the identity provider's JWKS, the node OTLP collector.
uses = ["controller", "tracing", "identity_provider", "otel_collector"]
# The proxy fronts `path`; in prod3 it (tsstammtisch) is on another host than this stack (rs1002), so publish = "proxy"
# needs host_port + allow_from (S7.4.3). 8081: controller holds 8083, webapp_ui 8082, cadvisor 8080 on that host (S6.3.2).
endpoints.http = { port = 8080, protocol = "http", publish = "proxy", host_port = 8081, path = "/api/webapp-server", allow_from = ["host.tsstammtisch"] }

[ciu_stack.server.hostdir]
logs = ""

[ciu_stack.server.app]               # consumer data (config.toml.j2)
host = "0.0.0.0"
log_level = "INFO"
cors_origins = "*"
controller_url = "http://{{ routes.controller.http.host }}:{{ routes.controller.http.port }}"
status_channel = "{{ pubsub.status }}"
job_progress_channel = "{{ pubsub.job_progress }}"
job_completed_channel = "{{ pubsub.job_completed }}"

[ciu_stack.server.consul]
address = "http://{{ routes.consul.http.host }}:{{ routes.consul.http.port }}"
kv_path = "services/webapp-server"   # this service's KV leaf under dstdns/<landscape>/ — the consul policy names this spelling; not an identity (was `name`)
# Base KV paths (without the /defaults leaf); the shared consul router appends
# /defaults, /overrides and /workers/<id>/overrides.
worker_io_kv_path = "services/worker-io/settings"
worker_db_kv_path = "services/worker-db/settings"

[ciu_stack.server.database]          # every host/port is a ROUTE — identical in every layout
host = "{{ routes.main_db.sql.host }}"
port = {{ routes.main_db.sql.port }}
database = "{{ registry.postgresql.database }}"
user = "{{ registry.postgresql.users.webapp }}"

[ciu_stack.server.redis]
host = "{{ routes.redis.redis.host }}"
port = {{ routes.redis.redis.port }}

[ciu_stack.server.minio]
endpoint = "{{ routes.object_store.s3.host }}:{{ routes.object_store.s3.port }}"
secure = false
bucket = "{{ instance.project }}-{{ instance.id }}"   # instance-scoped (was project-environment_tag)
prefix = "screenshots"

[ciu_stack.server.skywalking]
enabled = true
oap_url = "http://{{ routes.tracing.rest.host }}:{{ routes.tracing.rest.port }}"   # OAP REST (12800), for the config file
oap = "{{ routes.tracing.grpc.host }}:{{ routes.tracing.grpc.port }}"              # OAP gRPC (11800), for the native agent (compose env)

# Secrets: `delivery` is mandatory. The AppRole pair (provisioned by
# infra/vault/post_compose_vault.py from [registry.vault.roles.webapp_server]) is
# the bootstrap credential, delivered as env; the rest as files under
# /run/secrets/<key> (mounts injected). authentik/bootstrap_token is fetched by
# the SERVICE at runtime through this AppRole — deliberately no directive row.
[ciu_stack.server.secrets]
vault_role_id     = { directive = "ASK_VAULT:{{ vault.paths.webapp_server_vault_role_id }}",    delivery = "env", env_name = "WEBAPP_SERVER_VAULT_ROLE_ID" }
vault_secret_id   = { directive = "ASK_VAULT:{{ vault.paths.webapp_server_vault_secret_id }}",  delivery = "env", env_name = "WEBAPP_SERVER_VAULT_SECRET_ID" }
consul_token      = { directive = "ASK_VAULT:{{ vault.paths.consul_webapp_server_token }}",     delivery = "file" }
postgres_password = { directive = "ASK_VAULT:{{ vault.paths.postgres_webapp_password }}",       delivery = "file" }
redis_password    = { directive = "ASK_VAULT:{{ vault.paths.redis_password }}",                 delivery = "file" }
minio_access_key  = { directive = "ASK_VAULT:{{ vault.paths.minio_webapp_server_access_key }}", delivery = "file" }
minio_secret_key  = { directive = "ASK_VAULT:{{ vault.paths.minio_webapp_server_secret_key }}", delivery = "file" }

[ciu_stack.server.configfile.app]    # L1 instance file: rendered to applications/webapp-server/ciu.rendered.server.app, mounted read-only
template = "config.toml.j2"
target = "/etc/webapp-server/config.toml"

[hooks]
pre_compose = []
post_compose = []
