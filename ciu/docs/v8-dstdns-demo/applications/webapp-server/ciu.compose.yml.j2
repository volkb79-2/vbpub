# applications/webapp-server/ciu.compose.yml.j2 — v8 notation (draft.3)
# Injected by ciu: container_name/hostname (dstdns-<instance>-webapp-server-server),
# the instance network, ciu.* labels, CIU_* identity env, the config-directory
# (/etc/webapp-server) and secret (/run/secrets/*) mounts, healthcheck timing,
# cgroup fields. Every binding of this stack is template-delivered (most are
# read by config.toml.j2); this template reads only binds.tracing.
services:
  server:
    image: {{ ciu_stack.server.image }}
    user: "{{ host.user_uid }}:{{ host.user_gid }}"
    environment:
      {% for key, value in env_defaults.items() %}
      - {{ key }}={{ value }}
      {% endfor %}
      # Build metadata for the health endpoint / schema key (N8/D-116(7)):
      # derived by ciu, never a BUILD_VERSION default-interpolation fallback (refused, S11.3); the app REQUIRES it.
      - BUILD_VERSION={{ instance.build_version }}
      - BUILD_TIME={{ instance.build_time }}
      # bootstrap pointers — all config is in the mounted TOML file; none of
      # these can override a config key, all are needed BEFORE the merge.
      - WEBAPP_SERVER_CONFIG_FILE={{ ciu_stack.server.configfile.app.target }}
      - DSTDNS_LANDSCAPE_ID={{ instance.landscape_id }}
      - DSTDNS_INSTANCE_ID={{ ciu_stack.server.identity.container_name }}
      - DSTDNS_SERVICE_PROFILE=default
      # env delivery: the AppRole bootstrap pair (plain ${VAR}, S10.2.2)
      - WEBAPP_SERVER_VAULT_ROLE_ID=${WEBAPP_SERVER_VAULT_ROLE_ID}
      - WEBAPP_SERVER_VAULT_SECRET_ID=${WEBAPP_SERVER_VAULT_SECRET_ID}
      # file delivery (mounts injected)
      - WEBAPP_SERVER_CONSUL_TOKEN_FILE=/run/secrets/consul_token
      - WEBAPP_SERVER_DATABASE_PASSWORD_FILE=/run/secrets/postgres_password
      - WEBAPP_SERVER_REDIS_PASSWORD_FILE=/run/secrets/redis_password
      - WEBAPP_SERVER_MINIO_ACCESS_KEY_FILE=/run/secrets/minio_access_key
      - WEBAPP_SERVER_MINIO_SECRET_KEY_FILE=/run/secrets/minio_secret_key
      # SkyWalking native agent — OAP gRPC from the template-delivered binding (host:port)
      - SW_AGENT_COLLECTOR_BACKEND_SERVICES={{ ciu_stack.server.binds.tracing.host }}:{{ ciu_stack.server.binds.tracing.port }}
      # sw_asyncpg's bind_execute_many wrapper is incompatible with asyncpg>=0.29
      # on Python 3.14 (same workaround as controller); drop at apache-skywalking>=1.3.0.
      - SW_AGENT_DISABLE_PLUGINS=sw_asyncpg
    # no ports: reached on the instance network, or through the reverse proxy (endpoint path)
    volumes:
      - {{ ciu_stack.server.hostdir.logs }}:/app/logs
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:{{ ciu_stack.server.endpoints.http.port }}/health')"]   # python: no wget/curl in the slim image
      # interval / timeout / retries / start_period: injected from ciu_stack.server.health (S6.6.4)
    restart: unless-stopped                  # survives provider restarts; first-boot ordering is the wave gate's job
    labels:
      - "de.vxxu.volkb79.stack=application"      # extra label: docker-stats-exporter groups by it; ownership labels (ciu.*) are injected (S4.5)
      - "de.vxxu.volkb79.service-type=api"
      - "de.vxxu.volkb79.service-container=false"
