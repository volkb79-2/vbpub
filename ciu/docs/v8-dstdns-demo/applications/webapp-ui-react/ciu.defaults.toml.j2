# applications/webapp-ui-react/ciu.defaults.toml.j2 — v8 notation
# Realization `webapp_ui_react` (bound by the registry) = the `webapp_ui`
# LogicalService: the React SPA behind nginx, fronted by the reverse proxy at
# /app. Assets are baked into the image (multi-stage build). What became
# derived: the container/host name (dstdns-<instance>-webapp_ui_react-ui) —
# which the same-origin OIDC authority default now reads from the identity in
# the COMPOSE template (S3.5.3; this file cannot read `ciu_stack`, S3.5.2)
# instead of a hand-written "webapp-ui-react" — the network, the image string.

[ciu_stack.ui]
image = "{{ deploy.registry.namespace }}/webapp-ui-react:latest"
# The reverse proxy fronts `path`; in prod3 it (tsstammtisch) is on another host than this stack (rs1002), so
# publish = "proxy" needs host_port + allow_from (S7.4.3). 8082: controller holds 8083, webapp_server 8081, cadvisor 8080 there (S6.3.2).
# gstammtisch is admitted too: authentik (identity bundle) reads this origin for its redirect URIs over the mesh in prod3 (its `uses`).
endpoints.http = { port = 80, protocol = "http", publish = "proxy", host_port = 8082, path = "/app", allow_from = ["host.tsstammtisch", "host.gstammtisch"] }

# Public browser configuration, rendered into /app/env.js at container start.
# The UI auth mode follows the same global switch the API services read
# ([auth] enabled in ciu.global).
[ciu_stack.ui.auth]
mode = "{{ 'oidc' if auth.enabled else 'stub' }}"
# When auth is on, the browser reaches Authentik through this container's own
# nginx same-origin proxy (/application/...). "" = the compose template derives
# http://<this container's identity.hostname>/application/o/<authentik.oidc_slug>/
# (the identity is a compose-render fact, S3.5.3 — a stack file cannot read
# `ciu_stack`, S3.5.2). Production operators override with their public issuer
# in the sparse ciu.toml.j2.
oidc_authority = ""
oidc_client_id = "dstdns-ui"

[hooks]
pre_compose = []
post_compose = []
