COMPINIT_COMPOSE_START_MODE=abort-on-failure
COMPINIT_RESET_BEFORE_START=none
COMPINIT_IMAGE_CHECK_CONTINUE_ON_ERROR=0
COMPINIT_CHECK_IMAGE_ENABLED=false
COMPINIT_MYREGISTRY_URL=https://RA-R2001.vxxu.de:5000/

# Optional: when true, expand $VAR and $(cmd) in loaded env values at runtime
# This is OFF by default to ensure generated live env file contains literal values.
COMPINIT_ENABLE_ENV_EXPANSION=false

# Infrastructure
PUBLIC_FQDN=ra-r2001.vxxu.de
PUBLIC_TLS_KEY_PEM=/etc/letsencrypt/live/${PUBLIC_FQDN}/privkey.pem
PUBLIC_TLS_CRT_PEM=/etc/letsencrypt/live/${PUBLIC_FQDN}/fullchain.pem

# Project metadata
LABEL_ENV_TAG=dev
LABEL_PREFIX=volkb79.vxxu.de
LABEL_PROJECT_NAME=whisper-trans

# global env vars available to all services
# global variable names adhere to the pattern 'GLOBAL_<VARNAME>' and should be used in yml files to set a variable '<VARNAME>'
GLOBAL_DEMO_FLAG=false

# Public exposure / routing
PUBLIC_HTTP_PORT=9002
PUBLIC_HTTPS_PORT=9003

# Whisper service port (internal container listens here)
WHISPER_PORT=9000
# Whisper service configuration extracted from docker-compose
WHISPER_ASR_ENGINE=faster_whisper
# Whisper ASR model selection
# Available models (resource implications):
#   tiny   - Fastest, lowest accuracy, ~1GB RAM, ~500MB disk
#   base   - Fast, low accuracy, ~1.5GB RAM, ~800MB disk
#   small  - Moderate speed/accuracy, ~2GB RAM, ~1GB disk
#   medium - Slower, higher accuracy, ~5GB RAM, ~2GB disk
#   large  - Slowest, highest accuracy, ~10GB RAM, ~3GB disk
# Choose based on your hardware and accuracy needs.
#WHISPER_ASR_MODEL=tiny
WHISPER_ASR_MODEL=base
# WHISPER_ASR_MODEL=small
# WHISPER_ASR_MODEL=medium
# WHISPER_ASR_MODEL=large
WHISPER_ASR_DEVICE=cpu
WHISPER_ASR_MODEL_PATH=/data/whisper
WHISPER_OMP_NUM_THREADS=7
WHISPER_OPENBLAS_NUM_THREADS=7
WHISPER_MKL_NUM_THREADS=7
WHISPER_SAMPLE_RATE=16000
WHISPER_MODEL_QUANTIZATION=float32
WHISPER_ENABLE_POST_PROCESSING=false
WHISPER_MIN_TEXT_LENGTH=10
WHISPER_POST_PROCESSING_PROMPT_PATH=/config/post-processing-prompt.txt

# Post-processing models (currently UNUSED - post-processing disabled)
# gpt-4o-mini: ~3GB RAM, ~2GB disk
# gpt-4o-small: ~7GB RAM, ~5GB disk
# gpt-4o-medium: ~15GB RAM, ~10GB disk
# gpt-4o-large: ~30GB RAM, ~20GB disk
# Alternative models (uncomment to use)
WHISPER_POST_PROCESSING_MODEL=gpt-4o-mini

WHISPER_RESOURCE_MEMORY_LIMIT=12G
WHISPER_RESOURCE_CPU_LIMIT=4

# API token (also stored as secret whisper_api_token; here optional fallback)
## WHISPER_API_TOKEN removed: using file-based secret only.

# Traefik entrypoint internal ports
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_ENTRYPOINT=dashboard
TRAEFIK_DASHBOARD_INTERNAL_PORT=8443

# Dashboard settings (access now via https://<host>:${TRAEFIK_DASHBOARD_PORT}/ )
TRAEFIK_DASHBOARD=true
TRAEFIK_DASHBOARD_PORT=9005
## Dashboard domain & password env removed (using secret + dedicated entrypoint)

# --------- Health Check Defaults for services ---------
HEALTHCHECK_INTERVAL=2s
HEALTHCHECK_TIMEOUT=1s
HEALTHCHECK_RETRIES=5
HEALTHCHECK_START_PERIOD=20s

# Volume host directories
WHISPER_HOSTDIR_CACHE=./vol-whisper-cache
WHISPER_HOSTDIR_AUDIO_TEMP=./vol-audio-temp

# ----------- User and Group IDs for file permissions ---------
# used for UID/GID the containers run as, to allow file access on host volumes
# The sample uses command substitution so the real numeric IDs are determined when
# CIU creates the .env.active file and written to it. 
# If you prefer to hardcode values, replace the $(...) with explicit numbers.
UID=$(id -u)
GID=$(id -g)

# Secrets (automatically handled by CIU)
WHISPER_API_TOKEN=   # left empty to be queried from user input
TRAEFIK_DASHBOARD_PASSWORD=   # left empty to be dynamically generated
