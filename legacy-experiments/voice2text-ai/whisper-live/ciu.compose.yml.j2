# WhisperLive Streaming Service Stack
# Template for: whisper-live compose stack
# Communication: Services communicate via voice2text-prod-network
# External access via reverse proxy with TLS

x-defaults: &service-defaults
  labels:
    - "project={{ deploy.project_name }}"
    - "environment={{ deploy.environment_tag }}"
  user: "${CONTAINER_UID:-0}:${CONTAINER_GID:-0}"
  environment:
    {% for key, value in deploy.env.defaults.items() %}
    - {{ key }}={{ value }}
    {% endfor %}

services:
  {{ services.whisper_live.name }}:
    <<: *service-defaults
    image: {{ services.whisper_live.image_name }}:{{ services.whisper_live.image_tag }}
    hostname: {{ services.whisper_live.name }}
    environment:
      - WHISPER_MODEL={{ whisperlive.model }}
      - WHISPER_DEVICE={{ whisperlive.device }}
      - WHISPER_COMPUTE_TYPE={{ whisperlive.compute_type }}
      - WHISPER_LANGUAGE={{ whisperlive.language }}
      - WHISPER_TASK={{ whisperlive.task }}
      - VAD_FILTER={{ whisperlive.vad_filter }}
      - VAD_THRESHOLD={{ whisperlive.vad_threshold }}
      - CHUNK_LENGTH_S={{ whisperlive.chunk_length_s }}
    volumes:
      - {{ whisperlive.hostdir.models }}:/data/models
      - {{ whisperlive.hostdir.audio_temp }}:/data/audio
      - /dev/shm:/dev/shm:rw
    deploy:
      resources:
        limits:
          memory: {{ whisperlive.resource_memory_limit }}
          cpus: '{{ whisperlive.resource_cpu_limit }}'
        reservations:
          memory: 1G
          cpus: '1'
    shm_size: 1gb
    ulimits:
      memlock: -1
      stack: 67108864
    restart: unless-stopped
    # No external ports - accessed only via reverse proxy
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:{{ services.whisper_live.internal_port }}/health').read()"]
      interval: {{ deploy.health.interval }}
      timeout: {{ deploy.health.timeout }}
      retries: {{ deploy.health.retries }}
      start_period: {{ deploy.health.start_period }}
    labels:
      - "{{ deploy.labels.prefix }}.component={{ services.whisper_live.name }}"
      - "{{ deploy.labels.prefix }}.stack=application"
      - "{{ deploy.labels.prefix }}.service-type=streaming"
    networks:
      - {{ deploy.network_name }}

networks:
  {{ deploy.network_name }}:
    external: true
    name: {{ deploy.network_name }}
