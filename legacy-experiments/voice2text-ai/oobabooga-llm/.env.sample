# =============== Oobabooga Local LLM (CPU) Environment ==================
# Copy this file to .env and adjust as needed.
# Target hardware: <=6 CPU cores, <=10GB RAM available
# Model: small/quantized GGUF or GPT4All model (1B-3B recommended, optional 7B q4)
# ========================================================================

COMPINIT_COMPOSE_START_MODE=abort-on-failure
COMPINIT_RESET_BEFORE_START=none
COMPINIT_IMAGE_CHECK_CONTINUE_ON_ERROR=0
COMPINIT_CHECK_IMAGE_ENABLED=false
COMPINIT_MYREGISTRY_URL=https://RA-R2001.vxxu.de:5000/

# Optional: when true, expand $VAR and $(cmd) in loaded env values at runtime
# This is OFF by default to ensure generated live env file contains literal values.
COMPINIT_ENABLE_ENV_EXPANSION=false

# Infrastructure
PUBLIC_FQDN=ra-r2001.vxxu.de
PUBLIC_TLS_KEY_PEM=/etc/letsencrypt/live/${PUBLIC_FQDN}/privkey.pem
PUBLIC_TLS_CRT_PEM=/etc/letsencrypt/live/${PUBLIC_FQDN}/fullchain.pem

# Project metadata
LABEL_ENV_TAG=dev
LABEL_PREFIX=volkb79.vxxu.de
LABEL_PROJECT_NAME=oobabooga-llm

# Health monitoring
HEALTHCHECK_INTERVAL=15s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=10
HEALTHCHECK_START_PERIOD=30s

# Global environment variables
# global env vars available to all services
# global variable names adhere to the pattern 'GLOBAL_<VARNAME>' and should be used in yml files to set a variable '<VARNAME>'
GLOBAL_DEMO_FLAG=false

# External exposure
PUBLIC_HTTP_PORT=9100                 # External port -> Traefik HTTP (web)
PUBLIC_HTTPS_PORT=9101                # External port -> Traefik HTTPS (websecure)
TRAEFIK_DASHBOARD_PORT=9105           # Optional dashboard (if enabled)

###############################
# LLM Model Configuration    #
###############################
# MODEL_PRESET: if set (tinyllama|phi2|mistral7b|custom) init-model.sh can auto-populate repo/file
MODEL_PRESET=tinyllama

# Final model file name actually used inside container (symlink or direct file)
MODEL_NAME=ggml-model-q4_0.gguf       # Will be created or linked by init-model.sh

# Context / inference tuning
MODEL_CONTEXT_LENGTH=1024             # Reduce to save KV cache memory (e.g. 512)
MODEL_THREADS=6                       # CPU threads to use (<= physical cores)
MODEL_BATCH=16                        # Prompt processing batch size (lower if memory pressure)
MODEL_TOP_K=40
MODEL_TOP_P=0.95
MODEL_TEMPERATURE=0.7
MODEL_REPEAT_PENALTY=1.1

# Source model definition (applies when MODEL_PRESET=custom or for override)
# For direct GGUF quantized downloads prefer TheBloke repos to avoid conversion.
MODEL_HF_REPO=TheBloke/TinyLlama-1.1B-Chat-v1.0-GGUF
MODEL_HF_FILE=tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf   # Must exist in repo (GGUF)
MODEL_DOWNLOAD_STRATEGY=direct                       # direct | hf-cli | manual

# Conversion strategy (ONLY if you deliberately point to a non-GGUF model)
# Supported values: skip (default), stub (warn only). Full automatic conversion
# would require llama.cpp tooling & quantization binaries which we do not bundle here.
MODEL_CONVERSION=skip                                 # skip | stub
MODEL_CONVERSION_NOTES="Set MODEL_CONVERSION=stub to see guidance if HF_FILE isn't .gguf"

# Service behavior
LLM_SERVICE_PORT=8000                 # Internal service HTTP port
LLM_HEALTH_PATH=/health               # Shim health endpoint
LLM_MAX_TOKENS=256                    # Max generation tokens per request
LLM_PROMPT_SYSTEM_PATH=/config/system-prompt.txt

# Resource limits (Compose deploy section for documentation; not enforced by Docker Desktop without swarm)
LLM_RESOURCE_MEMORY_LIMIT=8G
LLM_RESOURCE_CPU_LIMIT=6

# Traefik (optional integration similar to whisper-trans)
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_ENABLE=true
TRAEFIK_DASHBOARD=true

# ZRAM / Memory strategy (documented only; not used directly by Compose)
# ZRAM_ENABLE=true
# ZRAM_SIZE=6G

# Logging
LOG_LEVEL=info

# OpenAI shim settings
SHIM_PORT=8300
SHIM_ROUTE=/v1/chat/completions
SHIM_MODEL_ALIAS=postproc-mini        # Name returned in OpenAI-style responses

# User and group for directory permissions
UID=$(id -u)
GID=$(id -g)

# Bind-mounted volume roots (single canonical variables)
LLM_HOSTDIR_MODELS=./vol-llm-models    # Host path for model files (bind mounted read-only)
LLM_HOSTDIR_CACHE=./vol-llm-cache      # Host path for transformers / runtime cache

