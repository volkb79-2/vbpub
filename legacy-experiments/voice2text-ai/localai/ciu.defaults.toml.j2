# ============================================================================
# LOCALAI - MULTI-MODEL LLM SERVICE
# ==========================================================================
# LocalAI provides OpenAI-compatible API with support for multiple models
# Supports model profiles for switching between TinyLlama, Phi-2, and Mistral
# ============================================================================

[compinit]
enabled = true
refresh_active_on_start = false

# ============================================================================
# SERVICE CONFIGURATION
# ============================================================================
[localai]
name = "localai"
internal_port = 80
image_name = "localai/localai"
image_tag = "latest-aio-cpu"  # All-in-one with all backends for CPU
gpu_enabled = false

# Model configuration
threads = 6  # Number of CPU threads for inference
context_size = 2048  # Context window size
batch_size = 512  # Batch size for prompt processing

# ============================================================================
# MODEL PROFILES
# Define 2-3 models with different quality/speed trade-offs
# ============================================================================

[localai.models.tinyllama]
name = "tinyllama-1.1b"
file = "tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf"
url = "https://huggingface.co/TheBloke/TinyLlama-1.1B-Chat-v1.0-GGUF/resolve/main/tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf"
size_mb = 669
description = "Fast inference, basic quality - best for real-time chat"
recommended_for = "real-time chat, quick responses"

[localai.models.phi2]
name = "phi-2"
file = "phi-2.Q4_K_M.gguf"
url = "https://huggingface.co/TheBloke/phi-2-GGUF/resolve/main/phi-2.Q4_K_M.gguf"
size_mb = 1560
description = "Balanced quality/speed - good for document processing"
recommended_for = "document processing, general use"

[localai.models.mistral]
name = "mistral-7b-instruct"
file = "mistral-7b-instruct-v0.2.Q4_K_M.gguf"
url = "https://huggingface.co/TheBloke/Mistral-7B-Instruct-v0.2-GGUF/resolve/main/mistral-7b-instruct-v0.2.Q4_K_M.gguf"
size_mb = 4370
description = "Best quality, slower - ideal for offline batch processing"
recommended_for = "offline batch, quality-critical tasks"

# ============================================================================
# VOLUME MOUNTS
# ============================================================================
[localai.hostdir]
models = ""  # Empty = auto-generates ./vol-localai-models
logs = ""  # Empty = auto-generates ./vol-localai-logs

# ============================================================================
# ENVIRONMENT VARIABLES
# ============================================================================
[env]
# LocalAI configuration
LOCALAI_THREADS = "6"
LOCALAI_CONTEXT_SIZE = "2048"
LOCALAI_MODELS_PATH = "/models"
LOCALAI_DEBUG = "false"
LOCALAI_CORS = "true"
LOCALAI_CORS_ALLOW_ORIGINS = "*"

# ============================================================================
# HOOKS
# ============================================================================
[hooks]
pre_compose = ["./download_models.py"]
post_compose = []
