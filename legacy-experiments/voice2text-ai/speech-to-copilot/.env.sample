# Generated minimal .env.sample by CIU
# Edit and extend with your service-specific variables.

COMPINIT_COMPOSE_START_MODE=abort-on-failure
# Reset actions before starting (none, containers, named-volumes, hostdirs, all)
COMPINIT_RESET_BEFORE_START=none
# Enable/disable image availability checks before compose up
COMPINIT_CHECK_IMAGE_ENABLED=false
# Continue on image check error (0/1)
COMPINIT_IMAGE_CHECK_CONTINUE_ON_ERROR=0
# Comma-separated list of dependency directories to start first
COMPINIT_DEPENDENCIES=
# Python script to run before compose up
COMPINIT_HOOK_PRE_COMPOSE=
# Python script to run after compose up
COMPINIT_HOOK_POST_COMPOSE=
# Optional registry mirror URL
COMPINIT_MYREGISTRY_URL=
# Global strict mode toggle (1 to enable)
COMPINIT_STRICT_MODE=
# Enable $VAR and $(cmd) expansion in env values at runtime
COMPINIT_ENABLE_ENV_EXPANSION=false
# Public DNS name for service
PUBLIC_FQDN=example.local
# Path to TLS private key PEM
PUBLIC_TLS_KEY_PEM=/etc/letsencrypt/live/$PUBLIC_FQDN/privkey.pem
# Path to TLS certificate PEM
PUBLIC_TLS_CRT_PEM=/etc/letsencrypt/live/$PUBLIC_FQDN/fullchain.pem
# Healthcheck interval
HEALTHCHECK_INTERVAL=10s
# Healthcheck timeout
HEALTHCHECK_TIMEOUT=5s
# Healthcheck retries
HEALTHCHECK_RETRIES=3
# Healthcheck start period
HEALTHCHECK_START_PERIOD=30s
# Project name label
LABEL_PROJECT_NAME=my-project
# Environment tag (dev/staging/prod)
LABEL_ENV_TAG=dev
# Label prefix for project
LABEL_PREFIX=example.com
# User ID for container
UID=$(id -u)
# Group ID for container
GID=$(id -g)
