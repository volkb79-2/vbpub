# Shared local safety policy for automated Netcup API and UI/PWMCP workflows.
# Comma-separated SCP internal server names matching v<digits>, such as
# v2202503209318326780. Any automated surface must check this policy before
# operating on a server. The SCP website does not enforce it, so manual UI
# actions can bypass the local guard. `scp-api.py login` can populate it.
NETCUP_PROTECTED_SERVERS=
# Comma-separated positive server IDs. The login wizard writes these alongside
# selected names so a later server rename cannot remove protection. Do not
# guess IDs; use `scp-api.py login` or a verified server ID.
NETCUP_PROTECTED_SERVER_IDS=

# Run `python3 scp-api.py login` to populate the API token automatically via
# the OAuth2 device-code flow, instead of setting it by hand.
NETCUP_SCP_API_REFRESH_TOKEN=

# Optional local PWMCP browser credentials for the SCP Screen (browser VNC).
# The current Netcup CLI does not read these keys. Keep real values only in
# .env; do not put SCP account credentials in netcup.toml or send them in chat.
NETCUP_SCP_UI_URL=https://www.servercontrolpanel.de/
NETCUP_SCP_UI_USERNAME=
NETCUP_SCP_UI_PASSWORD=

# Optional: a 2nd bot token used only for live debugging/reading via getUpdates.
# If this bot is made admin in the supergroup, it can receive all messages
# (bypasses privacy mode). Used by: `python3 telegram_setup.py --bot-watch`
# NOTE: Messages sent by another bot may NOT be delivered to this bot via updates,
# even if both are admins (bot-to-bot delivery is unreliable). For reliable live
# reading/debugging, use `python3 telegram_setup.py --mtproto-watch`.
TELEGRAM_READER_BOT_TOKEN=

# Optional: MTProto credentials (only needed for --setup-forum-mtproto)
# Create these at https://my.telegram.org
# click `API development tools)`
#   - If it asks you to “Create new application”, fill the form (any reasonable values are fine):
#   - App title: e.g. vbpub-setup
#   - Short name: e.g. vbpubsetup
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional: login phone number (can be prompted interactively)
TELEGRAM_PHONE=+4917712312345
# Optional: where to store the Telethon session file (contains auth secrets)
TELEGRAM_USER_SESSION_FILE=.telegram.user.session

# Optional (recommended): group install messages into a forum topic (thread).
# Requires TELEGRAM_CHAT_ID to point to a forum-enabled supergroup (Topics enabled)
# and the bot to be an admin with topic permissions.
TELEGRAM_USE_FORUM_TOPIC=auto
TELEGRAM_TOPIC_PREFIX=vbpub install

# Enable verbose request/response logging in install-host.py and
# monitor-task.py. Equivalent to passing --debug on either script.
NETCUP_SCP_API_DEBUG=yes

# Avoid inline comments unless the value is quoted.
# Good:
#   NETCUP_SCP_API_SERVER_NAME=v123123123123
#   NETCUP_SCP_API_SERVER_NAME="v123123123123"  # comment ok (quoted)
# Bad (comment becomes part of the value in many parsers):
#   NETCUP_SCP_API_SERVER_NAME=v123123123123  # myhost.example.com
# Leave empty to let an interactive install present the authenticated server
# picker. Set a real v<digits> name only when this checkout should always use
# that target.
NETCUP_SCP_API_SERVER_NAME=

# Optional explicit installer target. If omitted in a TTY, install-host.py
# lists authenticated account servers and asks you to choose one.
# NETCUP_SCP_API_SERVER_ID=799611

# Optional overrides for install-host.py's SSH attach/monitoring.
# Everything below has a required default in install-host.toml
# instead (no Python-side fallback) - set these only to override that file
# for a single run/environment without editing it.
# NETCUP_SCP_API_SSH_HOST=
# NETCUP_SCP_API_SSH_USER=
# NETCUP_SCP_API_SSH_IDENTITY_FILE=

# Local controller-key lifecycle after the consumed customScript's declared
# completion marker. The default preserves the host-specific key for reuse.
NETCUP_SCP_API_CONTROLLER_KEY_LOCAL_RETENTION=retain
