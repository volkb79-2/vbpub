// Default install recipe - generated by `scp-api-install-host.py configure`.
// Used as the base payload for interactive-gather installs when present;
// delete this file (or re-run `configure`) to reset to built-in defaults.
{
  "locale": "en_US.UTF-8",
  "timezone": "Europe/Berlin",
  "customScript": "curl -fsSL https://raw.githubusercontent.com/volkb79-2/vbpub/main/scripts/debian-install-v2/bootstrap-remote.py | AUTO_REBOOT_AFTER_STAGE1=yes NEVER_REBOOT=no TELEGRAM_BOT_TOKEN='{{TELEGRAM_BOT_TOKEN}}' TELEGRAM_CHAT_ID='{{TELEGRAM_CHAT_ID}}' CONTROLLER_SSH_PUBKEY='{{CONTROLLER_SSH_PUBKEY}}' python3 -",
  "rootPartitionFullDiskSize": false,
  "sshPasswordAuthentication": false,
  "emailToExecutingUser": true,
  // Image: Debian 13.6.0 UEFI amd64
  "imageFlavourId": 128
}
