{
  "hosts": {
    "v1001": {
      "ssh": ["ssh", "-i", "/path/to/controller-key", "-o", "UserKnownHostsFile=/path/to/pinned_known_hosts", "-o", "StrictHostKeyChecking=yes", "-o", "BatchMode=yes", "runner@HOST-ADDRESS"],
      "api_check": ["bash", "-c", "source /path/to/env.sh && provider_identity_check_function"],
      "guard": "test \"$(hostname -f)\" = host.example.org && test \"$(cat /etc/vbpub/server-id)\" = 000000",
      "runner_home": "/home/runner",
      "cockpit": "mdt-cockpit-runner",
      "image": "tester-unified:local"
    }
  }
}
