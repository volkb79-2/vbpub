#!/usr/bin/env bash
# Description: Import one controller-created Git bundle into a commit-specific runner checkout.
set -Eeuo pipefail
umask 077
if [[ $# != 2 ]]; then
  echo 'usage: sync-from-devcontainer <bundle-in-~/incoming> <branch>' >&2
  exit 2
fi
bundle=$1
branch=$2
case "$bundle" in "$HOME"/incoming/*) ;; *) echo 'bundle must be inside ~/incoming' >&2; exit 2 ;; esac
[[ -f $bundle && ! -L $bundle ]] || { echo 'bundle must be a regular file' >&2; exit 2; }
[[ $branch != -* && $branch != *..* && $branch != *//* ]] || { echo 'invalid branch name' >&2; exit 2; }
git check-ref-format --branch "$branch" >/dev/null
ref="refs/heads/$branch"
# `git bundle verify` needs a repository; use a private empty bare one.
verify_repo="$HOME/src/.verify.git"
[[ -d $verify_repo ]] || git init --quiet --bare "$verify_repo"
git -C "$verify_repo" bundle verify "$bundle" >/dev/null
commit=$(git -C "$verify_repo" bundle list-heads "$bundle" | awk -v ref="$ref" '$2 == ref {print $1}')
[[ $commit =~ ^[0-9a-f]{40,64}$ ]] || { echo "bundle has no single head for $ref" >&2; exit 3; }
checkout="$HOME/checkouts/$commit"
if [[ -e $checkout ]]; then
  actual=$(git -C "$checkout" rev-parse HEAD)
  [[ $actual == "$commit" ]] || { echo "existing checkout has unexpected HEAD: $checkout" >&2; exit 4; }
else
  git clone --quiet --no-checkout --single-branch --branch "$branch" "$bundle" "$checkout"
  git -C "$checkout" checkout --quiet --detach "$commit"
  # the tester uid must traverse and read the bind-mounted checkout (umask is 077 here)
  chmod -R go+rX "$checkout"
fi
current="$HOME/src/vbpub-current"
tmp="$HOME/src/.vbpub-current.$$"
[[ ! -e $tmp && ! -L $tmp ]] || { echo 'temporary current link already exists' >&2; exit 5; }
ln -s "$checkout" "$tmp"
if [[ -e $current && ! -L $current ]]; then
  echo 'refusing to replace a non-symlink ~/src/vbpub-current' >&2
  exit 6
fi
mv -Tf -- "$tmp" "$current"
printf 'CHECKOUT=%s\nCOMMIT=%s\nBRANCH=%s\n' "$checkout" "$commit" "$branch"
