{
  "name": "public-ssh-whitelist",
  "description": "Keep other public ingress unchanged; restrict SSH to administrators",
  "rules": [
    {
      "description": "Allow SSH from the administrator addresses",
      "direction": "INGRESS",
      "protocol": "TCP",
      "action": "ACCEPT",
      "sources": [
        "198.51.100.10",
        "203.0.113.0/24"
      ],
      "destinationPorts": "22"
    },
    {
      "description": "Drop all other SSH",
      "direction": "INGRESS",
      "protocol": "TCP",
      "action": "DROP",
      "destinationPorts": "22"
    }
  ]
}
