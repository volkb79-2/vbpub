# /etc/systemd/system/soulmask_tmpfs-ZSwapMax1.slice
#
# Child of soulmask_tmpfs.slice (MemoryMin=400M, at cgroup root).
[Unit]
Description=Soulmask unified tmpfs — compressible content (binaries, Steam, libs)
Documentation=file:///home/vb/volkb79-2/vbpub/scripts/gstammtisch-guide/SOULMASK-TMPFS.md

[Slice]
# Pages for compressible content ([compressible] section of
# soulmask-tmpfs-paths.conf) are charged here during tmpfs population.
# Independent memory accounting from both Soulmask's game cgroups and the
# separate soulmask_tmpfs-ZSwapMax0.slice.

# Rough starting floor, NOT yet calibrated against a vmtouch measurement
# (unlike soulmask_tmpfs-ZSwapMax0.slice's 150M, which is — see
# MEASUREMENTS.md M2). ~500M total payload (Engine + WS/Binaries + linux64 +
# Steam + steamclient.so + libsteamwebrtc.so + steamapps + steamcmd); the
# actually-executed working set of a binary/library is normally well under
# its on-disk size (unused code paths, debug sections), so this starts at
# roughly half. Revisit once a vmtouch reading exists for this content.
# NOTE: this floor is only effective if the parent soulmask_tmpfs.slice
# carries MemoryMin >= this value (it does: 400M >= 250M).
MemoryMin=250M

# Unlike the pak file (zstd-incompressible, 1.006×), executable code and
# libraries benefit from zswap compression — no MemoryZSwapMax override
# here, so normal zswap eligibility applies if this content goes cold under
# pressure.
