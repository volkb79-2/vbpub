# /etc/systemd/system/soulmask_tmpfs-ZSwapMax1.slice
#
# Child of soulmask_tmpfs.slice (MemoryMin=800M, at cgroup root).
[Unit]
Description=Soulmask unified tmpfs — compressible content (binaries, Steam, libs)
Documentation=file:///home/vb/volkb79-2/vbpub/scripts/gstammtisch-guide/SOULMASK-TMPFS.md

[Slice]
# Pages for compressible content ([compressible] section of
# soulmask-tmpfs-paths.conf) are charged here during tmpfs population.
# Independent memory accounting from both Soulmask's game cgroups and the
# separate soulmask_tmpfs-ZSwapMax0.slice.

# Originally a rough starting floor (250M, ~half of the ~500M total
# payload: Engine + WS/Binaries + linux64 + Steam + steamclient.so +
# libsteamwebrtc.so + steamapps + steamcmd), pending a real measurement.
# Lowered to 30M on 2026-07-31 once observed in practice: the actually-hot
# working set of this content is much smaller than the on-disk payload
# estimate assumed (most of it is unused code paths, debug sections, and
# rarely-touched Steam runtime files that don't need protecting from
# eviction).
# NOTE: this floor is only effective if every ancestor slice also carries
# MemoryMin >= this value — soulmask_tmpfs.slice's 800M clears it with a lot
# of room to spare (see that file's own comment for why).
MemoryMin=30M

# Unlike the pak file (zstd-incompressible, 1.006×), executable code and
# libraries benefit from zswap compression — no MemoryZSwapMax override
# here, so normal zswap eligibility applies if this content goes cold under
# pressure.
