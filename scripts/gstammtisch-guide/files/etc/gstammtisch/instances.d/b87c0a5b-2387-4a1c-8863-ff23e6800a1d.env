# DLC-map server ("DCHIVE Stammtisch DLC", DLC_Level01_Main) — the running
# production instance.
#
# Chosen as the cluster MAIN (SOULMASK.md §9): it already holds the
# established world/players in world.db/account.db; making the *new*
# base-map server the main would make the established DLC world's
# reachability depend on the new instance's uptime instead. Prefer keeping
# the existing DLC server as main; the new base-map server becomes the
# client (see the commented example in this same directory).
ROLE=main

# Opt into the unified shared tmpfs ramdisk (soulmask_tmpfs.service). All
# byte-identical install content (Engine, WS/Binaries, WS/Content/Paks,
# Steam, steamclient, steamcmd, steamapps — see
# /etc/gstammtisch/soulmask_tmpfs-paths.conf) is served from ONE shared
# tmpfs, bind-mounted into this instance -- including onto its own
# directory, which is what lets it share pages with other TMPFS=1
# instances rather than each holding a separate copy.
#
# 2026-07-31: was briefly disabled here (see git history) because the
# tmpfs's read-only remount is incompatible with Wings' unconditional
# pre-boot chown (EROFS) on an instance bind-mounted onto its own
# directory. Fixed by running the tmpfs read-write instead
# (SOULMASK_TMPFS_READONLY=0 in soulmask_tmpfs.service) rather than
# excluding this instance — see that file's comment and SOULMASK-TMPFS.md
# for the tradeoff accepted.
TMPFS=1

# SOULMASK_MIN / SOULMASK_LOW / SOULMASK_HIGH / SOULMASK_WRITEBACK: not
# overridden here — this instance uses the values from
# /etc/gstammtisch/instance-defaults.env (the production band they were
# calibrated for).
