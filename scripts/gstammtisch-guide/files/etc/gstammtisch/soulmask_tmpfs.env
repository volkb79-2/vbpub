# /etc/gstammtisch/soulmask_tmpfs.env — SINGLE source of the per-instance log
# tmpfs policy (SMT-01). Read via EnvironmentFile= by BOTH soulmask_tmpfs.service
# (setup) and soulmask-logs-prune.service (the 10-minute prune timer), so the two
# can never run different policies. Also sourceable by hand:
#   set -a; . /etc/gstammtisch/soulmask_tmpfs.env; set +a
# The scripts have NO defaults for these: a missing or invalid value is refused.
# Plain KEY=value lines only (systemd EnvironmentFile syntax).

# Cap of EACH per-instance tmpfs. Positive integer + optional k/m/g suffix
# (0 means UNLIMITED to tmpfs and percentages are relative to RAM: both refused).
# Sizing: a game log is ~66 MB. Steady state = live + KEEP_BACKUPS backups
# = 66 + 3*66 = ~264 MB (52% of 512M); the transient right after a restart (the
# old live log has become one more backup, before the next prune pass) is
# 4 backups + the new live log = ~330 MB (64%), still under the high-water mark
# (384 MB). Logs up to ~90 MB still fit. Worst case the pages count against the
# game cgroup's memory.max (12 GiB, ~4.5 GiB used): <= 0.5 GiB per instance,
# swappable (zswap-eligible) under [per-instance-compressible].
SOULMASK_TMPFS_PER_INSTANCE_SIZE=512M

# Keep the newest N WS-backup-*.log files (by mtime). 3 so the log of the
# session that crashed survives a few quick restart attempts (each restart
# renames the live log to another backup). More than 3 restarts inside one
# 10-minute prune window can still evict it: copy the evidence out first.
SOULMASK_TMPFS_PER_INSTANCE_KEEP_BACKUPS=3

# Delete the oldest remaining backups while usage is above this percent of the
# tmpfs. Integer 1..99.
SOULMASK_TMPFS_PER_INSTANCE_HIGH_WATER_PCT=75
