From 0e983c4263362566bc11cbfed6741f436dd9e12f Mon Sep 17 00:00:00 2001
From: TrueNAS Patch Series <patchseries@vbpub.invalid>
Date: Fri, 30 Oct 2026 00:00:00 +0000
Subject: [PATCH] Route container storage through the user-data namespace

Keep container datasets, roots, image mounts, and lifecycle paths inside the selected user-data namespace.

Change-Id: container-user-data-storage
Capability: container-storage
Role: plumbing
Risk: medium
Requires: path-a-dataset-api
Forwarded: not-needed
---
 middlewared/plugins/container/container.py | 43 ++++++++++++++++++----
 middlewared/plugins/container/dataset.py   | 20 +++++++---
 middlewared/plugins/container/image.py     |  4 +-
 middlewared/plugins/container/lifecycle.py | 13 ++++---
 middlewared/plugins/container/utils.py     | 24 +++++++++++-
 5 files changed, 81 insertions(+), 23 deletions(-)

diff --git a/middlewared/plugins/container/container.py b/middlewared/plugins/container/container.py
index 574c7c10c6fa68a3420a00676fdb74eaaf9e6fc7..0ac8b4a778bd02be4579705b62731ce4331e91fe 100644
--- a/middlewared/plugins/container/container.py
+++ b/middlewared/plugins/container/container.py
@@ -22,6 +22,7 @@ from middlewared.api.current import (
     ZFSResourceSnapshotDestroyQuery,
 )
 from middlewared.plugins.zfs.exceptions import ZFSDestroyFailedException
+from middlewared.plugins.boot_pool_user_data import USER_DATASET_COMPONENT
 from middlewared.plugins.zfs.utils import get_encryption_info
 from middlewared.pylibvirt import gather_pylibvirt_domains_states, get_pylibvirt_domain_state
 from middlewared.service import CallError, CRUDService, job, private, ValidationError, ValidationErrors
@@ -459,20 +460,48 @@ class ContainerService(CRUDService):
         """
         pools = {}
         imported_pools = await self.middleware.run_in_thread(query_imported_fast_impl)
+        imported_pool_names = {pool['name'] for pool in imported_pools.values()}
+        boot_user_data_roots = {
+            f'{pool}/{USER_DATASET_COMPONENT}'
+            for pool in BOOT_POOL_NAME_VALID
+            if pool in imported_pool_names
+        }
+        paths = [
+            pool['name']
+            for pool in imported_pools.values()
+            if pool['name'] not in BOOT_POOL_NAME_VALID
+        ] + sorted(boot_user_data_roots)
+
         for ds in await self.call2(
             self.s.zfs.resource.query_impl,
             ZFSResourceQuery(
-                paths=[
-                    p['name']
-                    for p in imported_pools.values()
-                    if p['name'] not in BOOT_POOL_NAME_VALID
-                ],
-                properties=['encryption'],
+                paths=paths,
+                properties=['encryption', 'quota', 'mountpoint', 'canmount'],
             )
         ):
+            if ds['name'] in boot_user_data_roots:
+                properties = ds['properties']
+                quota = (properties.get('quota') or {}).get('value')
+                mountpoint = (properties.get('mountpoint') or {}).get('value')
+                canmount = (properties.get('canmount') or {}).get('value')
+                if (
+                    type(quota) is not int or quota <= 0
+                    or mountpoint != f"/mnt/{ds['name']}"
+                    or canmount != 'on'
+                ):
+                    continue
+                try:
+                    mounted = await self.middleware.call('filesystem.statfs', mountpoint)
+                except CallError as e:
+                    if e.errno == errno.ENOENT:
+                        continue
+                    raise
+                if mounted.get('source') != ds['name'] or mounted.get('dest') != mountpoint:
+                    continue
+
             enc = get_encryption_info(ds['properties'])
             if not enc.locked:
-                pools[ds['name']] = ds['name']
+                pools[ds['pool']] = ds['pool']
 
         return pools
 
