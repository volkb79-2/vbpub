 if TYPE_CHECKING:
@@ -12,6 +20,37 @@ if TYPE_CHECKING:
     from middlewared.service_exception import ValidationErrors
 
 
+async def _boot_pool_user_data_root_is_ready(middleware, root: str) -> bool:
+    if user_data_namespace_root(root, BOOT_POOL_NAME_VALID) != root:
+        return False
+
+    rows = await middleware.call2(
+        middleware.services.zfs.resource.query_impl,
+        ZFSResourceQuery(paths=[root], properties=['quota', 'mountpoint', 'canmount']),
+    )
+    if not rows:
+        return False
+
+    properties = rows[0]['properties']
+    quota = (properties.get('quota') or {}).get('value')
+    mountpoint = (properties.get('mountpoint') or {}).get('value')
+    canmount = (properties.get('canmount') or {}).get('value')
+    if (
+        type(quota) is not int or quota <= 0
+        or mountpoint != f'/mnt/{root}'
+        or canmount != 'on'
+    ):
+        return False
+
+    try:
+        mounted = await middleware.call('filesystem.statfs', mountpoint)
+    except CallError as e:
+        if e.errno == errno.ENOENT:
+            return False
+        raise
+    return mounted.get('source') == root and mounted.get('dest') == mountpoint
+
+
 async def check_path_resides_within_volume(
     verrors: ValidationErrors, middleware: Middleware, schema_name: str, path: str, must_be_dir: bool = False
 ) -> bool:
@@ -19,11 +58,49 @@ async def check_path_resides_within_volume(
     async wrapper around synchronous general-purpose path validation function
     """
     vol_names = [vol["vol_name"] for vol in await middleware.call("datastore.query", "storage.volume")]
-    return await middleware.run_in_thread(
+    resolved_path = os.path.realpath(path)
+    ready_user_data_roots = []
+    for pool in BOOT_POOL_NAME_VALID:
+        root = f"{pool}/{USER_DATASET_COMPONENT}"
+        mountpoint = f"/mnt/{root}"
+        try:
+            inside_root = os.path.commonpath((resolved_path, mountpoint)) == mountpoint
+        except ValueError:
+            inside_root = False
+        if inside_root and await _boot_pool_user_data_root_is_ready(middleware, root):
+            if root not in vol_names:
+                vol_names.append(root)
+            ready_user_data_roots.append(root)
+
+    await middleware.run_in_thread(
         check_path_resides_within_volume_sync,
         verrors, schema_name, path, vol_names, must_be_dir
     )
 
+    # Resolve the nearest existing ancestor so a missing leaf is checked against
+    # the ZFS dataset that will contain it. This keeps hidden service datasets
+    # below the boot-pool namespace unavailable to path-based consumers.
+    if ready_user_data_roots:
+        if any(
+            os.path.commonpath((resolved_path, f"/mnt/{root}")) == f"/mnt/{root}"
+            for root in ready_user_data_roots
+        ):
+            source_path = resolved_path
+            while not os.path.exists(source_path):
+                parent = os.path.dirname(source_path)
+                if parent == source_path:
+                    break
+                source_path = parent
+            statfs = await middleware.call('filesystem.statfs', source_path)
+            source = statfs.get('source') or ''
+            source_root = user_data_namespace_root(source, BOOT_POOL_NAME_VALID)
+            from middlewared.plugins.pool_.dataset_query_utils import INTERNAL_DATASETS
+
+            if source_root not in ready_user_data_roots:
+                verrors.add(schema_name, 'Path does not resolve to a boot-pool user-data dataset.')
+            elif not is_user_data_namespace_path(source, BOOT_POOL_NAME_VALID, INTERNAL_DATASETS):
+                verrors.add(schema_name, 'Path resolves to a system-managed boot-pool dataset.')
+
 
