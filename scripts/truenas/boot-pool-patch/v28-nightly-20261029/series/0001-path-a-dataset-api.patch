@@ -12,6 +22,33 @@ if TYPE_CHECKING:
     from middlewared.service_exception import ValidationErrors
 
 
+async def _boot_pool_user_data_root_is_ready(middleware, root: str) -> bool:
+    if user_data_namespace_root(root, BOOT_POOL_NAME_VALID) != root:
+        return False
+
+    rows = await middleware.call2(
+        middleware.services.zfs.resource.list_impl,
+        ZFSResourceQuery(paths=[root], properties=['quota', 'mountpoint', 'canmount']),
+    )
+    if not rows:
+        return False
+
+    properties = rows[0]['properties']
+    quota = (properties.get('quota') or {}).get('value')
+    mountpoint = (properties.get('mountpoint') or {}).get('value')
+    canmount = (properties.get('canmount') or {}).get('value')
+    if type(quota) is not int or quota <= 0 or mountpoint != f'/mnt/{root}' or canmount != 'on':
+        return False
+
+    try:
+        mounted = await middleware.call('filesystem.statfs', mountpoint)
+    except CallError as e:
+        if e.errno == errno.ENOENT:
+            return False
+        raise
+    return statfs_field(mounted, 'source') == root and statfs_field(mounted, 'dest') == mountpoint
+
