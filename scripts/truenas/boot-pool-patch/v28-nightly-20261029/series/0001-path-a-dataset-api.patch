@@ -19,11 +56,43 @@ async def check_path_resides_within_volume(
     async wrapper around synchronous general-purpose path validation function
     """
     vol_names = [vol["vol_name"] for vol in await middleware.call("datastore.query", "storage.volume")]
-    return await middleware.run_in_thread(
+    resolved_path = os.path.realpath(path)
+    ready_user_data_roots = []
+    for pool in BOOT_POOL_NAME_VALID:
+        root = f"{pool}/{USER_DATASET_COMPONENT}"
+        mountpoint = f"/mnt/{root}"
+        try:
+            inside_root = os.path.commonpath((resolved_path, mountpoint)) == mountpoint
+        except ValueError:
+            inside_root = False
+        if inside_root and await _boot_pool_user_data_root_is_ready(middleware, root):
+            if root not in vol_names:
+                vol_names.append(root)
+            ready_user_data_roots.append(root)
+
+    await middleware.run_in_thread(
         check_path_resides_within_volume_sync,
         verrors, schema_name, path, vol_names, must_be_dir
     )
 
+    if any(
+        os.path.commonpath((resolved_path, f"/mnt/{root}")) == f"/mnt/{root}"
+        for root in ready_user_data_roots
+    ):
+        source_path = resolved_path
+        while not os.path.exists(source_path):
+            parent = os.path.dirname(source_path)
+            if parent == source_path:
+                break
+            source_path = parent
+        statfs = await middleware.call('filesystem.statfs', source_path)
+        source = statfs_field(statfs, 'source') or ''
+        source_root = user_data_namespace_root(source, BOOT_POOL_NAME_VALID)
+        if source_root not in ready_user_data_roots:
+            verrors.add(schema_name, 'Path does not resolve to a boot-pool user-data dataset.')
+        elif not is_user_data_namespace_path(source, BOOT_POOL_NAME_VALID, INTERNAL_PATHS):
+            verrors.add(schema_name, 'Path resolves to a system-managed boot-pool dataset.')
+
 
