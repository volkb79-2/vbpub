         for device in container.devices
@@ -161,7 +163,7 @@ def pylibvirt_container(
 
     dataset = data.pop("dataset")
     pool = dataset.split("/")[0]
-    data["root"] = f"/mnt/{container_instance_dataset_mountpoint(pool, data['name'])}"
