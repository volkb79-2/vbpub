diff --git a/middlewared/plugins/container/utils.py b/middlewared/plugins/container/utils.py
index ee9b24e5e07e9e656b092e438d9e1752eaceb30a..00c11f713c8e886c0710e01fe7c7c8a62ac6a124 100644
--- a/middlewared/plugins/container/utils.py
+++ b/middlewared/plugins/container/utils.py
@@ -1,5 +1,11 @@
 import os
 
+from middlewared.plugins.boot_pool_user_data import (
+    CONTAINER_DS_NAME as _CONTAINER_DS_NAME, USER_DATASET_COMPONENT,
+    container_instance_real_path as _container_instance_real_path,
+    container_mountpoint_property, container_mountpoint_real_path as _container_mountpoint_real_path,
+)
+from middlewared.utils.boot.pool import BOOT_POOL_NAME_VALID
 from truenas_os_pyutils.io import atomic_write
 
 __all__ = (
@@ -7,21 +13,24 @@ __all__ = (
     "container_dataset",
     "container_dataset_mountpoint",
     "container_instance_dataset_mountpoint",
+    "container_dataset_real_path",
+    "container_instance_real_path",
     "update_etc_hosts",
     "write_etc_hostname",
 )
 
-CONTAINER_DS_NAME = ".truenas_containers"
+CONTAINER_DS_NAME = _CONTAINER_DS_NAME
 
 
 def container_dataset(pool: str) -> str:
     """Returns the ZFS filesystem path for containers in `pool`."""
-    return f"{pool}/{CONTAINER_DS_NAME}"
+    parent = f"{pool}/{USER_DATASET_COMPONENT}" if pool in BOOT_POOL_NAME_VALID else pool
+    return f"{parent}/{CONTAINER_DS_NAME}"
 
 
 def container_dataset_mountpoint(pool: str) -> str:
     """Returns the mount point for the container filesystem."""
-    return f"/{CONTAINER_DS_NAME}/{pool}"
+    return container_mountpoint_property(pool, BOOT_POOL_NAME_VALID, CONTAINER_DS_NAME)
 
 
 def container_instance_dataset_mountpoint(pool: str, container_name: str) -> str:
@@ -29,6 +38,18 @@ def container_instance_dataset_mountpoint(pool: str, container_name: str) -> str
     return f"{container_dataset_mountpoint(pool)}/containers/{container_name}"
 
 
+def container_dataset_real_path(pool: str) -> str:
+    """Return the host-visible path for this pool's container dataset."""
+    return _container_mountpoint_real_path(pool, BOOT_POOL_NAME_VALID, CONTAINER_DS_NAME)
+
+
+def container_instance_real_path(pool: str, container_name: str) -> str:
+    """Return the host-visible rootfs path for one managed container."""
+    return _container_instance_real_path(
+        pool, container_name, BOOT_POOL_NAME_VALID, CONTAINER_DS_NAME
+    )
+
+
 def write_etc_hostname(rootfs: str, name: str) -> None:
     with atomic_write(os.path.join(rootfs, 'etc/hostname'), 'w') as f:
         f.write(f'{name}\n')
