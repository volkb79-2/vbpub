From e22e47f5907c44fddab10698ff6922d968de4f34 Mon Sep 17 00:00:00 2001
From: TrueNAS Patch Series <patchseries@vbpub.invalid>
Date: Fri, 30 Oct 2026 00:00:00 +0000
Subject: [PATCH] Route container storage through the user-data namespace

Keep container datasets, roots, image mounts, and lifecycle paths inside the selected user-data namespace.

Change-Id: container-user-data-storage
Capability: container-storage
Role: plumbing
Risk: medium
Requires: path-a-dataset-api
Forwarded: not-needed
---
 middlewared/plugins/container/crud.py         |  1 +
 middlewared/plugins/container/dataset.py      | 23 ++++----
 middlewared/plugins/container/info.py         | 53 +++++++++++++++----
 middlewared/plugins/container/lifecycle.py    | 12 +++--
 .../plugins/container/query_pull_images.py    |  4 +-
 middlewared/plugins/container/utils.py        | 27 ++++++++--
 6 files changed, 89 insertions(+), 31 deletions(-)

diff --git a/middlewared/plugins/container/crud.py b/middlewared/plugins/container/crud.py
index fd9735137bf949644e4598471a166f1f54870d07..8dd26d829a45ca342373d7845525889c2ce2e964 100644
--- a/middlewared/plugins/container/crud.py
+++ b/middlewared/plugins/container/crud.py
@@ -220,6 +220,7 @@ class ContainerServicePart(CRUDServicePart[ContainerEntry]):
                 self.s.zfs.resource.snapshot.clone,
                 ZFSResourceSnapshotCloneArgsData(snapshot=image_snapshot, dataset=dataset, bypass=True),  # noqa
             )
+            await self.call2(self.s.zfs.resource.mount, dataset)
         else:
             # The container is on the different pool. Let's replicate the image.
             source_dataset, source_snapshot = image_snapshot.split('@', 1)  # noqa
diff --git a/middlewared/plugins/container/dataset.py b/middlewared/plugins/container/dataset.py
index 3cc9964fd91915ae177a9a09be2df109960c148e..36f91ffee4da9f33874ab1ca11ea76040f455535 100644
--- a/middlewared/plugins/container/dataset.py
+++ b/middlewared/plugins/container/dataset.py
@@ -6,12 +6,14 @@ from middlewared.utils.filesystem.perms import enforce_dir_perms
 
 from .utils import CONTAINER_DS_NAME, container_dataset, container_dataset_mountpoint
 
-CONTAINER_DS_PARENT_DIR = f"/mnt/{CONTAINER_DS_NAME}"
-
-
 async def ensure_datasets(context: ServiceContext, pool: str) -> None:
     main_dataset = container_dataset(pool)
     main_dataset_mountpoint = container_dataset_mountpoint(pool)
+    effective_main_dataset_mountpoint = (
+        main_dataset_mountpoint
+        if main_dataset_mountpoint.startswith("/mnt/")
+        else f"/mnt{main_dataset_mountpoint}"
+    )
 
     datasets = [f"{main_dataset}/containers", f"{main_dataset}/images"]
 
@@ -23,10 +25,9 @@ async def ensure_datasets(context: ServiceContext, pool: str) -> None:
             raise CallError(f"Expected dataset {dataset['name']!r} to be FILESYSTEM, but it is {dataset['type']}")
 
         if dataset["name"] == main_dataset:
-            main_dataset_mountpoint_value = f"/mnt{main_dataset_mountpoint}"
-            if dataset["properties"]["mountpoint"]["value"] != main_dataset_mountpoint_value:
+            if dataset["properties"]["mountpoint"]["value"] != effective_main_dataset_mountpoint:
                 raise CallError(
-                    f"Expected dataset {dataset['name']} to have mountpoint of {main_dataset_mountpoint_value!r}, "
+                    f"Expected dataset {dataset['name']} to have mountpoint of {effective_main_dataset_mountpoint!r}, "
                     f"but it is {dataset['properties']['mountpoint']['value']!r}."
                 )
 
@@ -47,7 +48,7 @@ async def ensure_datasets(context: ServiceContext, pool: str) -> None:
             ),
         )
 
-    if not await context.to_thread(os.path.ismount, f"/mnt{main_dataset_mountpoint}"):
+    if not await context.to_thread(os.path.ismount, effective_main_dataset_mountpoint):
         await context.call2(context.s.zfs.resource.mount, main_dataset)
 
     for ds_name in datasets:
@@ -57,7 +58,7 @@ async def ensure_datasets(context: ServiceContext, pool: str) -> None:
             )
         await context.call2(context.s.zfs.resource.mount, ds_name)
 
-    # ZFS auto-creates CONTAINER_DS_PARENT_DIR as a side effect of mounting the
-    # per-pool dataset. Restrict it so non-root host users can't traverse to
-    # any container's on-disk rootfs (UID-collision exposure for apps user etc.).
-    await context.to_thread(enforce_dir_perms, CONTAINER_DS_PARENT_DIR)
+    # ZFS creates the mountpoint's parent as a side effect of mounting the
+    # per-pool dataset. Restrict it so non-root host users cannot traverse to
+    # any container's on-disk rootfs (UID-collision exposure for apps users).
+    await context.to_thread(enforce_dir_perms, os.path.dirname(effective_main_dataset_mountpoint))
diff --git a/middlewared/plugins/container/info.py b/middlewared/plugins/container/info.py
index d04d183336ec6022a763fe27a8b07c64b142b986..70f5f0dab999c269aa7eb15b0745ececbae9845e 100644
--- a/middlewared/plugins/container/info.py
+++ b/middlewared/plugins/container/info.py
@@ -1,8 +1,14 @@
+import errno
+
 from truenas_pylicensed.features import LicenseFeature
 
 from middlewared.api.current import ZFSResourceQuery
-from middlewared.plugins.zfs.utils import get_encryption_info
+from middlewared.plugins.boot_pool_user_data import (
+    USER_DATASET_COMPONENT, is_user_data_namespace_path, statfs_field,
+)
+from middlewared.plugins.zfs.utils import get_encryption_info, INTERNAL_PATHS
 from middlewared.service import ServiceContext
+from middlewared.service_exception import CallError
 from middlewared.utils.boot.pool import BOOT_POOL_NAME_VALID
 from middlewared.utils.zfs import query_imported_fast_impl
 
@@ -17,19 +23,46 @@ async def license_active(context: ServiceContext) -> bool:
 async def pool_choices(context: ServiceContext) -> dict[str, str]:
     pools = {}
     imported_pools = await context.to_thread(query_imported_fast_impl)
+    boot_user_data_roots = {
+        f"{pool}/{USER_DATASET_COMPONENT}": pool
+        for pool in BOOT_POOL_NAME_VALID
+        if pool in {row['name'] for row in imported_pools.values()}
+    }
+    paths = [
+        pool['name']
+        for pool in imported_pools.values()
+        if pool['name'] not in BOOT_POOL_NAME_VALID
+    ] + sorted(boot_user_data_roots)
+
     for ds in await context.call2(
         context.s.zfs.resource.list_impl,
-        ZFSResourceQuery(
-            paths=[
-                p['name']
-                for p in imported_pools.values()
-                if p['name'] not in BOOT_POOL_NAME_VALID
-            ],
-            properties=['encryption'],
-        )
+        ZFSResourceQuery(paths=paths, properties=['encryption', 'quota', 'mountpoint', 'canmount']),
     ):
+        pool_name = boot_user_data_roots.get(ds['name'], ds['name'])
+        if ds['name'] in boot_user_data_roots:
+            if not is_user_data_namespace_path(ds['name'], BOOT_POOL_NAME_VALID, INTERNAL_PATHS):
+                continue
+            properties = ds['properties']
+            quota = (properties.get('quota') or {}).get('value')
+            mountpoint = (properties.get('mountpoint') or {}).get('value')
+            canmount = (properties.get('canmount') or {}).get('value')
+            if (
+                type(quota) is not int or quota <= 0
+                or mountpoint != f"/mnt/{ds['name']}"
+                or canmount != 'on'
+            ):
+                continue
+            try:
+                mounted = await context.middleware.call('filesystem.statfs', mountpoint)
+            except CallError as e:
+                if e.errno == errno.ENOENT:
+                    continue
+                raise
+            if statfs_field(mounted, 'source') != ds['name'] or statfs_field(mounted, 'dest') != mountpoint:
+                continue
+
         enc = get_encryption_info(ds['properties'])
         if not enc.locked:
-            pools[ds['name']] = ds['name']
+            pools[pool_name] = pool_name
 
     return pools
