+    # Boot-pool relaxation (Path A): the web UI gates the Shares, Storage and
+    # Data Protection pages on a non-empty `pool.query`. Boot-pool is never a
+    # `storage.volume` row, so externally originated queries (websocket/REST/
+    # midclt, i.e. `app` is set) additionally see ONE read-only synthetic
+    # boot-pool row while the user-data root is mounted. Internal callers
+    # (`app is None`, including pool.get_instance and every middleware.call)
+    # never see it. Its id is 0, which is not a datastore id, so every pool.*
+    # mutation that resolves the pool by id refuses it ("does not exist").
+    # The row is cached for a few seconds because the UI polls pool.query; it is
+    # not part of pool.query events/subscriptions.
+    BOOT_USER_DATA_MOUNT = '/mnt/boot-pool/user-data'
+    _boot_pool_row = (0.0, None)
+
+    async def _synthetic_boot_pool_row(self):
+        now = time.monotonic()
+        expires, row = self._boot_pool_row
+        if now < expires:
+            return row
+        row = None
+        try:
+            info = await self.middleware.call('pool.pool_normalize_info', 'boot-pool')
+            proc = await asyncio.create_subprocess_exec(
+                'zpool', 'get', '-H', '-o', 'value', 'guid', 'boot-pool',
+                stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL,
+            )
+            guid = (await asyncio.wait_for(proc.communicate(), timeout=10))[0].decode().strip()
+            if not guid.isdigit():
+                raise CallError('boot-pool guid is unavailable')
+            row = info | {'id': 0, 'guid': guid, 'all_sed': False}
+        except Exception:
+            self.logger.warning('Could not build the synthetic boot-pool row', exc_info=True)
+        PoolService._boot_pool_row = (now + 5, row)
+        return row
+
+    @filterable_api_method(item=PoolEntry, roles=['POOL_READ'], pass_app=True)
+    async def query(self, app, filters, options):
+        options = dict(options or {})
+        rows = await super().query([], {'extra': options.get('extra') or {}})
+        if app is not None and await self.middleware.run_in_thread(os.path.ismount, self.BOOT_USER_DATA_MOUNT):
+            if not any(row['name'] == 'boot-pool' for row in rows):
+                if (row := await self._synthetic_boot_pool_row()) is not None:
+                    rows = rows + [row]
+        return await self.middleware.run_in_thread(filter_list, rows, filters or [], options)
