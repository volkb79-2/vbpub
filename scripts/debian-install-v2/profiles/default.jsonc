{
  // Follow the installer’s current Config() defaults on the selected channel.
  // Today this includes Docker, APT policy/automatic upgrades, journald,
  // zswap and memory tuning, cgroup2 flags, oomd, fstrim, and scheduled reboot
  // checks. Disk layout uses the default whole-disk plan (root fills its
  // allocation, 8 GiB raw iobench reservation) and swap_policy=on; swap
  // capacity is min(2x RAM, rounded 20% of disk), split into four parts.
  // Per-host credentials and SSH keys are always supplied separately.
  "schema_version": 1
}
