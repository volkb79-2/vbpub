+def resolve_testdev_sysfs_name(devname):
+    """Resolve a partition name to its parent disk for queue sysfs access."""
+    parents = glob.glob('/sys/block/*/' + devname)
+    if len(parents) > 1:
+        raise RuntimeError(f'ambiguous whole-disk parent for test device {devname}')
+    if parents:
+        return os.path.basename(os.path.dirname(parents[0]))
+    return devname
