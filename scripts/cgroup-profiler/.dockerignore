# Keep the build context to what the image actually needs (Dockerfile only
# COPYs cgprofile.py, lib/, docs/, cgprofile, requirements.txt) — everything
# below is test/gate/dev-only state that must never end up baked into
# `cgprofile:local`.
.git
.gitignore
.coverage
.hypothesis
.pytest_cache
.run-gate
.assay
__pycache__
**/__pycache__
*.pyc
venv/
runs/
tests/
nyxloom-trove/
examples/
tools/
run-gate.py
run-gate.toml
assay.toml
setup.sh
pyproject.toml
README.md
DESIGN.md
ATTACH-GUIDE.md
