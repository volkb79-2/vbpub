# cgpd.service: the native cgprofile daemon unit.
# Template shipped inside the cgprofile wheel; `cgpd unit print` renders it
# (package 3). @INSTALL_ROOT@ is the only substituted token (default
# /opt/cgprofile). Values are the NATIVE-DEPLOYMENT.md section 4.2 proposals.
[Unit]
Description=cgprofile resource-profiling daemon
After=local-fs.target

[Service]
Type=simple
ExecStart=@INSTALL_ROOT@/current/venv/bin/cgpd run
ExecReload=/bin/kill -HUP $MAINPID
Slice=cgprofile.slice
User=root
MemoryHigh=512M
MemoryMax=768M
MemorySwapMax=0
CPUQuota=50%
TasksMax=256
IOWeight=50
LimitNOFILE=4096
Restart=on-failure
RestartSec=2s
TimeoutStopSec=20s
KillMode=mixed
PrivateNetwork=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/cgprofile /var/lib/cgprofile /sys/fs/cgroup /sys/kernel/mm/damon
StateDirectory=cgprofile
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
