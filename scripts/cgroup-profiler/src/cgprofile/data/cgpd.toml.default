# /etc/cgprofile/cgpd.toml: cgpd configuration (CGPCTL-SPEC.md section 3.2).
# Shipped inside the cgprofile wheel as the documented default; every key is
# commented out because an absent file means exactly these defaults.
#
# Fixed (restart required):
# sessions_dir     = "/var/lib/cgprofile/sessions"
# ctl_socket       = "/run/cgprofile/ctl.sock"
# observer_socket  = "/run/cgprofile/observer/resource-observer.sock"
# damon_lock       = "/run/cgprofile/damon.lock"
# proc_root        = "/proc"
# busctl           = "busctl"
#
# Reloadable (systemctl reload cgpd); the ones marked [tunable] can also be
# changed live by uid 0 with `cgpctl config set` (section 3.5):
# export_max_bytes = 268435456   # [tunable]
# max_exports      = 4           # [tunable]
# max_watchers     = 32          # [tunable]
# interval         = 1.0         # [tunable]
# damon_default    = "on"        # [tunable]
# keep_sessions    = 200         # [tunable]
# keep_days        = 14          # [tunable]
# max_sessions     = 16          # [tunable]
# observe_slices   = []
# gates_slice      = "dev-gates.slice"
# allow_uids       = []          # [tunable]
