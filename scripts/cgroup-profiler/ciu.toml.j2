# cgprofile — sparse, committed per-stack override. The managed cockpit uses
# the published RG-55 1.0.0 image. For local development, clear this image
# table before `ciu up` after building `cgprofile:local`; see
# docs/CONSUMERS.md#deploy-a-published-daemon-image-with-ciu.
[cgprofile.image]
registry = "ghcr.io"
namespace = "volkb79-2"
name = "cgprofile"
tag = "1.0.0"

# Local operators may also override daemon settings, for example:
# [cgprofile.daemon]
# interval = "0.5"

[state]
initialized = false
