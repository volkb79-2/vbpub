# Before the first CMRU release, leave the sparse override empty so CIU uses
# the local `cgprofile:local` default. Add a published image pin here only
# after CMRU has published that exact release tag; see
# docs/CONSUMERS.md#deploy-a-published-daemon-image-with-ciu.

# Local operators may also override daemon settings, for example:
# [cgprofile.daemon]
# interval = "0.5"

[state]
initialized = false
