#!/usr/bin/env bash
# dr-state: PoC tool for OS states on a flat btrfs layout (see install-btrfs.sh).
#
#   dr-state install-grub                 build the ESP GRUB image (no Secure Boot yet)
#   dr-state install-systemd-boot         install systemd-boot on the ESP (no EFI variables)
#   dr-state gen-menu [--state S] [--default S]
#   dr-state snapshot [--reason WORD] [--note TEXT] writable copy of the running state, menu refreshed
#   dr-state list [--long]
#   dr-state show STATE
#   dr-state set-default STATE            "make permanent"
#   dr-state boot-once STATE              next boot only
#   dr-state delete STATE [--dry-run|--yes] remove one inactive OS state
#   dr-state prune [--keep N] [--dry-run]  retain the newest N snapshots
#
# Facts it relies on: every state is a top-level subvolume named @os-*; the top
# level (subvolid 5) is mounted at /.top (fstab); the ESP is at /boot/efi.
# BOOTLOADER=grub (the default) keeps the GRUB menu and environment in EFI/dr/.
# BOOTLOADER=systemd-boot keeps one BLS entry per state in /loader/entries/ and
# content-addressed kernel pairs in EFI/dr/kernels/ on the ESP.
set -euo pipefail

die() { echo "dr-state: $*" >&2; exit 1; }

BOOT_ESP=/boot/efi
TOP=/.top
DR_STATE_CONF=/etc/dr-state.conf
DR_STATE_FSTAB=/etc/fstab
DR_STATE_LOCK=/run/dr-state.lock
SDBOOT_EFIVARS_DIR=/sys/firmware/efi/efivars
TEST_MODE=0
case "${DR_STATE_TEST_MODE:-}" in
  '')
    [ -z "${DR_STATE_TEST_ROOT:-}" ] \
      || die "DR_STATE_TEST_ROOT is only allowed with DR_STATE_TEST_MODE=1"
    ;;
  1)
    TEST_ROOT=${DR_STATE_TEST_ROOT:-}
    [ -n "$TEST_ROOT" ] || die "DR_STATE_TEST_MODE=1 requires DR_STATE_TEST_ROOT"
    case "$TEST_ROOT" in /*) ;; *) die "DR_STATE_TEST_ROOT must be an absolute path" ;; esac
    [ -d "$TEST_ROOT" ] || die "DR_STATE_TEST_ROOT '$TEST_ROOT' is not a directory"
    TEST_MODE=1
    BOOT_ESP=$TEST_ROOT/esp
    TOP=$TEST_ROOT/top
    DR_STATE_CONF=$TEST_ROOT/etc/dr-state.conf
    DR_STATE_FSTAB=$TEST_ROOT/etc/fstab
    DR_STATE_LOCK=$TEST_ROOT/run/dr-state.lock
    SDBOOT_EFIVARS_DIR=$TEST_ROOT/sys/firmware/efi/efivars
    ;;
  *) die "DR_STATE_TEST_MODE must be 1 when set" ;;
esac
case "${DR_STATE_TEST_FAIL_STEP:-}" in
  '') ;;
  *) [ "$TEST_MODE" = 1 ] \
      || die "DR_STATE_TEST_FAIL_STEP is only allowed with DR_STATE_TEST_MODE=1" ;;
esac

ESP_DIR=$BOOT_ESP/EFI/dr
SDBOOT_MARKER=$ESP_DIR/bootloader
SDBOOT_KERNEL_DIR=$ESP_DIR/kernels
SDBOOT_ENTRY_DIR=$BOOT_ESP/loader/entries
SDBOOT_LOADER_CONF=$BOOT_ESP/loader/loader.conf
SDBOOT_ENTRY_MARKER='# generated by dr-state sdboot; do not edit'
SDBOOT_ENTRY_TMP_NAME=.dr-state-entry.new
SDBOOT_ONESHOT_EFIVAR=$SDBOOT_EFIVARS_DIR/LoaderEntryOneShot-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
STATE_EXCLUDE="" # scoped to delete's menu publication, before the matching subvolume is removed

sdboot_test_failure() { # STEP: deterministic interruption fixture, inert outside the test root
  [ "$TEST_MODE" = 1 ] || return 0
  [ -n "${DR_STATE_TEST_FAIL_STEP:-}" ] || return 0
  [ "$DR_STATE_TEST_FAIL_STEP" = "$1" ] || return 0
  die "injected failure at $1"
}

root_uuid() { awk '$2=="/" && $3=="btrfs" {sub("UUID=","",$1); print $1; exit}' "$DR_STATE_FSTAB"; }

sdboot_source_value() { # LABEL PRESENT VALUE -> VALUE; refuse an existing but empty source
  local label=$1 present=$2 value=${3-}
  case "$present" in
    0)
      [ -z "$value" ] || die "$label is absent but produced a value"
      ;;
    1)
      [ -n "$value" ] || die "$label is present but empty; refusing to guess the bootloader backend"
      ;;
    *) die "$label has invalid presence state '$present'" ;;
  esac
  [ -z "$value" ] || printf '%s\n' "$value"
}

bootloader_from_conf_file() {
  local file=$1 line value="" found=0
  [ -e "$file" ] || { sdboot_source_value BOOTLOADER 0 ""; return 0; }
  [ -r "$file" ] || die "$file is not readable"
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}
    case "$line" in
      ''|'#'*) continue ;;
      BOOTLOADER=*)
        [ "$found" = 0 ] || die "$DR_STATE_CONF sets BOOTLOADER more than once"
        value=${line#BOOTLOADER=}
        found=1 ;;
      [A-Z_][A-Z0-9_]*=*) ;;
      *) die "$file contains a line that is not KEY=VALUE or a comment" ;;
    esac
  done <"$file"
  sdboot_source_value BOOTLOADER "$found" "$value"
}

bootloader_from_conf() {
  bootloader_from_conf_file "$DR_STATE_CONF"
}

bootloader_from_marker_file() {
  local file=$1 marker
  [ -e "$file" ] || { sdboot_source_value "$file bootloader marker" 0 ""; return 0; }
  [ -r "$file" ] || die "$file is not readable"
  marker=$(tr -d '\r\n' <"$file") || die "cannot read $file"
  sdboot_source_value "$file bootloader marker" 1 "$marker"
}

bootloader_from_marker() {
  bootloader_from_marker_file "$SDBOOT_MARKER"
}

select_bootloader() { # CONF_VALUE MARKER_VALUE -> one backend; only absence means the GRUB default
  local conf=$1 marker=$2
  [ -z "$conf" ] || [ -z "$marker" ] || [ "$conf" = "$marker" ] \
    || die "BOOTLOADER=$conf in $DR_STATE_CONF conflicts with $SDBOOT_MARKER ($marker)"
  if [ -z "$conf" ]; then conf=$marker; fi
  if [ -z "$conf" ]; then conf=grub; fi
  case "$conf" in grub|systemd-boot) printf '%s\n' "$conf" ;; *) die "unknown BOOTLOADER '$conf'" ;; esac
}

bootloader() {
  local conf marker
  conf=$(bootloader_from_conf) || return $?
  marker=$(bootloader_from_marker) || return $?
  select_bootloader "$conf" "$marker"
}

ensure_top() {
  if [ "$TEST_MODE" = 1 ]; then
    [ -d "$TOP" ] || die "test root has no $TOP directory"
  else
    mountpoint -q "$TOP" || mount "$TOP" || die "cannot mount $TOP (fstab entry missing?)"
  fi
}

ensure_esp() {
  if [ "$TEST_MODE" = 1 ]; then
    [ -d "$BOOT_ESP" ] || die "test root has no $BOOT_ESP directory"
  else
    mountpoint -q "$BOOT_ESP" || die "$BOOT_ESP is not mounted (refusing to write the boot menu into the state)"
  fi
}

current_state() {
  local s
  s=$(tr ' ' '\n' </proc/cmdline | sed -n 's/^rootflags=.*subvol=\([^,]*\).*/\1/p' | head -n1)
  [ -n "$s" ] || s=${DR_STATE:-}
  [ -n "$s" ] || die "cannot tell the running state (no rootflags=subvol= on the command line; set DR_STATE=<state>, or DR_STATE=none to skip the snapshot)"
  echo "$s"
}

state_has_conf_suffix() {
  case "${1-}" in *.conf) return 0 ;; *) return 1 ;; esac
}

warn_conf_suffix_state() {
  echo "dr-state: skipping state $1: a state name that ends in .conf is not selectable" >&2
}

sdboot_states() {
  local state
  while IFS= read -r state; do
    if state_has_conf_suffix "$state"; then
      warn_conf_suffix_state "$state"
      continue
    fi
    printf '%s\n' "$state"
  done < <(states)
}

states() {
  local state
  while IFS= read -r state; do
    [ "$state" = "$STATE_EXCLUDE" ] || printf '%s\n' "$state"
  done < <(find "$TOP" -maxdepth 1 -name '@os-*' -printf '%f\n' | sort)
}

state_exists() { # exact top-level state-name membership; never interpolate caller text into a path first
  local wanted=$1 state
  while IFS= read -r state; do
    [ "$state" = "$wanted" ] && return 0
  done < <(states)
  return 1
}

latest_kernel() { # latest_kernel STATE -> newest version that has BOTH vmlinuz and initrd, empty if none
  local v
  for v in $(find "$TOP/$1/boot" -maxdepth 1 -name 'vmlinuz-*' -printf '%f\n' 2>/dev/null | sed 's/^vmlinuz-//' | sort -rV); do
    if [ -s "$TOP/$1/boot/vmlinuz-$v" ] && [ -s "$TOP/$1/boot/initrd.img-$v" ]; then
      echo "$v"
      return 0
    fi
  done
}

# systemd-boot's type #1 entry id is the complete file name, including .conf. Internally dr-state keeps the extension
# separate; @os-X maps reversibly to the basename os-X. Acceptance of '@' by systemd-boot was not verified offline,
# so the PoC does not rely on it. Unsafe names are refused rather than silently changed. Relative components and
# embedded '@' are rejected even though FAT would allow most of them.
entry_id_for_state() {
  local state=$1 id
  case "$state" in *.conf) return 1 ;; esac
  [[ "$state" =~ ^@os-[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || return 1
  case "$state" in *..*|*.) return 1 ;; esac
  id=${state#@}
  [ "${#id}" -le 240 ] || return 1
  printf '%s\n' "$id"
}

sdboot_bare_entry_id() { # ENTRY_ID[.conf] -> suffix-less basename used by dr-state state mapping
  local id=${1-}
  if [[ "$id" == *.conf ]]; then id=${id%.conf}; fi
  case "$id" in *.conf) return 1 ;; esac
  [[ "$id" =~ ^os-[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || return 1
  case "$id" in *..*|*.) return 1 ;; esac
  [ "${#id}" -le 240 ] || return 1
  printf '%s\n' "$id"
}

state_for_entry_id() {
  local id
  id=$(sdboot_bare_entry_id "${1-}") || return 1
  printf '@%s\n' "$id"
}

sdboot_entry_ids() { # STATE... -> one reversible id each; reject FAT case-insensitive collisions
  local state id folded
  local -a ids=()
  local -A by_fold=()
  for state in "$@"; do
    id=$(entry_id_for_state "$state") || return 1
    folded=${id,,}
    if [ -n "${by_fold[$folded]+x}" ]; then
      echo "dr-state: states ${by_fold[$folded]} and $state case-insensitively collide as entry id $folded on the vfat ESP" >&2
      return 1
    fi
    by_fold["$folded"]=$state
    ids+=("$id")
  done
  [ "${#ids[@]}" -eq 0 ] || printf '%s\n' "${ids[@]}"
}

kernel_id() {
  local kver=$1 sha256=$2
  [[ "$kver" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]] || return 1
  case "$kver" in *..*) return 1 ;; esac
  [[ "$sha256" =~ ^[0-9a-f]{64}$ ]] || return 1
  printf '%s-%s\n' "$kver" "${sha256:0:12}"
}

valid_kernel_id() {
  local id=$1
  [[ "$id" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*-[0-9a-f]{12}$ ]] || return 1
  case "$id" in *..*) return 1 ;; esac
}

sdboot_entry_text() { # sdboot_entry_text STATE KVER UUID KERNEL_ID
  local state=$1 kver=$2 uuid=$3 kid=$4 entry_id
  entry_id=$(entry_id_for_state "$state") || return 1
  [[ "$kver" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]] || return 1
  case "$kver" in *..*) return 1 ;; esac
  [[ "$uuid" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]] || return 1
  valid_kernel_id "$kid" || return 1
  [[ "$kid" == "$kver-"* ]] || return 1
  cat <<EOF
$SDBOOT_ENTRY_MARKER
title Debian $state (kernel $kver)
linux /EFI/dr/kernels/$kid/vmlinuz
initrd /EFI/dr/kernels/$kid/initrd.img
options root=UUID=$uuid rootflags=subvol=$state ro net.ifnames=0 console=tty0 console=ttyS0,115200
sort-key $entry_id
EOF
}

sdboot_entry_refs() { # BLS entries on stdin -> unique kernel ids referenced by every linux/initrd path
  local id
  {
    awk '
    { sub(/\r$/, "") }
    ($1 == "linux" || $1 == "initrd") {
      for (i = 2; i <= NF; i++) {
        path = $i
        n = split(path, part, "/")
        if (n == 6 && part[1] == "" && part[2] == "EFI" && part[3] == "dr" && part[4] == "kernels" \
            && (part[6] == "vmlinuz" || part[6] == "initrd.img")) {
          print part[5]
        }
      }
    }
  ' | while IFS= read -r id; do
      if valid_kernel_id "$id"; then printf '%s\n' "$id"; fi
    done
  } | sort -u
}

sdboot_orphan_kernels() { # EXISTING_CSV REFERENCED_CSV -> existing ids not referenced, preserving existing order
  local existing=$1 referenced=$2 id protection=",$2,"
  local -a ids
  if [ -n "$referenced" ]; then
    IFS=, read -r -a ids <<<"$referenced"
    for id in "${ids[@]}"; do valid_kernel_id "$id" || return 1; done
  fi
  if [ -n "$existing" ]; then
    IFS=, read -r -a ids <<<"$existing"
    for id in "${ids[@]}"; do
      valid_kernel_id "$id" || return 1
      case "$protection" in *",$id,"*) ;; *) printf '%s\n' "$id" ;; esac
    done
  fi
}

sdboot_space_check() { # NEEDED FREE; 0 if it fits, 1 if it does not, 2 for a malformed value
  local needed=$1 free=$2
  [[ "$needed" =~ ^[0-9]+$ ]] || { echo "dr-state: invalid needed-byte count '$needed'" >&2; return 2; }
  [[ "$free" =~ ^[0-9]+$ ]] || { echo "dr-state: invalid free-byte count '$free'" >&2; return 2; }
  if [ "$needed" -gt "$free" ]; then
    echo "dr-state: ESP has too little space: need $needed bytes, only $free bytes free" >&2
    return 1
  fi
  printf 'dr-state: ESP space ok: need %s bytes, %s bytes free\n' "$needed" "$free"
}

sdboot_byte_length() { # TEXT -> bytes, independent of the caller's locale
  local text=${1-}
  printf '%s' "$text" | LC_ALL=C wc -c | tr -d '[:space:]'
}

sdboot_loader_conf() { # DEFAULT_ID; existing loader.conf on stdin -> one default and timeout 5 plus unrelated lines
  local default_id
  [ -n "${1-}" ] || { echo "dr-state: loader.conf rewrite requires a default entry id" >&2; return 1; }
  default_id=$(sdboot_bare_entry_id "$1") || return 1
  awk -v default_id="$default_id" '
    BEGIN { bad = 0 }
    { sub(/\r$/, "") }
    $1 == "default" {
      if (NF != 2 || $2 !~ /^os-[A-Za-z0-9][A-Za-z0-9._-]*(\.conf)?$/) bad = 1
      next
    }
    $1 == "timeout" {
      if (NF != 2 || $2 !~ /^[0-9]+$/) bad = 1
      next
    }
    { print }
    END {
      if (bad) exit 2
      print "default " default_id ".conf"
      print "timeout 5"
    }
  ' || return 1
}

sdboot_selector_names_conf_state() { # selector value for the now-invalid state "@os-X.conf"
  [[ "${1-}" =~ ^os-[A-Za-z0-9][A-Za-z0-9._-]*\.conf\.conf$ ]]
}

loader_default_raw() {
  [ -e "$SDBOOT_LOADER_CONF" ] || return 0
  [ -r "$SDBOOT_LOADER_CONF" ] || die "$SDBOOT_LOADER_CONF is not readable"
  awk '{sub(/\r$/, ""); if ($1 == "default") {print $2; exit}}' "$SDBOOT_LOADER_CONF"
}

sdboot_loader_default_values() { # require a readable loader.conf with valid default(s); print each selector
  [ -f "$SDBOOT_LOADER_CONF" ] && [ -r "$SDBOOT_LOADER_CONF" ] || return 1
  awk '
    { sub(/\r$/, "") }
    $1 == "default" {
      if (NF != 2 || $2 !~ /^os-[A-Za-z0-9][A-Za-z0-9._-]*(\.conf)?$/) bad = 1
      else { print $2; defaults++ }
      next
    }
    $1 == "timeout" {
      if (NF != 2 || $2 !~ /^[0-9]+$/) bad = 1
      next
    }
    END {
      if (bad) exit 2
      if (!defaults) exit 3
    }
  ' "$SDBOOT_LOADER_CONF"
}

loader_default_id() {
  local id bare
  id=$(loader_default_raw)
  [ -n "$id" ] || return 0
  if bare=$(sdboot_bare_entry_id "$id"); then
    printf '%s\n' "$bare"
  elif sdboot_selector_names_conf_state "$id"; then
    echo "dr-state: ignoring loader.conf default '$id': the named state name ends in .conf and is not selectable" >&2
  else
    printf '%s\n' "$id"
  fi
}

bootctl_set_oneshot() { # the only place that writes the systemd-boot one-shot variable
  local id
  id=$(sdboot_bare_entry_id "${1-}") || return 1
  bootctl set-oneshot "$id.conf"
}

sdboot_oneshot_raw() {
  local raw
  [ -d "$SDBOOT_EFIVARS_DIR" ] \
    || { echo "dr-state: efivarfs is unavailable; the pending one-shot is unknown" >&2; return 2; }
  [ -e "$SDBOOT_ONESHOT_EFIVAR" ] || return 0
  [ -r "$SDBOOT_ONESHOT_EFIVAR" ] \
    || { echo "dr-state: cannot read LoaderEntryOneShot; the pending one-shot is unknown" >&2; return 2; }
  if ! raw=$(dd if="$SDBOOT_ONESHOT_EFIVAR" bs=1 skip=4 status=none 2>/dev/null \
    | iconv -f UTF-16LE -t UTF-8 2>/dev/null | tr -d '\000\r\n'); then
    echo "dr-state: cannot decode LoaderEntryOneShot; the pending one-shot is unknown" >&2
    return 2
  fi
  [ -n "$raw" ] || { echo "dr-state: LoaderEntryOneShot is empty; the pending one-shot is unknown" >&2; return 2; }
  printf '%s\n' "$raw"
}

sdboot_oneshot_id() {
  local id raw
  if ! raw=$(sdboot_oneshot_raw); then return 2; fi
  [ -n "$raw" ] || return 0
  if id=$(sdboot_bare_entry_id "$raw"); then
    printf '%s\n' "$id"
  elif sdboot_selector_names_conf_state "$raw"; then
    echo "dr-state: LoaderEntryOneShot '$raw' cannot be mapped safely; the pending one-shot is unknown" >&2
    return 2
  else
    echo "dr-state: LoaderEntryOneShot '$raw' is not a dr-state entry id; the pending one-shot is unknown" >&2
    return 2
  fi
}

sdboot_inventory_default_state() { # report only a selector that names an existing state; inventory remains usable otherwise
  local id state
  id=$(loader_default_id) || return 1
  [ -n "$id" ] || return 0
  state=$(state_for_entry_id "$id" 2>/dev/null) || state=""
  if [ -z "$state" ] || ! state_exists "$state"; then
    echo "dr-state: loader.conf default '$id' does not name an existing OS state; inventory continues without a default label" >&2
    return 0
  fi
  printf '%s\n' "$state"
}

sdboot_prune_selector_states() { # RAW_SELECTOR LABEL -> legacy states to protect, accepting suffix-less and suffixed forms
  local raw=${1-} label=$2 bare legacy state
  [ -n "$raw" ] || return 0
  if sdboot_selector_names_conf_state "$raw"; then
    legacy="@${raw%.conf}"
    echo "dr-state: protecting legacy $label state $legacy" >&2
    printf '%s\n' "$legacy"
    return 0
  fi
  bare=$(sdboot_bare_entry_id "$raw") || return 1
  state="@$bare"
  printf '%s\n' "$state"
  # Before the guest finding, a state "@os-X.conf" had entry file os-X.conf.conf while its writer emitted os-X.conf.
  # Protect that legacy state too when it exists, because the same selector is also canonical for valid state @os-X.
  if [[ "$raw" == *.conf ]]; then
    legacy="@$raw"
    if [ -d "$TOP/$legacy" ] && [ "$legacy" != "$state" ]; then
      echo "dr-state: protecting legacy $label state $legacy" >&2
      printf '%s\n' "$legacy"
    fi
  fi
}

cleanup_sdboot_scratch() { # KERNEL_DIR ENTRY_DIR LOADER_CONF MARKER; remove only interrupted dr-state temporaries
  local kernel_dir=$1 entry_dir=$2 loader_conf=$3 marker=$4
  local path base stem eid dir candidate suffix

  if [ -e "$kernel_dir" ] && [ ! -d "$kernel_dir" ]; then
    die "$kernel_dir exists but is not a directory"
  fi
  if [ -d "$kernel_dir" ]; then
    # copy_sdboot_kernel stages a complete pair in a top-level .tmp.* directory, then renames it.
    while IFS= read -r -d '' path; do
      base=${path##*/}
      [[ "$base" =~ ^\.tmp\.[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789]{6}$ ]] \
        || continue
      rm -rf -- "$path"
    done < <(find "$kernel_dir" -mindepth 1 -maxdepth 1 -type d -name '.tmp.*' -print0)
    # A repair stages two files inside an already published kernel directory.
    while IFS= read -r -d '' path; do
      base=${path##*/}
      dir=${path%/*}
      stem=${dir##*/}
      valid_kernel_id "$stem" || continue
      if [[ "$base" =~ ^\.vmlinuz\.tmp\.[0-9]+$ ]] || [[ "$base" =~ ^\.initrd\.img\.tmp\.[0-9]+$ ]]; then
        rm -f -- "$path"
      fi
    done < <(find "$kernel_dir" -mindepth 2 -maxdepth 2 -type f \
      \( -name '.vmlinuz.tmp.*' -o -name '.initrd.img.tmp.*' \) -print0)
  fi

  if [ -e "$entry_dir" ] && [ ! -d "$entry_dir" ]; then
    die "$entry_dir exists but is not a directory"
  fi
  if [ -d "$entry_dir" ]; then
    while IFS= read -r -d '' path; do
      base=${path##*/}
      if [[ "$base" =~ ^\.dr-state-entry\.new\.[0-9]+$ ]]; then
        rm -f -- "$path"
      elif [[ "$base" =~ ^\.(os-[A-Za-z0-9][A-Za-z0-9._-]*)\.conf\.new\.[0-9]+$ ]]; then
        eid=${BASH_REMATCH[1]}
        state_for_entry_id "$eid" >/dev/null || continue
        rm -f -- "$path"
      fi
    done < <(find "$entry_dir" -mindepth 1 -maxdepth 1 -type f \
      \( -name '.dr-state-entry.new.*' -o -name '.*.conf.new.*' \) -print0)
  fi

  for path in "$loader_conf" "$marker"; do
    dir=${path%/*}
    base=${path##*/}
    [ "$dir" != "$path" ] || continue
    [ -d "$dir" ] || continue
    while IFS= read -r -d '' stem; do
      candidate=${stem##*/}
      case "$candidate" in
        "$base.new."*)
          suffix=${candidate#"$base.new."}
          if [[ "$suffix" =~ ^[0-9]+$ ]]; then
            rm -f -- "$stem"
          fi
          ;;
      esac
    done < <(find "$dir" -mindepth 1 -maxdepth 1 -type f -name "$base.new.*" -print0)
  done
}

prune_sdboot_kernels() {
  local list path base id ids existing_csv="" refs_csv="" doomed
  local -a existing=() refs=()
  list=$(mktemp) || die "cannot create a temporary file for the ESP prune scan"
  find "$SDBOOT_KERNEL_DIR" -mindepth 1 -maxdepth 1 -type d -print0 >"$list" \
    || { rm -f -- "$list"; die "cannot list ESP kernel directories"; }
  while IFS= read -r -d '' path; do
    base=${path##*/}
    valid_kernel_id "$base" || continue
    existing+=("$base")
  done <"$list"
  if [ "${#existing[@]}" -gt 0 ]; then
    printf -v existing_csv '%s,' "${existing[@]}"
    existing_csv=${existing_csv%,}
  fi
  find "$SDBOOT_ENTRY_DIR" -maxdepth 1 -name '*.conf' -print0 >"$list" \
    || { rm -f -- "$list"; die "cannot list BLS entries for the ESP prune scan"; }
  while IFS= read -r -d '' path; do
    ids=$(sdboot_entry_refs <"$path") || die "cannot read kernel references from $path"
    while IFS= read -r id; do [ -z "$id" ] || refs+=("$id"); done <<<"$ids"
  done <"$list"
  rm -f -- "$list"
  if [ "${#refs[@]}" -gt 0 ]; then
    printf -v refs_csv '%s,' "${refs[@]}"
    refs_csv=${refs_csv%,}
  fi
  doomed=$(sdboot_orphan_kernels "$existing_csv" "$refs_csv") \
    || die "cannot determine which ESP kernel directories are unreferenced"
  for id in $doomed; do
    valid_kernel_id "$id" || die "refusing to delete an invalid ESP kernel id: $id"
    rm -rf -- "${SDBOOT_KERNEL_DIR:?}/$id"
    echo "deleted kernel $id"
  done
}

cmd_install_grub() {
  ensure_esp
  mkdir -p "$ESP_DIR" /boot/efi/EFI/BOOT
  # Standalone image whose prefix is the ESP directory, not a path inside a state.
  grub-mkimage -O x86_64-efi -o /boot/efi/EFI/BOOT/BOOTX64.EFI -p '(,gpt1)/EFI/dr' \
    part_gpt fat btrfs search search_fs_uuid normal linux configfile echo test ls \
    loadenv serial terminal efi_gop gzio
  [ -f "$ESP_DIR/grubenv" ] || grub-editenv "$ESP_DIR/grubenv" create
}

cmd_install_systemd_boot() {
  ensure_esp
  bootctl install --esp-path="$BOOT_ESP" --no-variables
  mkdir -p "$ESP_DIR" "$SDBOOT_KERNEL_DIR" "$SDBOOT_ENTRY_DIR"
  printf 'systemd-boot\n' >"$SDBOOT_MARKER.new.$$"
  mv "$SDBOOT_MARKER.new.$$" "$SDBOOT_MARKER"
  printf 'BOOTLOADER=systemd-boot\n' >"$DR_STATE_CONF.new.$$"
  mv "$DR_STATE_CONF.new.$$" "$DR_STATE_CONF"
}

sdboot_allocated_bytes() { # SIZE CLUSTER -> bytes after FAT allocation
  local size=$1 cluster=$2
  [[ "$size" =~ ^[0-9]+$ ]] || return 1
  [[ "$cluster" =~ ^[1-9][0-9]*$ ]] || return 1
  printf '%s\n' $(( ((size + cluster - 1) / cluster) * cluster ))
}

sdboot_allocated_sum() { # CLUSTER SIZE... -> sum of independently FAT-rounded sizes
  local cluster=$1 size total=0 bytes
  [[ "$cluster" =~ ^[1-9][0-9]*$ ]] || return 1
  shift
  for size in "$@"; do
    bytes=$(sdboot_allocated_bytes "$size" "$cluster") || return 1
    total=$((total + bytes))
  done
  printf '%s\n' "$total"
}

sdboot_dir_alloc() { # ROOT CLUSTER RELDIR... -> clusters needed for every missing directory, counted once
  local root=$1 cluster=$2 rel current part missing=0
  local IFS=/
  local -A seen=()
  [[ "$cluster" =~ ^[1-9][0-9]*$ ]] || return 1
  [ -d "$root" ] || return 1
  shift 2
  for rel in "$@"; do
    [[ "$rel" =~ ^[A-Za-z0-9._+-]+(/[A-Za-z0-9._+-]+)*$ ]] || return 1
    current=$root
    for part in $rel; do
      [ "$part" != . ] && [ "$part" != .. ] || return 1
      current=$current/$part
      if [ -n "${seen[$current]+x}" ]; then continue; fi
      if [ -d "$current" ]; then
        seen["$current"]=existing
      elif [ -e "$current" ]; then
        return 1
      else
        seen["$current"]=missing
        missing=$((missing + 1))
      fi
    done
  done
  printf '%s\n' $((missing * cluster))
}

sdboot_fat_record_estimate() { # CLUSTER CREATED_CHILDREN PARENT_DIRS -> conservative LFN directory-record bytes
  local cluster=$1 children=$2 parents=$3
  [[ "$cluster" =~ ^[1-9][0-9]*$ ]] || return 1
  [[ "$children" =~ ^[0-9]+$ ]] || return 1
  [[ "$parents" =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' $(( (2 * children + parents) * cluster ))
}

sdboot_file_allocated_bytes() { # FILE CLUSTER
  local path=$1 cluster=$2 size
  [ -s "$path" ] || return 1
  size=$(stat -c %s -- "$path") || return 1
  sdboot_allocated_bytes "$size" "$cluster"
}

esp_cluster_bytes() {
  local cluster
  if [ "$TEST_MODE" = 1 ] && [ -n "${DR_STATE_TEST_ESP_CLUSTER:-}" ]; then
    cluster=$DR_STATE_TEST_ESP_CLUSTER
  else
    cluster=$(stat -f -c %S "$BOOT_ESP") || die "cannot read the ESP block size"
  fi
  [[ "$cluster" =~ ^[1-9][0-9]*$ ]] || die "ESP block size '$cluster' is not a positive number"
  printf '%s\n' "$cluster"
}

esp_free_bytes() {
  local free
  if [ "$TEST_MODE" = 1 ] && [ -n "${DR_STATE_TEST_ESP_FREE:-}" ]; then
    free=$DR_STATE_TEST_ESP_FREE
  else
    free=$(df -P -B1 "$BOOT_ESP" | awk 'NR == 2 {print $4}') \
      || die "cannot read free space on $BOOT_ESP"
  fi
  [[ "$free" =~ ^[0-9]+$ ]] || die "ESP free-space value '$free' is not a number"
  printf '%s\n' "$free"
}

sdboot_kernel_pair_matches() { # STATE KVER TARGET_DIR -> success only when both staged files match the state
  local state=$1 kver=$2 target=$3
  [ -s "$TOP/$state/boot/vmlinuz-$kver" ] && [ -s "$TOP/$state/boot/initrd.img-$kver" ] \
    && [ -s "$target/vmlinuz" ] && [ -s "$target/initrd.img" ] \
    && cmp -s -- "$TOP/$state/boot/vmlinuz-$kver" "$target/vmlinuz" \
    && cmp -s -- "$TOP/$state/boot/initrd.img-$kver" "$target/initrd.img"
}

copy_sdboot_kernel() { # STATE KVER KERNEL_ID INITRD_SHA256
  local state=$1 kver=$2 kid=$3 sha256=$4
  local src_kernel="$TOP/$state/boot/vmlinuz-$kver"
  local src_initrd="$TOP/$state/boot/initrd.img-$kver"
  local target="$SDBOOT_KERNEL_DIR/$kid" tmp copied_sha
  [ -s "$src_kernel" ] && [ -s "$src_initrd" ] || die "state $state lost its kernel or initrd while generating the menu"
  [ ! -e "$target" ] || [ -d "$target" ] || die "$target exists but is not a kernel directory"
  if sdboot_kernel_pair_matches "$state" "$kver" "$target"; then return 0; fi
  tmp=$(mktemp -d "$SDBOOT_KERNEL_DIR/.tmp.XXXXXX") || die "cannot create a temporary kernel directory on the ESP"
  if ! cp -L -- "$src_kernel" "$tmp/vmlinuz" || ! cp -L -- "$src_initrd" "$tmp/initrd.img"; then
    rm -rf -- "$tmp"
    die "cannot copy state $state kernel $kver to the ESP"
  fi
  copied_sha=$(sha256sum -- "$tmp/initrd.img" | awk '{print $1}') || {
    rm -rf -- "$tmp"
    die "cannot hash the copied initrd for state $state"
  }
  if [ "$copied_sha" != "$sha256" ]; then
    rm -rf -- "$tmp"
    die "state $state initrd changed while the menu was being generated; retry"
  fi
  if ! chmod 0644 "$tmp/vmlinuz" "$tmp/initrd.img"; then
    rm -rf -- "$tmp"
    die "cannot set permissions on the copied kernel for state $state"
  fi
  if [ ! -e "$target" ]; then
    if ! mv -- "$tmp" "$target"; then
      rm -rf -- "$tmp"
      die "cannot publish the copied kernel for state $state"
    fi
    return 0
  fi
  # An interrupted older copy can leave the directory without one file. Replace its files in place; never remove a
  # directory that an installed entry may still reference.
  if ! cp -p -- "$tmp/vmlinuz" "$target/.vmlinuz.tmp.$$" \
      || ! cp -p -- "$tmp/initrd.img" "$target/.initrd.img.tmp.$$"; then
    rm -f -- "$target/.vmlinuz.tmp.$$" "$target/.initrd.img.tmp.$$"
    rm -rf -- "$tmp"
    die "cannot repair the copied kernel for state $state"
  fi
  if ! mv -f -- "$target/.vmlinuz.tmp.$$" "$target/vmlinuz" \
      || ! mv -f -- "$target/.initrd.img.tmp.$$" "$target/initrd.img"; then
    rm -f -- "$target/.vmlinuz.tmp.$$" "$target/.initrd.img.tmp.$$"
    rm -rf -- "$tmp"
    die "cannot publish the repaired kernel for state $state"
  fi
  rm -rf -- "$tmp"
}

cmd_gen_menu_systemd_boot() {
  local default="" entries=0 i s kver sha256 kid eid ruuid cluster needed free text kernel_bytes initrd_bytes
  local dir_bytes loader_bytes text_bytes entry_path base folded found_existing expected
  local missing_dirs record_children=0 record_parents=0 record_bytes
  local target entry_tmp loader_in="" loader_out default_id="" default_requested=0 default_entry_id oneshot_id=""
  local oneshot_unknown=0 existing_default_id="" existing_default_state="" running_state=""
  local -a all_states=() states_list=() kvers=() hashes=() kids=() eids=()
  local -A wanted_states=()
  while [ $# -gt 0 ]; do
    case "$1" in --default) default=$2; shift 2 ;; *) die "gen-menu: $1" ;; esac
  done
  ensure_top
  ensure_esp
  cleanup_sdboot_scratch "$SDBOOT_KERNEL_DIR" "$SDBOOT_ENTRY_DIR" "$SDBOOT_LOADER_CONF" "$SDBOOT_MARKER"
  if oneshot_id=$(sdboot_oneshot_id); then :; else oneshot_unknown=1; fi
  ruuid=$(root_uuid); [ -n "$ruuid" ] || die "no btrfs root UUID in /etc/fstab"
  if [ -n "$default" ]; then
    default_entry_id=$(entry_id_for_state "$default") || die "unsafe state name for a systemd-boot entry id: $default"
    default_requested=1
  fi

  # Decide the whole desired menu and its ESP allocation before creating a directory or touching any menu file.
  mapfile -t all_states < <(sdboot_states)
  if [ "${#all_states[@]}" -gt 0 ]; then
    sdboot_entry_ids "${all_states[@]}" >/dev/null \
      || die "state names cannot be represented as unique systemd-boot entry ids; keeping the existing menu"
  fi
  for s in "${all_states[@]}"; do
    eid=$(entry_id_for_state "$s") || die "state name cannot be represented safely as a systemd-boot entry id: $s"
    kver=$(latest_kernel "$s")
    [ -n "$kver" ] || continue
    sha256=$(sha256sum -- "$TOP/$s/boot/initrd.img-$kver" | awk '{print $1}') \
      || die "cannot hash the initrd for state $s kernel $kver"
    kid=$(kernel_id "$kver" "$sha256") || die "cannot make a kernel id for state $s kernel $kver"
    states_list+=("$s"); kvers+=("$kver"); hashes+=("$sha256"); kids+=("$kid"); eids+=("$eid")
    wanted_states["$s"]=1
    entries=$((entries + 1))
    if [ "$default_requested" = 1 ] && [ "$s" = "$default" ]; then default_requested=2; fi
  done
  if [ "$default_requested" = 1 ]; then
    die "default state $default has no kernel with a non-empty initrd; keeping the existing menu"
  fi
  [ "$entries" -gt 0 ] || die "no state has a kernel with an initrd; keeping the existing menu"

  # A case-insensitive vfat lookup resolves names after folding the COMPLETE basename, including the extension.
  # Refuse any alias of a desired entry name, and refuse an exact target that is not one of our marked entries.
  if [ -d "$SDBOOT_ENTRY_DIR" ]; then
    while IFS= read -r -d '' entry_path; do
      base=${entry_path##*/}
      folded=${base,,}
      for eid in "${eids[@]}"; do
        expected=$eid.conf
        if [ "${expected,,}" = "$folded" ]; then
          if [ "$base" != "$expected" ]; then
            die "existing ESP name $entry_path case-insensitively collides with desired entry $expected; refusing to overwrite it"
          fi
          [ -f "$entry_path" ] || die "desired BLS entry path $entry_path exists but is not a regular file"
          [ "$(head -n 1 "$entry_path" | tr -d '\r')" = "$SDBOOT_ENTRY_MARKER" ] \
            || die "existing BLS entry $entry_path is not owned by dr-state; refusing to overwrite it"
        fi
      done
    done < <(find "$SDBOOT_ENTRY_DIR" -mindepth 1 -maxdepth 1 -print0)
  fi

  if [ -n "$default" ]; then
    default_id=$default_entry_id
  else
    default_id=$(loader_default_id) || die "cannot read the existing loader.conf default"
    existing_default_id=$default_id
    if [ -n "$default_id" ]; then
      existing_default_state=$(state_for_entry_id "$default_id" 2>/dev/null || true)
      if [ -z "$existing_default_state" ] || ! state_exists "$existing_default_state"; then
        echo "dr-state: existing loader.conf default '$default_id' is not an existing OS state" >&2
        default_id=""
      fi
    fi
    found_existing=0
    for eid in "${eids[@]}"; do
      if [ "$default_id" = "$eid" ]; then found_existing=1; break; fi
    done
    if [ "$found_existing" = 0 ]; then
      # Keep the currently running state as default when the old selection cannot be generated. If that state
      # cannot be identified, use the first available entry and tell the operator what changed.
      running_state=${DR_STATE:-}
      if [ "$running_state" = none ]; then running_state=""; fi
      if [ -z "$running_state" ]; then
        running_state=$(tr ' ' '\n' </proc/cmdline | sed -n 's/^rootflags=.*subvol=\([^,]*\).*/\1/p' | head -n 1)
      fi
      default_id=""
      for ((i = 0; i < entries; i++)); do
        if [ "${states_list[i]}" = "$running_state" ]; then default_id=${eids[i]}; break; fi
      done
      if [ -n "$default_id" ]; then
        echo "dr-state: configured default '${existing_default_id:-none}' is unavailable; keeping running state $running_state as default" >&2
      else
        default_id=${eids[0]}
        echo "dr-state: configured default '${existing_default_id:-none}' and running state '${running_state:-unknown}' are unavailable; selecting $default_id" >&2
      fi
    fi
  fi
  [ -n "$default_id" ] || die "cannot select a default systemd-boot entry; keeping the existing menu"
  if [ -r "$SDBOOT_LOADER_CONF" ]; then loader_in=$(cat "$SDBOOT_LOADER_CONF"); fi
  loader_out=$(printf '%s' "$loader_in" | sdboot_loader_conf "$default_id") \
    || die "cannot construct loader.conf"

  cluster=$(esp_cluster_bytes)
  dir_bytes=$(sdboot_dir_alloc "$BOOT_ESP" "$cluster" EFI/dr/kernels loader/entries) \
    || die "cannot account for the systemd-boot parent directories"
  missing_dirs=$((dir_bytes / cluster))
  record_children=$missing_dirs
  record_parents=$missing_dirs
  loader_bytes=$(sdboot_byte_length "$loader_out") \
    || die "cannot measure the rewritten loader.conf"
  needed=$(sdboot_allocated_sum "$cluster" "$((loader_bytes + 1))") \
    || die "cannot round loader.conf allocation"
  needed=$((needed + dir_bytes))
  for ((i = 0; i < entries; i++)); do
    target="$SDBOOT_KERNEL_DIR/${kids[i]}"
    if ! sdboot_kernel_pair_matches "${states_list[i]}" "${kvers[i]}" "$target"; then
      # Staging dir + two staged files + target directory record + repair/temp names. This is an estimate, not an
      # attempt to model a particular FAT implementation's directory packing.
      record_children=$((record_children + 6))
      record_parents=$((record_parents + 2))
      needed=$((needed + cluster))
      kernel_bytes=$(sdboot_file_allocated_bytes "$TOP/${states_list[i]}/boot/vmlinuz-${kvers[i]}" "$cluster") \
        || die "cannot size the kernel for ${states_list[i]}"
      initrd_bytes=$(sdboot_file_allocated_bytes "$TOP/${states_list[i]}/boot/initrd.img-${kvers[i]}" "$cluster") \
        || die "cannot size the initrd for ${states_list[i]}"
      needed=$((needed + kernel_bytes + initrd_bytes))
      if [ -d "$target" ]; then
        # Repair stages a second copy inside the existing target before replacing its files.
        needed=$((needed + cluster + kernel_bytes + initrd_bytes))
      fi
    fi
    text=$(sdboot_entry_text "${states_list[i]}" "${kvers[i]}" "$ruuid" "${kids[i]}") \
      || die "cannot construct the entry for ${states_list[i]}"
    text_bytes=$(sdboot_byte_length "$text") || die "cannot measure the entry for ${states_list[i]}"
    needed=$((needed + $(sdboot_allocated_sum "$cluster" "$((text_bytes + 1))")))
    record_children=$((record_children + 2))
    record_parents=$((record_parents + 1))
  done
  record_children=$((record_children + 2))
  record_parents=$((record_parents + 1))
  record_bytes=$(sdboot_fat_record_estimate "$cluster" "$record_children" "$record_parents") \
    || die "cannot estimate FAT directory-record growth"
  needed=$((needed + record_bytes))
  free=$(esp_free_bytes)
  sdboot_space_check "$needed" "$free" >&2 || exit $?

  mkdir -p "$SDBOOT_KERNEL_DIR" "$SDBOOT_ENTRY_DIR"
  for ((i = 0; i < entries; i++)); do
    copy_sdboot_kernel "${states_list[i]}" "${kvers[i]}" "${kids[i]}" "${hashes[i]}"
  done

  for ((i = 0; i < entries; i++)); do
    text=$(sdboot_entry_text "${states_list[i]}" "${kvers[i]}" "$ruuid" "${kids[i]}") \
      || die "cannot construct the entry for ${states_list[i]}"
    entry_tmp="$SDBOOT_ENTRY_DIR/$SDBOOT_ENTRY_TMP_NAME.$$"
    sdboot_test_failure entry-write
    printf '%s\n' "$text" >"$entry_tmp"
    sdboot_test_failure entry-publish
    mv "$entry_tmp" "$SDBOOT_ENTRY_DIR/${eids[i]}.conf"
  done

  # Publish a default that names one of the entries above before removing any stale entry. A failed write or rename
  # therefore leaves the old menu and its old default entry intact.
  sdboot_test_failure loader-write
  printf '%s\n' "$loader_out" >"$SDBOOT_LOADER_CONF.new.$$"
  sdboot_test_failure loader-publish
  mv "$SDBOOT_LOADER_CONF.new.$$" "$SDBOOT_LOADER_CONF"

  # Remove only entries that carry our marker and are neither the new default nor a pending one-shot. Foreign BLS
  # entries are left alone.
  local entry_path entry_base entry_id entry_state
  if [ "$oneshot_unknown" != 1 ]; then
    while IFS= read -r entry_path; do
      [ "$(head -n 1 "$entry_path")" = "$SDBOOT_ENTRY_MARKER" ] || continue
      entry_base=${entry_path##*/}
      entry_id=${entry_base%.conf}
      [ "$entry_id" != "$default_id" ] || continue
      [ -z "$oneshot_id" ] || [ "$entry_id" != "$oneshot_id" ] || continue
      entry_state=$(state_for_entry_id "$entry_id") || {
        sdboot_test_failure stale-delete
        rm -f -- "$entry_path"
        continue
      }
      if [ -z "${wanted_states[$entry_state]+x}" ]; then
        sdboot_test_failure stale-delete
        rm -f -- "$entry_path"
      fi
    done < <(find "$SDBOOT_ENTRY_DIR" -maxdepth 1 -name '*.conf' -print)
  fi
}

cmd_gen_menu_grub() {
  local default="" entries=0
  while [ $# -gt 0 ]; do
    case "$1" in --default) default=$2; shift 2 ;; *) die "gen-menu: $1" ;; esac
  done
  ensure_top
  ensure_esp
  mkdir -p "$ESP_DIR"
  local ruuid; ruuid=$(root_uuid); [ -n "$ruuid" ] || die "no btrfs root UUID in /etc/fstab"
  [ -f "$ESP_DIR/grubenv" ] || grub-editenv "$ESP_DIR/grubenv" create
  {
    cat <<'EOF'
# generated by dr-state gen-menu; do not edit
serial --unit=0 --speed=115200
terminal_input serial console
terminal_output serial console
set timeout=5
load_env
if [ "${next_entry}" ]; then
  set default="${next_entry}"
  set next_entry=
  save_env next_entry
else
  set default="${saved_entry}"
fi
EOF
    local s kver
    for s in $(states); do
      kver=$(latest_kernel "$s")
      [ -n "$kver" ] || continue
      entries=$((entries + 1))
      cat <<EOF
menuentry "Debian $s (kernel $kver)" --id $s {
  search --no-floppy --fs-uuid --set=root $ruuid
  linux /$s/boot/vmlinuz-$kver root=UUID=$ruuid rootflags=subvol=$s ro net.ifnames=0 console=tty0 console=ttyS0,115200
  initrd /$s/boot/initrd.img-$kver
}
EOF
    done
  } >"$ESP_DIR/grub.cfg.new.$$"
  if [ "$entries" -eq 0 ]; then
    rm -f "$ESP_DIR/grub.cfg.new.$$"
    die "no state has a kernel with an initrd; keeping the existing menu"
  fi
  mv "$ESP_DIR/grub.cfg.new.$$" "$ESP_DIR/grub.cfg"
  # the default changes only after a menu was written successfully
  if [ -n "$default" ]; then grub-editenv "$ESP_DIR/grubenv" set saved_entry="$default"; fi
}

cmd_gen_menu() {
  local backend i default_state
  backend=$(bootloader) || die "cannot determine the bootloader backend"
  local -a gen_args=("$@")
  if [ "$backend" = systemd-boot ]; then
    for ((i = 0; i < ${#gen_args[@]}; i++)); do
      if [ "${gen_args[i]}" = --default ] && [ $((i + 1)) -lt "${#gen_args[@]}" ]; then
        default_state=${gen_args[i + 1]}
        state_has_conf_suffix "$default_state" \
          && die "state $default_state ends in .conf and is not selectable; refusing the requested default"
      fi
    done
  fi
  case "$backend" in
    grub) cmd_gen_menu_grub "$@" ;;
    systemd-boot) cmd_gen_menu_systemd_boot "$@" ;;
  esac
}

# both print nothing (and succeed) when btrfs cannot show the subvolume, so the window fails open under set -e/pipefail
subvol_uuid() { { btrfs subvolume show "$TOP/$1" 2>/dev/null || true; } | awk '$1=="UUID:" {print $2; exit}'; }
subvol_parent_uuid() { { btrfs subvolume show "$TOP/$1" 2>/dev/null || true; } | awk '$1=="Parent" && $2=="UUID:" {print $3; exit}'; }

# State IDs carry a monotonic creation sequence, UTC creation time and short origin/reason slug:
#   @os-000001-YYYYMMDD-HHMMSSZ-install
#   @os-000002-YYYYMMDD-HHMMSSZ-apt
#   @os-000003-YYYYMMDD-HHMMSSZ-manual-before-driver
state_id_parts() { # STATE -> SEQUENCE<TAB>TIMESTAMP<TAB>SLUG; only this format is current
  local state=${1-}
  [[ "$state" =~ ^@os-([0-9]{6})-([0-9]{8})-([0-9]{6})Z-([a-z0-9][a-z0-9_-]*[a-z0-9])$ ]] || return 1
  [ "${BASH_REMATCH[1]}" != 000000 ] || return 1
  local sequence=${BASH_REMATCH[1]} timestamp=${BASH_REMATCH[2]}${BASH_REMATCH[3]} slug=${BASH_REMATCH[4]}
  local epoch roundtrip
  epoch=$(date -u -d "${timestamp:0:8} ${timestamp:8:2}:${timestamp:10:2}:${timestamp:12:2}" +%s 2>/dev/null) || return 1
  roundtrip=$(date -u -d "@$epoch" +%Y%m%d%H%M%S 2>/dev/null) || return 1
  [ "$roundtrip" = "$timestamp" ] || return 1
  printf '%s\t%s\t%s\n' "$sequence" "$timestamp" "$slug"
}

state_sequence_from_name() {
  local parts
  parts=$(state_id_parts "${1-}") || return 1
  printf '%s\n' "${parts%%$'\t'*}"
}

state_timestamp_from_name() {
  local parts rest
  parts=$(state_id_parts "${1-}") || return 1
  rest=${parts#*$'\t'}
  printf '%s\n' "${rest%%$'\t'*}"
}

state_slug_from_name() {
  local parts
  parts=$(state_id_parts "${1-}") || return 1
  printf '%s\n' "${parts##*$'\t'}"
}

state_name() { # SEQUENCE TIMESTAMP REASON_SLUG -> canonical subvolume name
  local sequence=${1-} timestamp=${2-} slug=${3-} name
  [[ "$sequence" =~ ^[0-9]{6}$ && "$sequence" != 000000 ]] || return 1
  [[ "$timestamp" =~ ^[0-9]{14}$ ]] || return 1
  [[ "$slug" =~ ^[a-z0-9][a-z0-9_-]*[a-z0-9]$ ]] || return 1
  name="@os-$sequence-${timestamp:0:8}-${timestamp:8:6}Z-$slug"
  state_id_parts "$name" >/dev/null || return 1
  entry_id_for_state "$name" >/dev/null || return 1
  printf '%s\n' "$name"
}

snapshot_slug_for_name() { # SOURCE REASON -> stable, readable origin/reason component
  local source=${1-} reason=${2-} slug
  case "$source" in
    apt) printf 'apt\n'; return 0 ;;
    manual) ;;
    *) return 1 ;;
  esac
  reason=$(printf '%s' "$reason" | LC_ALL=C tr '[:upper:]' '[:lower:]' \
    | LC_ALL=C tr -cs 'a-z0-9_-' '-' | sed -E 's/^-+//; s/-+$//')
  [ -n "$reason" ] || return 1
  if [ "$reason" = manual ]; then slug=manual
  elif [[ "$reason" == manual-* ]]; then slug=$reason
  else slug="manual-$reason"
  fi
  slug=${slug:0:64}
  slug=${slug%-}
  [[ "$slug" =~ ^[a-z0-9][a-z0-9_-]*[a-z0-9]$ ]] || return 1
  printf '%s\n' "$slug"
}

# The high-water mark lives at the btrfs top level, outside every rollback state. Deletion
# never changes it; a failed snapshot may consume a sequence and leave a gap. Missing or
# malformed state is an error, never an invitation to guess and reuse a deleted ID.
state_control_dir() { printf '%s/.dr-state\n' "$TOP"; }

ensure_state_control_dir() {
  local dir
  dir=$(state_control_dir)
  [ ! -L "$dir" ] || return 1
  { [ ! -e "$dir" ] || [ -d "$dir" ]; } || return 1
  mkdir -p -- "$dir" || return 1
  chmod 700 "$dir" || return 1
  [ -d "$dir" ] && [ ! -L "$dir" ]
}

ensure_metadata_dir() {
  local dir
  ensure_state_control_dir || return 1
  dir=$(metadata_dir)
  [ ! -L "$dir" ] || return 1
  { [ ! -e "$dir" ] || [ -d "$dir" ]; } || return 1
  mkdir -p -- "$dir" || return 1
  chmod 700 "$dir" || return 1
  [ -d "$dir" ] && [ ! -L "$dir" ]
}

sequence_file() { printf '%s/last-sequence\n' "$(state_control_dir)"; }

sequence_read() {
  local file raw dir
  file=$(sequence_file)
  dir=${file%/*}
  [ -d "$dir" ] && [ ! -L "$dir" ] || return 1
  [ -f "$file" ] && [ ! -L "$file" ] && [ -r "$file" ] || return 1
  raw=$(cat -- "$file") || return 1
  [[ "$raw" =~ ^[0-9]{6}$ && "$raw" != 000000 ]] || return 1
  printf '%s\n' "$raw"
}

sequence_write() { # SEQUENCE -> durable atomic high-water update
  local sequence=$1 dir tmp
  [[ "$sequence" =~ ^[0-9]{6}$ && "$sequence" != 000000 ]] || return 1
  ensure_state_control_dir || return 1
  dir=$(state_control_dir)
  tmp=$(mktemp "$dir/.last-sequence.new.XXXXXXXX") || return 1
  if ! { chmod 600 "$tmp" && printf '%s\n' "$sequence" >"$tmp" && sync -f "$tmp" \
      && mv -f -- "$tmp" "$dir/last-sequence" && sync -f "$dir"; }; then
    rm -f -- "$tmp"
    return 1
  fi
}

sequence_allocate() { # reserve and return the next sequence; caller holds DR_STATE_LOCK
  local previous number next
  previous=$(sequence_read) \
    || die "sequence counter $(sequence_file) is missing or invalid; refusing to guess or reuse an ID. This runtime requires a fresh install initialized by dr-state; no migration from historical @os-0001 installs is provided, and its APT snapshot hook will refuse package changes if this runtime is copied there."
  number=$((10#$previous))
  [ "$number" -lt 999999 ] || die "state sequence exhausted at $previous"
  next=$(printf '%06d' "$((number + 1))")
  sequence_write "$next" || die "cannot durably reserve state sequence $next"
  printf '%s\n' "$next"
}

# snapshot_epoch_from_name NAME -> creation epoch from the canonical state ID.
snapshot_epoch_from_name() {
  local timestamp stamp
  timestamp=$(state_timestamp_from_name "${1-}") || return 1
  stamp="${timestamp:0:8} ${timestamp:8:2}:${timestamp:10:2}:${timestamp:12:2}"
  date -u -d "$stamp" +%s 2>/dev/null
}

# window_blocks NAME INTERVAL NOW: exit 0 when a snapshot is younger than INTERVAL seconds at NOW (epoch).
# A malformed name or a name from the future (clock jump) never blocks.
window_blocks() {
  local name=$1 interval=$2 now=$3 made
  made=$(snapshot_epoch_from_name "$name") || return 1
  [ $((now - made)) -ge 0 ] && [ $((now - made)) -lt "$interval" ]
}

snapshot_name() { # SEQUENCE TIMESTAMP SOURCE REASON -> @os-SEQ-DATE-TIMEZ-SLUG
  local sequence=${1-} timestamp=${2-} source=${3-} reason=${4-} slug
  slug=$(snapshot_slug_for_name "$source" "$reason") || return 1
  state_name "$sequence" "$timestamp" "$slug"
}

metadata_dir() { printf '%s/.dr-state/metadata\n' "$TOP"; }

metadata_path() { # STATE -> sidecar path; caller has verified exact state membership or constructed the name
  printf '%s/%s.meta\n' "$(metadata_dir)" "$1"
}

metadata_put() { # FILE KEY VALUE -> append one base64-encoded field
  local file=$1 key=$2 value=$3 encoded
  [[ "$key" =~ ^[a-z][a-z0-9_]*$ ]] || return 1
  encoded=$(printf '%s' "$value" | base64 | tr -d '\n') || return 1
  printf '%s=%s\n' "$key" "$encoded" >>"$file"
}

metadata_get() { # FILE KEY -> decoded value; return 1 for absent or invalid fields
  local file=$1 key=$2 encoded dir
  dir=${file%/*}
  [ -d "$dir" ] && [ ! -L "$dir" ] && [ -f "$file" ] && [ ! -L "$file" ] && [ -r "$file" ] || return 1
  grep -q "^${key}=" "$file" || return 1
  encoded=$(sed -n "s/^${key}=//p" "$file" | head -n 1)
  printf '%s' "$encoded" | base64 -d 2>/dev/null
}

metadata_capture_packages() {
  if [ "$TEST_MODE" = 1 ] && [ -n "${DR_STATE_TEST_PACKAGES:-}" ]; then
    printf '%s\n' "$DR_STATE_TEST_PACKAGES"
    return 0
  fi
  command -v dpkg-query >/dev/null 2>&1 || return 1
  dpkg-query -W -f='${binary:Package}\t${Version}\n' 2>/dev/null \
    | awk -F '\t' '$1 ~ /^(apt|base-files|dpkg|libc6|systemd|systemd-sysv|systemd-boot|systemd-boot-efi|linux-image)/'
}

metadata_write_snapshot() { # STATE PARENT CREATED SOURCE REASON NOTE APT_ACTIONS [KERNEL_OVERRIDE] -> durable sidecar
  local state=$1 parent=$2 created=$3 source=$4 reason=$5 note=$6 apt_actions=$7 kernel_override=${8-}
  local dir tmp release pretty id version kernel packages package_status sequence slug
  sequence=$(state_sequence_from_name "$state") || return 1
  slug=$(state_slug_from_name "$state") || return 1
  ensure_metadata_dir || return 1
  dir=$(metadata_dir)
  tmp=$(mktemp "$dir/.${state}.new.XXXXXXXX") || return 1
  chmod 600 "$tmp" || { rm -f -- "$tmp"; return 1; }

  release=/etc/os-release
  if [ "$TEST_MODE" = 1 ] && [ -n "${DR_STATE_TEST_OS_RELEASE:-}" ]; then
    pretty=$DR_STATE_TEST_OS_RELEASE
    id=${DR_STATE_TEST_OS_ID:-debian}
    version=${DR_STATE_TEST_OS_VERSION_ID:-13}
  else
    pretty=$(sed -n 's/^PRETTY_NAME=//p' "$release" 2>/dev/null | head -n 1 | sed 's/^"//; s/"$//')
    id=$(sed -n 's/^ID=//p' "$release" 2>/dev/null | head -n 1 | sed 's/^"//; s/"$//')
    version=$(sed -n 's/^VERSION_ID=//p' "$release" 2>/dev/null | head -n 1 | sed 's/^"//; s/"$//')
  fi
  if [ -n "$kernel_override" ]; then
    kernel=$kernel_override
  elif [ "$TEST_MODE" = 1 ] && [ -n "${DR_STATE_TEST_KERNEL:-}" ]; then
    kernel=$DR_STATE_TEST_KERNEL
  else
    kernel=$(uname -r 2>/dev/null || true)
  fi
  if packages=$(metadata_capture_packages 2>/dev/null); then package_status=recorded
  else packages=""; package_status=unavailable; fi

  printf 'schema=1\n' >"$tmp" || { rm -f -- "$tmp"; return 1; }
  metadata_put "$tmp" state "$state" || { rm -f -- "$tmp"; return 1; }
  metadata_put "$tmp" sequence "$sequence" || { rm -f -- "$tmp"; return 1; }
  metadata_put "$tmp" origin_slug "$slug" || { rm -f -- "$tmp"; return 1; }
  metadata_put "$tmp" created_utc "$created" || { rm -f -- "$tmp"; return 1; }
  metadata_put "$tmp" parent_state "$parent" || { rm -f -- "$tmp"; return 1; }
  metadata_put "$tmp" source "$source" || { rm -f -- "$tmp"; return 1; }
  metadata_put "$tmp" reason "$reason" || { rm -f -- "$tmp"; return 1; }
  metadata_put "$tmp" note "$note" || { rm -f -- "$tmp"; return 1; }
  metadata_put "$tmp" os_pretty_name "$pretty" || { rm -f -- "$tmp"; return 1; }
  metadata_put "$tmp" os_id "$id" || { rm -f -- "$tmp"; return 1; }
  metadata_put "$tmp" os_version_id "$version" || { rm -f -- "$tmp"; return 1; }
  metadata_put "$tmp" kernel "$kernel" || { rm -f -- "$tmp"; return 1; }
  metadata_put "$tmp" packages_status "$package_status" || { rm -f -- "$tmp"; return 1; }
  metadata_put "$tmp" packages "$packages" || { rm -f -- "$tmp"; return 1; }
  metadata_put "$tmp" apt_actions "$apt_actions" || { rm -f -- "$tmp"; return 1; }
  sync -f "$tmp" || { rm -f -- "$tmp"; return 1; }
  mv -f -- "$tmp" "$(metadata_path "$state")" || { rm -f -- "$tmp"; return 1; }
  sync -f "$dir" || return 1
}

cmd_initialize_state() { # STATE TIMESTAMP -> initialize sequence 000001 and capture the first installed state
  local state=${1-} timestamp=${2-} expected file kernel created existing_counter metadata_state metadata_sequence
  [ "$#" -eq 2 ] || die "usage: dr-state initialize-state STATE TIMESTAMP"
  ensure_top
  expected=$(state_name 000001 "$timestamp" install) \
    || die "initial state must use a valid UTC timestamp and the install origin slug"
  [ "$state" = "$expected" ] || die "initial state name must be $expected"
  [ -d "$TOP/$state" ] && [ ! -L "$TOP/$state" ] || die "initial state $state is not a real top-level directory"
  local -a existing_states=()
  mapfile -t existing_states < <(states)
  [ "${#existing_states[@]}" -eq 1 ] && [ "${existing_states[0]}" = "$state" ] \
    || die "initialize-state requires a fresh filesystem containing only $state"
  file=$(sequence_file)
  if [ -e "$file" ] || [ -L "$file" ]; then
    existing_counter=$(sequence_read) || die "sequence counter exists but is invalid; refusing to reset it"
    [ "$existing_counter" = 000001 ] || die "sequence counter already records $existing_counter; refusing to reset it"
    metadata_state=$(metadata_get "$(metadata_path "$state")" state || true)
    metadata_sequence=$(metadata_get "$(metadata_path "$state")" sequence || true)
    [ "$metadata_state" = "$state" ] && [ "$metadata_sequence" = 000001 ] \
      || die "sequence counter is initialized but the initial state metadata is missing or inconsistent"
    echo "dr-state: $state is already initialized with sequence 000001"
    return 0
  fi
  kernel=$(latest_kernel "$state")
  [ -n "$kernel" ] || die "initial state has no complete kernel/initrd pair"
  created=$(snapshot_created_utc "$timestamp") || die "cannot format initial-state timestamp"
  metadata_write_snapshot "$state" none "$created" install install "" "" "$kernel" \
    || die "cannot persist metadata for initial state $state"
  if ! sequence_write 000001; then
    rm -f -- "$(metadata_path "$state")"
    die "cannot initialize the durable state sequence counter"
  fi
  echo "dr-state: initialized $state with sequence 000001"
}

metadata_update_apt_actions() { # STATE ACTIONS -> atomically append unique APT plan lines to existing snapshot metadata
  local state=$1 actions=$2 file tmp existing combined
  ensure_metadata_dir || return 1
  file=$(metadata_path "$state")
  [ -f "$file" ] || return 0
  existing=$(metadata_get "$file" apt_actions || true)
  combined=$(printf '%s\n%s\n' "$existing" "$actions" | awk 'NF && !seen[$0]++')
  tmp=$(mktemp "$(metadata_dir)/.${state}.new.XXXXXXXX") || return 1
  if ! awk -F= '$1 != "apt_actions" {print}' "$file" >"$tmp"; then
    rm -f -- "$tmp"
    return 1
  fi
  metadata_put "$tmp" apt_actions "$combined" || { rm -f -- "$tmp"; return 1; }
  chmod 600 "$tmp" || { rm -f -- "$tmp"; return 1; }
  sync -f "$tmp" || { rm -f -- "$tmp"; return 1; }
  mv -f -- "$tmp" "$file" || { rm -f -- "$tmp"; return 1; }
  sync -f "$(metadata_dir)" || return 1
}

apt_plan_summary() { # APT Pre-Install-Pkgs VERSION 2/3 protocol on stdin -> concise package operations
  awk '
    NR == 1 {
      if ($0 !~ /^VERSION [23]$/) bad = 1
      version = $2
      next
    }
    !actions && $0 == "" { actions = 1; next }
    !actions { next }
    {
      sub(/^[[:space:]]+/, "")
      sub(/[[:space:]]+$/, "")
      fields = split($0, f, /[[:space:]]+/)
      if (version == 3) {
        if (fields < 9) { bad = 1; next }
        direction = f[5]; new_version = f[6]; operation = f[9]
      } else {
        if (fields < 5) { bad = 1; next }
        direction = f[3]; new_version = f[4]; operation = f[5]
      }
      package = f[1]
      old_version = f[2]
      if (operation == "**REMOVE**") kind = "remove"
      else if (old_version == "-") kind = "install"
      else if (direction == "<") kind = "upgrade"
      else if (direction == ">") kind = "downgrade"
      else if (operation == "**CONFIGURE**") kind = "configure"
      else if (direction == "=") kind = "reinstall-or-unchanged"
      else { bad = 1; next }
      printf "%s %s %s -> %s\n", kind, package, old_version, new_version
      count++
    }
    END {
      if (!actions || bad) exit 1
      if (!count) print "no package actions reported"
    }
  '
}

cmd_apt_pre_install_pkgs() {
  local fd=${APT_HOOK_INFO_FD:-} input actions
  [[ "$fd" =~ ^[3-9][0-9]*$ ]] || die "APT_HOOK_INFO_FD is missing or invalid; refusing to guess the APT package plan"
  input=$(cat <&"$fd") || die "cannot read the APT package-plan descriptor"
  if actions=$(printf '%s\n' "$input" | apt_plan_summary); then
    :
  else
    actions="package plan unavailable (APT hook protocol was not recognized)"
    echo "dr-state: APT package plan could not be parsed; recording an apt snapshot without inferred actions" >&2
  fi
  cmd_snapshot --reason apt --apt-actions "$actions"
}

snapshot_created_utc() { # TIMESTAMP -> ISO-8601 UTC
  local timestamp=$1
  date -u -d "${timestamp:0:8} ${timestamp:8:2}:${timestamp:10:2}:${timestamp:12:2}" +%Y-%m-%dT%H:%M:%SZ
}

cmd_snapshot() {
  local reason=manual note="" apt_actions="" source=manual
  while [ $# -gt 0 ]; do
    case "$1" in
      --reason) [ $# -ge 2 ] || die "snapshot: --reason needs a value"; reason=$2; shift 2 ;;
      --note) [ $# -ge 2 ] || die "snapshot: --note needs a value"; note=$2; shift 2 ;;
      --apt-actions) [ $# -ge 2 ] || die "snapshot: --apt-actions needs a value"; apt_actions=$2; shift 2 ;;
      *) die "snapshot: $1" ;;
    esac
  done
  if [ "${DR_STATE:-}" = none ]; then echo "dr-state: DR_STATE=none, snapshot skipped" >&2; return 0; fi
  ensure_top
  local backend cur name timestamp created sequence slug; cur=$(current_state)
  backend=$(bootloader) || die "cannot determine the bootloader backend"
  [ "$reason" != apt ] || source=apt
  slug=$(snapshot_slug_for_name "$source" "$reason") \
    || die "reason '$reason' cannot produce a state-name slug; use letters/numbers or add details with --note"
  if [ "$backend" = systemd-boot ]; then
    state_has_conf_suffix "$cur" \
      && die "running state $cur ends in .conf and is not selectable; use a state name that does not end in .conf"
  fi
  # Dedupe window for the apt hook (found by S7: one unattended-upgrade run called dpkg 18 times and took 18
  # snapshots). While an APT snapshot of THIS running state younger than DR_SNAPSHOT_MIN_INTERVAL seconds exists
  # (default 900), another apt run takes none: the rollback target stays the state from before the whole upgrade.
  # Only apt snapshots whose btrfs parent is the running state count; manual snapshots (--reason other than apt) and
  # snapshots of another state (after a rollback) neither start nor satisfy the window. 0 disables it.
  local interval=${DR_SNAPSHOT_MIN_INTERVAL:-900}
  [[ "$interval" =~ ^[0-9]+$ ]] || die "DR_SNAPSHOT_MIN_INTERVAL must be a number of seconds"
  if [ "$reason" = apt ] && [ "$interval" -gt 0 ]; then
    local cur_uuid newest="" s
    cur_uuid=$(subvol_uuid "$cur")
    for s in $(states); do
      [ "$(state_slug_from_name "$s" 2>/dev/null || true)" = apt ] || continue
      [ -z "$cur_uuid" ] || [ "$(subvol_parent_uuid "$s")" != "$cur_uuid" ] || newest=$s
    done
    if [ -n "$newest" ] && window_blocks "$newest" "$interval" "$(date -u +%s)"; then
      metadata_update_apt_actions "$newest" "$apt_actions" \
        || die "cannot update APT package actions for existing snapshot $newest"
      echo "dr-state: $newest (a snapshot of $cur) is inside the window of $interval s, no new snapshot" >&2
      return 0
    fi
  fi
  timestamp=$(date -u +%Y%m%d%H%M%S)
  created=$(snapshot_created_utc "$timestamp") || die "cannot format snapshot creation time"
  sequence=$(sequence_allocate)
  name=$(state_name "$sequence" "$timestamp" "$slug") || die "cannot construct a snapshot state name"
  state_exists "$name" && die "state sequence $sequence collides with existing state $name"
  if btrfs subvolume snapshot "$TOP/$cur" "$TOP/$name" >/dev/null; then :
  else
    die "cannot create snapshot $name"
  fi
  if ! metadata_write_snapshot "$name" "$cur" "$created" "$source" "$reason" "$note" "$apt_actions"; then
    rm -f -- "$(metadata_path "$name")"
    if ! btrfs subvolume delete "$TOP/$name" >/dev/null 2>&1; then
      echo "dr-state: metadata capture failed and snapshot $name could not be removed" >&2
    fi
    die "cannot persist pre-change metadata for $name"
  fi
  cmd_gen_menu
  echo "dr-state: wrote $name (copy of $cur)"
}

cmd_list() {
  local long=0
  while [ $# -gt 0 ]; do
    case "$1" in --long|--verbose) long=1; shift ;; *) die "list: unknown option $1" ;; esac
  done
  ensure_top
  local backend def=""
  backend=$(bootloader) || die "cannot determine the bootloader backend"
  case "$backend" in
    grub) def=$(grub-editenv "$ESP_DIR/grubenv" list 2>/dev/null | sed -n 's/^saved_entry=//p') ;;
    systemd-boot)
      def=$(sdboot_inventory_default_state) || die "cannot read the systemd-boot default" ;;
  esac
  local s meta kernel created reason os note actions running status
  running=${DR_STATE:-}
  if [ -z "$running" ]; then
    running=$(tr ' ' '\n' </proc/cmdline | sed -n 's/^rootflags=.*subvol=\([^,]*\).*/\1/p' | head -n 1)
  fi
  [ "$running" != none ] || running=""
  local -a listed_states=()
  case "$backend" in
    grub) mapfile -t listed_states < <(states) ;;
    systemd-boot) mapfile -t listed_states < <(sdboot_states) ;;
  esac
  for s in "${listed_states[@]}"; do
    if [ "$long" = 1 ]; then
      cmd_show "$s"
      printf '\n'
      continue
    fi
    meta=$(metadata_path "$s")
    kernel=$(latest_kernel "$s")
    status=""
    [ "$s" != "$running" ] || status=running
    [ "$s" != "$def" ] || status="${status:+$status, }default"
    if [ -f "$meta" ]; then
      created=$(metadata_get "$meta" created_utc || printf 'unknown')
      reason=$(metadata_get "$meta" reason || printf 'unknown')
      os=$(metadata_get "$meta" os_pretty_name || printf 'unknown')
      note=$(metadata_get "$meta" note || true)
      actions=$(metadata_get "$meta" apt_actions || true)
      printf '%s%s kernel=%s created=%s reason=%s os=%s' "$s" "$([ -n "$status" ] && printf ' (%s)' "$status")" \
        "${kernel:-unknown}" "$created" "$(printf '%s' "${reason:-unknown}" | tr '\r\n\t' '   ' | cut -c1-48)" \
        "$(printf '%s' "${os:-unknown}" | tr '\r\n\t' '   ' | cut -c1-64)"
      [ -z "$note" ] || printf ' note=%s' "$(printf '%s' "$note" | tr '\r\n\t' '   ' | cut -c1-96)"
      [ -z "$actions" ] || printf ' changes=%s' "$(printf '%s' "$actions" | sed -n '1p' | tr '\r\n\t' '   ' | cut -c1-72)"
      printf '\n'
    else
      printf '%s%s kernel=%s' "$s" "$([ -n "$status" ] && printf ' (%s)' "$status")" "${kernel:-unknown}"
      printf '\n'
    fi
  done
}

cmd_show() {
  local state=${1-} meta value backend def="" id kernel running status="" sequence slug
  [ $# -eq 1 ] || die "usage: dr-state show STATE"
  ensure_top
  state_exists "$state" || die "no such state: $state"
  meta=$(metadata_path "$state")
  backend=$(bootloader) || die "cannot determine the bootloader backend"
  case "$backend" in
    grub) def=$(grub-editenv "$ESP_DIR/grubenv" list 2>/dev/null | sed -n 's/^saved_entry=//p') ;;
    systemd-boot)
      def=$(sdboot_inventory_default_state) || die "cannot read the systemd-boot default" ;;
  esac
  kernel=$(latest_kernel "$state")
  printf 'state: %s\n' "$state"
  running=${DR_STATE:-}
  if [ -z "$running" ]; then
    running=$(tr ' ' '\n' </proc/cmdline | sed -n 's/^rootflags=.*subvol=\([^,]*\).*/\1/p' | head -n 1)
  fi
  [ "$running" != none ] || running=""
  [ "$state" != "$running" ] || status=running
  [ "$state" != "$def" ] || status="${status:+$status, }default"
  [ -z "$status" ] || printf 'status: %s\n' "$status"
  sequence=$(state_sequence_from_name "$state" 2>/dev/null || printf 'unknown')
  slug=$(state_slug_from_name "$state" 2>/dev/null || printf 'unknown')
  printf 'sequence: %s\n' "$sequence"
  printf 'origin-slug: %s\n' "$slug"
  [ -n "$kernel" ] && printf 'boot-kernel-available: %s\n' "$kernel" || printf 'boot-kernel-available: no\n'
  if [ ! -f "$meta" ]; then
    value=$(snapshot_epoch_from_name "$state" 2>/dev/null || true)
    if [ -n "$value" ]; then value=$(date -u -d "@$value" +%Y-%m-%dT%H:%M:%SZ); else value=unrecorded; fi
    printf 'created-utc: %s\n' "$value"
    printf 'recorded-metadata: unavailable (state predates metadata capture)\n'
    return 0
  fi
  value=$(metadata_get "$meta" created_utc || printf 'unknown'); printf 'created-utc: %s\n' "$value"
  value=$(metadata_get "$meta" source || printf 'unknown'); printf 'source: %s\n' "$value"
  value=$(metadata_get "$meta" reason || printf 'unknown'); printf 'reason: %s\n' "$value"
  value=$(metadata_get "$meta" parent_state || printf 'unknown'); printf 'copied-from: %s\n' "$value"
  value=$(metadata_get "$meta" note || true); printf 'note: %s\n' "${value:-none}"
  value=$(metadata_get "$meta" os_pretty_name || printf 'unknown'); printf 'os-at-snapshot: %s\n' "$value"
  value=$(metadata_get "$meta" os_id || printf 'unknown'); printf 'os-id: %s\n' "$value"
  value=$(metadata_get "$meta" os_version_id || printf 'unknown'); printf 'os-version-id: %s\n' "$value"
  value=$(metadata_get "$meta" kernel || printf 'unknown'); printf 'running-kernel-at-snapshot: %s\n' "$value"
  value=$(metadata_get "$meta" packages_status || printf 'unavailable'); printf 'package-version-capture: %s\n' "$value"
  value=$(metadata_get "$meta" packages || true)
  if [ -n "$value" ]; then
    printf 'key-package-versions:\n%s\n' "$value"
  else
    printf 'key-package-versions: unavailable\n'
  fi
  value=$(metadata_get "$meta" apt_actions || true)
  if [ -n "$value" ]; then
    printf 'apt-package-actions:\n%s\n' "$value"
  else
    printf 'apt-package-actions: not recorded\n'
  fi
}

cmd_set_default() {
  [ $# -eq 1 ] || die "usage: dr-state set-default STATE"
  ensure_top
  state_exists "$1" || die "no such state: $1"
  local backend
  backend=$(bootloader) || die "cannot determine the bootloader backend"
  case "$backend" in
    grub) grub-editenv "$ESP_DIR/grubenv" set saved_entry="$1" ;;
    systemd-boot)
      state_has_conf_suffix "$1" \
        && die "state $1 ends in .conf and is not selectable; refusing set-default"
      cmd_gen_menu_systemd_boot --default "$1" ;;
  esac
}

# select_prune KEEP PROTECTED_CSV NAME...: prints, oldest first, all but the KEEP newest snapshots by sequence,
# never a protected one (the running, default and one-shot states). Initial install states are not pruned.
decimal_normalize() { # DECIMAL -> canonical base-10 digits without leading zeroes
  local value=${1-}
  [[ "$value" =~ ^[0-9]+$ ]] || return 1
  while [ "${#value}" -gt 1 ] && [[ "$value" == 0* ]]; do value=${value#0}; done
  printf '%s\n' "$value"
}

select_prune() {
  local keep=$1 protected=",$2," n i state sequence slug
  shift 2
  keep=$(decimal_normalize "$keep") || return 1
  # State IDs have at most 999999 distinct six-digit sequences. A larger retention count cannot prune any of them.
  [ "${#keep}" -le 6 ] || return 0
  keep=$((10#$keep))
  local -a names
  local ordered=""
  for state in "$@"; do
    sequence=$(state_sequence_from_name "$state" 2>/dev/null) || continue
    slug=$(state_slug_from_name "$state" 2>/dev/null) || continue
    [ "$slug" != install ] || continue
    ordered+="$(printf '%06d\t%s' "$((10#$sequence))" "$state")"$'\n'
  done
  mapfile -t names < <(printf '%s' "$ordered" | sort -t $'\t' -k1,1n -k2,2 | cut -f2-)
  n=${#names[@]}
  [ "$n" -gt "$keep" ] || return 0
  for ((i = 0; i < n - keep; i++)); do
    case "$protected" in *",${names[i]},"*) ;; *) echo "${names[i]}" ;; esac
  done
}

cmd_prune() {
  local keep=10 dry=0
  while [ $# -gt 0 ]; do
    case "$1" in --keep) keep=${2:?}; shift 2 ;; --dry-run) dry=1; shift ;; *) die "prune: $1" ;; esac
  done
  keep=$(decimal_normalize "$keep") || die "prune: --keep must be a number"
  ensure_top
  ensure_esp
  [ "${DR_STATE:-}" != none ] || die "prune: refusing with DR_STATE=none (the running state would not be protected)"
  local backend cur def next s doomed rc=0 raw protected defaults selector
  cur=$(current_state)
  backend=$(bootloader) || die "cannot determine the bootloader backend"
  case "$backend" in
    grub)
      def=$(grub-editenv "$ESP_DIR/grubenv" list 2>/dev/null | sed -n 's/^saved_entry=//p')
      next=$(grub-editenv "$ESP_DIR/grubenv" list 2>/dev/null | sed -n 's/^next_entry=//p') ;;
    systemd-boot)
      state_has_conf_suffix "$cur" \
        && die "running state $cur ends in .conf and is not selectable; refusing prune"
      if [ "$dry" != 1 ]; then
        cleanup_sdboot_scratch "$SDBOOT_KERNEL_DIR" "$SDBOOT_ENTRY_DIR" "$SDBOOT_LOADER_CONF" "$SDBOOT_MARKER"
      fi
      def=""; next=""
      defaults=$(sdboot_loader_default_values) \
        || die "loader.conf is missing, unreadable, malformed, or has no valid default; refusing prune"
      while IFS= read -r selector; do
        [ -n "$selector" ] || continue
        protected=$(sdboot_prune_selector_states "$selector" default) \
          || die "loader.conf has an unknown default entry id: $selector"
        while IFS= read -r s; do
          [ -n "$s" ] || continue
          def="${def:+$def,}$s"
        done <<<"$protected"
      done <<<"$defaults"
      raw=$(sdboot_oneshot_raw) || die "cannot read the systemd-boot one-shot entry"
      protected=$(sdboot_prune_selector_states "$raw" one-shot) \
        || die "LoaderEntryOneShot has an unknown entry id: $raw"
      next=$(printf '%s' "$protected" | tr '\n' ',') ;;
  esac
  # shellcheck disable=SC2046  # state names have no spaces
  doomed=$(select_prune "$keep" "$cur,$def,$next" $(states))
  for s in $doomed; do
    if [ "$dry" = 1 ]; then echo "would delete $s"
    elif btrfs subvolume delete "$TOP/$s" >/dev/null; then
      rm -f -- "$(metadata_path "$s")" || { echo "dr-state: deleted $s but could not remove its metadata" >&2; rc=1; }
      echo "deleted $s"
    else echo "dr-state: could not delete $s" >&2; rc=1; fi
  done
  # The menu is rewritten even after a partial failure, so it names only states that still exist. Keep this as a
  # normal command in an `if` body: invoking it as the right side of `||` disables errexit inside the function.
  if [ "$dry" != 1 ]; then
    cmd_gen_menu
  fi
  if [ "$dry" != 1 ] && [ "$backend" = systemd-boot ]; then prune_sdboot_kernels; fi
  return "$rc"
}

cmd_delete() {
  local target="" dry=0 confirm=0 backend cur defaults selector raw protected state
  local grub_env grub_default grub_next rc
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry=1; shift ;;
      --yes) confirm=1; shift ;;
      --*) die "delete: unknown option $1" ;;
      *)
        [ -z "$target" ] || die "delete: provide exactly one state name"
        target=$1
        shift ;;
    esac
  done
  [ -n "$target" ] || die "usage: dr-state delete STATE [--dry-run|--yes]"
  [ "$dry" = 1 ] || [ "$confirm" = 1 ] \
    || die "delete requires --yes (use --dry-run to inspect the target first)"
  [ "${DR_STATE:-}" != none ] || die "delete: refusing with DR_STATE=none (the running state would not be protected)"
  ensure_top
  ensure_esp
  state_exists "$target" || die "no such state: $target"
  [ -d "$TOP/$target" ] && [ ! -L "$TOP/$target" ] \
    || die "state $target is not a real top-level directory"
  btrfs subvolume show "$TOP/$target" >/dev/null 2>&1 \
    || die "state $target is not a readable btrfs subvolume; refusing delete"

  cur=$(current_state)
  state_exists "$cur" || die "cannot verify the running state '$cur'; refusing delete"
  [ "$target" != "$cur" ] || die "refusing to delete the running state $target"
  backend=$(bootloader) || die "cannot determine the bootloader backend"
  case "$backend" in
    grub)
      grub_env=$(grub-editenv "$ESP_DIR/grubenv" list) \
        || die "cannot read the GRUB environment; refusing delete"
      grub_default=$(printf '%s\n' "$grub_env" | sed -n 's/^saved_entry=//p')
      grub_next=$(printf '%s\n' "$grub_env" | sed -n 's/^next_entry=//p')
      [ -n "$grub_default" ] \
        || die "GRUB has no readable saved_entry; refusing delete without a known configured default"
      [ "$(printf '%s\n' "$grub_env" | awk -F= '$1 == "saved_entry" {n++} END {print n+0}')" = 1 ] \
        || die "GRUB saved_entry is missing or duplicated; refusing delete"
      [ "$(printf '%s\n' "$grub_env" | awk -F= '$1 == "next_entry" {n++} END {print n+0}')" -le 1 ] \
        || die "GRUB next_entry is duplicated; refusing delete"
      state_exists "$grub_default" \
        || die "GRUB saved_entry names an unknown state '$grub_default'; refusing delete"
      [ "$grub_default" != "$target" ] \
        || die "refusing to delete the configured GRUB default state $target; boot and select another default first"
      if [ -n "$grub_next" ]; then
        state_exists "$grub_next" \
          || die "GRUB next_entry names an unknown state '$grub_next'; refusing delete"
        [ "$grub_next" != "$target" ] \
          || die "refusing to delete the pending GRUB one-shot state $target"
      fi
      ;;
    systemd-boot)
      state_has_conf_suffix "$cur" \
        && die "running state $cur ends in .conf and is not selectable; refusing delete"
      defaults=$(sdboot_loader_default_values) \
        || die "loader.conf is missing, unreadable, malformed, or has no valid default; refusing delete"
      [ -n "$defaults" ] || die "loader.conf has no default; refusing delete"
      while IFS= read -r selector; do
        [ -n "$selector" ] || continue
        protected=$(sdboot_prune_selector_states "$selector" default) \
          || die "loader.conf has an unknown default entry id: $selector"
        [ -n "$protected" ] || die "loader.conf has an empty default entry id: $selector"
        while IFS= read -r state; do
          [ -n "$state" ] || continue
          state_exists "$state" \
            || die "loader.conf default '$selector' names an unknown state '$state'; refusing delete"
          [ -n "$(latest_kernel "$state")" ] \
            || die "loader.conf default '$selector' names a state with no bootable kernel: $state"
          [ "$state" != "$target" ] \
            || die "refusing to delete configured systemd-boot default state $target; boot and select another default first"
        done <<<"$protected"
      done <<<"$defaults"
      raw=$(sdboot_oneshot_raw) \
        || die "cannot read the systemd-boot one-shot entry; refusing delete"
      protected=$(sdboot_prune_selector_states "$raw" one-shot) \
        || die "LoaderEntryOneShot names an unknown entry id: $raw"
      while IFS= read -r state; do
        [ -n "$state" ] || continue
        state_exists "$state" \
          || die "LoaderEntryOneShot names an unknown state '$state'; refusing delete"
        [ "$state" != "$target" ] \
          || die "refusing to delete the pending systemd-boot one-shot state $target"
      done <<<"$protected"
      ;;
    *) die "unsupported bootloader backend: $backend" ;;
  esac

  if [ "$dry" = 1 ]; then
    echo "would delete $target"
    return 0
  fi

  # Publish a menu that no longer exposes the target before deleting its subvolume. If the menu cannot be
  # published, dr-state exits with the state intact. If deletion fails, restore the menu from the surviving states.
  STATE_EXCLUDE=$target
  cmd_gen_menu
  STATE_EXCLUDE=""
  if btrfs subvolume delete "$TOP/$target" >/dev/null; then
    rm -f -- "$(metadata_path "$target")" \
      || die "deleted $target but could not remove its snapshot metadata"
    echo "deleted $target"
  else
    rc=$?
    echo "dr-state: could not delete $target; the subvolume remains" >&2
    if ! cmd_gen_menu; then
      echo "dr-state: menu regeneration also failed; $target remains hidden from the boot menu" >&2
    fi
    return "$rc"
  fi
  if [ "$backend" = systemd-boot ]; then prune_sdboot_kernels; fi
}

cmd_boot_once() {
  [ $# -eq 1 ] || die "usage: dr-state boot-once STATE"
  ensure_top
  state_exists "$1" || die "no such state: $1"
  local backend entry_id
  backend=$(bootloader) || die "cannot determine the bootloader backend"
  case "$backend" in
    grub) grub-editenv "$ESP_DIR/grubenv" set next_entry="$1" ;;
    systemd-boot)
      state_has_conf_suffix "$1" \
        && die "state $1 ends in .conf and is not selectable; refusing boot-once"
      ensure_esp
      entry_id=$(entry_id_for_state "$1") || die "cannot map state $1 to a systemd-boot entry id"
      cmd_gen_menu_systemd_boot
      [ -f "$SDBOOT_ENTRY_DIR/$entry_id.conf" ] \
        || die "state $1 has no bootable kernel entry; refusing the one-shot"
      bootctl_set_oneshot "$entry_id" ;;
  esac
}

if [ "${1:-}" = _window-blocks ]; then   # test hook: dr-state _window-blocks NAME INTERVAL NOW; exit 0 = blocks
  window_blocks "${2:?name}" "${3:?interval}" "${4:?now}"; exit $?
fi

if [ "${1:-}" = _snapshot-epoch ]; then
  snapshot_epoch_from_name "${2:?name}"; exit $?
fi

if [ "${1:-}" = _apt-plan-summary ]; then
  apt_plan_summary; exit $?
fi

if [ "${1:-}" = _state-name ]; then   # test hook: dr-state _state-name SEQUENCE TIMESTAMP REASON_SLUG
  state_name "${2:?sequence}" "${3:?timestamp}" "${4:?reason slug}"; exit $?
fi

if [ "${1:-}" = _snapshot-name ]; then   # test hook: dr-state _snapshot-name SEQUENCE TIMESTAMP SOURCE REASON
  snapshot_name "${2:?sequence}" "${3:?timestamp}" "${4:?source}" "${5:?reason}"; exit $?
fi

if [ "${1:-}" = _prune-select ]; then   # test hook: dr-state _prune-select KEEP PROTECTED_CSV NAME...
  shift; select_prune "${1:?keep}" "${2-}" "${@:3}"; exit $?
fi

if [ "${1:-}" = _sdboot-conf-backend ]; then
  bootloader_from_conf_file "${2:-}"; exit $?
fi
if [ "${1:-}" = _sdboot-marker-backend ]; then
  bootloader_from_marker_file "${2:-}"; exit $?
fi
if [ "${1:-}" = _sdboot-source-value ]; then
  sdboot_source_value "${2:-}" "${3:-}" "${4:-}"; exit $?
fi
if [ "${1:-}" = _sdboot-kernel-id ]; then
  kernel_id "${2:-}" "${3:-}"; exit $?
fi
if [ "${1:-}" = _sdboot-entry-id ]; then
  entry_id_for_state "${2:-}"; exit $?
fi
if [ "${1:-}" = _sdboot-state-from-id ]; then
  state_for_entry_id "${2:-}"; exit $?
fi
if [ "${1:-}" = _sdboot-entry-ids ]; then
  shift; sdboot_entry_ids "$@"; exit $?
fi
if [ "${1:-}" = _sdboot-entry-text ]; then
  sdboot_entry_text "${2:-}" "${3:-}" "${4:-}" "${5:-}"; exit $?
fi
if [ "${1:-}" = _sdboot-entry-refs ]; then
  sdboot_entry_refs; exit $?
fi
if [ "${1:-}" = _sdboot-orphan-kernels ]; then
  sdboot_orphan_kernels "${2-}" "${3-}"; exit $?
fi
if [ "${1:-}" = _sdboot-space-check ]; then
  sdboot_space_check "${2:-}" "${3:-}"; exit $?
fi
if [ "${1:-}" = _sdboot-byte-length ]; then
  sdboot_byte_length "${2-}"; exit $?
fi
if [ "${1:-}" = _sdboot-alloc-sum ]; then
  shift; sdboot_allocated_sum "$@"; exit $?
fi
if [ "${1:-}" = _sdboot-dir-alloc ]; then
  shift; sdboot_dir_alloc "$@"; exit $?
fi
if [ "${1:-}" = _sdboot-loader-conf ]; then
  sdboot_loader_conf "${2-}"; exit $?
fi
if [ "${1:-}" = _sdboot-select-backend ]; then
  select_bootloader "${2-}" "${3-}"; exit $?
fi
if [ "${1:-}" = _sdboot-clean-scratch ]; then
  [ "$TEST_MODE" = 1 ] || die "test hook _sdboot-clean-scratch requires DR_STATE_TEST_MODE=1"
  cleanup_sdboot_scratch "${2:-}" "${3:-}" "${4:-}" "${5:-}"; exit $?
fi

sub=${1:-}; [ $# -gt 0 ] && shift
case "$sub" in
  install-grub|install-systemd-boot|initialize-state|gen-menu|snapshot|apt-pre-install-pkgs|set-default|boot-once|prune|delete)
    # one writer at a time (apt hook, kernel hooks and manual runs can overlap)
    exec 9>"$DR_STATE_LOCK"
    flock -w 60 9 || die "another dr-state run holds the lock" ;;
esac
case "$sub" in
  install-grub) cmd_install_grub "$@" ;;
  install-systemd-boot) cmd_install_systemd_boot "$@" ;;
  initialize-state) cmd_initialize_state "$@" ;;
  gen-menu) cmd_gen_menu "$@" ;;
  snapshot) cmd_snapshot "$@" ;;
  apt-pre-install-pkgs) [ $# -eq 0 ] || die "apt-pre-install-pkgs takes no arguments"; cmd_apt_pre_install_pkgs ;;
  list) cmd_list "$@" ;;
  show) cmd_show "$@" ;;
  set-default) cmd_set_default "$@" ;;
  boot-once) cmd_boot_once "$@" ;;
  prune) cmd_prune "$@" ;;
  delete) cmd_delete "$@" ;;
  *) die "usage: dr-state install-grub|install-systemd-boot|initialize-state STATE TIMESTAMP|gen-menu|snapshot [--reason WORD] [--note TEXT]|list [--long]|show STATE|set-default STATE|boot-once STATE|delete STATE [--dry-run|--yes]|prune [--keep N] [--dry-run]" ;;
esac
