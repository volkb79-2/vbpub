#!/usr/bin/python3
"""Strip Bash startup hooks before starting the namespace wrapper."""

import os
import sys


_BASH_STARTUP_ENV = {"BASH_ENV", "ENV", "SHELLOPTS", "BASHOPTS"}
for _name in tuple(os.environ):
    if _name in _BASH_STARTUP_ENV or _name.startswith("BASH_FUNC_"):
        os.environ.pop(_name, None)

_worker = os.path.join(os.path.dirname(os.path.realpath(__file__)), "pi-pidns-bash-worker.sh")
os.execve("/bin/bash", ["/bin/bash", _worker, *sys.argv[1:]], os.environ)
