# Copy to controller.local.env and edit for this machine.
# The local file is sourced as shell and is ignored by Git.
CONTROLLER_HOME="$HOME/controller"
CONTROLLER_QUEUE="$CONTROLLER_HOME/bin/host-sat-queue.sh"
# Optional: gate-run logs are searched here for final-head evidence.
# CONTROLLER_LOGS_DIR="$CONTROLLER_HOME/logs"
# Optional alternate run-record directory for Codex, job-check, and
# resume-usage-limited.sh.
# CONTROLLER_RUNS_DIR="$CONTROLLER_HOME/runs"
# gate-run.sh requires both variables. Read the shared lock locations from
# host policy, fill these in, and export CONTROLLER_GATE_LOCK and
# CONTROLLER_GATE2_LOCK before running a gate.
# CONTROLLER_GATE_LOCK="/path/from-host-policy/gate.lock"
# CONTROLLER_GATE2_LOCK="/path/from-host-policy/gate2.lock"
# Set to the controller's vbpub checkout. Required when host-sat-queue.sh is
# installed under CONTROLLER_HOME/bin; repo-local scripts can derive it.
# CONTROLLER_REPO="/path/to/vbpub"
# Choose the Codex profile locations explicitly for this controller.
CODEX_HOME_LUNA="$HOME/.codex"
CODEX_HOME_DEEPSEEK_VOLKER="$HOME/.codex-opendesign-volker"
CODEX_HOME_DEEPSEEK_GITHUB2="$HOME/.codex-opendesign-github2"
CODEX_HOME_REVIEW="$HOME/.codex"
CODEX_SQLITE_HOME="$HOME/.codex/sqlite-shared"
# Optional absolute location for the key-free Open Design account state.
# Default: "$CONTROLLER_RUNS_DIR/opendesign-accounts.json"
# CONTROLLER_OD_STATE="/absolute/path/to/opendesign-accounts.json"
# Default temporary account block when a 402 has no parseable reset time: 21600 seconds (6 hours).
# CONTROLLER_OD_UNKNOWN_BLOCK_SECONDS=21600
# Prefer the account with the earliest recorded window end (default off).
# CONTROLLER_OD_PREFER_EXPIRING=1
# CODEX_AUTO_CONTINUE defaults to 0 for Luna and 2 for DeepSeek.
# CODEX_AUTO_CONTINUE=2
# RESUME_SKIP="run-one run-two"
# RESUME_EXCLUDE_PREFIXES="naf- external-"
# RESUME_MAX_AGE_MINUTES=180
# Set the selected engine venv before using release-from-wt.sh.
# CMRU_VENV="/path/to/cmru-engine-venv"
# Set these only when the local commands need explicit configuration.
# OPENCODE_COMMAND="/path/to/opencode-wrapper"
# OPENCODE_PROVIDER="opendesign_volker"
# OPENCODE_MODEL="opendesign_github2/deepseek-v4.1-flash-eco"
# NETCUP_TOKEN_FILE="/path/to/provider-token-file"
# REMOTE_GATE_HOSTS="$CONTROLLER_HOME/hosts.local.json"
