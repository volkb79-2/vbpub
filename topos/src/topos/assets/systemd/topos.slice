[Unit]
Description=Resource envelope for the topos host-inspection daemon and sampler

[Slice]
# D-024 envelope: observability must yield to production workloads and must report
# its own throttling (topos-sampler `status.throttle`), not hide it.
MemoryMin=48M
MemoryHigh=96M
MemoryMax=128M
MemorySwapMax=0
CPUQuota=25%
CPUWeight=20
IOWeight=20
TasksMax=32
