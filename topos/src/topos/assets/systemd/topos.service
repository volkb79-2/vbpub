[Unit]
Description=topos read-only daemon
After=network.target

[Service]
Type=simple
User=root
Group=topos
UMask=0007
# S-07: its own slice with its previous limits; topos.slice (128M) is the sampler's envelope.
Slice=topos-legacy.slice
RuntimeDirectory=topos
RuntimeDirectoryMode=0750
# Shared with topos-sampler.service: a restart of either keeps the other's files.
RuntimeDirectoryPreserve=yes
# The start command stays selectable until the Python daemon is retired (D-026): replace
# this line (drop-in) to run `topos-sampler` instead, or run topos-sampler.service beside it.
ExecStart=/usr/bin/env topos daemon serve --socket /run/topos/topos.sock
Restart=on-failure
RestartSec=5s

# The daemon needs host cgroup, Docker, BPF and optional DAMON access, so it is
# intentionally a host service rather than a privileged container.  Its slice,
# topos-legacy.slice, keeps the limits the daemon always had (256M/512M memory, weight 50,
# no CPU quota, so incident collection is not throttled); the D-024 envelope is the sampler's.
NoNewPrivileges=true
PrivateTmp=true

# Create the topos group and add approved users before enabling this unit.
# The daemon remains read-only; clients attach over its socket. (The Rust sampler's socket is
# root-only 0600: its `current` carries full command lines. Group access needs redaction first.)

[Install]
WantedBy=multi-user.target
